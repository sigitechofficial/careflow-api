# ─── Dependencies ─────────────────────────────────────────────
node_modules/

# ─── Nest / TypeScript build ──────────────────────────────────
dist/
build/
*.tsbuildinfo
# Accidental `tsc` output beside `.ts` sources (breaks Jest / ts-node resolution)
src/**/*.js

# ─── Environment (never commit) ───────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
prisma/.env
!.env.example


# ─── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Tests & coverage ─────────────────────────────────────────
coverage/
.nyc_output/

# ─── Caches ───────────────────────────────────────────────────
.cache/
.turbo/
.eslintcache
*.tmp
*.temp
tmp/
temp/

# ─── Local file uploads (dev / runtime) ───────────────────────
# Runtime-generated upload dirs — never commit these test/runtime artifacts.
# (uploads/care-pathway/* holds intentional committed assets, so keep it tracked.)
uploads/body-map/photos/
uploads/employee-app-incidents/
uploads/employee-app-observations/
uploads/incidents/attachments/
# Private carer voice notes (never statically served)
storage/visit-voice-notes/

# ─── Local documentation (not pushed to git) ────────────────────
Dcoumentation/
Documentation/

# ─── Local archives / exports ────────────────────────────────
*.zip

# ─── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── IDE / editors ───────────────────────────────────────────
.idea/
*.swp
*.swo
*~

# Firebase Admin private key
serviceAccount.json
storage/body-map-videos/
