model ReviewType {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  /// Stable key for seeded types (e.g. SUPERVISION); null for types an admin adds.
  code        String?   @unique
  description String?
  /// Days from "last done" to "next due" (e.g. 90 for supervision, NICE QS123). Null = no repeat.
  /// For EVENT types it is the follow-up gap once one has been recorded (e.g. PIP every 14 days).
  defaultIntervalDays Int?
  /// How the due date is worked out (review-schedule.util.ts): repeating, milestones after the
  /// carer's start date, or only when something happens (return to work, performance plan).
  scheduleKind           ReviewScheduleKind @default(REPEATING)
  /// REPEATING: first due this many days after the start date (null = the interval).
  firstDueAfterStartDays Int?
  /// MILESTONES: days after the start date (e.g. probation 30, 90, 180); done after the last one.
  milestoneDays          Int[]              @default([])
  /// Who it applies to (e.g. NMC revalidation: staff with an NMC PIN only).
  audience               ReviewAudience     @default(ALL_STAFF)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Care Pathway staff form used for sessions of this type (Settings → Supervision).
  supervisionFormId String? @db.Uuid

  reviews EmployeeReview[]
  supervisionForm     CarePathwayForm?     @relation("ReviewTypeSupervisionForm", fields: [supervisionFormId], references: [id], onDelete: SetNull)
