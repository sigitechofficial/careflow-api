  scheduledJobId      String   @db.Uuid
  scheduledVisitId    String?  @db.Uuid
  /// clock_in | clock_out | task | medication | observation | visit_note | handover | concern | incident
  eventType           String   @db.VarChar(32)
  occurredAt          DateTime
  timeLabel           String?  @db.VarChar(8)
  title               String
  detail              String?  @db.Text
  /// primary | success | danger | warning | teal | ink
  tone                String?  @db.VarChar(16)
  /// check_in | task | medication | observation | log_note | handover | concern | incident | complete
  sourceType          String   @db.VarChar(32)
  sourceId            String   @db.VarChar(128)
  logEntryId          String?  @db.VarChar(128)
  isDraft             Boolean  @default(false)
  idempotencyKey      String?  @unique @db.VarChar(128)
  createdByEmployeeId String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  scheduledJob ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)

  @@unique([scheduledJobId, sourceType, sourceId, eventType])
  @@index([scheduledJobId, occurredAt])
  @@index([scheduledJobId, isDraft])
  @@schema("scheduling")
}

/// Carer voice note (audio) attached to a visit log entry (visit note / handover / concern).
/// Files live in private storage (never the public /uploads static path) and are served
/// only through permission-checked endpoints. One active voice note per log entry —
/// the entry's `voiceNoteId` in ScheduledJob.metadata.employeeApp decides which one shows.
model VisitVoiceNote {
  id                   String    @id @default(uuid()) @db.Uuid
  scheduledJobId       String    @db.Uuid
  /// Carer-app log entry id (clientEntryId) the recording belongs to.
  logEntryId           String    @db.VarChar(128)
  /// visit_note | handover | concern
  entryType            String    @db.VarChar(32)
  /// Carer-app generated id; the log entry references it as `voiceNoteId`.
  clientVoiceNoteId    String    @db.VarChar(128)
  fileName             String    @db.VarChar(255)
  originalName         String?   @db.VarChar(255)
  /// Relative to the API working directory (private storage root).
  storagePath          String    @db.VarChar(512)
  mimeType             String    @db.VarChar(100)
  fileSize             Int
  durationMs           Int?
  recordedAt           DateTime?
  uploadedByEmployeeId String?   @db.Uuid
  idempotencyKey       String    @unique @db.VarChar(128)
  createdAt            DateTime  @default(now())
  deletedAt            DateTime?

  scheduledJob ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)

  @@unique([scheduledJobId, clientVoiceNoteId])
  @@index([scheduledJobId, logEntryId])
  @@schema("scheduling")
}

