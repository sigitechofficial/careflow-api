  medicationRequired     Boolean              @default(false)
  checklistRequired      Boolean              @default(false)
  photoRequired          Boolean              @default(false)
  notesRequired          Boolean              @default(false)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  createdById            String?              @db.Uuid
  updatedById            String?              @db.Uuid
  deletedById            String?              @db.Uuid

  scheduledJob ScheduledJob  @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  serviceUser  ServiceUser     @relation(fields: [serviceUserId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("ScheduledVisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?           @relation("ScheduledVisitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy    User?           @relation("ScheduledVisitDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  actions      VisitAction[]
  allocations  JobAllocation[]
  callOffVisits CallOffVisit[]

  @@index([scheduledJobId])
  @@index([serviceUserId])
  @@index([status])
  @@index([scheduledStartDateTime])
  @@index([deletedAt])
  @@index([isActive])
  @@schema("scheduling")
}

enum CallOffVisitStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED

  @@schema("scheduling")
}

model CallOffVisit {
  id               String             @id @default(uuid()) @db.Uuid
  scheduledJobId   String?            @db.Uuid
  scheduledVisitId String?            @db.Uuid
  serviceUserId    String             @db.Uuid
  callOffDate      DateTime           @db.Date
  reason           String
  notes            String?
  status           CallOffVisitStatus @default(REQUESTED)
  requestedById    String?            @db.Uuid
  approvedById     String?            @db.Uuid
  approvedAt       DateTime?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  scheduledJob   ScheduledJob?   @relation(fields: [scheduledJobId], references: [id], onDelete: SetNull)
  scheduledVisit ScheduledVisit? @relation(fields: [scheduledVisitId], references: [id], onDelete: SetNull)
  serviceUser    ServiceUser     @relation(fields: [serviceUserId], references: [id], onDelete: Restrict)
  requestedBy    User?           @relation("CallOffVisitRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy     User?           @relation("CallOffVisitApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([scheduledJobId])
  @@index([scheduledVisitId])
  @@index([serviceUserId])
  @@index([callOffDate])
  @@index([status])
  @@index([deletedAt])
  @@index([isActive])
  @@schema("scheduling")
}

enum AllocationStatus {
  PENDING_CONFIRMATION
  ALLOCATED
  CONFIRMED
  UNALLOCATED
  CANCELLED

  @@schema("scheduling")
}

model JobAllocation {
  id                 String           @id @default(uuid()) @db.Uuid
  scheduledJobId     String           @db.Uuid
  scheduledVisitId   String?          @db.Uuid
  employeeId         String           @db.Uuid
  status             AllocationStatus @default(PENDING_CONFIRMATION)
  requiresConfirmation Boolean        @default(false)
  confirmedAt        DateTime?
  confirmedById      String?          @db.Uuid
  warningTypes       Json?
  warningMessages    Json?
  notes              String?
  allocatedAt        DateTime         @default(now())
  allocatedById      String?          @db.Uuid
  unallocatedAt      DateTime?
  unallocatedById    String?          @db.Uuid
  unallocationReason String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  scheduledJob   ScheduledJob    @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  scheduledVisit ScheduledVisit? @relation(fields: [scheduledVisitId], references: [id], onDelete: SetNull)
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  allocatedBy    User?           @relation("JobAllocationAllocatedBy", fields: [allocatedById], references: [id], onDelete: SetNull)
  confirmedBy    User?           @relation("JobAllocationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  unallocatedBy  User?           @relation("JobAllocationUnallocatedBy", fields: [unallocatedById], references: [id], onDelete: SetNull)

  @@index([scheduledJobId])
  @@index([scheduledVisitId])
  @@index([employeeId])
  @@index([status])
  @@index([deletedAt])
  @@index([isActive])
  @@schema("scheduling")
}

model VisitAction {
  id               String    @id @default(uuid()) @db.Uuid
  scheduledJobId   String?   @db.Uuid
  scheduledVisitId String?   @db.Uuid
  name             String
  description      String?
  actionType       String?
  isRequired       Boolean   @default(false)
  sortOrder        Int       @default(0)
  completedAt      DateTime?
  completedById    String?   @db.Uuid
  status           String?
  notes            String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  scheduledJob   ScheduledJob?   @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  scheduledVisit ScheduledVisit? @relation(fields: [scheduledVisitId], references: [id], onDelete: Cascade)
  completedBy    Employee?       @relation("VisitActionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([scheduledJobId])
  @@index([scheduledVisitId])
  @@index([deletedAt])
  @@index([isActive])
  @@schema("scheduling")
}

