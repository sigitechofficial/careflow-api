model ServiceUser {
  id                       String    @id @default(uuid()) @db.Uuid
  serviceUserNumber        String?   @unique
  residentId               String?
  residentGuid             String?   @unique
  firstName                String
  middleName               String?
  lastName                 String
  preferredName            String?
  dateOfBirth              DateTime?
  titleId                  String?   @db.Uuid
  genderId                 String?   @db.Uuid
  maritalStatusId          String?   @db.Uuid
  statusId                 String?   @db.Uuid
  careTypeId               String?   @db.Uuid
  fundingTypeId            String?   @db.Uuid
  riskLevelId              String?   @db.Uuid
  profilePhotoUrl          String?
  nhsNumber                String?
  socialServicesRef        String?
  nationalInsuranceNumber  String?
  email                    String?
  phone                    String?
  mobile                   String?
  serviceStartDate         DateTime?
  serviceEndDate           DateTime?
  locationId               String?   @db.Uuid
  keyWorkerId              String?   @db.Uuid
  namedNurseId             String?   @db.Uuid
  notes                    String?

  currentFundingId       String?   @unique @db.Uuid

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  title         ServiceUserTitle?         @relation(fields: [titleId], references: [id])
  gender        ServiceUserGender?        @relation(fields: [genderId], references: [id])
  maritalStatus ServiceUserMaritalStatus? @relation(fields: [maritalStatusId], references: [id])
  status        ServiceUserStatus?        @relation(fields: [statusId], references: [id])
  careType      ServiceUserCareType?      @relation(fields: [careTypeId], references: [id])
  fundingType   ServiceUserFundingType?   @relation(fields: [fundingTypeId], references: [id])
  riskLevel     ServiceUserRiskLevel?     @relation(fields: [riskLevelId], references: [id])
  location      Location?                 @relation(fields: [locationId], references: [id])
  keyWorker     Employee?                 @relation("ServiceUserKeyWorker", fields: [keyWorkerId], references: [id])
  namedNurse    Employee?                 @relation("ServiceUserNamedNurse", fields: [namedNurseId], references: [id])

  contacts        ServiceUserContact[]
  address         ServiceUserAddress?
  references      ServiceUserReference[]
  assignments     ServiceUserAssignment[]
  photos          ServiceUserPhoto[]
  inventoryItems  ServiceUserInventoryItem[]
  allergies       ServiceUserAllergy[]
  legalDocument   ServiceUserLegalDocument?
  dolsRecords     ServiceUserDolsRecord[]
  absences          ServiceUserAbsence[]
  domCare           ServiceUserDomCare?
  initialAssessment ServiceUserInitialAssessment?
  fundings          ServiceUserFunding[] @relation("FundingLines")
  currentFunding    ServiceUserFunding?  @relation("FundingAsCurrent", fields: [currentFundingId], references: [id])
  liveInProfile     ServiceUserLiveInProfile?

  medicationPacks              MedicationPack[]
  medicationAllergies          MedicationAllergy[]
  medications                ServiceUserMedication[]
  medicationSupportProfile   MedicationSupportProfile?
  medicationAdministrationEvents MedicationAdministrationEvent[]
  medicationReviews          MedicationReview[]

  @@index([deletedAt])
  @@index([statusId])
  @@index([careTypeId])
  @@index([fundingTypeId])
  @@index([riskLevelId])
  @@index([locationId])
  @@index([keyWorkerId])
  @@index([namedNurseId])
  @@index([lastName, firstName])
  @@schema("service_users")
}

