model VisitReconciliation {
  id                     String                    @id @default(uuid()) @db.Uuid
  scheduledVisitId       String                    @db.Uuid
  scheduledJobId         String                    @db.Uuid
  serviceUserId          String                    @db.Uuid
  employeeId             String?                   @db.Uuid
  jobAllocationId        String?                   @db.Uuid
  visitRef               String
  plannedStartDateTime   DateTime
  plannedEndDateTime     DateTime?
  actualStartDateTime    DateTime?
  actualEndDateTime      DateTime?
  approvedPayStart       DateTime?
  approvedPayEnd         DateTime?
  approvedBillStart      DateTime?
  approvedBillEnd        DateTime?
  payableMinutes         Int?
  billableMinutes        Int?
  payableAmount          Decimal?                  @db.Decimal(12, 2)
  billableAmount         Decimal?                  @db.Decimal(12, 2)
  travelMiles            Decimal?                  @db.Decimal(10, 2)
  travelMinutes          Int?
  /**
   * Qualifying unpaid travel minutes (NMW hours) not paid as TRAVEL_TIME wages.
   */
  unpaidTravelMinutes    Int?
  /**
   * Passenger miles for AMAP passenger supplement (driver only).
   */
  passengerMiles         Decimal?                  @db.Decimal(10, 2)
  /**
   * Snapshot of pay card version used when last evaluated.
   */
  payCardVersion         Int?
  /**
   * Frozen copy of the calculation breakdown (calculationPreview shape) captured
   * when the visit was priced at completion. Replayed on the detail view so later
   * pay/charge card rule edits do not retro-change how a completed visit was priced.
   */
  pricingSnapshot        Json?
  /**
   * When the pricingSnapshot was captured.
   */
  pricingSnapshotAt      DateTime?
  currency               String                    @default("GBP")
  status                 VisitReconciliationStatus @default(PENDING_REVIEW)
  payCardId              String?                   @db.Uuid
  chargeCardId           String?                   @db.Uuid
  payCardSource          String?
  chargeCardSource       String?
  approvedById           String?                   @db.Uuid
  approvedAt             DateTime?
  /// Who or what approved (R-18): AUTO_VERIFIED | MANAGER_APPROVED | MANAGER_OVERRIDE.
  /// Null on a row that is not approved, or was approved before this was recorded.
  approvalSource         String?
  /// The attendance evidence the approval was given for: start|finish|review flag
  /// (see approval-evidence.util). Evidence that differs later withdraws an automatic approval
  /// and sends a person's approval back for review.
  approvedEvidence       String?
  /// Set when new evidence undermined a person's approval, or reached a visit whose pay is
  /// settled. Cleared by the next approval or by the office verifying the times.
  evidenceChangedReason  String?
  evidenceChangedAt      DateTime?
  approvalNotes          String?
  /**
   * Minutes actual exceeded planned (null when no overrun).
   */
  overrunMinutes         Int?
  /**
   * Required from carer/recorder when actual time exceeds planned.
   */
  overrunReason          String?
  /**
   * Admin decision on whether to pay the overrun minutes.
   */
  overrunDecision        VisitOverrunDecision?
  /**
   * Chosen when the overrun is acknowledged: price carer pay / client charge on the
   * planned slot or the actual clock times. Null = legacy rule (pay actual, charge from actual).
   */
  overrunPayBasis        VisitOverrunTimeBasis?
  overrunBillBasis       VisitOverrunTimeBasis?
  lockedAt               DateTime?
  lastEvaluatedAt        DateTime?
  includedInPayrollRunId String?                   @db.Uuid
  /// Set when a UK payroll run closes with this visit as a provisional input (approved, but never
  /// put through a visit pay run). Like includedInPayrollRunId it means "pay settled": the visit
  /// cannot be paid again and its pay snapshot is frozen.
  paidByUkPayrollRunId   String?                   @db.Uuid
  includedInInvoiceRunId String?                   @db.Uuid
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  exceptions           FinanceException[]
  payrollRunLines      PayrollRunLine[]
  invoiceRunLines      InvoiceRunLine[]
  includedInPayrollRun PayrollRun?        @relation("ReconciliationPayrollRun", fields: [includedInPayrollRunId], references: [id], onDelete: SetNull)
  includedInInvoiceRun InvoiceRun?        @relation("ReconciliationInvoiceRun", fields: [includedInInvoiceRunId], references: [id], onDelete: SetNull)

  @@unique([scheduledVisitId, jobAllocationId])
  @@index([scheduledVisitId])
  @@index([scheduledJobId])
  @@index([serviceUserId])
  @@index([employeeId])
  @@index([status])
  @@index([plannedStartDateTime])
  @@index([overrunDecision])
  @@index([includedInPayrollRunId])
  @@index([paidByUkPayrollRunId])
  @@index([includedInInvoiceRunId])
  @@schema("billing")
}

