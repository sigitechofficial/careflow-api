model PayCard {
  id   String @id @default(uuid()) @db.Uuid
  name String
  code String

  assignmentLevel         PayCardAssignmentLevel @default(ORGANISATION_DEFAULT)
  assignmentTargetId      String?                @db.Uuid
  assignmentTargetKey     String?
  assignmentLabel         String?
  currency                String                 @default("GBP")
  nation                  String?                @default("ENG")
  payFrequency            BillingFrequency       @default(WEEKLY)
  version                 Int                    @default(1)
  stackingPolicy          PayStackingPolicy      @default(PRIORITY)
  holidayPayMethod        HolidayPayMethod?
  travelInheritsTimeBands Boolean                @default(false)
  mileageVehicleType      MileageVehicleType     @default(CAR_VAN)
  useUkMileageRates       Boolean                @default(true)
  status                  BillingCardStatus      @default(DRAFT)
  effectiveFrom           DateTime               @db.Date
  effectiveTo             DateTime?              @db.Date
  notes                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  deletedAt               DateTime?
  createdById             String?                @db.Uuid
  updatedById             String?                @db.Uuid
  replacedById            String?                @db.Uuid

  rules                     PayCardRule[]
  defaultEmployments        EmployeeEmployment[]          @relation("EmployeeDefaultPayCard")
  payComponents             PayComponent[]
  employeeFunderAssignments EmployeeFunderPayAssignment[]

  @@unique([code, version])
  @@index([deletedAt])
  @@index([status])
  @@index([assignmentLevel, assignmentTargetId])
  @@index([assignmentLevel, assignmentTargetKey])
  @@schema("billing")
}

/**
 * Per-carer pay card override for work funded by a specific council/funder.
 * Visit pay resolve: Employee+Funder → Employee default → role/branch/… match.
 * Charge cards remain independent.
 */
model EmployeeFunderPayAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @db.Uuid
  funderId      String    @db.Uuid
  payCardId     String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid

  payCard PayCard @relation(fields: [payCardId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([funderId])
  @@index([payCardId])
  @@index([deletedAt])
  @@index([employeeId, funderId])
  @@schema("billing")
}

model PayCardRule {
  id                String                @id @default(uuid()) @db.Uuid
  payCardId         String                @db.Uuid
  label             String?
  serviceType       String?
  dayType           BillingDayType        @default(ANY)
  startTime         String?
  endTime           String?
  rateType          BillingRateType       @default(HOURLY)
  amount            Decimal               @db.Decimal(12, 4)
  multiplier        Decimal?              @db.Decimal(8, 4)
  additionalAmount  Decimal?              @db.Decimal(12, 4)
  percentageUplift  Decimal?              @db.Decimal(8, 4)
