model User {
  id               String  @id @default(uuid()) @db.Uuid
  email            String  @unique
  username         String? @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  refreshTokenHash String?

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("UserDeletedBy", fields: [deletedById], references: [id])

  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")
  deletedUsers User[] @relation("UserDeletedBy")

  userRoles                            UserRole[]
  /**
   * Authorization branch membership (distinct from employee employment locations).
   */
  userLocations                        UserLocation[]
  auditLogs                            AuditLog[]
  loginHistories                       LoginHistory[]
  securityEvents                       SecurityEvent[]
  dataAccessLogs                       DataAccessLog[]
  exportLogs                           ExportLog[]
  reviewedEmployees                    EmployeeReview[]                      @relation("EmployeeReviewReviewedBy")
  uploadedEmployeeDocuments            EmployeeDocument[]
  employeeCompliancesVerified          EmployeeCompliance[]                  @relation("EmployeeComplianceVerifiedBy")
  employeeCompliancesRejected          EmployeeCompliance[]                  @relation("EmployeeComplianceRejectedBy")
  employeeCompliancesNoLongerReq       EmployeeCompliance[]                  @relation("EmployeeComplianceNoLongerRequiredBy")
  employeeComplianceDocumentsUploaded  EmployeeComplianceDocument[]          @relation("EmployeeComplianceDocumentUploadedBy")
  complianceVerificationsPerformed     ComplianceVerification[]              @relation("ComplianceVerificationPerformedBy")
  approvedServiceUserFundings          ServiceUserFunding[]                  @relation("ServiceUserFundingApprovedBy")
  uploadedLiveInContractDocuments      ServiceUserLiveInContractDocument[]   @relation("LiveInContractUploadedBy")
  uploadedServiceUserDocumentRecords   ServiceUserDocumentRecord[]           @relation("ServiceUserDocumentRecordUploadedBy")
  notificationRecipients               NotificationRecipient[]
  notificationPreferences              NotificationPreference[]
  notificationsCreated                 Notification[]                        @relation("NotificationCreatedBy")
  initialAssessmentsSubmitted          InitialAssessmentSubmission[]         @relation("InitialAssessmentSubmittedBy")
  initialAssessmentsReviewed           InitialAssessmentSubmission[]         @relation("InitialAssessmentReviewedBy")
  initialAssessmentsCreated            InitialAssessmentSubmission[]         @relation("InitialAssessmentCreatedBy")
  initialAssessmentsUpdated            InitialAssessmentSubmission[]         @relation("InitialAssessmentUpdatedBy")
  initialAssessmentActionsAssigned     InitialAssessmentAction[]             @relation("InitialAssessmentActionAssignee")
  initialAssessmentAttachmentsUploaded InitialAssessmentAttachment[]         @relation("InitialAssessmentAttachmentUploadedBy")
  initialAssessmentRisksResponsible    InitialAssessmentRiskRecord[]         @relation("InitialAssessmentRiskResponsible")
  serviceUserAssessmentCompletions     ServiceUserAssessmentCompletion[]     @relation("ServiceUserAssessmentCompletedBy")
  carePlanAssessmentLinksLinked        CarePlanAssessmentLink[]              @relation("CarePlanAssessmentLinkedBy")
  carePlanInstancesCreated             ServiceUserCarePlanInstance[]         @relation("CarePlanInstanceCreatedBy")
  carePlanInstancesUpdated             ServiceUserCarePlanInstance[]         @relation("CarePlanInstanceUpdatedBy")
  carePlanInstancesLastReviewed        ServiceUserCarePlanInstance[]         @relation("CarePlanInstanceLastReviewedBy")
  carePlanDraftsUpdated                ServiceUserCarePlanDraft[]            @relation("CarePlanDraftUpdatedBy")
  carePlanVersionsPublished            ServiceUserCarePlanPublishedVersion[] @relation("CarePlanVersionPublishedBy")
  scheduleAreasCreated                 ScheduleArea[]                        @relation("ScheduleAreaCreatedBy")
  scheduleAreasUpdated                 ScheduleArea[]                        @relation("ScheduleAreaUpdatedBy")
  scheduleAreasDeleted                 ScheduleArea[]                        @relation("ScheduleAreaDeletedBy")
  serviceUserAreasCreated              ServiceUserArea[]                     @relation("ServiceUserAreaCreatedBy")
  serviceUserAreasUpdated              ServiceUserArea[]                     @relation("ServiceUserAreaUpdatedBy")
  serviceUserAreasDeleted              ServiceUserArea[]                     @relation("ServiceUserAreaDeletedBy")
  scheduleBatchesCreated               ScheduleBatch[]                       @relation("ScheduleBatchCreatedBy")
  scheduleBatchesUpdated               ScheduleBatch[]                       @relation("ScheduleBatchUpdatedBy")
  scheduleBatchesDeleted               ScheduleBatch[]                       @relation("ScheduleBatchDeletedBy")
  scheduleBatchesBuilt                 ScheduleBatch[]                       @relation("ScheduleBatchBuiltBy")
  scheduleAreaStatusesBuilt            ScheduleAreaStatus[]                  @relation("ScheduleAreaStatusBuiltBy")
  scheduleRunsCreated                  ScheduleRun[]                         @relation("ScheduleRunCreatedBy")
  scheduleRunsUpdated                  ScheduleRun[]                         @relation("ScheduleRunUpdatedBy")
  scheduleRunsDeleted                  ScheduleRun[]                         @relation("ScheduleRunDeletedBy")
  scheduledJobsCreated                 ScheduledJob[]                        @relation("ScheduledJobCreatedBy")
  scheduledJobsUpdated                 ScheduledJob[]                        @relation("ScheduledJobUpdatedBy")
  scheduledJobsDeleted                 ScheduledJob[]                        @relation("ScheduledJobDeletedBy")
  scheduledVisitsCreated               ScheduledVisit[]                      @relation("ScheduledVisitCreatedBy")
  scheduledVisitsUpdated               ScheduledVisit[]                      @relation("ScheduledVisitUpdatedBy")
  scheduledVisitsDeleted               ScheduledVisit[]                      @relation("ScheduledVisitDeletedBy")
  jobAllocationsAllocated              JobAllocation[]                       @relation("JobAllocationAllocatedBy")
  jobAllocationsConfirmed              JobAllocation[]                       @relation("JobAllocationConfirmedBy")
  jobAllocationsUnallocated            JobAllocation[]                       @relation("JobAllocationUnallocatedBy")
  callOffVisitsRequested               CallOffVisit[]                        @relation("CallOffVisitRequestedBy")
  callOffVisitsApproved                CallOffVisit[]                        @relation("CallOffVisitApprovedBy")
  scheduledJobCancellations            ScheduledJobCancellation[]            @relation("ScheduledJobCancellationBy")
  scheduledJobReinstatements           ScheduledJobCancellation[]            @relation("ScheduledJobReinstatedBy")
  observationsRecorded                 ServiceUserObservation[]              @relation("ObservationRecordedByUser")
  serviceUserFlashMessagesCreated      ServiceUserFlashMessage[]             @relation("FlashMessageCreatedBy")
  bodyMapRecordsCreated                BodyMapRecord[]                       @relation("BodyMapRecordCreatedBy")
  bodyMapRecordsUpdated                BodyMapRecord[]                       @relation("BodyMapRecordUpdatedBy")
  bodyMapRecordsClosed                 BodyMapRecord[]                       @relation("BodyMapRecordClosedBy")
  bodyMapMarkersCreated                BodyMapMarker[]                       @relation("BodyMapMarkerCreatedBy")
  bodyMapReviewsAuthored               BodyMapReview[]                       @relation("BodyMapReviewedBy")
  bodyMapAlertsDismissed               BodyMapAlert[]                        @relation("BodyMapAlertDismissedBy")
  bodyMapAuditLogs                     BodyMapAuditLog[]                     @relation("BodyMapAuditActor")
  bodyMapSafeguardingChecksCompleted   BodyMapSafeguardingCheck[]            @relation("BodyMapSafeguardingCompletedBy")
  bodyMapPhotosUploaded                BodyMapPhoto[]                        @relation("BodyMapPhotoUploadedBy")
  bodyMapLinksCreated                  BodyMapLink[]                         @relation("BodyMapLinkCreatedBy")
  bodyMapWoundAssessmentsCreated       BodyMapWoundAssessment[]              @relation("BodyMapWoundAssessmentCreatedBy")
  bodyMapPressureAssessmentsCreated    BodyMapPressureAssessment[]           @relation("BodyMapPressureAssessmentCreatedBy")
  bodyMapMedicationSitesApplied        BodyMapMedicationSite[]               @relation("BodyMapMedicationSiteAppliedBy")
  bodyMapMedicationSitesCreated        BodyMapMedicationSite[]               @relation("BodyMapMedicationSiteCreatedBy")
  serviceUserFlashMessagesUpdated      ServiceUserFlashMessage[]             @relation("FlashMessageUpdatedBy")
  serviceUserFlashMessagesCleared      ServiceUserFlashMessage[]             @relation("FlashMessageClearedBy")
  serviceUserFlashMessagesDeleted      ServiceUserFlashMessage[]             @relation("FlashMessageDeletedBy")
  companyProfilesUpdated               CompanyProfile[]                      @relation("CompanyProfileUpdatedBy")
  organisationGeneralSettingsUpdated   OrganisationGeneralSettings[]         @relation("OrganisationGeneralSettingsUpdatedBy")
  medicationSupplyDeliveriesReceived   MedicationSupplyDelivery[]            @relation("MedSupplyReceivedBy")
  medicationSupplyDeliveriesWitnessed  MedicationSupplyDelivery[]            @relation("MedSupplyWitnessBy")
  medicationSupplyDeliveriesCreated    MedicationSupplyDelivery[]            @relation("MedSupplyDeliveryCreatedBy")
  medicationEventsEntered              MedicationAdministrationEvent[]       @relation("MedEventEnteredBy")
  medicationEventsCreated              MedicationAdministrationEvent[]       @relation("MedEventCreatedBy")
  medicationEventsManagerReviewed      MedicationAdministrationEvent[]       @relation("MedEventManagerReviewedBy")
  medicationsStatusEnded               ServiceUserMedication[]               @relation("MedicationStatusEndedBy")
  visitTaskAssignmentsCreated          ServiceUserVisitTaskAssignment[]      @relation("ServiceUserVisitTaskAssignmentCreatedBy")
  visitTaskAssignmentsUpdated          ServiceUserVisitTaskAssignment[]      @relation("ServiceUserVisitTaskAssignmentUpdatedBy")
  vacanciesCreated                     Vacancy[]                             @relation("VacancyCreatedBy")
  candidatesConverted                  Candidate[]                           @relation("CandidateConvertedBy")
  candidateDocumentsUploaded           CandidateDocument[]                   @relation("CandidateDocumentUploadedBy")
  candidateStageChanges                CandidateStageHistory[]               @relation("CandidateStageChangedBy")
  policyDocumentsOwned                 PolicyDocument[]                      @relation("PolicyDocumentOwner")
  policyDocumentsReviewed              PolicyDocument[]                      @relation("PolicyDocumentReviewer")
  policyDocumentsApproved              PolicyDocument[]                      @relation("PolicyDocumentApprover")
  policyApprovalsAuthored              PolicyApproval[]                      @relation("PolicyApprovalActor")
  policyAcknowledgements               PolicyAcknowledgement[]

  @@index([email])
  @@index([deletedAt])
  @@schema("identity")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  policyAudiences PolicyAudience[]

  @@index([deletedAt])
  @@schema("identity")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  rolePermissions RolePermission[]

  @@index([deletedAt])
  @@schema("identity")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@schema("identity")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@schema("identity")
}

/// Office-user ↔ branch (Location) assignment for authorization scope.
/// Separate from EmployeeEmployment location fields (job placement).
model UserLocation {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  locationId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@schema("identity")
}

/// Singleton organisation profile (one row per deployment).
model CompanyProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  groupName            String?
  companyName          String
  odsCsCode            String
  displayName          String
  displayLogoUrl       String?
  displayLogoFileName  String?
  companyLogoUrl       String?
  companyLogoFileName  String?
  companyWebsite       String?
  contactName          String
  email                String
  phoneNumber          String
  companyNumber        String?
  vatNumber            String?
  bankName             String?
  bankSortCode         String?
  bankAccountNumber    String?
  numberOfCarers       Int      @default(0)
  numberOfServiceUsers Int      @default(0)
  activeModules        String[] @default([])
  /// Organisation-operated care settings (ServiceUserCareType codes, e.g. DOMICILIARY, RESIDENTIAL, SUPPORTED_LIVING).
  /// Empty = not configured. Used for policy visibility; not inferred from service-user records.
  careServiceTypes     String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  updatedById          String?  @db.Uuid

  updatedBy User? @relation("CompanyProfileUpdatedBy", fields: [updatedById], references: [id])

  @@schema("identity")
}

enum TimeDisplayFormat {
  HH_XX
  HH_MM

  @@schema("identity")
}

enum DateDisplayFormat {
  DD_MM_YYYY
  MM_DD_YYYY
  YYYY_MM_DD

  @@schema("identity")
}

enum DefaultCarerStatus {
  ACTIVE
  INACTIVE

  @@schema("identity")
}

enum HolidayUnit {
  HOURS
  DAYS

  @@schema("identity")
}

enum SalaryCalculationBasis {
  MONTHLY
  WEEKLY

  @@schema("identity")
}

/// How multi-carer (double-up) visits are charged to the service-user funder.
/// COMBINED = sum each carer's billable hours (default).
/// FIXED = charge the visit window once (envelope duration).
enum MultiCarerFunderChargeMode {
  COMBINED
  FIXED

  @@schema("identity")
}

enum ComplianceRequiredBy {
  ROLE_WORK_AREA
  CITIZENSHIP

  @@schema("identity")
}

enum ComplianceApprovalType {
  MANAGER_APPROVAL
  HR_APPROVAL

  @@schema("identity")
}

enum WellbeingRegularity {
  DAILY
  WEEKLY
  MONTHLY

  @@schema("identity")
}

enum ActionsDefaultView {
  TASK_LIST
  ACTIONS_LIST

  @@schema("identity")
}

enum AllocateEmployeeBy {
  FLOOR
  WARD
  ZONE
  UNIT

  @@schema("identity")
}

/// WARN = compliance issues surface as allocation warnings (existing-org default).
/// BLOCK = missing/expired/rejected mandatory checks prevent allocation.
enum ComplianceAllocationMode {
  WARN
  BLOCK

  @@schema("identity")
}

/// Singleton organisation general settings (care rules, time display, etc.).
model OrganisationGeneralSettings {
  id                                   String                     @id @default(uuid()) @db.Uuid
  reviewCarePlanAfterDays              Int                        @default(180)
  handoverReportLastHours              Int                        @default(12)
  archiveServiceUserAfterMonths        Int                        @default(3)
  timeDisplayFormat                    TimeDisplayFormat          @default(HH_MM)
  dateDisplayFormat                    DateDisplayFormat          @default(DD_MM_YYYY)
  /// IANA timezone for operational calendar days (schedules, ECM, "today").
  timezone                             String                     @default("Asia/Karachi")
  defaultCarerStatus                   DefaultCarerStatus         @default(ACTIVE)
  sendEmailWhenEmployeeActive          Boolean                    @default(true)
  allowMultipleRoles                   Boolean                    @default(true)
  allowWeekendDaysInHoliday            Boolean                    @default(true)
  mandateComplianceForNewEmployees     Boolean                    @default(false)
  defaultHolidaysUnit                  HolidayUnit                @default(DAYS)
  /// How employee salary is periodised in admin (visit pay + fines/penalties).
  salaryCalculationBasis               SalaryCalculationBasis     @default(MONTHLY)
  /// Multi-carer visits: charge funder for combined carer hours or fixed visit length.
  multiCarerFunderChargeMode           MultiCarerFunderChargeMode @default(COMBINED)
  recruitmentFunctionalityRequired     Boolean                    @default(true)
  complianceRequiredBy                 ComplianceRequiredBy       @default(ROLE_WORK_AREA)
  complianceApprovalForNewEmployee     ComplianceApprovalType     @default(MANAGER_APPROVAL)
  /// Existing orgs stay WARN so rotas are not surprise-blocked; switch to BLOCK in settings.
  complianceAllocationMode             ComplianceAllocationMode   @default(WARN)
  /// Computed statuses that block when mode is BLOCK (always warn when mode is WARN).
  complianceBlockStatuses              String[]                   @default(["MISSING", "EXPIRED", "REJECTED"])
  includeLearningInAllocationBlock     Boolean                    @default(false)
  calculateSicknessBradfordScale       Boolean                    @default(false)
  recordServiceUserWellbeing           Boolean                    @default(false)
  recordEmployeeWellbeing              Boolean                    @default(true)
  wellbeingRegularity                  WellbeingRegularity        @default(DAILY)
  wellbeingLabel1                      String                     @default("Very Happy")
  wellbeingLabel2                      String                     @default("Somewhat Happy")
  wellbeingLabel3                      String                     @default("Somewhat sad")
  wellbeingLabel4                      String                     @default("sad")
  wellbeingLabel5                      String                     @default("Very Sad")
  enhancedRegularActionChecks          Boolean                    @default(true)
  showRegularActionsInDailyList        Boolean                    @default(true)
  allowFastAction                      Boolean                    @default(true)
  actionsDefaultView                   ActionsDefaultView         @default(TASK_LIST)
  appDefaultToObservationsTab          Boolean                    @default(true)
  allocateEmployeeBy                   AllocateEmployeeBy         @default(FLOOR)
  restrictCarerToAllocatedServiceUsers Boolean                    @default(true)
  restrictLoginToShiftTimes            Boolean                    @default(true)
  preventCarerWebLogin                 Boolean                    @default(true)
  shiftAccessMinutesBefore             Int                        @default(60)
  shiftAccessMinutesAfter              Int                        @default(30)
  domJobCancellationRules              Json                       @default("[]")
  domGlobalToleranceMinutes            Int                        @default(30)
  domGeofenceDistanceMeters            Int                        @default(100)
  domWorkPatternCycles                 Int                        @default(2)
  domShowAllEmployeesAcrossZones       Boolean                    @default(true)
  domEmailTomorrowsSchedule            Boolean                    @default(false)
  domAppShowHoursBefore                Int                        @default(48)
  domRestrictJobOutsideGeofence        Boolean                    @default(true)
  /// Carer-app clock-in methods (visit details `clockInSettings.enabledMethods`).
  /// Default live set is GPS only; Manual / NFC / QR are opt-in.
  domCheckInGpsEnabled                 Boolean                    @default(true)
  domCheckInManualEnabled              Boolean                    @default(false)
  domCheckInNfcEnabled                 Boolean                    @default(false)
  domCheckInQrEnabled                  Boolean                    @default(false)
  domGeofenceToleranceMeters           Int                        @default(150)
  domDownloadAllServiceUsers           Boolean                    @default(false)
  domFutureVisitsDays                  Int                        @default(14)
  domAutoExtendRotaEnabled             Boolean                    @default(true)
