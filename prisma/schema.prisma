  liveInProfile     ServiceUserLiveInProfile?
  defaultChargeCard ChargeCard?          @relation("ServiceUserDefaultChargeCard", fields: [defaultChargeCardId], references: [id], onDelete: SetNull)

  medicationPacks              MedicationPack[]
  medicationAllergies          MedicationAllergy[]
  medications                ServiceUserMedication[]
  medicationSupportProfiles  MedicationSupportProfile[]
  medicationAdministrationEvents MedicationAdministrationEvent[]
  medicationSupplyDeliveries   MedicationSupplyDelivery[]
  medicationReviews          MedicationReview[]
  calendarEvents             ServiceUserCalendarEvent[]
  initialAssessmentSubmissions InitialAssessmentSubmission[]
  initialAssessmentActions     InitialAssessmentAction[]
  initialAssessmentAttachments InitialAssessmentAttachment[]
  initialAssessmentRiskRecords InitialAssessmentRiskRecord[]
  visitPlans                 ServiceUserVisitPlan[]
  visitTaskAssignments       ServiceUserVisitTaskAssignment[]
  assessments                ServiceUserAssessment[]
  carePlanInstances          ServiceUserCarePlanInstance[]
  scheduledJobs              ScheduledJob[]
  scheduledVisits            ScheduledVisit[]
  callOffVisits              CallOffVisit[]
  jobCancellations           ScheduledJobCancellation[]
  observations               ServiceUserObservation[]
  flashMessages              ServiceUserFlashMessage[]
  bodyMapRecords             BodyMapRecord[]
  bodyMapAlerts              BodyMapAlert[]
  portalAccount              ServiceUserPortalAccount?

  @@index([deletedAt])
  @@index([statusId])
  @@index([careTypeId])
  @@index([fundingTypeId])
  @@index([riskLevelId])
  @@index([locationId])
  @@index([defaultChargeCardId])
  @@index([keyWorkerId])
  @@index([namedNurseId])
  @@index([lastName, firstName])
