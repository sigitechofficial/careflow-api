// ─── Supervision & appraisals (CQC Reg 18, NICE QS123) ─────────────────────────────────────────
// A session is the record of one supervision meeting (agenda notes, actions, signatures). The
// EmployeeReview row for the same type stays the due-date tracker: completing a session moves its
// "last done" on. Signed sessions are never edited; corrections are dated addenda.

enum SupervisionFormat {
  ONE_TO_ONE
  GROUP
  OBSERVED_PRACTICE
  REMOTE

  @@schema("employees")
}

enum SupervisionSessionStatus {
  SCHEDULED
  IN_PROGRESS
  AWAITING_SIGN_OFF
  COMPLETED
  CANCELLED

  @@schema("employees")
}

enum SupervisionActionStatus {
  OPEN
  DONE
  CANCELLED

  @@schema("employees")
}

enum SupervisionActionOwner {
  CARER
  SUPERVISOR
  MANAGER
  OTHER

  @@schema("employees")
}

model SupervisionSession {
  id                  String                   @id @default(uuid()) @db.Uuid
  reviewTypeId        String                   @db.Uuid
  format              SupervisionFormat        @default(ONE_TO_ONE)
  status              SupervisionSessionStatus @default(SCHEDULED)
  scheduledAt         DateTime
  heldAt              DateTime?
  durationMinutes     Int?
  location            String?
  /// Visit observed for an OBSERVED_PRACTICE session (scheduling.ScheduledJob).
  scheduledJobId      String?                  @db.Uuid
  supervisorUserId    String                   @db.Uuid
  summary             String?                  @db.Text
  /// Shown only with supervision.read_confidential (e.g. health or personal matters).
  confidentialNotes   String?                  @db.Text
  supervisorSignature String?                  @db.Text
  supervisorSignedAt  DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  /// Care Pathway form the session is recorded on. `formSnapshot` is the form as it was when the
  /// session was set up (sections and fields), so editing the form later never changes a record.
  formId              String?                  @db.Uuid
  formVersionId       String?                  @db.Uuid
  formSnapshot        Json?
  /// Answers keyed `sectionId:fieldId` from the snapshot (the Care Pathway renderer's key).
  answers             Json                     @default("{}")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  reviewType ReviewType            @relation(fields: [reviewTypeId], references: [id])
  supervisor User                  @relation("SupervisionSessionSupervisor", fields: [supervisorUserId], references: [id])
  form       CarePathwayForm?      @relation("SupervisionSessionForm", fields: [formId], references: [id], onDelete: SetNull)
  attendees  SupervisionAttendee[]
  actions    SupervisionAction[]
  addenda    SupervisionAddendum[]

  @@index([status])
  @@index([scheduledAt])
  @@index([supervisorUserId])
  @@index([formId])
  @@index([deletedAt])
  @@schema("employees")
}

/// One carer in a session (several for GROUP). Each signs (or comments) for themselves.
model SupervisionAttendee {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @db.Uuid
  employeeId String    @db.Uuid
  signature  String?   @db.Text
  signedAt   DateTime?
  /// False when the carer does not agree with the record; their comment says why.
  agrees     Boolean?
  comment    String?   @db.Text

  session  SupervisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee Employee           @relation(fields: [employeeId], references: [id])

  @@unique([sessionId, employeeId])
  @@index([employeeId])
  @@schema("employees")
}

/// Agreed action for one carer. Open actions carry into that carer's next session.
model SupervisionAction {
  id            String                  @id @default(uuid()) @db.Uuid
  sessionId     String                  @db.Uuid
  employeeId    String                  @db.Uuid
  description   String                  @db.Text
  owner         SupervisionActionOwner  @default(CARER)
  ownerName     String?
  dueDate       DateTime?
  status        SupervisionActionStatus @default(OPEN)
  completedAt   DateTime?
  completedNote String?                 @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  session  SupervisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee Employee           @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([sessionId])
  @@schema("employees")
}

/// One reminder sent for one due date (carer + review type + next due + kind), so the job never
/// sends the same reminder twice, even if it is retried or run by hand. A new starter's first
/// reminder has no EmployeeReview row yet, so the key does not depend on one.
model SupervisionReminderLog {
  id               String   @id @default(uuid()) @db.Uuid
  employeeReviewId String?  @db.Uuid
  employeeId       String   @db.Uuid
  reviewTypeId     String   @db.Uuid
  dueDate          DateTime
  /// e.g. DUE_IN_14, DUE_TODAY, OVERDUE_7, ESCALATION
  kind             String
  recipientUserIds String[] @db.Uuid
  carerPushed      Boolean  @default(false)
  emailed          Boolean  @default(false)
  sentAt           DateTime @default(now())

  @@unique([employeeId, reviewTypeId, dueDate, kind])
  @@index([employeeReviewId])
  @@schema("employees")
}

/// Dated correction or later note on a signed session (signed content is never edited).
model SupervisionAddendum {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  text        String   @db.Text
  createdAt   DateTime @default(now())
  createdById String   @db.Uuid

  session SupervisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@schema("employees")
}

