model ReviewType {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  reviews EmployeeReview[]
  @@schema("lookups")
