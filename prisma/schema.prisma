  periodEnd                DateTime         @db.Date
  status                   PayrollRunStatus @default(DRAFT)
  carerCount               Int              @default(0)
  visitLineCount           Int              @default(0)
  grossPay                 Decimal          @default(0) @db.Decimal(12, 2)
  nmwTopUp                 Decimal          @default(0) @db.Decimal(12, 2)
  expenseTotal             Decimal          @default(0) @db.Decimal(12, 2)
