/// A later initial assessment suggests this care plan needs a manager's review. Nothing about the
/// plan changes until the manager acts; one flag per plan per triggering assessment.
model CarePlanReassessmentFlag {
  id                     String                       @id @default(uuid()) @db.Uuid
