  createdAt   DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([eventType])
  @@index([recordType, recordId])
  @@index([createdAt])
  @@index([status])
  @@schema("audit")
}

