}

/**
 * Non-visit earnings for one carer (bonus, manual adjustment, holiday, sick, on-call, live-in, training).
 * Approved items are picked up by the next visit pay run whose period end is on/after `workDate`,
 * and are frozen once that run is locked (`includedInPayrollRunId`).
 */
model EmployeePayItem {
  id                     String    @id @default(uuid()) @db.Uuid
  employeeId             String    @db.Uuid
  wageTypeCode           String
  workDate               DateTime  @db.Date
  quantity               Decimal?  @db.Decimal(10, 2)
  unit                   String?
  rate                   Decimal?  @db.Decimal(12, 4)
  amount                 Decimal   @db.Decimal(12, 2)
  reason                 String
  notes                  String?
  /// MANUAL | EMPLOYEE_HOLIDAY | EMPLOYEE_ABSENCE | VISIT_CORRECTION | REVERSAL | MILEAGE_CORRECTION
  sourceType             String    @default("MANUAL")
  sourceId               String?   @db.Uuid
  /// Correction ledger (sourceType VISIT_CORRECTION): the locked pay line being corrected, the amount
  /// settled so far and the corrected amount. `amount` is the difference, paid in the next run.
  originalPayrollRunLineId String? @db.Uuid
  originalAmount           Decimal? @db.Decimal(12, 2)
  correctedAmount          Decimal? @db.Decimal(12, 2)
  /// Reversal (sourceType REVERSAL): the pay item this one cancels out. One reversal per item.
  reversesPayItemId        String? @unique @db.Uuid
  /// Mileage correction (sourceType MILEAGE_CORRECTION): `quantity` is the difference in miles and
  /// `amount` the difference in reimbursement. A reimbursement is not wages: these say how much of
  /// the difference is within HMRC's approved amount and how much above it (NOT_VERIFIED: unknown).
  taxFreeAmount            Decimal? @db.Decimal(12, 2)
  taxableAmount            Decimal? @db.Decimal(12, 2)
  taxTreatment             String?
  payCardId              String?   @db.Uuid
  payCardVersion         Int?
  /// PENDING_APPROVAL | APPROVED | REJECTED | CANCELLED
  status                 String    @default("PENDING_APPROVAL")
  createdAt              DateTime  @default(now())
  createdById            String?   @db.Uuid
  approvedAt             DateTime?
  approvedById           String?   @db.Uuid
  rejectedAt             DateTime?
  rejectedById           String?   @db.Uuid
  rejectionReason        String?
  includedInPayrollRunId String?   @db.Uuid
  updatedAt              DateTime  @updatedAt

  payrollRunLines PayrollRunLine[]

  @@index([employeeId])
  @@index([status])
  @@index([workDate])
  @@index([includedInPayrollRunId])
  @@schema("billing")
}

