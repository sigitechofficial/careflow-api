  invoiceMileage      Boolean            @default(false)
  sortOrder           Int                @default(0)

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  serviceUser     ServiceUser          @relation(fields: [serviceUserId], references: [id])
  careService     FundingCareService   @relation(fields: [careServiceId], references: [id])
  rateCard        RateCard             @relation(fields: [rateCardId], references: [id])
  funder1Contact  ServiceUserContact?  @relation(fields: [funder1ContactId], references: [id])

  @@index([serviceUserId])
  @@index([deletedAt])
  @@schema("service_users")
}

