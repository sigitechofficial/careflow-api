/// change status rather than creating duplicates.
model ServiceUserMedicalCondition {
  id                 String                            @id @default(uuid()) @db.Uuid
  serviceUserId      String                            @db.Uuid
  conditionId        String                            @db.Uuid
  status             ServiceUserMedicalConditionStatus @default(ACTIVE)
