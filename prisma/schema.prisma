  nmwTopUp                 Decimal          @default(0) @db.Decimal(12, 2)
  expenseTotal             Decimal          @default(0) @db.Decimal(12, 2)
  estimatedEmployerNi      Decimal          @default(0) @db.Decimal(12, 2)
  estimatedEmployerPension Decimal          @default(0) @db.Decimal(12, 2)
  estimatedEmployerCost    Decimal          @default(0) @db.Decimal(12, 2)
  exceptionCount           Int              @default(0)
  currency                 String           @default("GBP")
