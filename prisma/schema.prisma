/// Maps a care pathway care plan form to initial assessment answer conditions (no re-seed required).
model InitialAssessmentCarePlanRecommendationRule {
  id                 String                                 @id @default(uuid()) @db.Uuid
  carePathwayFormId  String                                 @db.Uuid
  label              String?
  matchMode          InitialAssessmentCarePlanRuleMatchMode @default(ANY)
