enum TimeDisplayFormat {
  HH_XX
  HH_MM

  @@schema("identity")
}

enum DateDisplayFormat {
  DD_MM_YYYY
  MM_DD_YYYY
  YYYY_MM_DD

  @@schema("identity")
}

enum DefaultCarerStatus {
  ACTIVE
  INACTIVE

  @@schema("identity")
}

enum HolidayUnit {
  HOURS
  DAYS

  @@schema("identity")
}

enum SalaryCalculationBasis {
  MONTHLY
  WEEKLY

  @@schema("identity")
}

/// How multi-carer (double-up) visits are charged to the service-user funder.
/// COMBINED = sum each carer's billable hours (default).
/// FIXED = charge the visit window once (envelope duration).
enum MultiCarerFunderChargeMode {
  COMBINED
  FIXED

  @@schema("identity")
}

enum ComplianceRequiredBy {
  ROLE_WORK_AREA
  CITIZENSHIP

  @@schema("identity")
}

enum ComplianceApprovalType {
  MANAGER_APPROVAL
  HR_APPROVAL

  @@schema("identity")
}

enum WellbeingRegularity {
  DAILY
  WEEKLY
  MONTHLY

  @@schema("identity")
}

enum ActionsDefaultView {
  TASK_LIST
  ACTIONS_LIST

  @@schema("identity")
}

enum AllocateEmployeeBy {
  FLOOR
  WARD
  ZONE
  UNIT

  @@schema("identity")
}

/// WARN = compliance issues surface as allocation warnings (existing-org default).
/// BLOCK = missing/expired/rejected mandatory checks prevent allocation.
enum ComplianceAllocationMode {
  WARN
  BLOCK

  @@schema("identity")
}

/// Singleton organisation general settings (care rules, time display, etc.).
model OrganisationGeneralSettings {
  id                                   String                     @id @default(uuid()) @db.Uuid
  /// Care plans: when true, only a manager-approved working draft can be published. Off by default.
  carePlanApprovalRequired             Boolean                    @default(false)
  handoverReportLastHours              Int                        @default(12)
  /// Incidents: Duty of Candour is flagged overdue after this many days without telling the person
  /// in person (organisation policy — the law says "as soon as reasonably practicable"). Null = off.
  incidentCandourOverdueDays           Int?
  archiveServiceUserAfterMonths        Int                        @default(3)
  timeDisplayFormat                    TimeDisplayFormat          @default(HH_MM)
  dateDisplayFormat                    DateDisplayFormat          @default(DD_MM_YYYY)
  /// IANA timezone for operational calendar days (schedules, ECM, "today").
  timezone                             String                     @default("Europe/London")
  /// Carer pay when a holiday falls on a weekend: BOTH (the date and its substitute day, the
  /// behaviour before this setting existed), ACTUAL_DAY or STATUTORY_DAY. Policy decision D-13.
  holidayPremiumBasis                  String                     @default("BOTH")
  /// Bank holidays for working-day timescales (survey alerts): UK (England and Wales), SCOTLAND or
  /// NORTHERN_IRELAND (lookups.BankHoliday regions; organisation special days always count).
  bankHolidayRegion                    String                     @default("UK")
  /// Carer pay: priority per day type ({ CHRISTMAS: 100, ..., ANY: 10 }) when rules for different days
  /// compete; higher wins. Null = the built-in order (most specific day wins).
  payDayTypePriority                   Json?
  /// Travel between visits: false = gaps are never paid automatically (only travel entered on a visit).
  travelGapPayEnabled                  Boolean                    @default(true)
  /// Travel between visits: GAP (the gap limits below) or DISTANCE (the drive between the two addresses, same day only).
  travelPayBasis                       String                     @default("GAP") @db.VarChar(20)
  /// Travel between visits (DISTANCE): average driving speed that turns miles into travel minutes.
  travelAverageSpeedMph                Int                        @default(20)
  /// Travel between visits (DISTANCE): straight-line miles × this, as roads are not straight.
  travelRoadFactor                     Decimal                    @default(1.3) @db.Decimal(4, 2)
  /// Travel between visits: gaps up to this many minutes are paid as waiting time.
  travelWaitingGapMinutes              Int                        @default(15)
  /// Travel between visits: gaps from this many minutes between visits to the same service user are a break (not paid).
  travelBreakGapMinutes                Int                        @default(60)
  /// Travel between visits: gaps from this many minutes are treated as the carer going home (not paid).
  travelWentHomeGapMinutes             Int                        @default(90)
  defaultCarerStatus                   DefaultCarerStatus         @default(ACTIVE)
  sendEmailWhenEmployeeActive          Boolean                    @default(true)
  allowMultipleRoles                   Boolean                    @default(true)
  allowWeekendDaysInHoliday            Boolean                    @default(true)
  mandateComplianceForNewEmployees     Boolean                    @default(false)
  defaultHolidaysUnit                  HolidayUnit                @default(DAYS)
  /// How employee salary is periodised in admin (visit pay + fines/penalties).
  salaryCalculationBasis               SalaryCalculationBasis     @default(MONTHLY)
  /// Multi-carer visits: charge funder for combined carer hours or fixed visit length.
  multiCarerFunderChargeMode           MultiCarerFunderChargeMode @default(COMBINED)
  recruitmentFunctionalityRequired     Boolean                    @default(true)
  complianceRequiredBy                 ComplianceRequiredBy       @default(ROLE_WORK_AREA)
  complianceApprovalForNewEmployee     ComplianceApprovalType     @default(MANAGER_APPROVAL)
  /// Existing orgs stay WARN so rotas are not surprise-blocked; switch to BLOCK in settings.
  complianceAllocationMode             ComplianceAllocationMode   @default(WARN)
  /// Computed statuses that block when mode is BLOCK (always warn when mode is WARN).
  complianceBlockStatuses              String[]                   @default(["MISSING", "EXPIRED", "REJECTED"])
  includeLearningInAllocationBlock     Boolean                    @default(false)
  calculateSicknessBradfordScale       Boolean                    @default(false)
  recordServiceUserWellbeing           Boolean                    @default(false)
  recordEmployeeWellbeing              Boolean                    @default(true)
  wellbeingRegularity                  WellbeingRegularity        @default(DAILY)
  wellbeingLabel1                      String                     @default("Very Happy")
  wellbeingLabel2                      String                     @default("Somewhat Happy")
  wellbeingLabel3                      String                     @default("Somewhat sad")
  wellbeingLabel4                      String                     @default("sad")
  wellbeingLabel5                      String                     @default("Very Sad")
  enhancedRegularActionChecks          Boolean                    @default(true)
  showRegularActionsInDailyList        Boolean                    @default(true)
  allowFastAction                      Boolean                    @default(true)
  actionsDefaultView                   ActionsDefaultView         @default(TASK_LIST)
  appDefaultToObservationsTab          Boolean                    @default(true)
  allocateEmployeeBy                   AllocateEmployeeBy         @default(FLOOR)
  restrictCarerToAllocatedServiceUsers Boolean                    @default(true)
  restrictLoginToShiftTimes            Boolean                    @default(true)
  preventCarerWebLogin                 Boolean                    @default(true)
  shiftAccessMinutesBefore             Int                        @default(60)
  shiftAccessMinutesAfter              Int                        @default(30)
  domJobCancellationRules              Json                       @default("[]")
  domGlobalToleranceMinutes            Int                        @default(30)
  domGeofenceDistanceMeters            Int                        @default(100)
  domWorkPatternCycles                 Int                        @default(2)
  domShowAllEmployeesAcrossZones       Boolean                    @default(true)
  domEmailTomorrowsSchedule            Boolean                    @default(false)
  domAppShowHoursBefore                Int                        @default(48)
  domRestrictJobOutsideGeofence        Boolean                    @default(true)
  /// Carer-app clock-in methods (visit details `clockInSettings.enabledMethods`).
  /// Default live set is GPS only; Manual / NFC / QR are opt-in.
  domCheckInGpsEnabled                 Boolean                    @default(true)
  domCheckInManualEnabled              Boolean                    @default(false)
  domCheckInNfcEnabled                 Boolean                    @default(false)
  domCheckInQrEnabled                  Boolean                    @default(false)
  domGeofenceToleranceMeters           Int                        @default(150)
  domDownloadAllServiceUsers           Boolean                    @default(false)
  domFutureVisitsDays                  Int                        @default(14)
  domAutoExtendRotaEnabled             Boolean                    @default(true)
  /// Visit cancellation policy: emergency hospital admission is never charged to the service user.
  domCancellationHospitalExemption     Boolean                    @default(true)
  domRotaHorizonDays                   Int                        @default(28)
  domRotaHorizonMode                   String                     @default("FIXED_DAYS")
  domAutoExtendRotaRunHour             Int                        @default(12)
  /// Most days back a manager may create visits for (Backfill past visits). 0 = backfill off.
  domMaxBackfillDays                   Int                        @default(14)
  domShowWeeklyHours                   Boolean                    @default(true)
  domShowServiceUserName               Boolean                    @default(true)
  /// When true, carers blocked by a service user still appear in schedule pickers (marked, not assignable).
  domShowBlockedCarersInSchedule       Boolean                    @default(false)
  domLateVisitAlertRequired            Boolean                    @default(true)
  domLateVisitAlertMinutes             Int                        @default(20)
  domLateVisitAlertEmail               Boolean                    @default(true)
  domLateVisitAlertText                Boolean                    @default(false)
  domLateVisitAlertNotification        Boolean                    @default(true)
  domTextAlertsSentThisMonth           Int                        @default(0)
  domTextAlertsSentLastMonth           Int                        @default(0)
  domLateVisitZoneAlerts               Json                       @default("[]")
  domCareShiftDefinitions              Json                       @default("[]")
  domCareAllocationRules               Json                       @default("[]")
  /// Service user weekly hours rules (approval, over-limit behaviour, weeks checked). Missing keys use the defaults.
  serviceUserWeeklyHoursSettings       Json                       @default("{}")
  /// Settings → Supervision (see supervision-settings.util.ts for keys and defaults).
  supervisionSettings                  Json                       @default("{}")
  /// Settings → Reviews & reminders: review/expiry windows, assessment intervals and the
  /// compliance / assessment / care plan reminder jobs (see review-settings.util.ts).
  reviewSettings                       Json                       @default("{}")
  incidentDetailsEditableMinutes       Int                        @default(60)
  incidentDisplayHours                 Int                        @default(12)
  incidentDefaultStatus                String                     @default("REPORTED")
  incidentTypeSettings                 Json                       @default("[]")
  /// Carer Report-an-incident severity chips (fixed keys: low/medium/high/critical).
  incidentSeveritySettings             Json                       @default("[]")
  /// Carer Report-an-incident "who was informed" chips (defaults + org extras).
  incidentWhoInformedSettings          Json                       @default("[]")
  optionalEmarIntegration              Boolean                    @default(false)
  optionalMedicationListRequired       Boolean                    @default(true)
  optionalMedicationAmendRoles         Json                       @default("[]")
  optionalMhaDetentionRequired         Boolean                    @default(false)
  optionalRestraintRecordingRequired   Boolean                    @default(false)
  optionalCarePlanReadRequired         Boolean                    @default(true)
  optionalCarePlanReadCycleMonths      Int                        @default(1)
  optionalFormBuilderRequired          Boolean                    @default(true)
  optionalRemoveCreateNewCarePlan      Boolean                    @default(true)
  optionalAboutMeFields                Json                       @default("[]")
  optionalServiceManagementRequired    Boolean                    @default(true)
  optionalLearningDevSessionsRequired  Boolean                    @default(true)
  optionalFamilyPortalEnabled          Boolean                    @default(true)
  optionalFamilySharingAuthRequired    Boolean                    @default(false)
  optionalFamilyShareAllActions        Boolean                    @default(true)
  optionalFamilyShareCarePlans         Boolean                    @default(true)
  optionalFamilyShareVisitInfo         Json                       @default("{}")
  optionalAllowInspectorLogin          Boolean                    @default(true)
  preAssessmentCareRequired            Boolean                    @default(true)
  preAssessmentComponents              Json                       @default("[]")
  preAssessmentForms                   Json                       @default("[]")
  alertActionsOverdueEnabled           Boolean                    @default(true)
  alertActionsOverdueMinutes           Int                        @default(30)
  alertRequiredCheckNotTicked          Boolean                    @default(true)
  alertRequiredMedicationNotGiven      Boolean                    @default(true)
  alertScheduleJobsBeforeHours         Int                        @default(24)
  alertBeepOnNewAlert                  Boolean                    @default(true)
  alertFluidAlertsEnabled              Boolean                    @default(false)
  criticalGenerateActions              Boolean                    @default(true)
  criticalMemorableAnswerRequired      Boolean                    @default(false)
  criticalLockdownWebAccess            Boolean                    @default(false)
  criticalLockdownCareAppAccess        Boolean                    @default(false)
  appSettingPinCodeRequired            Boolean                    @default(false)
  appSettingViewPoliciesCareApp        Boolean                    @default(true)
  appSettingViewPoliciesRosterApp      Boolean                    @default(true)
  appSettingBookHolidaysCareApp        Boolean                    @default(true)
  appSettingFingerprintLoginCareApp    Boolean                    @default(true)
  /// When true, a second Care-app login is blocked while a refresh session is active.
  appSettingSingleDeviceLoginCareApp   Boolean                    @default(false)
  privacyNonActiveServiceUserDays      Int                        @default(60)
  privacyNotifyInternalMessage         Boolean                    @default(true)
  privacyNotifyEmail                   Boolean                    @default(false)
  privacySensitiveViewerRoles          Json                       @default("[]")
  employeeVisaTypes                    Json                       @default("[]")
  createdAt                            DateTime                   @default(now())
  updatedAt                            DateTime                   @updatedAt
  updatedById                          String?                    @db.Uuid

  updatedBy User? @relation("OrganisationGeneralSettingsUpdatedBy", fields: [updatedById], references: [id])

