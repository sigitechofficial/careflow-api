enum CarePlanVisitTaskLinkStatus {
  LINKED
  REVIEW_REQUIRED
  NOT_APPLICABLE

  @@schema("service_users")
}

/// Manager-confirmed link between a published care plan (optionally one structured requirement, a
/// form field key) and an existing visit task assignment. Never creates, changes or deletes tasks.
/// NOT_APPLICABLE rows record a requirement judged not to need a task (no assignment).
model CarePlanVisitTaskLink {
  id                         String                      @id @default(uuid()) @db.Uuid
  serviceUserId              String                      @db.Uuid
  carePlanInstanceId         String                      @db.Uuid
  /// Published version the link was confirmed against (kept when a newer version is published).
  carePlanPublishedVersionId String                      @db.Uuid
  visitTaskAssignmentId      String?                     @db.Uuid
  /// Structured care plan field key; "" means the plan as a whole.
  requirementKey             String                      @default("")
  requirementLabel           String?
  status                     CarePlanVisitTaskLinkStatus @default(LINKED)
  reason                     String?                     @db.Text
  linkedById                 String?                     @db.Uuid
  linkedAt                   DateTime                    @default(now())
  reviewedById               String?                     @db.Uuid
  reviewedAt                 DateTime?
  updatedAt                  DateTime                    @updatedAt

  carePlanInstance         ServiceUserCarePlanInstance         @relation(fields: [carePlanInstanceId], references: [id], onDelete: Cascade)
  carePlanPublishedVersion ServiceUserCarePlanPublishedVersion @relation(fields: [carePlanPublishedVersionId], references: [id], onDelete: Cascade)
  visitTaskAssignment      ServiceUserVisitTaskAssignment?     @relation(fields: [visitTaskAssignmentId], references: [id], onDelete: Cascade)

  @@unique([carePlanInstanceId, visitTaskAssignmentId, requirementKey])
  @@index([serviceUserId])
  @@index([visitTaskAssignmentId])
  @@index([carePlanInstanceId, status])
  @@schema("service_users")
}

/// One row per carer per published care plan version: created when the carer is notified (the row
/// is the "already notified" claim) and completed when the carer acknowledges that exact version.
/// A new version needs a new row. Delivery never sets acknowledgedAt.
model CarePlanVersionAcknowledgement {
  id                 String    @id @default(uuid()) @db.Uuid
  publishedVersionId String    @db.Uuid
  carePlanInstanceId String    @db.Uuid
  serviceUserId      String    @db.Uuid
  employeeId         String    @db.Uuid
  notifiedAt         DateTime?
  acknowledgedAt     DateTime?
  acknowledgedById   String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  publishedVersion ServiceUserCarePlanPublishedVersion @relation(fields: [publishedVersionId], references: [id], onDelete: Cascade)
  carePlanInstance ServiceUserCarePlanInstance         @relation(fields: [carePlanInstanceId], references: [id], onDelete: Cascade)

  @@unique([publishedVersionId, employeeId])
  @@index([employeeId])
  @@index([carePlanInstanceId])
  @@schema("service_users")
}

