/**
 * Append-only Electronic Call Monitoring (ECM) evidence.
 * Do not update rows after insert — corrections are new events + audit.
 */
model VisitAttendanceEvent {
  id                    String                            @id @default(uuid()) @db.Uuid
  scheduledJobId        String                            @db.Uuid
  scheduledVisitId      String?                           @db.Uuid
  jobAllocationId       String?                           @db.Uuid
  employeeId            String                            @db.Uuid
  eventType             VisitAttendanceEventType
  verificationMethod    VisitAttendanceVerificationMethod @default(MOBILE_GPS)
  occurredAt            DateTime
  deviceCapturedAt      DateTime?
  clientEventId         String?
  latitude              Decimal?                          @db.Decimal(10, 7)
  longitude             Decimal?                          @db.Decimal(10, 7)
  accuracyMeters        Decimal?                          @db.Decimal(10, 2)
  isMockLocation        Boolean                           @default(false)
  outsideGeofence       Boolean                           @default(false)
  outsideGeofenceReason String?
  distanceMeters        Int?
  identityConfirmed     Boolean                           @default(false)
  notes                 String?
  createdAt             DateTime                          @default(now())

  scheduledJob   ScheduledJob    @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  scheduledVisit ScheduledVisit? @relation(fields: [scheduledVisitId], references: [id], onDelete: SetNull)
  jobAllocation  JobAllocation?  @relation(fields: [jobAllocationId], references: [id], onDelete: SetNull)
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([scheduledJobId, employeeId, eventType])
  @@index([clientEventId])
  @@index([scheduledJobId])
  @@index([scheduledVisitId])
  @@index([employeeId])
  @@index([eventType])
  @@index([occurredAt])
  @@index([outsideGeofence])
  @@index([isMockLocation])
  @@schema("scheduling")
}

/// One carer's attendance verification on one visit job (R-16): which times are the record, where
/// each came from, what the device and the server said, what the office entered, and whether a
/// person still has to look at them. One row per job x carer, so carers of a double-up never write
/// to the same record. `version` counts changes of evidence; an approval remembers the version it
/// was given for (R-18).
model VisitAttendanceVerification {
  id               String    @id @default(uuid()) @db.Uuid
  scheduledJobId   String    @db.Uuid
  employeeId       String    @db.Uuid
  jobAllocationId  String?   @db.Uuid
  /// SERVER | CARER_REPORTED | OFFICE | NONE
  startSource      String    @default("NONE")
  endSource        String    @default("NONE")
  needsReview      Boolean   @default(false)
  /// Plain-language reasons for the reviewer (string[]).
  reviewReasons    Json      @default("[]")
  /// Server-observed: when the completion arrived, and the check-in the server recorded.
  serverReceivedAt DateTime?
  serverCheckInAt  DateTime?
  /// Device-reported, kept exactly as sent.
  reportedStart    DateTime?
  reportedEnd      DateTime?
  /// Office-entered times, with who entered the latest one, when and why.
  officeStart      DateTime?
  officeEnd        DateTime?
  officeByUserId   String?   @db.Uuid
  officeAt         DateTime?
  officeReason     String?
  /// Set when the office has verified this carer's times after completion.
  verifiedAt       DateTime?
  verifiedByUserId String?   @db.Uuid
  version          Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  entries VisitAttendanceVerificationEntry[]

  @@unique([scheduledJobId, employeeId])
  @@index([scheduledJobId])
  @@index([employeeId])
  @@index([needsReview])
  @@schema("scheduling")
}

/// Append-only history of a verification record: every completion, late clock-out and office
/// entry, with what it contained. `clientEventId` is the identity the device gave the request, so
/// the same offline event delivered twice is recorded once.
model VisitAttendanceVerificationEntry {
  id              String   @id @default(uuid()) @db.Uuid
  verificationId  String   @db.Uuid
  /// COMPLETION | LATE_CLOCK_OUT | OFFICE_TIME | LEGACY_IMPORT
  kind            String
  /// Version of the record after this entry.
  version         Int
  clientEventId   String?
  actorEmployeeId String?  @db.Uuid
  actorUserId     String?  @db.Uuid
  payload         Json
  createdAt       DateTime @default(now())

  verification VisitAttendanceVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, clientEventId])
  @@index([verificationId])
  @@schema("scheduling")
}

