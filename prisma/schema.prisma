enum AuditStatus {
  SUCCESS
  FAILED

  @@schema("audit")
}

/// Immutable category for audit log filtering (stored on each row).
enum AuditEventType {
  VIEW
  CREATE
  UPDATE
  DELETE
  EXPORT
  SECURITY
  SYSTEM

  @@schema("audit")
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("audit")
}

enum DataAccessType {
  VIEW
  DOWNLOAD
  EXPORT
  PRINT

  @@schema("audit")
}

enum ExportType {
  CSV
  EXCEL
  PDF
  PRINT

  @@schema("audit")
}

