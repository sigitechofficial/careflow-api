  recordedById  String?   @db.Uuid
  recordedAt    DateTime  @default(now())
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedById   String?   @db.Uuid

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id])

  @@index([serviceUserId])
  @@index([deletedAt])
  @@schema("service_users")
}

model MedicationPack {
  id            String    @id @default(uuid()) @db.Uuid
  serviceUserId String    @db.Uuid
  name          String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)

  // Track E — pack cycle lifecycle (medication.md §35)
  cycleNumber        Int                  @default(1)
  packType           MedicationPackType   @default(BLISTER)
  status             MedicationPackStatus @default(DRAFT)
  roundLabel         String?
  pharmacyName       String?
  pharmacyPhone      String?
  gpName             String?
  gpSurgery          String?
  nhsNumber          String?
  publishedAt        DateTime?
  publishedById      String?              @db.Uuid
  supersededAt       DateTime?
  supersededById     String?              @db.Uuid
  supersededByPackId String?              @db.Uuid
  endedAt            DateTime?
  endedById          String?              @db.Uuid

  cycleDurationDays     Int?
  reviewDate            DateTime?
  prescriptionChecked   Boolean   @default(false)
  prescriptionCheckedBy String?
  prescriptionCheckedAt DateTime?
  generateAheadDays     Int?
  adminRules            Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  serviceUser       ServiceUser                      @relation(fields: [serviceUserId], references: [id])
  items             MedicationPackItem[]
  medications       ServiceUserMedication[]
  members           MedicationPackMember[]
  contentsSnapshots MedicationPackContentsSnapshot[]
  deliveries        MedicationPackDelivery[]
  compartments      MedicationPackCompartment[]
  supersededByPack  MedicationPack?                  @relation("MedicationPackSupersession", fields: [supersededByPackId], references: [id])
  supersedes        MedicationPack[]                 @relation("MedicationPackSupersession")

  @@index([serviceUserId])
  @@index([deletedAt])
  @@index([status])
  @@schema("service_users")
}

/// Canonical pack membership — authoritative link between a pack cycle and a
/// service user medication (medication.md §35.2). ServiceUserMedication.medicationPackId
/// is a denormalized cache synced from the ACTIVE member row.
model MedicationPackMember {
  id                      String                     @id @default(uuid()) @db.Uuid
  medicationPackId        String                     @db.Uuid
  serviceUserMedicationId String                     @db.Uuid
  status                  MedicationPackMemberStatus @default(ACTIVE)
  linkedAt                DateTime                   @default(now())
  linkedById              String?                    @db.Uuid
  endedAt                 DateTime?
  endedById               String?                    @db.Uuid
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?

  medicationPack        MedicationPack        @relation(fields: [medicationPackId], references: [id])
  serviceUserMedication ServiceUserMedication @relation(fields: [serviceUserMedicationId], references: [id])

  @@unique([medicationPackId, serviceUserMedicationId])
  @@index([medicationPackId])
  @@index([serviceUserMedicationId])
  @@index([status])
  @@index([deletedAt])
  @@schema("service_users")
}

/// Immutable contents record captured at publish (CQC / MCA cross-reference §35.3).
model MedicationPackContentsSnapshot {
  id               String             @id @default(uuid()) @db.Uuid
  medicationPackId String             @db.Uuid
  cycleNumber      Int
  packName         String
  packType         MedicationPackType
  pharmacyName     String?
  pharmacyPhone    String?
  gpName           String?
  gpSurgery        String?
  nhsNumber        String?
  startDate        DateTime?
  endDate          DateTime?
  publishedAt      DateTime           @default(now())
  publishedById    String?            @db.Uuid
  createdAt        DateTime           @default(now())

  medicationPack MedicationPack                       @relation(fields: [medicationPackId], references: [id])
  lines          MedicationPackContentsSnapshotLine[]

  @@index([medicationPackId])
  @@schema("service_users")
}

model MedicationPackContentsSnapshotLine {
  id                      String   @id @default(uuid()) @db.Uuid
  snapshotId              String   @db.Uuid
  serviceUserMedicationId String?  @db.Uuid
  medicationName          String
  strength                String?
  dose                    String?
  routeName               String?
  instructions            String?
  roundLabels             String?
  tabletDescription       String?
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())

  snapshot MedicationPackContentsSnapshot @relation(fields: [snapshotId], references: [id])

  @@index([snapshotId])
  @@schema("service_users")
}

/// Flow 2 — a physical pack arriving from the pharmacy for a cycle, reconciled
/// against the published contents snapshot (medication.md §35.4, CQC evidence).
model MedicationPackDelivery {
  id                 String                       @id @default(uuid()) @db.Uuid
  medicationPackId   String                       @db.Uuid
  contentsSnapshotId String?                      @db.Uuid
  cycleNumber        Int
  status             MedicationPackDeliveryStatus @default(PENDING)
  receivedAt         DateTime
  receivedById       String?                      @db.Uuid
  deliveredBy        String?
  batchReference     String?
  condition          MedicationPackCondition      @default(INTACT)
  conditionNotes     String?
  countersignedAt    DateTime?
  countersignedById  String?                      @db.Uuid
  countersignNotes   String?
  isActive           Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  deletedAt          DateTime?
  createdById        String?                      @db.Uuid

  medicationPack MedicationPack               @relation(fields: [medicationPackId], references: [id])
  lines          MedicationPackDeliveryLine[]

  @@index([medicationPackId])
  @@index([status])
  @@index([deletedAt])
  @@schema("service_users")
}

/// Flow 1 Step 3 — a time-slot compartment in the physical tray (medication.md §35.5).
model MedicationPackCompartment {
  id                   String    @id @default(uuid()) @db.Uuid
  medicationPackId     String    @db.Uuid
  label                String
  dueTime              String    @db.VarChar(5)
  windowStart          String?   @db.VarChar(5)
  windowEnd            String?   @db.VarChar(5)
  lateThresholdMinutes Int       @default(0)
  witnessRequired      Boolean   @default(false)
  sortOrder            Int       @default(0)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  medicationPack MedicationPack @relation(fields: [medicationPackId], references: [id])

  @@index([medicationPackId])
  @@index([deletedAt])
  @@schema("service_users")
}

model MedicationPackDeliveryLine {
  id                      String                          @id @default(uuid()) @db.Uuid
  deliveryId              String                          @db.Uuid
  serviceUserMedicationId String?                         @db.Uuid
  medicationName          String
  strength                String?
  dose                    String?
  expectedOnSnapshot      Boolean                         @default(true)
  state                   MedicationPackDeliveryLineState @default(PENDING)
  confirmedPresent        Boolean                         @default(false)
  notes                   String?
  sortOrder               Int                             @default(0)
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  delivery MedicationPackDelivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId])
  @@schema("service_users")
}

model MedicationPackItem {
  id               String    @id @default(uuid()) @db.Uuid
  medicationPackId String    @db.Uuid
  medicationName   String
  strength         String?
  notes            String?
  sortOrder        Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  medicationPack MedicationPack @relation(fields: [medicationPackId], references: [id])

  @@index([medicationPackId])
  @@index([deletedAt])
  @@schema("service_users")
}

model ServiceUserMedication {
  id                       String                     @id @default(uuid()) @db.Uuid
  serviceUserId            String                     @db.Uuid
  medicationPackId         String?                    @db.Uuid
  medicationName           String
  dose                     String?
  strength                 String?
  startDate                DateTime?
  endDate                  DateTime?
  expiryDate               DateTime?
  howAssisted              String?
  medicationTypeId         String?                    @db.Uuid
  routeId                  String?                    @db.Uuid
  categoryId               String?                    @db.Uuid
  frequencyId              String?                    @db.Uuid
  frequencyText            String?
  schedulePattern          MedicationSchedulePattern?
  frequencyIntervalDays    Int                        @default(1)
  monthlyDayOfMonth        Int?
  monthlyAnchorToStartDate Boolean                    @default(true)
  /// Why this medicine is prescribed (shown to the carer).
  reasonForMedication      String?
  /// How to give this dose (shown to the carer).
  instructions             String?
  /// Office-only chart notes (not sent to the employee app).
  notes                    String?
  isControlledMedication   Boolean                    @default(false)
  isDecongestantMedication Boolean                    @default(false)
  /// Must be given within timeToleranceMinutes of the due time (CQC time-sensitive).
  timeCritical             Boolean                    @default(false)
  timeToleranceMinutes     Int                        @default(30)
  medicationKind           MedicationKind
  status                   MedicationRecordStatus     @default(ACTIVE)
  statusEndReason          MedicationStatusEndReason?
  statusEndedAt            DateTime?
  statusEndedById          String?                    @db.Uuid
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  deletedAt                DateTime?
  createdById              String?                    @db.Uuid
  updatedById              String?                    @db.Uuid
  deletedById              String?                    @db.Uuid

  serviceUser            ServiceUser                     @relation(fields: [serviceUserId], references: [id])
  statusEndedBy          User?                           @relation("MedicationStatusEndedBy", fields: [statusEndedById], references: [id])
  medicationPack         MedicationPack?                 @relation(fields: [medicationPackId], references: [id])
  medicationType         MedicationType?                 @relation(fields: [medicationTypeId], references: [id])
  route                  MedicationRoute?                @relation(fields: [routeId], references: [id])
  category               MedicationCategory?             @relation(fields: [categoryId], references: [id])
  frequency              MedicationFrequency?            @relation(fields: [frequencyId], references: [id])
  schedules              MedicationSchedule[]
  events                 MedicationAdministrationEvent[]
  stockRecords           MedicationStockRecord[]
  supplyProfile          MedicationSupplyProfile?
  supplyDeliveries       MedicationSupplyDelivery[]
  packMemberships        MedicationPackMember[]
  bodyMapMedicationSites BodyMapMedicationSite[]

  @@index([serviceUserId])
  @@index([medicationPackId])
  @@index([deletedAt])
