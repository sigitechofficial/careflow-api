  checklistId String    @db.Uuid
  itemText    String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  checklist PathwayChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([deletedAt])
  @@schema("care_pathway")
}

model PathwayAction {
  id                    String            @id @default(uuid()) @db.Uuid
  actionName            String
  actionIcon            String
  instruction           String?           @db.Text
  actionType            PathwayActionType
  carersCount           Int               @default(1)
  startTime             String?
  endTime               String?
  durationMinutes       Int?
  notesMandatory        Boolean           @default(false)
  photoAllowed          Boolean           @default(false)
  allowFamilyShare      Boolean           @default(false)
  analysisAreaId        String?           @db.Uuid
  approxDurationMinutes Int?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
