/// TR-09: mileage rates in force from a date, per vehicle type. Two separate things are recorded:
/// what the organisation reimburses, and the amounts HMRC approves as tax-free for the same
/// period. The approved amounts stay empty until a person has checked them against HMRC and says
/// where; until then the tax treatment of mileage paid in that period is "not verified".
model MileageRate {
  id                     String             @id @default(uuid()) @db.Uuid
  effectiveFrom          DateTime           @db.Date
  vehicleType            MileageVehicleType
  /// Organisation rate per mile up to the threshold, and above it. A pay card's own mileage rate
  /// replaces rateFirst for carers on that card.
  rateFirst              Decimal            @db.Decimal(8, 4)
  rateAfter              Decimal            @db.Decimal(8, 4)
  /// Business miles in a tax year after which rateAfter applies. Null: no threshold.
  thresholdMiles         Int?
  passengerRate          Decimal            @default(0) @db.Decimal(8, 4)
  approvedRateFirst      Decimal?           @db.Decimal(8, 4)
  approvedRateAfter      Decimal?           @db.Decimal(8, 4)
  approvedThresholdMiles Int?
  approvedPassengerRate  Decimal?           @db.Decimal(8, 4)
  /// Where the approved amounts were checked (publication and date).
  approvedSource         String?
  approvedVerifiedAt     DateTime?
  approvedVerifiedById   String?            @db.Uuid
  label                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  createdById            String?            @db.Uuid

  @@unique([effectiveFrom, vehicleType])
  @@schema("billing")
}

