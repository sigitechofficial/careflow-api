  isActive           Boolean                                @default(true)
  createdAt          DateTime                               @default(now())
  updatedAt          DateTime                               @updatedAt
  deletedAt          DateTime?

  @@index([carePathwayFormId])
  @@index([isActive])
  @@index([deletedAt])
  @@schema("service_users")
}

/// Care plan recommendations captured when an initial assessment is submitted. `legacyRecommendationId`
/// is the id the API has always used (`cp-…`, `rule-…`, `condition-…`); decisions are still also kept in
/// `InitialAssessmentSubmission.metadata.carePlanDecisions`. Submissions without rows use live calculation.
model InitialAssessmentCarePlanRecommendation {
  id                     String                                        @id @default(uuid()) @db.Uuid
  submissionId           String                                        @db.Uuid
  serviceUserId          String                                        @db.Uuid
  carePathwayFormId      String?                                       @db.Uuid
  legacyRecommendationId String
  sourceType             String
  /// Full recommendation as calculated at submission (area, title, triggers, aliasIds…).
  evidenceJson           Json
  sortOrder              Int                                           @default(0)
  status                 InitialAssessmentCarePlanRecommendationStatus @default(PENDING)
  decisionReason         String?                                       @db.Text
  decidedById            String?                                       @db.Uuid
  decidedAt              DateTime?
  /// Care plan instance created or linked when the recommendation was accepted. Kept if the decision later changes.
  carePlanInstanceId     String?                                       @db.Uuid
  createdAt              DateTime                                      @default(now())
  updatedAt              DateTime                                      @updatedAt

  submission InitialAssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, legacyRecommendationId])
  @@index([serviceUserId])
  @@index([carePathwayFormId])
  @@index([carePlanInstanceId])
  @@schema("service_users")
}

