model PayrollRunLine {
  id                    String             @id @default(uuid()) @db.Uuid
  payrollRunId          String             @db.Uuid
  /// Null for non-visit earnings (pay items, training/on-call activity, overtime, rolled-up holiday pay).
  visitReconciliationId String?            @db.Uuid
  /// VISIT (default) | PAY_ITEM | NON_CORE_ACTIVITY | OVERTIME | HOLIDAY_ROLLED_UP
  sourceType            String?
  /// Source record id (activity id, week key…) used to stop the same earning being paid twice.
  sourceRef             String?
  employeePayItemId     String?            @db.Uuid
  /// Original-earning claim, e.g. VISIT:<reconciliationId>:VISIT_PAY. Unique across all runs, so one
  /// payable source is an original earning in one run only. Null for derived lines (NMW top-up,
  /// overtime premium, rolled-up holiday); corrections are separate pay items with their own claim.
  claimKey              String?            @unique
  employeeId            String?            @db.Uuid
  lineType              PayrollRunLineType @default(VISIT_PAY)
  description           String
  minutes               Int?
  /// Miles, for mileage lines (TR-09). The year-to-date total is counted from these.
  quantity              Decimal?           @db.Decimal(10, 2)
  unitAmount            Decimal?           @db.Decimal(12, 4)
  amount                Decimal            @db.Decimal(12, 2)
  /// Mileage lines (TR-13): how much of `amount` is within HMRC's approved amount, and how much is
  /// above it and therefore taxable. Both empty when the treatment is NOT_VERIFIED.
  taxFreeAmount         Decimal?           @db.Decimal(12, 2)
  taxableAmount         Decimal?           @db.Decimal(12, 2)
  /// TAX_FREE | PART_TAXABLE | NOT_VERIFIED. Null on lines that are not reimbursements.
  taxTreatment          String?
  currency              String             @default("GBP")
  payCardId             String?            @db.Uuid
  visitRef              String?
  exceptionMessage      String?
  createdAt             DateTime           @default(now())

  payrollRun          PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  visitReconciliation VisitReconciliation? @relation(fields: [visitReconciliationId], references: [id], onDelete: Restrict)
  employeePayItem     EmployeePayItem?     @relation(fields: [employeePayItemId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, visitReconciliationId, lineType])
  @@unique([payrollRunId, employeePayItemId])
  @@index([sourceType, sourceRef])
  @@index([payrollRunId])
  @@index([visitReconciliationId])
  @@index([employeeId])
  @@schema("billing")
}

/// TR-01 / TR-04 / TR-05 / TR-06: a stretch of time before a visit, classified by a person.
/// An approved interval replaces the estimate made from the gap between two visits. It is time,
/// never distance: mileage stays on its own lines.
model TravelTimeInterval {
  id                        String    @id @default(uuid()) @db.Uuid
  employeeId                String    @db.Uuid
  /// The visit the journey or wait led to (stored UUID); the pay run of that visit pays it.
  toVisitReconciliationId   String    @db.Uuid
  fromVisitReconciliationId String?   @db.Uuid
  startAt                   DateTime
  endAt                     DateTime
  minutes                   Int
  /// BETWEEN_SERVICE_USERS | REQUIRED_WAITING | REST_BREAK | ORDINARY_COMMUTE | TRAINING_JOURNEY |
  /// CANCELLED_VISIT_JOURNEY | OTHER
  category                  String
  /// How the times are known: ESTIMATED | RECORDED | VERIFIED.
  evidence                  String
  /// PENDING | APPROVED | REJECTED. Only an approved interval changes pay.
  status                    String    @default("PENDING")
  /// A training journey, a journey to a cancelled visit and "other" are paid only when this is set.
  payable                   Boolean   @default(false)
  note                      String?
  createdById               String?   @db.Uuid
  createdAt                 DateTime  @default(now())
  decidedById               String?   @db.Uuid
  decidedAt                 DateTime?
  decisionNote              String?
  updatedAt                 DateTime  @updatedAt

  @@index([toVisitReconciliationId, status])
  @@index([employeeId, startAt])
  @@schema("billing")
}

/// Q13: what a carer is paid when a visit does not go ahead as planned. This is the employer's
/// policy: effective-dated and put into effect by a second person. Where no rule covers an event
/// nothing is assumed, and the event waits for a person's decision.
model VisitDisruptionPayRule {
  id                 String    @id @default(uuid()) @db.Uuid
  /// CLIENT_CANCELLED | LATE_CANCELLATION | CARER_ALREADY_TRAVELLING | NOBODY_HOME |
  /// REPLACEMENT_WORKER | EMERGENCY_VISIT | SHORTENED_VISIT | ENDED_EARLY | ADDITIONAL_WAITING
  eventType          String
  /// Applies when the notice given was shorter than this many minutes. Empty: any notice.
  noticeBelowMinutes Int?
  /// NO_PAY | PERCENT_OF_SCHEDULED | FULL_SCHEDULED | FIXED_AMOUNT | HOURLY_FOR_AFFECTED_MINUTES
  outcome            String
  percent            Decimal?  @db.Decimal(5, 2)
  fixedAmount        Decimal?  @db.Decimal(12, 2)
  effectiveFrom      DateTime  @db.Date
  effectiveTo        DateTime? @db.Date
  /// DRAFT | ACTIVE | RETIRED
  status             String    @default("DRAFT")
  /// A rule entered to test the calculation. It is never the employer's policy.
  isSynthetic        Boolean   @default(false)
  note               String?
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  approvedById       String?   @db.Uuid
  approvedAt         DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([eventType, status, effectiveFrom])
  @@schema("billing")
}

/// One event for one carer on one visit, and what was decided to pay for it. An approved decision
/// with an amount is paid through a pay item, so it is claimed and paid once like any other.
model VisitDisruptionPayDecision {
  id                    String    @id @default(uuid()) @db.Uuid
  employeeId            String    @db.Uuid
  scheduledJobId        String?   @db.Uuid
  visitReconciliationId String?   @db.Uuid
  eventType             String
  /// When the visit was due, or when the event happened.
  eventAt               DateTime
  noticeMinutes         Int?
  scheduledMinutes      Int?
  /// Minutes waited, or minutes the visit was cut short by.
  affectedMinutes       Int?
  hourlyRate            Decimal?  @db.Decimal(12, 4)
  ruleId                String?   @db.Uuid
  /// What the rule in force proposes, or NOT_DECIDED when no rule covers the event.
  proposedOutcome       String
  proposedAmount        Decimal?  @db.Decimal(12, 2)
  amount                Decimal?  @db.Decimal(12, 2)
  /// NEEDS_DECISION | PENDING_APPROVAL | APPROVED | REJECTED
  status                String
  reason                String
  decisionNote          String?
  /// The pay item that pays an approved amount (stored UUID).
  payItemId             String?   @unique @db.Uuid
  createdById           String?   @db.Uuid
  createdAt             DateTime  @default(now())
  decidedById           String?   @db.Uuid
  decidedAt             DateTime?
  approvedById          String?   @db.Uuid
  approvedAt            DateTime?
  updatedAt             DateTime  @updatedAt

  @@index([employeeId, eventAt])
  @@index([scheduledJobId])
  @@index([status])
  @@schema("billing")
}

/// Q37–Q39: minimum wage is checked over the worker's pay reference period, not over whatever
/// dates a visit pay run happens to cover. One row per run, worker and pay reference period: this
/// run's pay and hours for the period, and the position of the whole period so far.
/// How the employer turns contracted weekly hours into basic hours for a year, for the minimum
/// wage on salaried hours work. HMRC accepts a multiplier or formula, and the employer must be
/// able to show how the hours were ascertained. Nothing is assumed: with no approved method in
/// force, the annual hours are not assessed (POLICY_REVIEW_REQUIRED). A method is entered by one
/// user and approved by another; rows are never edited, only withdrawn.
model SalariedHoursAnnualisation {
  id            String    @id @default(uuid()) @db.Uuid
  /// Weeks of contracted hours in a year, for example 52, 52.14 or 52.18.
  weeksPerYear  Decimal   @db.Decimal(6, 3)
  /// Where the method is written down and why it is right for these contracts.
  basis         String
  effectiveFrom DateTime  @db.Date
  /// DRAFT | APPROVED | WITHDRAWN
  status        String    @default("DRAFT")
  /// A test fixture, never an employer's policy.
  isSynthetic   Boolean   @default(false)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  approvedById  String?   @db.Uuid
  approvedAt    DateTime?
  withdrawnById String?   @db.Uuid
  withdrawnAt   DateTime?
  withdrawnNote String?

  @@index([status, effectiveFrom])
  @@schema("payroll")
}

model NmwPeriodAssessment {
  id               String   @id @default(uuid()) @db.Uuid
  /// The visit pay run that made the assessment (time work). Empty for a UK payroll run.
  payrollRunId     String?  @db.Uuid
  /// The UK payroll run that made the assessment (salaried hours work; stored UUID).
  ukPayrollRunId   String?  @db.Uuid
  employeeId       String   @db.Uuid
  periodStart      DateTime @db.Date
  periodEnd        DateTime @db.Date
  /// PAYROLL_SCHEDULE: the period of the worker's UK payroll schedule.
  /// PAY_RUN_PERIOD: no schedule period covers the date, so the run's own dates were used.
  periodSource     String
  /// TIME_WORK | SALARIED_HOURS (a salaried worker is not assessed as time work here)
  workType         String
  category         String
  ageAtPeriodStart Int?
  requiredHourly   Decimal  @db.Decimal(8, 4)
  /// This run's part of the period.
  eligiblePay      Decimal  @db.Decimal(12, 2)
  minutes          Int
  /// The whole period so far: this run and the locked runs before it.
  periodPay        Decimal  @db.Decimal(12, 2)
  periodMinutes    Int
  topUpAlreadyPaid Decimal  @db.Decimal(12, 2)
  /// The top-up line of this run for the period (negative when an earlier top-up is reduced).
  topUpInRun       Decimal  @db.Decimal(12, 2)
  /// Empty = not assessed: nothing is claimed about compliance.
  compliant        Boolean?
  /// Why the assessment needs a person: NO_PAYROLL_SCHEDULE | SALARIED_NOT_ASSESSED_HERE |
  /// BASIC_HOURS_NOT_RECORDED | EXCESS_HOURS_NOT_VERIFIED | SHORTFALL
  issue            String?
  /// Pay still missing against the rate after any top-up of this run.
  shortfall        Decimal? @db.Decimal(12, 2)
  /// What the review found: EVIDENCE_SUPPORTS_COMPLIANCE (the issue no longer stops the run
  /// closing) | SHORTFALL_CONFIRMED (pay must be topped up or corrected; a review cannot clear it).
  reviewOutcome    String?
  /// Salaried hours work, Sprint B4B: the calculation year the period falls in, the basic hours
  /// of that year and how they were derived (contracted weekly hours x weeksPerYear of the
  /// approved method), the hours worked in the year before this period, and the hours beyond
  /// the basic hours that this assessment counted. Empty when the year could not be assessed.
  calcYearStart      DateTime? @db.Date
  calcYearEnd        DateTime? @db.Date
  weeksPerYear       Decimal?  @db.Decimal(6, 3)
  annualBasicMinutes Int?
  yearMinutesBefore  Int?
  excessMinutes      Int?
  /// The person with the power to close payroll who reviewed the issue, and when.
  resolvedById     String?  @db.Uuid
  resolvedAt       DateTime?
  resolutionNote   String?
  note             String?
  createdAt        DateTime @default(now())

  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([ukPayrollRunId, employeeId, periodStart])
  @@unique([payrollRunId, employeeId, periodStart])
  @@index([employeeId, periodStart])
  @@schema("billing")
}

/// D-23: the employer's own statement that it has an approved policy, with legal authority, for
/// recovering overpaid wages. Until one is in force, a recovery can be reviewed and authorised but
/// is still not deducted. Rows are history: the one in force is the latest that is not withdrawn.
model WageRecoveryPolicy {
  id            String    @id @default(uuid()) @db.Uuid
  /// Where the policy and its authority are recorded (document, clause, date approved, by whom).
  reference     String
  recordedById  String?   @db.Uuid
  recordedAt    DateTime  @default(now())
  withdrawnById String?   @db.Uuid
  withdrawnAt   DateTime?
  withdrawnNote String?

  @@index([withdrawnAt])
  @@schema("billing")
}

/// An overpayment of wages that a calculation found, and whether the employer has authorised
/// taking it back. Finding an overpayment is arithmetic; recovering it from wages is a decision
/// with legal conditions. Nothing is deducted until a person with the authority approves it and
/// records the basis. A rejected recovery is written off for that amount.
model WageRecovery {
  id                String    @id @default(uuid()) @db.Uuid
  employeeId        String    @db.Uuid
  /// SALARY | GUARANTEED_HOURS | OVERTIME | NMW_TOP_UP
  kind              String
  /// The claim the deduction line would carry, e.g. GUARANTEE:<employee>:<week>:<n>. One
  /// recovery per settlement of a week or period, so it cannot be proposed or applied twice.
  subjectKey        String    @unique
  /// The overpayment, as a positive amount.
  amount            Decimal   @db.Decimal(12, 2)
  /// What was originally paid for the week or period, and what is now due (amount = paid - due).
  paidAmount        Decimal?  @db.Decimal(12, 2)
  dueAmount         Decimal?  @db.Decimal(12, 2)
  /// What the overpayment is and how it arose.
  reason            String
  /// The original payment: what was paid for the week or period, and what is now due.
  originalReference String
  /// PROPOSED | APPROVED | REJECTED | APPLIED | WITHDRAWN
  status            String    @default("PROPOSED")
  /// The contractual or legal authority for the deduction, recorded by the approver.
  authorityBasis    String?
  decisionNote      String?
  /// The pay run (visit pay run or UK payroll run) whose calculation proposed it, and who ran it.
  detectedInRunId   String?   @db.Uuid
  detectedById      String?   @db.Uuid
  decidedById       String?   @db.Uuid
  decidedAt         DateTime?
  /// Set when the run holding the deduction line is locked or closed.
  appliedInRunId    String?   @db.Uuid
  appliedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([detectedInRunId])
  @@schema("billing")
}

enum SalaryDeductionType {
  FINE
  PENALTY

