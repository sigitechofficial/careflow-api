  description              String?
  displayOrder             Int      @default(0)
  isRequired               Boolean  @default(true)
  estimatedDurationMinutes Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  courseVersion LearningCourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  contentItems  LearningContentItem[]

  @@index([courseVersionId])
  @@index([displayOrder])
  @@schema("learning")
}

model LearningContentItem {
  id                       String                 @id @default(uuid()) @db.Uuid
  courseSectionId          String                 @db.Uuid
  contentType              LearningContentType
  title                    String
  description              String?
  contentBody              String?
  fileId                   String?                @db.Uuid
  videoUrl                 String?
  externalUrl              String?
  displayOrder             Int                    @default(0)
  estimatedDurationMinutes Int?
  isRequired               Boolean                @default(true)
  completionRule           LearningCompletionRule @default(VIEW)
  minimumTimeSpentSeconds  Int?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  courseSection LearningCourseSection           @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  completions   LearningContentItemCompletion[]

  @@index([courseSectionId])
  @@index([contentType])
  @@index([displayOrder])
  @@schema("learning")
}

model LearningAssessment {
  id                 String   @id @default(uuid()) @db.Uuid
  courseVersionId    String   @db.Uuid
  title              String
  instructions       String?
  passingScore       Int
  maximumAttempts    Int?
  timeLimitMinutes   Int?
  randomiseQuestions Boolean  @default(false)
  randomiseAnswers   Boolean  @default(false)
  showCorrectAnswers Boolean  @default(false)
  allowReview        Boolean  @default(true)
  retakeDelayMinutes Int?
  isRequired         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  courseVersion LearningCourseVersion        @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  questions     LearningAssessmentQuestion[]
  attempts      LearningAssessmentAttempt[]

