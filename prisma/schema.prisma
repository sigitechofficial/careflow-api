  riskSnapshotJson   Json
  reviewReason       String?                @db.Text
  linkedById         String?                @db.Uuid
  linkedAt           DateTime               @default(now())
  reviewedById       String?                @db.Uuid
  reviewedAt         DateTime?
  updatedAt          DateTime               @updatedAt

  carePlanInstance ServiceUserCarePlanInstance @relation(fields: [carePlanInstanceId], references: [id], onDelete: Cascade)
  riskRecord       InitialAssessmentRiskRecord @relation(fields: [riskRecordId], references: [id], onDelete: Cascade)

