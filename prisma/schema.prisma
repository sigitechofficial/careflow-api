  /// An extra visit that takes a service user's week over their weekly hours.
  EXTRA_VISIT_OVER_HOURS
  /// A draft visit plan over the service user's weekly hours: it can't be activated until approved.
  DRAFT_PLAN_OVER_HOURS
  /// A rota visit (board, extra or special visit) that puts the carer over their contracted weekly hours:
  /// the carer is allocated only once a manager approves.
  ROTA_VISIT_OVER_HOURS
  /// Extra weekly hours for a carer waiting for a manager (Settings → Dom Rules).
  EXTRA_WEEKLY_HOURS
  /// A rota visit (visit plan or special visit) over the service user's weekly hours: made only once a
  /// manager approves (Settings → Dom Rules "Visits over the weekly hours need approval").
  SERVICE_USER_VISIT_OVER_HOURS

  @@schema("service_users")
}

/// Manager/admin approval for assigning a carer beyond their contracted weekly
/// hours. Created when an over-contracted assignment is saved; the carer is
/// assigned immediately but stays PENDING until decided. Independent of the
/// slot's carer-assignment rows (which are replaced on every slot save).
/// CONTRACTED_HOURS_CHANGE rows hold a requested contracted-hours change instead
/// (no service user / visit plan); nothing changes until they are approved.
model EmployeeHoursApproval {
  id                    String                      @id @default(uuid()) @db.Uuid
  /// Null for service user weekly hours requests (no carer involved).
  employeeId            String?                     @db.Uuid
  requestType           EmployeeHoursApprovalType   @default(VISIT_PLAN_OVER_HOURS)
  serviceUserId         String?                     @db.Uuid
  visitPlanId           String?                     @db.Uuid
  visitPlanSlotId       String?                     @db.Uuid
  status                EmployeeHoursApprovalStatus @default(PENDING)
  contractedWeeklyHours Float?
  projectedWeeklyHours  Float?
  extraHours            Float?
  previousContractedWeeklyHours  Float?
  requestedContractedWeeklyHours Float?
  /// Preview shown when the request was sent (visits/hours that would be unassigned).
  impactSummary         Json?
  /// Extra visit over hours: the visit to create when approved (date, time, carers, reason…).
  requestPayload        Json?
  reason                String?                     @db.Text
  requestedById         String?                     @db.Uuid
  requestedAt           DateTime                    @default(now())
  decidedById           String?                     @db.Uuid
  decidedAt             DateTime?
  decisionNotes         String?                     @db.Text
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([status])
  @@index([employeeId])
  @@index([serviceUserId])
  @@index([visitPlanSlotId])
  @@index([requestType])
  @@schema("service_users")
}

/// How the manager picked the dates of extra weekly hours (the dates are always stored).
enum EmployeeExtraHoursPeriod {
  DAY
  WEEK
  RANGE

  @@schema("employees")
}

/// Extra weekly hours a manager gave a carer for a day, a week or a date range. Every
/// Monday–Sunday week the dates touch gets the extra on top of the contracted weekly hours;
/// extras on the same week add up. Cancelled rows are kept as the record.
model EmployeeExtraWeeklyHours {
  id            String                   @id @default(uuid()) @db.Uuid
  employeeId    String                   @db.Uuid
  periodType    EmployeeExtraHoursPeriod
  startDate     DateTime                 @db.Date
  endDate       DateTime                 @db.Date
  extraHours    Float
  reason        String?                  @db.Text
  grantedById   String?                  @db.Uuid
  grantedAt     DateTime                 @default(now())
  /// Hours requests approved because of this extra, and those still over (shown on the record).
  outcome       Json?
  cancelledById String?                  @db.Uuid
  cancelledAt   DateTime?
  cancelReason  String?                  @db.Text
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([employeeId, startDate, endDate])
  @@schema("employees")
}

