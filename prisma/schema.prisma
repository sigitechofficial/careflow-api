  daysAfterDue  Int?
  recipientType LearningNotificationRecipientType
  channel       LearningNotificationChannel       @default(IN_APP)
  isActive      Boolean                           @default(true)
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt

  @@index([eventType])
  @@index([recipientType])
  @@index([isActive])
  @@schema("learning")
