/// Recruitment vacancy (ATS).
model Vacancy {
  id                String                    @id @default(uuid()) @db.Uuid
  /// Sequential number rendered as VAC-0001.
  recordNo          Int                       @unique @default(autoincrement())
  title             String
  jobTitleId        String?                   @db.Uuid
  locationId        String?                   @db.Uuid
  employmentType    RecruitmentEmploymentType
  description       String?
  requirements      String?
  salaryRange       String?
  numberOfPositions Int                       @default(1)
  status            VacancyStatus             @default(OPEN)
  hiringManagerId   String?                   @db.Uuid
  createdById       String?                   @db.Uuid

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  updatedById String?   @db.Uuid

  jobTitle      JobTitle?   @relation(fields: [jobTitleId], references: [id])
  location      Location?   @relation(fields: [locationId], references: [id])
  hiringManager Employee?   @relation("VacancyHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  createdBy     User?       @relation("VacancyCreatedBy", fields: [createdById], references: [id])
  candidates    Candidate[]

  @@index([status])
  @@index([hiringManagerId])
  @@index([locationId])
  @@index([deletedAt])
  @@schema("employees")
}

/// Pre-employment candidate (not an Employee until converted).
model Candidate {
  id                    String          @id @default(uuid()) @db.Uuid
  /// Sequential number rendered as CAN-0001.
  recordNo              Int             @unique @default(autoincrement())
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  address               String?
  vacancyId             String          @db.Uuid
  source                CandidateSource
  stage                 CandidateStage  @default(APPLIED)
  coverLetter           String?
  personalStatement     String?
  cvFileUrl             String?
  dataProcessingConsent Boolean         @default(false)
  consentDate           DateTime?
  convertedEmployeeId   String?         @unique @db.Uuid
  convertedAt           DateTime?
  convertedById         String?         @db.Uuid

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

