  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  medicationPack MedicationPack @relation(fields: [medicationPackId], references: [id])

  @@index([medicationPackId])
  @@index([deletedAt])
  @@schema("service_users")
}

model MedicationPackDeliveryLine {
