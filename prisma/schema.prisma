model LearningCategory {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  code         String
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedById  String?   @db.Uuid

  courses      LearningCourse[]
  competencies LearningCompetency[]

  @@unique([code])
  @@index([deletedAt])
  @@index([isActive])
  @@index([displayOrder])
  @@schema("learning")
}

model LearningCourse {
  id                          String                  @id @default(uuid()) @db.Uuid
  categoryId                  String?                 @db.Uuid
  title                       String
  code                        String
  shortDescription            String?
  description                 String?
  thumbnailFileId             String?                 @db.Uuid
  courseType                  LearningCourseType      @default(COURSE)
  deliveryMethod              LearningDeliveryMethod  @default(ONLINE)
  difficultyLevel             LearningDifficultyLevel @default(BEGINNER)
  estimatedDurationMinutes    Int?
  cpdMinutes                  Int?
  isMandatory                 Boolean                 @default(false)
  requiresAssessment          Boolean                 @default(false)
  requiresPracticalAssessment Boolean                 @default(false)
  requiresManagerApproval     Boolean                 @default(false)
  requiresTrainingEvent       Boolean                 @default(false)
  passingScore                Int?
  maximumAttempts             Int?
  certificateEnabled          Boolean                 @default(false)
  certificateValidityDays     Int?
  refresherFrequencyDays      Int?
  effectiveFrom               DateTime?               @db.Date
  reviewDate                  DateTime?               @db.Date
  status                      LearningCourseStatus    @default(DRAFT)
  /// Plain UUID pointer to the active published version (no FK to avoid version/course cycles).
  currentVersionId            String?                 @db.Uuid
  archivedAt                  DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  deletedAt                   DateTime?
  createdById                 String?                 @db.Uuid
  updatedById                 String?                 @db.Uuid
  deletedById                 String?                 @db.Uuid

  category            LearningCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions            LearningCourseVersion[]
  assignments         LearningAssignment[]
  pathwayItems        LearningPathwayItem[]
  certificates        LearningCertificate[]
  complianceSnapshots LearningComplianceSnapshot[]
  assignmentRules     LearningAssignmentRule[]
  trainingEvents      LearningTrainingEvent[]

  @@unique([code])
  @@index([categoryId])
  @@index([status])
  @@index([courseType])
  @@index([deliveryMethod])
  @@index([isMandatory])
  @@index([reviewDate])
  @@index([deletedAt])
  @@index([archivedAt])
  @@schema("learning")
}

model LearningCourseVersion {
  id                       String               @id @default(uuid()) @db.Uuid
  courseId                 String               @db.Uuid
  versionNumber            Int
  versionLabel             String?
  titleSnapshot            String
  descriptionSnapshot      String?
  passingScore             Int?
  maximumAttempts          Int?
  estimatedDurationMinutes Int?
  cpdMinutes               Int?
  certificateValidityDays  Int?
  refresherFrequencyDays   Int?
  publishedAt              DateTime?
  publishedById            String?              @db.Uuid
  changeSummary            String?
  status                   LearningCourseStatus @default(DRAFT)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  course          LearningCourse             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections        LearningCourseSection[]
  assessments     LearningAssessment[]
  assignments     LearningAssignment[]
  pathwayItems    LearningPathwayItem[]
  progressRecords LearningEmployeeProgress[]
  certificates    LearningCertificate[]
  trainingEvents  LearningTrainingEvent[]

  @@unique([courseId, versionNumber])
  @@index([courseId])
  @@index([status])
  @@index([publishedAt])
  @@schema("learning")
}

model LearningCourseSection {
  id                       String   @id @default(uuid()) @db.Uuid
  courseVersionId          String   @db.Uuid
