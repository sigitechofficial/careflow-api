   */
  actualEndDateTime      DateTime?
  isLeadCarer            Boolean          @default(false)
  /// Put on the visit from the visit plan (generate / plan sync). False: chosen on the rota,
  /// approved on Hours approvals, an extra or special visit — the nightly plan sync keeps it.
  fromVisitPlan          Boolean          @default(false)
  warningTypes           Json?
  warningMessages        Json?
