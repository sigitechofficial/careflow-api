  status                 LearningPathwayStatus @default(DRAFT)
  archivedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?
  createdById            String?               @db.Uuid
  updatedById            String?               @db.Uuid
  deletedById            String?               @db.Uuid

  items           LearningPathwayItem[]
  assignments     LearningAssignment[]
  assignmentRules LearningAssignmentRule[]

  @@unique([code])
  @@index([status])
  @@index([targetRoleId])
  @@index([targetWorkAreaId])
  @@index([targetLocationId])
  @@index([deletedAt])
  @@index([archivedAt])
  @@schema("learning")
}

model LearningPathwayItem {
  id                    String   @id @default(uuid()) @db.Uuid
  pathwayId             String   @db.Uuid
  courseId              String   @db.Uuid
  courseVersionId       String?  @db.Uuid
  displayOrder          Int      @default(0)
  isRequired            Boolean  @default(true)
  dueDaysFromAssignment Int?
  prerequisiteItemId    String?  @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pathway          LearningPathway        @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  course           LearningCourse         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseVersion    LearningCourseVersion? @relation(fields: [courseVersionId], references: [id], onDelete: SetNull)
  prerequisiteItem LearningPathwayItem?   @relation("PathwayPrereq", fields: [prerequisiteItemId], references: [id], onDelete: SetNull)
  dependentItems   LearningPathwayItem[]  @relation("PathwayPrereq")

  @@index([pathwayId])
  @@index([courseId])
  @@index([courseVersionId])
  @@index([prerequisiteItemId])
  @@index([displayOrder])
  @@schema("learning")
}

model LearningAssignment {
  id                      String                     @id @default(uuid()) @db.Uuid
  assignmentType          LearningAssignmentType
  courseId                String                     @db.Uuid
  courseVersionId         String?                    @db.Uuid
  pathwayId               String?                    @db.Uuid
  employeeId              String?                    @db.Uuid
  locationId              String?                    @db.Uuid
  workAreaId              String?                    @db.Uuid
  roleId                  String?                    @db.Uuid
  parentAssignmentId      String?                    @db.Uuid
  refresherOfAssignmentId String?                    @db.Uuid
  sourceEntityType        String?
  sourceEntityId          String?                    @db.Uuid
  assignedById            String?                    @db.Uuid
  assignedAt              DateTime                   @default(now())
  availableFrom           DateTime?
  dueAt                   DateTime?
  priority                LearningAssignmentPriority @default(NORMAL)
  isMandatory             Boolean                    @default(true)
  assignmentReason        String?
  status                  LearningAssignmentStatus   @default(ASSIGNED)
  completedAt             DateTime?
  cancelledAt             DateTime?
  cancelledById           String?                    @db.Uuid
  cancellationReason      String?
  exemptAt                DateTime?
  exemptById              String?                    @db.Uuid
  exemptionReason         String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  course                LearningCourse                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseVersion         LearningCourseVersion?          @relation(fields: [courseVersionId], references: [id], onDelete: SetNull)
  pathway               LearningPathway?                @relation(fields: [pathwayId], references: [id], onDelete: SetNull)
  parentAssignment      LearningAssignment?             @relation("AssignmentCampaign", fields: [parentAssignmentId], references: [id], onDelete: SetNull)
  childAssignments      LearningAssignment[]            @relation("AssignmentCampaign")
  progress              LearningEmployeeProgress?
  contentCompletions    LearningContentItemCompletion[]
  assessmentAttempts    LearningAssessmentAttempt[]
  certificates          LearningCertificate[]
  competencyAssessments LearningCompetencyAssessment[]

  @@index([courseId])
  @@index([courseVersionId])
  @@index([pathwayId])
  @@index([employeeId])
  @@index([locationId])
  @@index([workAreaId])
  @@index([roleId])
  @@index([assignmentType])
  @@index([status])
  @@index([dueAt])
  @@index([assignedAt])
  @@index([parentAssignmentId])
  @@index([sourceEntityType, sourceEntityId])
  @@schema("learning")
}

model LearningEmployeeProgress {
  id                        String                 @id @default(uuid()) @db.Uuid
  assignmentId              String                 @unique @db.Uuid
  employeeId                String                 @db.Uuid
  courseVersionId           String                 @db.Uuid
  progressPercentage        Decimal                @default(0) @db.Decimal(5, 2)
  startedAt                 DateTime?
  lastAccessedAt            DateTime?
  completedContentItems     Int                    @default(0)
  totalRequiredContentItems Int                    @default(0)
  assessmentStatus          LearningProgressStatus @default(NOT_STARTED)
  practicalAssessmentStatus LearningProgressStatus @default(NOT_STARTED)
  managerApprovalStatus     LearningProgressStatus @default(NOT_STARTED)
  courseCompletionStatus    LearningProgressStatus @default(NOT_STARTED)
  completedAt               DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  assignment    LearningAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  courseVersion LearningCourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([courseVersionId])
  @@index([courseCompletionStatus])
  @@schema("learning")
}

model LearningContentItemCompletion {
  id                  String    @id @default(uuid()) @db.Uuid
  assignmentId        String    @db.Uuid
  employeeId          String    @db.Uuid
  contentItemId       String    @db.Uuid
  startedAt           DateTime?
  completedAt         DateTime?
  timeSpentSeconds    Int       @default(0)
  acknowledgementText String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignment  LearningAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  contentItem LearningContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, contentItemId])
  @@index([employeeId])
  @@index([contentItemId])
  @@index([completedAt])
  @@schema("learning")
}

model LearningAssessmentAttempt {
  id               String                   @id @default(uuid()) @db.Uuid
  assessmentId     String                   @db.Uuid
  assignmentId     String                   @db.Uuid
  employeeId       String                   @db.Uuid
  attemptNumber    Int
  startedAt        DateTime                 @default(now())
  submittedAt      DateTime?
  score            Int?
  percentage       Decimal?                 @db.Decimal(5, 2)
  result           LearningAssessmentResult @default(IN_PROGRESS)
  timeSpentSeconds Int                      @default(0)
  reviewedById     String?                  @db.Uuid
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  assessment LearningAssessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assignment LearningAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers    LearningAssessmentAnswer[]

  @@unique([assessmentId, assignmentId, attemptNumber])
  @@index([employeeId])
  @@index([result])
  @@index([submittedAt])
  @@schema("learning")
}

model LearningAssessmentAnswer {
  id                  String    @id @default(uuid()) @db.Uuid
  assessmentAttemptId String    @db.Uuid
  questionId          String    @db.Uuid
  selectedOptionIds   String[]  @db.Uuid
  textAnswer          String?
  isCorrect           Boolean?
  pointsAwarded       Int?
  reviewedById        String?   @db.Uuid
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  attempt  LearningAssessmentAttempt  @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  question LearningAssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentAttemptId, questionId])
  @@index([questionId])
  @@schema("learning")
}

model LearningCompetency {
  id                 String    @id @default(uuid()) @db.Uuid
  categoryId         String?   @db.Uuid
  name               String
  code               String
  description        String?
  validityDays       Int?
  assessmentCriteria Json?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedById        String?   @db.Uuid

  category    LearningCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assessments LearningCompetencyAssessment[]

  @@unique([code])
