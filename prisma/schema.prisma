/// NFC tag fixed in a service user's home. Carers scan it at clock-in to prove
/// they are at the address. `uid` is the chip's factory UID, normalised to
/// upper-case hex with no separators (e.g. 04A23B1C5D8000).
/// Only one ACTIVE, non-deleted row may hold a given uid (partial unique index in SQL).
model ServiceUserNfcTag {
  id              String    @id @default(uuid()) @db.Uuid
  serviceUserId   String    @db.Uuid
  uid             String    @db.VarChar(32)
  label           String    @db.VarChar(100)
  locationNote    String?   @db.VarChar(500)
  /// ACTIVE | LOST | RETIRED
  status          String    @default("ACTIVE") @db.VarChar(20)
  statusReason    String?   @db.VarChar(500)
  statusChangedAt DateTime?
  lastScannedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  serviceUser ServiceUser             @relation(fields: [serviceUserId], references: [id])
  scans       ServiceUserNfcTagScan[]

  @@index([serviceUserId])
  @@index([uid])
  @@index([deletedAt])
  @@schema("service_users")
}

/// One scan of a registered NFC tag at clock-in — the tag's scan history.
/// Unknown UIDs (no tag row) are only recorded as ECM exceptions.
model ServiceUserNfcTagScan {
  id                 String   @id @default(uuid()) @db.Uuid
  tagId              String   @db.Uuid
  scheduledJobId     String   @db.Uuid
  /// Client whose visit it was (differs from the tag's client when WRONG_CLIENT).
  visitServiceUserId String   @db.Uuid
  employeeId         String   @db.Uuid
  /// ACCEPTED | WRONG_CLIENT | INACTIVE
  result             String   @db.VarChar(20)
  /// CHECK_IN (server) | APP_REPORT (app caught it, possibly offline)
  source             String   @db.VarChar(20)
  scannedAt          DateTime
  createdAt          DateTime @default(now())

  tag ServiceUserNfcTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId, scannedAt])
  @@schema("service_users")
}

