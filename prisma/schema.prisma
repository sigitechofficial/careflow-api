  @@unique([scheduledJobId, alertKind])
  @@index([alertedAt])
  @@schema("scheduling")
}

/**
 * ECM lifecycle is parallel to ScheduledJobStatus — do not replace rota statuses.
 * Plan: Draft → … → Completed / CompletedWithException → Closed
 */
enum EcmLifecycleStatus {
  DRAFT
  SCHEDULED
  UNASSIGNED
  ASSIGNED
  EN_ROUTE
  DUE
  CHECKED_IN
  IN_PROGRESS
  CHECKED_OUT
  COMPLETED
  COMPLETED_WITH_EXCEPTION
  CLOSED

  @@schema("scheduling")
}

enum EcmCriticality {
  STANDARD
  PRIORITY
  TIME_CRITICAL

  @@schema("scheduling")
}

/** Which settings level supplied the applied timing rule (most-specific wins). */
enum EcmSettingsLevel {
  PLATFORM
  ORGANISATION
  BRANCH
  CONTRACT
  SERVICE_USER
  VISIT_TEMPLATE
  VISIT

  @@schema("scheduling")
}

enum EcmArrivalClassification {
  EARLY_ARRIVAL
  ON_TIME
  LATE_ARRIVAL
  VERY_LATE_ARRIVAL
  NOT_ASSESSED

  @@schema("scheduling")
}

enum EcmDepartureClassification {
  EARLY_DEPARTURE
  ON_TIME
  LATE_DEPARTURE
  NOT_ASSESSED

  @@schema("scheduling")
}

enum EcmDurationClassification {
  SHORT_VISIT
  ON_TIME
  LONG_VISIT
  EXCESSIVE_OVERRUN
  NOT_ASSESSED

  @@schema("scheduling")
}

/**
 * Missed-care triage — never collapse with cancelled / no-access.
 * POTENTIAL ≠ CONFIRMED; FALSE_ECM_ALERT = mechanism failed but care occurred.
 */
enum EcmMissedClassification {
  NONE
  POTENTIAL_MISSED
  ATTENDANCE_VERIFICATION_PENDING
  CONFIRMED_MISSED
  FALSE_ECM_ALERT
  DISPUTED

  @@schema("scheduling")
}

enum EcmAttendanceConfidence {
  VERIFIED
  PARTIALLY_VERIFIED
  MANUALLY_VERIFIED
  UNVERIFIED
  DISPUTED
  REJECTED

  @@schema("scheduling")
}

/**
 * Persisted ECM evaluation for a scheduled job (BE1.1–BE1.4).
 * Attendance evidence remains VisitAttendanceEvent (append-only).
 * Timing uses four independent measurements; classifications are separate.
 */
model EcmVisitEvaluation {
  id                 String @id @default(uuid()) @db.Uuid
  scheduledJobId     String @unique @db.Uuid
  scheduledVisitId   String? @db.Uuid

  /// Communicated / current planned times (punctuality baseline).
  plannedStartDateTime DateTime
  plannedEndDateTime   DateTime?
  plannedDurationMinutes Int?
  earliestPermittedStart DateTime?
  latestPermittedStart   DateTime?
  minPermittedDurationMinutes Int?
  maxPermittedDurationMinutes Int?
  criticality        EcmCriticality @default(STANDARD)
  requiredCarers     Int            @default(1)
  /// Calendar date used for operational reporting (local timezone).
  localVisitDate     DateTime       @db.Date
  timezone           String         @default("Europe/London")

  actualCheckInAt        DateTime?
  actualCheckOutAt       DateTime?
  actualDurationMinutes  Int?

  startVarianceMinutes     Int?
  endVarianceMinutes       Int?
  durationVarianceMinutes  Int?

  arrivalClassification   EcmArrivalClassification   @default(NOT_ASSESSED)
  departureClassification EcmDepartureClassification @default(NOT_ASSESSED)
  durationClassification  EcmDurationClassification  @default(NOT_ASSESSED)
  lifecycleStatus         EcmLifecycleStatus         @default(SCHEDULED)
  missedClassification    EcmMissedClassification    @default(NONE)
  /// Operational exception codes (NO_ACCESS, OUTSIDE_GEOFENCE, …) — never collapsed.
  operationalExceptionCodes String[] @default([])
  confidence              EcmAttendanceConfidence    @default(UNVERIFIED)

  appliedSettingsLevel          EcmSettingsLevel @default(ORGANISATION)
  lateArrivalToleranceMinutes   Int
  veryLateThresholdMinutes      Int
  shortVisitToleranceMinutes    Int
  longVisitToleranceMinutes     Int
  excessiveOverrunMinutes       Int
  missedVisitThresholdMinutes   Int
  geofenceRadiusMeters          Int?
  /// Frozen rule id/version for historical KPI stability (GAP15 foundation).
  thresholdRuleVersion          String?

  evaluatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scheduledJob   ScheduledJob    @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  scheduledVisit ScheduledVisit? @relation(fields: [scheduledVisitId], references: [id], onDelete: SetNull)
  exceptions     EcmException[]

  @@index([lifecycleStatus])
  @@index([arrivalClassification])
  @@index([missedClassification])
  @@index([confidence])
  @@index([localVisitDate])
  @@index([evaluatedAt])
  @@index([criticality])
  @@schema("scheduling")
}

enum EcmExceptionKind {
  LATE_ARRIVAL
  VERY_LATE_ARRIVAL
  EARLY_ARRIVAL
  EARLY_DEPARTURE
  SHORT_VISIT
  LONG_VISIT
  EXCESSIVE_OVERRUN
  POTENTIAL_MISSED
  CONFIRMED_MISSED
  MISSING_CHECKOUT
  OUTSIDE_GEOFENCE
  MANUAL_ATTENDANCE
  MOCK_LOCATION
  OTHER

  @@schema("scheduling")
}

enum EcmExceptionLifecycle {
  DETECTED
  ALERT_GENERATED
  ASSIGNED
  ACKNOWLEDGED
  INVESTIGATING
  ACTION_TAKEN
  RESOLVED
  MANAGER_REVIEWED
  CLOSED

  @@schema("scheduling")
}

/**
 * Operational ECM exception with accountable follow-up lifecycle (BE1.11 / GAP2 foundation).
 */
model EcmException {
  id                   String               @id @default(uuid()) @db.Uuid
  scheduledJobId       String               @db.Uuid
  ecmVisitEvaluationId String?              @db.Uuid
  kind                 EcmExceptionKind
  lifecycle            EcmExceptionLifecycle @default(DETECTED)
  title                String
  detail               String?
  reasonCode           String?
  resolutionNote       String?
  ownerUserId          String?              @db.Uuid
  acknowledgedAt       DateTime?
  acknowledgedById     String?              @db.Uuid
  firstActionAt        DateTime?
  resolvedAt           DateTime?
  resolvedById         String?              @db.Uuid
  closedAt             DateTime?
  closedById           String?              @db.Uuid
  responseTargetMinutes Int?
  escalationDeadlineAt DateTime?
  overdue              Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  scheduledJob       ScheduledJob        @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  ecmVisitEvaluation EcmVisitEvaluation? @relation(fields: [ecmVisitEvaluationId], references: [id], onDelete: SetNull)
  notificationEvidence EcmNotificationEvidence[]

  @@index([scheduledJobId])
  @@index([lifecycle])
  @@index([kind])
  @@index([overdue])
  @@index([createdAt])
  @@schema("scheduling")
}

/**
 * Append-only original + revised planned times for a visit (GAP1 / BE1.25–27).
