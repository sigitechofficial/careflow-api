  PENDING
  APPROVED
  ACTIVE
  SUSPENDED
  ENDED
  REJECTED
  UNKNOWN

  @@schema("service_users")
}

/// Enterprise funding classification (who pays — LA, NHS, private, etc.). Distinct from `ServiceUserFundingType` (demographic lookup on ServiceUser).
model FundingType {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  code        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  funders             Funder[]
  serviceUserFundings ServiceUserFunding[]

  @@index([deletedAt])
  @@schema("service_users")
}

model Funder {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  code          String?   @unique
  fundingTypeId String?   @db.Uuid
  contactName   String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  town          String?
  county        String?
  country       String?
  postcode      String?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedById   String?   @db.Uuid

  fundingType         FundingType?           @relation(fields: [fundingTypeId], references: [id])
  serviceUserFundings ServiceUserFunding[]

  @@index([fundingTypeId])
  @@index([deletedAt])
  @@schema("service_users")
}

model ServiceUserFunding {
  id                 String         @id @default(uuid()) @db.Uuid
  serviceUserId      String         @db.Uuid
  fundingTypeId      String         @db.Uuid
  funderId           String?        @db.Uuid
  status             FundingStatus  @default(UNKNOWN)
  fundingReference   String?
  approvalReference  String?
  packageName        String?
  startDate          DateTime?
  endDate            DateTime?
  weeklyBudget       Decimal?       @db.Decimal(12, 2)
  hourlyRate         Decimal?       @db.Decimal(12, 2)
  contributionAmount Decimal?       @db.Decimal(12, 2)
  isPrimary          Boolean        @default(false)
  isActive           Boolean        @default(true)
  approvedAt         DateTime?
  approvedById       String?        @db.Uuid
  reviewDate         DateTime?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  createdById        String?        @db.Uuid
  updatedById        String?        @db.Uuid
  deletedById        String?        @db.Uuid

  serviceUser        ServiceUser  @relation("FundingLines", fields: [serviceUserId], references: [id])
  fundingType        FundingType  @relation(fields: [fundingTypeId], references: [id])
  funder             Funder?      @relation(fields: [funderId], references: [id])
  approvedBy         User?        @relation("ServiceUserFundingApprovedBy", fields: [approvedById], references: [id])
  markedCurrentFor   ServiceUser? @relation("FundingAsCurrent")

  @@index([serviceUserId])
  @@index([deletedAt])
  @@index([status])
  @@schema("service_users")
}

