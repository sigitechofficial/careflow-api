  observationsRecorded          ServiceUserObservation[]        @relation("ObservationRecordedByEmployee")
  observationPhotosUploaded     ServiceUserObservationPhoto[]   @relation("ObservationPhotoUploadedByEmployee")
  scheduleRuns                  ScheduleRun[]
  portalAccount                 EmployeePortalAccount?
  hoursMonthlyReviews           EmployeeHoursMonthlyReview[]
  absenceRecords                EmployeeAbsenceRecord[]
  hrProfile                     EmployeeHRProfile?
  hrDirectReports               EmployeeHRProfile[]             @relation("HrReportingManager")
  vacanciesAsHiringManager      Vacancy[]                       @relation("VacancyHiringManager")
  convertedCandidates           Candidate[]                     @relation("CandidateConvertedEmployee")
  deviceTokens                  EmployeeDeviceToken[]
  visitPushReceipts             CarerVisitPushReceipt[]

