  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  personalDetail    EmployeePersonalDetail?
  emergencyContacts EmployeeEmergencyContact[]
  employment        EmployeeEmployment?
  skills            EmployeeSkill[]
  certifications    EmployeeWorkCertification[]
  reviews           EmployeeReview[]
  documents         EmployeeDocument[]
  nonCoreActivities EmployeeNonCoreActivity[]
  specialVisits     SpecialVisit[]
  allocations       EmployeeAllocation[]
  workingPatterns   EmployeeWorkingPattern[]
  complianceRecords EmployeeCompliance[]
  holidays          EmployeeHoliday[]
  leavingRecords    EmployeeLeavingRecord[]

  serviceUsersAsKeyWorker   ServiceUser[]                      @relation("ServiceUserKeyWorker")
  serviceUsersAsNamedNurse  ServiceUser[]                      @relation("ServiceUserNamedNurse")
  assignmentAsKeyWorker     ServiceUserAssignment[]            @relation("AssignmentKeyWorker")
  assignmentAsNamedNurse    ServiceUserAssignment[]            @relation("AssignmentNamedNurse")
  domCarePreferredLinks     ServiceUserDomCarePreferredCarer[] @relation("DomCarePreferredEmployee")
  domCareBlockedLinks       ServiceUserDomCareBlockedCarer[]   @relation("DomCareBlockedEmployee")
  liveInPreferredCarerLinks ServiceUserLiveInPreferredCarer[]  @relation("LiveInPreferredEmployee")
  liveInBlockedCarerLinks   ServiceUserLiveInBlockedCarer[]    @relation("LiveInBlockedEmployee")

  medicationAdministrations     MedicationAdministrationEvent[] @relation("MedAdministeredBy")
  medicationAdministrationsWitnessed MedicationAdministrationEvent[] @relation("MedWitnessEmployee")
  medicationReviews             MedicationReview[]              @relation("MedReviewedBy")
  medicationStockRecords        MedicationStockRecord[]         @relation("MedStockRecordedBy")
  visitActionsCompleted         VisitAction[]                   @relation("VisitActionCompletedBy")
  visitTaskCompletions          ScheduledVisitTaskCompletion[]  @relation("VisitTaskCompletedBy")
  jobAllocations                JobAllocation[]
  visitAttendanceEvents         VisitAttendanceEvent[]
  visitCareConsentsCaptured     VisitCareConsent[]
  visitPlanSlotCarerAssignments VisitPlanSlotCarerAssignment[]
  observationsRecorded          ServiceUserObservation[]        @relation("ObservationRecordedByEmployee")
  observationPhotosUploaded     ServiceUserObservationPhoto[]   @relation("ObservationPhotoUploadedByEmployee")
  scheduleRuns                  ScheduleRun[]
  portalAccount                 EmployeePortalAccount?
  hoursMonthlyReviews           EmployeeHoursMonthlyReview[]
  absenceRecords                EmployeeAbsenceRecord[]
  hrProfile                     EmployeeHRProfile?
  hrDirectReports               EmployeeHRProfile[]             @relation("HrReportingManager")
  vacanciesAsHiringManager      Vacancy[]                       @relation("VacancyHiringManager")
  convertedCandidates           Candidate[]                     @relation("CandidateConvertedEmployee")
  deviceTokens                  EmployeeDeviceToken[]
  visitPushReceipts             CarerVisitPushReceipt[]
  supervisionAttendances             SupervisionAttendee[]
  supervisionActions                 SupervisionAction[]
  policyAcknowledgements             PolicyAcknowledgement[]

  @@index([deletedAt])
  @@schema("employees")
}

enum DevicePushPlatform {
  ANDROID
  IOS

  @@schema("employees")
}

model EmployeeDeviceToken {
  id         String             @id @default(uuid()) @db.Uuid
  employeeId String             @db.Uuid
  token      String             @unique
  platform   DevicePushPlatform
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@schema("employees")
}

/// HR workforce extension — lifecycle and deployment readiness (parallel to operational EmployeeStatus).
model EmployeeHRProfile {
  id                      String                  @id @default(uuid()) @db.Uuid
  employeeId              String                  @unique @db.Uuid
  legalName               String?
  preferredName           String?
  careWorkforceCategory   CareWorkforceCategory?
  employeeLifecycleStatus EmployeeLifecycleStatus @default(ACTIVE)
  deploymentStatus        HrDeploymentStatus      @default(GREEN)
  reportingManagerId      String?                 @db.Uuid
  branchTeam              String?

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  employee         Employee  @relation(fields: [employeeId], references: [id])
  reportingManager Employee? @relation("HrReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([reportingManagerId])
  @@index([employeeLifecycleStatus])
  @@index([deploymentStatus])
  @@index([deletedAt])
  @@schema("employees")
}

/// Recruitment vacancy (ATS).
model Vacancy {
  id                String                    @id @default(uuid()) @db.Uuid
  /// Sequential number rendered as VAC-0001.
  recordNo          Int                       @unique @default(autoincrement())
  title             String
  jobTitleId        String?                   @db.Uuid
  locationId        String?                   @db.Uuid
  employmentType    RecruitmentEmploymentType
  description       String?
  requirements      String?
  salaryRange       String?
  numberOfPositions Int                       @default(1)
  status            VacancyStatus             @default(OPEN)
  hiringManagerId   String?                   @db.Uuid
  createdById       String?                   @db.Uuid

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  updatedById String?   @db.Uuid

  jobTitle      JobTitle?   @relation(fields: [jobTitleId], references: [id])
  location      Location?   @relation(fields: [locationId], references: [id])
  hiringManager Employee?   @relation("VacancyHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  createdBy     User?       @relation("VacancyCreatedBy", fields: [createdById], references: [id])
  candidates    Candidate[]

  @@index([status])
  @@index([hiringManagerId])
  @@index([locationId])
  @@index([deletedAt])
  @@schema("employees")
}

/// Pre-employment candidate (not an Employee until converted).
model Candidate {
  id                    String          @id @default(uuid()) @db.Uuid
  /// Sequential number rendered as CAN-0001.
  recordNo              Int             @unique @default(autoincrement())
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  address               String?
  vacancyId             String          @db.Uuid
  source                CandidateSource
  stage                 CandidateStage  @default(APPLIED)
  coverLetter           String?
  personalStatement     String?
  cvFileUrl             String?
  dataProcessingConsent Boolean         @default(false)
  consentDate           DateTime?
  convertedEmployeeId   String?         @unique @db.Uuid
  convertedAt           DateTime?
  convertedById         String?         @db.Uuid

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  vacancy           Vacancy                 @relation(fields: [vacancyId], references: [id])
  convertedEmployee Employee?               @relation("CandidateConvertedEmployee", fields: [convertedEmployeeId], references: [id], onDelete: SetNull)
  convertedBy       User?                   @relation("CandidateConvertedBy", fields: [convertedById], references: [id])
  documents         CandidateDocument[]
  stageHistory      CandidateStageHistory[]

  @@index([vacancyId])
  @@index([stage])
  @@index([email])
  @@index([deletedAt])
  @@schema("employees")
}

model CandidateDocument {
  id           String                  @id @default(uuid()) @db.Uuid
  candidateId  String                  @db.Uuid
  documentType CandidateDocumentType
  fileUrl      String
  fileName     String
  fileSize     Int
  mimeType     String
  status       CandidateDocumentStatus @default(UPLOADED)
  reviewNotes  String?
  uploadedById String?                 @db.Uuid

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid

