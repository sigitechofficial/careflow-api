  updatedAt DateTime @updatedAt

  fundingProfiles ServiceUserFundingProfile[]
  rateCards         RateCard[]

  @@schema("service_users")
}

/// Rate cards: global catalog rows plus optional per–service-user custom cards.
model RateCard {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  code                 String?   @unique
  sortOrder            Int       @default(0)
  isActive             Boolean   @default(true)
  isCustom             Boolean   @default(false)
  serviceUserId        String?   @db.Uuid
  standardHourlyRate   Decimal?  @db.Decimal(12, 2)
  mileageRatePerUnit   Decimal?  @db.Decimal(12, 4)
  startDate            DateTime?
  endDate              DateTime?
  linkedCareServiceId  String?   @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  serviceUser       ServiceUser?                @relation("RateCardOwner", fields: [serviceUserId], references: [id])
  linkedCareService FundingCareService?         @relation(fields: [linkedCareServiceId], references: [id])
  fundingProfiles   ServiceUserFundingProfile[]

  @@index([serviceUserId])
  @@schema("service_users")
}

model ServiceUserFundingProfile {
  id                  String             @id @default(uuid()) @db.Uuid
