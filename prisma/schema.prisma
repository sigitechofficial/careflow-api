  managerApprovedAt      DateTime?
  commissionerAuthorised Boolean?
  createdAt              DateTime               @default(now())

  scheduledJob ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)

  @@unique([scheduledJobId, versionNumber])
  @@index([scheduledJobId, changedAt])
  @@index([changeClass])
  @@index([retrospective])
  @@index([lateNotice])
  @@schema("scheduling")
}

/**
