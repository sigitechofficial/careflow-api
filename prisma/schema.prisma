  id             String                    @id @default(uuid()) @db.Uuid
  /// Display period key: YYYY-MM or YYYY-Www (derived from UK run period)
  periodKey      String
  periodStart    DateTime                  @db.Date
  periodEnd      DateTime                  @db.Date
  /// Source UK payroll run (net pay). Required for new batches.
