  reason                 String                       @db.Text
  /// Structured evidence only (recommendation trigger question ids, risk types / levels).
  detailsJson            Json?
  status                 CarePlanReviewFlagStatus     @default(OPEN)
  resolvedById           String?                      @db.Uuid
  resolvedAt             DateTime?
  resolutionNote         String?                      @db.Text
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  carePlanInstance ServiceUserCarePlanInstance @relation(fields: [carePlanInstanceId], references: [id], onDelete: Cascade)

  @@unique([carePlanInstanceId, triggeringSubmissionId])
  @@index([serviceUserId])
  @@index([carePlanInstanceId, status])
  @@schema("service_users")
}

enum CarePlanRiskLinkStatus {
  LINKED
  REVIEW_REQUIRED

