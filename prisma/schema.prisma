/// One consent-to-care row per visit (lead records; support does not).
model VisitCareConsent {
  id                   String                 @id @default(uuid()) @db.Uuid
  scheduledVisitId     String                 @unique @db.Uuid
  scheduledJobId       String                 @db.Uuid
  serviceUserId        String                 @db.Uuid
  capturedByEmployeeId String                 @db.Uuid
  status               VisitCareConsentStatus
  reason               String?                @db.Text
  deviceRecordedAt     DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  scheduledVisit ScheduledVisit @relation(fields: [scheduledVisitId], references: [id], onDelete: Cascade)
  scheduledJob   ScheduledJob   @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  serviceUser    ServiceUser    @relation(fields: [serviceUserId], references: [id], onDelete: Restrict)
  capturedBy     Employee       @relation(fields: [capturedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([scheduledJobId])
  @@index([serviceUserId])
  @@index([capturedByEmployeeId])
  @@schema("scheduling")
}

/**
 * Dedupes late-visit ECM alerts so cron does not spam.
 */
model LateVisitAlertLog {
  id               String             @id @default(uuid()) @db.Uuid
  scheduledJobId   String             @db.Uuid
  alertKind        LateVisitAlertKind
  thresholdMinutes Int
  scheduledStart   DateTime
  alertedAt        DateTime           @default(now())
  channels         Json?
  recipientCount   Int                @default(0)
  message          String?

  scheduledJob ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)

  @@unique([scheduledJobId, alertKind])
  @@index([alertedAt])
  @@schema("scheduling")
}

/**
 * ECM lifecycle is parallel to ScheduledJobStatus — do not replace rota statuses.
 * Plan: Draft → … → Completed / CompletedWithException → Closed
 */
enum EcmLifecycleStatus {
  DRAFT
  SCHEDULED
  UNASSIGNED
  ASSIGNED
  EN_ROUTE
  DUE
  CHECKED_IN
  IN_PROGRESS
  CHECKED_OUT
  COMPLETED
  COMPLETED_WITH_EXCEPTION
  CLOSED

  @@schema("scheduling")
}

enum EcmCriticality {
  STANDARD
  PRIORITY
  TIME_CRITICAL

  @@schema("scheduling")
}

/**
 * Which settings level supplied the applied timing rule (most-specific wins).
 */
enum EcmSettingsLevel {
  PLATFORM
  ORGANISATION
  BRANCH
  CONTRACT
  SERVICE_USER
  VISIT_TEMPLATE
  VISIT

  @@schema("scheduling")
}

enum EcmArrivalClassification {
  EARLY_ARRIVAL
  ON_TIME
  LATE_ARRIVAL
  VERY_LATE_ARRIVAL
  NOT_ASSESSED

  @@schema("scheduling")
}

enum EcmDepartureClassification {
  EARLY_DEPARTURE
  ON_TIME
  LATE_DEPARTURE
  NOT_ASSESSED

  @@schema("scheduling")
}

enum EcmDurationClassification {
  SHORT_VISIT
  ON_TIME
  LONG_VISIT
  EXCESSIVE_OVERRUN
  NOT_ASSESSED

  @@schema("scheduling")
}

/**
 * Missed-care triage — never collapse with cancelled / no-access.
 * POTENTIAL ≠ CONFIRMED; FALSE_ECM_ALERT = mechanism failed but care occurred.
 */
enum EcmMissedClassification {
  NONE
  POTENTIAL_MISSED
  ATTENDANCE_VERIFICATION_PENDING
  CONFIRMED_MISSED
  FALSE_ECM_ALERT
  DISPUTED

  @@schema("scheduling")
}

enum EcmAttendanceConfidence {
  VERIFIED
  PARTIALLY_VERIFIED
  MANUALLY_VERIFIED
  UNVERIFIED
  DISPUTED
  REJECTED

  @@schema("scheduling")
}

/**
 * Persisted ECM evaluation for a scheduled job (BE1.1–BE1.4).
 * Attendance evidence remains VisitAttendanceEvent (append-only).
 * Timing uses four independent measurements; classifications are separate.
 */
model EcmVisitEvaluation {
  id               String  @id @default(uuid()) @db.Uuid
  scheduledJobId   String  @unique @db.Uuid
  scheduledVisitId String? @db.Uuid

  /// Communicated / current planned times (punctuality baseline).
  plannedStartDateTime        DateTime
  plannedEndDateTime          DateTime?
  plannedDurationMinutes      Int?
  earliestPermittedStart      DateTime?
  latestPermittedStart        DateTime?
  minPermittedDurationMinutes Int?
  maxPermittedDurationMinutes Int?
  criticality                 EcmCriticality @default(STANDARD)
  requiredCarers              Int            @default(1)
  /// Calendar date used for operational reporting (local timezone).
  localVisitDate              DateTime       @db.Date
  timezone                    String         @default("Asia/Karachi")

  actualCheckInAt       DateTime?
  actualCheckOutAt      DateTime?
  actualDurationMinutes Int?

  startVarianceMinutes    Int?
  endVarianceMinutes      Int?
  durationVarianceMinutes Int?

  arrivalClassification     EcmArrivalClassification   @default(NOT_ASSESSED)
  departureClassification   EcmDepartureClassification @default(NOT_ASSESSED)
  durationClassification    EcmDurationClassification  @default(NOT_ASSESSED)
  lifecycleStatus           EcmLifecycleStatus         @default(SCHEDULED)
  missedClassification      EcmMissedClassification    @default(NONE)
  /// Operational exception codes (NO_ACCESS, OUTSIDE_GEOFENCE, …) — never collapsed.
  operationalExceptionCodes String[]                   @default([])
  confidence                EcmAttendanceConfidence    @default(UNVERIFIED)

  appliedSettingsLevel        EcmSettingsLevel @default(ORGANISATION)
  lateArrivalToleranceMinutes Int
  veryLateThresholdMinutes    Int
  shortVisitToleranceMinutes  Int
  longVisitToleranceMinutes   Int
  excessiveOverrunMinutes     Int
  missedVisitThresholdMinutes Int
  geofenceRadiusMeters        Int?
  /// Frozen rule id/version for historical KPI stability (GAP15 foundation).
  thresholdRuleVersion        String?

  evaluatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scheduledJob   ScheduledJob    @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  scheduledVisit ScheduledVisit? @relation(fields: [scheduledVisitId], references: [id], onDelete: SetNull)
  exceptions     EcmException[]

  @@index([lifecycleStatus])
  @@index([arrivalClassification])
  @@index([missedClassification])
  @@index([confidence])
  @@index([localVisitDate])
  @@index([evaluatedAt])
  @@index([criticality])
  @@schema("scheduling")
}

enum EcmExceptionKind {
  LATE_ARRIVAL
  VERY_LATE_ARRIVAL
  EARLY_ARRIVAL
  EARLY_DEPARTURE
  SHORT_VISIT
  LONG_VISIT
  EXCESSIVE_OVERRUN
  POTENTIAL_MISSED
  CONFIRMED_MISSED
  MISSING_CHECKOUT
  OUTSIDE_GEOFENCE
  LEFT_VISIT_AREA
  MANUAL_ATTENDANCE
  MOCK_LOCATION
  CARER_SOS
  OUTSIDE_AREA_CHECK_IN_REQUEST
  UNABLE_TO_START
  OTHER

  @@schema("scheduling")
}

enum EcmExceptionLifecycle {
  DETECTED
  ALERT_GENERATED
  ASSIGNED
  ACKNOWLEDGED
  INVESTIGATING
  ACTION_TAKEN
  RESOLVED
  MANAGER_REVIEWED
  CLOSED

  @@schema("scheduling")
}

/**
 * Operational ECM exception with accountable follow-up lifecycle (BE1.11 / GAP2 foundation).
 */
model EcmException {
  id                    String                @id @default(uuid()) @db.Uuid
  scheduledJobId        String                @db.Uuid
  ecmVisitEvaluationId  String?               @db.Uuid
  kind                  EcmExceptionKind
  lifecycle             EcmExceptionLifecycle @default(DETECTED)
  title                 String
  detail                String?
  reasonCode            String?
  resolutionNote        String?
  ownerUserId           String?               @db.Uuid
  acknowledgedAt        DateTime?
  acknowledgedById      String?               @db.Uuid
  firstActionAt         DateTime?
  resolvedAt            DateTime?
  resolvedById          String?               @db.Uuid
  closedAt              DateTime?
  closedById            String?               @db.Uuid
  responseTargetMinutes Int?
  escalationDeadlineAt  DateTime?
  overdue               Boolean               @default(false)
  context               Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  scheduledJob         ScheduledJob              @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  ecmVisitEvaluation   EcmVisitEvaluation?       @relation(fields: [ecmVisitEvaluationId], references: [id], onDelete: SetNull)
  notificationEvidence EcmNotificationEvidence[]
  visitAreaLock        VisitAreaLock?
  checkInMethodGrant   VisitCheckInMethodGrant?

  @@index([scheduledJobId])
  @@index([lifecycle])
  @@index([kind])
  @@index([overdue])
  @@index([createdAt])
  @@schema("scheduling")
}

enum VisitAreaLockStatus {
  LOCKED
  ALLOWED

  @@schema("scheduling")
}

/// Mid-visit leave-area lock. Latest LOCKED row blocks carer writes until office allows.
model VisitAreaLock {
  id             String              @id @default(uuid()) @db.Uuid
  scheduledJobId String              @db.Uuid
  employeeId     String              @db.Uuid
  status         VisitAreaLockStatus @default(LOCKED)
  lockedAt       DateTime
  latitude       Decimal?            @db.Decimal(10, 7)
  longitude      Decimal?            @db.Decimal(10, 7)
  distanceMeters Int?
  ecmExceptionId String?             @unique @db.Uuid
  allowedAt      DateTime?
  allowedById    String?             @db.Uuid
  allowedByName  String?
  allowNote      String?
  allowReasonId  String?             @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  scheduledJob ScheduledJob                     @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  ecmException EcmException?                    @relation(fields: [ecmExceptionId], references: [id], onDelete: SetNull)
  allowReason  VisitLeftAreaAllowReasonCatalog? @relation(fields: [allowReasonId], references: [id], onDelete: SetNull)

  @@index([scheduledJobId, status])
  @@index([scheduledJobId, lockedAt])
  @@schema("scheduling")
}

enum VisitCheckInMethodGrantStatus {
  PENDING
  AUTHORISED
  REJECTED
  CONSUMED

  @@schema("scheduling")
}

/// Office-authorised Manual clock-in for one carer, one visit, one operational day.
/// Does not change organisation check-in method settings.
model VisitCheckInMethodGrant {
  id                  String                        @id @default(uuid()) @db.Uuid
  scheduledJobId      String                        @db.Uuid
  employeeId          String                        @db.Uuid
  /// Visit operational calendar day YYYY-MM-DD in organisation timezone.
  operationalDay      String
  status              VisitCheckInMethodGrantStatus @default(PENDING)
  carerNote           String?
  latitude            Decimal?                      @db.Decimal(10, 7)
  longitude           Decimal?                      @db.Decimal(10, 7)
  accuracyMeters      Decimal?                      @db.Decimal(8, 2)
  distanceMeters      Int?
  isMockedLocation    Boolean                       @default(false)
  locationUnavailable Boolean                       @default(false)
  requestedAt         DateTime                      @default(now())
  expiresAt           DateTime
  decidedAt           DateTime?
  decidedById         String?                       @db.Uuid
  decidedByName       String?
  officeNote          String?
  officeReasonId      String?                       @db.Uuid
  consumedAt          DateTime?
  ecmExceptionId      String?                       @unique @db.Uuid
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  scheduledJob ScheduledJob                           @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  ecmException EcmException?                          @relation(fields: [ecmExceptionId], references: [id], onDelete: SetNull)
  officeReason VisitManualAuthorisationReasonCatalog? @relation(fields: [officeReasonId], references: [id], onDelete: SetNull)

  @@index([scheduledJobId, employeeId, operationalDay])
  @@index([scheduledJobId, status])
  @@index([employeeId, status])
  @@schema("scheduling")
}

/**
 * Append-only original + revised planned times for a visit (GAP1 / BE1.25–27).
 * Never overwrite; version 1 is always the original schedule.
 */
enum EcmScheduleChangeClass {
  ORIGINAL
  PLANNED
  SERVICE_USER_REQUESTED
  PROVIDER_REQUESTED
  EMERGENCY
  SAME_DAY
  LATE_NOTICE
  RETROSPECTIVE
  UNAUTHORISED

  @@schema("scheduling")
}

model EcmScheduleVersion {
  id                     String                 @id @default(uuid()) @db.Uuid
  scheduledJobId         String                 @db.Uuid
  versionNumber          Int
  isOriginal             Boolean                @default(false)
  changeClass            EcmScheduleChangeClass @default(ORIGINAL)
  plannedStartDateTime   DateTime
  plannedEndDateTime     DateTime?
  previousStartDateTime  DateTime?
  previousEndDateTime    DateTime?
  reasonCode             String?
  reasonNote             String?
  changedById            String?                @db.Uuid
  changedAt              DateTime               @default(now())
  serviceUserAgreed      Boolean?
  serviceUserInformed    Boolean?
  informedAt             DateTime?
  agreedAt               DateTime?
  beforeDueTime          Boolean                @default(true)
  lateNotice             Boolean                @default(false)
  retrospective          Boolean                @default(false)
  managerApproved        Boolean?
  managerApprovedById    String?                @db.Uuid
  managerApprovedAt      DateTime?
  commissionerAuthorised Boolean?
  createdAt              DateTime               @default(now())

  scheduledJob ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)

  @@unique([scheduledJobId, versionNumber])
  @@index([scheduledJobId, changedAt])
  @@index([changeClass])
  @@index([retrospective])
  @@index([lateNotice])
  @@schema("scheduling")
}

/**
 * Immutable ECM operational audit trail (BE1.14 / Reg 17).
 * Append-only — no updates or soft-deletes.
 */
enum EcmAuditEventType {
  SCHEDULE_VERSION_CREATED
  EVALUATION_UPSERTED
  EXCEPTION_DETECTED
  EXCEPTION_ACKNOWLEDGED
  EXCEPTION_RESOLVED
  EXCEPTION_CLOSED
  ATTENDANCE_AMENDED
  ALERT_GENERATED
  NOTIFICATION_RECORDED
  SETTINGS_CHANGED
  MANUAL_OVERRIDE
  OTHER

  @@schema("scheduling")
}

model EcmAuditEvent {
  id             String            @id @default(uuid()) @db.Uuid
  scheduledJobId String?           @db.Uuid
  ecmExceptionId String?           @db.Uuid
  eventType      EcmAuditEventType
  actorUserId    String?           @db.Uuid
  summary        String
  detail         Json?
  createdAt      DateTime          @default(now())

  @@index([scheduledJobId, createdAt])
  @@index([ecmExceptionId])
  @@index([eventType])
  @@index([createdAt])
  @@schema("scheduling")
}

/**
 * Proof of service-user / family contact for ECM exceptions (GAP3 / BE1.30).
 * Never collapse to a boolean serviceUserNotified flag.
 */
enum EcmNotificationMethod {
  PHONE
  SMS
  EMAIL
  IN_APP
  IN_PERSON
  OTHER

  @@schema("scheduling")
}

enum EcmNotificationOutcome {
  ATTEMPTED
  ANSWERED
  DELIVERED
  READ
  NO_ANSWER
  FAILED
  ACCEPTED
  DECLINED

  @@schema("scheduling")
}

model EcmNotificationEvidence {
  id                 String                 @id @default(uuid()) @db.Uuid
  scheduledJobId     String                 @db.Uuid
  ecmExceptionId     String?                @db.Uuid
  contactedByUserId  String?                @db.Uuid
  contactName        String?
  contactRole        String?
  method             EcmNotificationMethod
  outcome            EcmNotificationOutcome @default(ATTEMPTED)
  attemptedAt        DateTime               @default(now())
  answeredAt         DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  etaGiven           String?
  reasonGiven        String?
  replacementDetails String?
  acceptedDeclined   String?
  proofUrl           String?
  notes              String?
  createdAt          DateTime               @default(now())

  scheduledJob ScheduledJob  @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  ecmException EcmException? @relation(fields: [ecmExceptionId], references: [id], onDelete: SetNull)

  @@index([scheduledJobId, attemptedAt])
  @@index([ecmExceptionId])
  @@index([outcome])
  @@schema("scheduling")
}

model ScheduledVisitTaskCompletion {
  id                  String    @id @default(uuid()) @db.Uuid
  scheduledJobId      String    @db.Uuid
  assignmentId        String?   @db.Uuid
  taskCatalogueTaskId String    @db.Uuid
  medicationRoundCode String
  isAdHoc             Boolean   @default(false)
  isCompleted         Boolean   @default(false)
  recordedValue       String?
  notes               String?
  completedAt         DateTime?
  completedById       String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  scheduledJob ScheduledJob                    @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  assignment   ServiceUserVisitTaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  completedBy  Employee?                       @relation("VisitTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([scheduledJobId, assignmentId])
  @@index([scheduledJobId])
  @@index([assignmentId])
  @@schema("scheduling")
}

// Append to schema.prisma — Care Pathway module

enum CarePathwayFormType {
  CARE_PLAN
  ASSESSMENT
  SERVICE_FORM
  STAFF_FORM

  @@schema("care_pathway")
}

enum CarePathwayFormStatus {
  DRAFT
  ACTIVE
  PUBLISHED
  ARCHIVED

  @@schema("care_pathway")
}

enum CarePathwayFormVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("care_pathway")
}

enum CarePathwayFormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  TIME
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  YES_NO
  RICH_TEXT
  SUMMERNOTE
  FILE_UPLOAD
  SIGNATURE
  PHOTO
  SECTION_TEXT

  @@schema("care_pathway")
}

enum PathwayActionType {
  CHECKLIST
  OBSERVATION

  @@schema("care_pathway")
}

enum CarePictureType {
  STANDARD
  UPLOADED

  @@schema("care_pathway")
}

model CarePathwayForm {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  description           String?
  formType              CarePathwayFormType
  status                CarePathwayFormStatus @default(DRAFT)
  currentVersionId      String?               @unique @db.Uuid
  lastPublishedAt       DateTime?
  publishedById         String?               @db.Uuid
  pictureUrl            String?
  versionLabel          String                @default("1")
  /// Care-plan review interval in calendar months. Allowed: 1, 2, 3, 6, 12. Null for non-care-plan forms.
  reviewFrequencyMonths Int?
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  createdById           String?               @db.Uuid
  updatedById           String?               @db.Uuid
  deletedById           String?               @db.Uuid

  currentVersion    CarePathwayFormVersion?       @relation("CurrentFormVersion", fields: [currentVersionId], references: [id])
  versions          CarePathwayFormVersion[]      @relation("FormVersions")
  publishLogs       CarePathwayFormPublishLog[]
  defaultSelections DefaultFormSelection[]
  textTemplates     CarePlanTextTemplate[]
  carePlanInstances ServiceUserCarePlanInstance[]

  @@index([deletedAt])
  @@index([formType])
  @@index([status])
  @@index([name])
  @@schema("care_pathway")
}

model CarePathwayFormVersion {
  id            String                       @id @default(uuid()) @db.Uuid
  formId        String                       @db.Uuid
  versionNumber Int                          @default(1)
  status        CarePathwayFormVersionStatus @default(DRAFT)
  schemaJson    Json?
  publishedAt   DateTime?
  publishedById String?                      @db.Uuid
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  form              CarePathwayForm               @relation("FormVersions", fields: [formId], references: [id])
  currentFor        CarePathwayForm?              @relation("CurrentFormVersion")
  sections          CarePathwayFormSection[]
  publishLogs       CarePathwayFormPublishLog[]
  carePlanInstances ServiceUserCarePlanInstance[]

  @@unique([formId, versionNumber])
  @@index([formId])
  @@index([status])
  @@schema("care_pathway")
}

model CarePathwayFormSection {
  id            String    @id @default(uuid()) @db.Uuid
  formVersionId String    @db.Uuid
  title         String
  description   String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  formVersion CarePathwayFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  fields      CarePathwayFormField[]

  @@index([formVersionId])
  @@index([deletedAt])
  @@schema("care_pathway")
}

model CarePathwayFormField {
  id                   String                   @id @default(uuid()) @db.Uuid
  sectionId            String                   @db.Uuid
  /// Stable business key for IA → care plan mapping (e.g. hsp_personal_care_tasks). Nullable until backfill.
  fieldKey             String?                  @db.VarChar(128)
  label                String
  fieldType            CarePathwayFormFieldType
  placeholder          String?
  helpText             String?
  required             Boolean                  @default(false)
  optionsJson          Json?
  validationJson       Json?
  conditionalLogicJson Json?
  sortOrder            Int                      @default(0)
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?

  section CarePathwayFormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([fieldKey])
  @@index([deletedAt])
  @@schema("care_pathway")
}

model CarePathwayFormPublishLog {
  id            String   @id @default(uuid()) @db.Uuid
  formId        String   @db.Uuid
  formVersionId String   @db.Uuid
  publishedById String?  @db.Uuid
  publishedAt   DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  form        CarePathwayForm        @relation(fields: [formId], references: [id])
  formVersion CarePathwayFormVersion @relation(fields: [formVersionId], references: [id])

  @@index([formId])
  @@schema("care_pathway")
}

model DefaultFormSelection {
  id           String              @id @default(uuid()) @db.Uuid
  formId       String              @db.Uuid
  formType     CarePathwayFormType
  isDefault    Boolean             @default(true)
  selectedById String?             @db.Uuid
  selectedAt   DateTime            @default(now())
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  form CarePathwayForm @relation(fields: [formId], references: [id])

  @@index([formType, deletedAt])
  @@index([formId])
  @@schema("care_pathway")
}

model CarePlanTextCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  templates CarePlanTextTemplate[]

  @@index([deletedAt])
  @@schema("care_pathway")
}

model CarePlanTextTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  categoryId  String?   @db.Uuid
  formId      String?   @db.Uuid
  contentHtml String    @db.Text
  plainText   String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  category CarePlanTextCategory? @relation(fields: [categoryId], references: [id])
  form     CarePathwayForm?      @relation(fields: [formId], references: [id])

  @@index([deletedAt])
  @@index([categoryId])
  @@schema("care_pathway")
}

model CarePlanTextPersonalisationToken {
  id                String  @id @default(uuid()) @db.Uuid
  token             String  @unique
  description       String
  replacementSource String
  isActive          Boolean @default(true)

  @@schema("care_pathway")
}

model PathwayChecklist {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  icon               String?
  carePlanId         String?   @db.Uuid
  analysisGroupId    String?   @db.Uuid
  observationEnabled Boolean   @default(false)
  recordPhoto        Boolean   @default(false)
  familyShare        Boolean   @default(false)
  groupAction        Boolean   @default(false)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedById        String?   @db.Uuid

  items       PathwayChecklistItem[]
  actionLinks PathwayActionChecklistLink[]

  @@index([deletedAt])
  @@index([name])
  @@schema("care_pathway")
}

model PathwayChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  checklistId String    @db.Uuid
  itemText    String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  checklist PathwayChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([deletedAt])
  @@schema("care_pathway")
}

model PathwayAction {
  id                    String            @id @default(uuid()) @db.Uuid
