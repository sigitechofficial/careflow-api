  lifeSustainingTreatment Boolean?
  registeredOn            DateTime?
  expiresOn               DateTime?
  /// OPG registration reference, court case number, DWP reference.
  reference               String                                @default("") @db.VarChar(255)
  verificationStatus      ServiceUserLegalAuthorityVerification @default(REPORTED)
  verificationMethod      String                                @default("") @db.Text
  verifiedAt              DateTime?
  verifiedById            String?                               @db.Uuid
  documentUrl             String?
  notes                   String                                @default("") @db.Text
  source                  ServiceUserClinicalDataSource         @default(MANUAL)
  sourceSubmissionId      String?                               @db.Uuid
  isActive                Boolean                               @default(true)
  createdAt               DateTime                              @default(now())
  updatedAt               DateTime                              @updatedAt
  deletedAt               DateTime?
  createdById             String?                               @db.Uuid
  updatedById             String?                               @db.Uuid
  deletedById             String?                               @db.Uuid

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id])

  @@index([serviceUserId])
  @@index([deletedAt])
  @@schema("service_users")
}

