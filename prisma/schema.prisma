/// Who may legally decide for the person, for which decisions, and how that was checked. One row per
/// authority. A finance LPA / EPA / appointee never gives authority over care; next of kin is never an
/// authority. Coverage rules: `legal-authority-coverage.util.ts`.
model ServiceUserLegalAuthority {
  id                      String                                @id @default(uuid()) @db.Uuid
  serviceUserId           String                                @db.Uuid
  category                ServiceUserLegalAuthorityCategory
  holderName              String                                @db.VarChar(255)
  holderRelationship      String                                @default("") @db.VarChar(255)
  holderContact           String                                @default("") @db.Text
  /// Which decisions it covers, conditions / restrictions, how several attorneys must act.
  scope                   String                                @default("") @db.Text
