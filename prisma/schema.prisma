model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  username          String?  @unique
  passwordHash      String
  firstName         String?
  lastName          String?
  refreshTokenHash  String?

  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  createdById       String?  @db.Uuid
  updatedById       String?  @db.Uuid
  deletedById       String?  @db.Uuid

  createdBy         User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?    @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  deletedBy         User?    @relation("UserDeletedBy", fields: [deletedById], references: [id])

  createdUsers      User[]   @relation("UserCreatedBy")
  updatedUsers      User[]   @relation("UserUpdatedBy")
  deletedUsers      User[]   @relation("UserDeletedBy")

  userRoles         UserRole[]
  auditLogs         AuditLog[]
  loginHistories    LoginHistory[]
  securityEvents    SecurityEvent[]
  dataAccessLogs    DataAccessLog[]
  exportLogs        ExportLog[]
  reviewedEmployees EmployeeReview[] @relation("EmployeeReviewReviewedBy")
  uploadedEmployeeDocuments EmployeeDocument[]
  employeeCompliancesVerified       EmployeeCompliance[]       @relation("EmployeeComplianceVerifiedBy")
  employeeCompliancesRejected      EmployeeCompliance[]       @relation("EmployeeComplianceRejectedBy")
  employeeCompliancesNoLongerReq    EmployeeCompliance[]       @relation("EmployeeComplianceNoLongerRequiredBy")
  employeeComplianceDocumentsUploaded EmployeeComplianceDocument[] @relation("EmployeeComplianceDocumentUploadedBy")
  complianceVerificationsPerformed ComplianceVerification[]   @relation("ComplianceVerificationPerformedBy")
  approvedServiceUserFundings      ServiceUserFunding[]        @relation("ServiceUserFundingApprovedBy")
  uploadedLiveInContractDocuments    ServiceUserLiveInContractDocument[] @relation("LiveInContractUploadedBy")
  uploadedServiceUserDocumentRecords ServiceUserDocumentRecord[]         @relation("ServiceUserDocumentRecordUploadedBy")
  notificationRecipients             NotificationRecipient[]
  notificationPreferences            NotificationPreference[]
  notificationsCreated               Notification[]                    @relation("NotificationCreatedBy")
  initialAssessmentsSubmitted        InitialAssessmentSubmission[]     @relation("InitialAssessmentSubmittedBy")
  initialAssessmentsReviewed         InitialAssessmentSubmission[]     @relation("InitialAssessmentReviewedBy")
  initialAssessmentsCreated          InitialAssessmentSubmission[]     @relation("InitialAssessmentCreatedBy")
  initialAssessmentsUpdated          InitialAssessmentSubmission[]     @relation("InitialAssessmentUpdatedBy")
  initialAssessmentActionsAssigned   InitialAssessmentAction[]         @relation("InitialAssessmentActionAssignee")
  initialAssessmentAttachmentsUploaded InitialAssessmentAttachment[]   @relation("InitialAssessmentAttachmentUploadedBy")
  initialAssessmentRisksResponsible  InitialAssessmentRiskRecord[]     @relation("InitialAssessmentRiskResponsible")
  serviceUserAssessmentCompletions ServiceUserAssessmentCompletion[] @relation("ServiceUserAssessmentCompletedBy")
  carePlanAssessmentLinksLinked    CarePlanAssessmentLink[]          @relation("CarePlanAssessmentLinkedBy")
  carePlanInstancesCreated         ServiceUserCarePlanInstance[]     @relation("CarePlanInstanceCreatedBy")
  carePlanInstancesUpdated         ServiceUserCarePlanInstance[]     @relation("CarePlanInstanceUpdatedBy")
  carePlanInstancesLastReviewed    ServiceUserCarePlanInstance[]     @relation("CarePlanInstanceLastReviewedBy")
  carePlanDraftsUpdated            ServiceUserCarePlanDraft[]        @relation("CarePlanDraftUpdatedBy")
  carePlanVersionsPublished        ServiceUserCarePlanPublishedVersion[] @relation("CarePlanVersionPublishedBy")
  scheduleAreasCreated               ScheduleArea[]                    @relation("ScheduleAreaCreatedBy")
  scheduleAreasUpdated               ScheduleArea[]                    @relation("ScheduleAreaUpdatedBy")
  scheduleAreasDeleted               ScheduleArea[]                    @relation("ScheduleAreaDeletedBy")
  scheduleBatchesCreated             ScheduleBatch[]                   @relation("ScheduleBatchCreatedBy")
  scheduleBatchesUpdated             ScheduleBatch[]                   @relation("ScheduleBatchUpdatedBy")
  scheduleBatchesDeleted             ScheduleBatch[]                   @relation("ScheduleBatchDeletedBy")
  scheduleBatchesBuilt               ScheduleBatch[]                   @relation("ScheduleBatchBuiltBy")
  scheduleAreaStatusesBuilt          ScheduleAreaStatus[]              @relation("ScheduleAreaStatusBuiltBy")
  scheduleRunsCreated                  ScheduleRun[]                     @relation("ScheduleRunCreatedBy")
  scheduleRunsUpdated                  ScheduleRun[]                     @relation("ScheduleRunUpdatedBy")
  scheduleRunsDeleted                  ScheduleRun[]                     @relation("ScheduleRunDeletedBy")
  scheduledJobsCreated                 ScheduledJob[]                    @relation("ScheduledJobCreatedBy")
  scheduledJobsUpdated                 ScheduledJob[]                    @relation("ScheduledJobUpdatedBy")
  scheduledJobsDeleted                 ScheduledJob[]                    @relation("ScheduledJobDeletedBy")
  scheduledVisitsCreated               ScheduledVisit[]                  @relation("ScheduledVisitCreatedBy")
  scheduledVisitsUpdated               ScheduledVisit[]                  @relation("ScheduledVisitUpdatedBy")
  scheduledVisitsDeleted               ScheduledVisit[]                  @relation("ScheduledVisitDeletedBy")
  jobAllocationsAllocated              JobAllocation[]                   @relation("JobAllocationAllocatedBy")
  jobAllocationsConfirmed              JobAllocation[]                   @relation("JobAllocationConfirmedBy")
  jobAllocationsUnallocated            JobAllocation[]                   @relation("JobAllocationUnallocatedBy")
  callOffVisitsRequested               CallOffVisit[]                    @relation("CallOffVisitRequestedBy")
  callOffVisitsApproved                CallOffVisit[]                    @relation("CallOffVisitApprovedBy")
  scheduledJobCancellations            ScheduledJobCancellation[]        @relation("ScheduledJobCancellationBy")
  scheduledJobReinstatements           ScheduledJobCancellation[]        @relation("ScheduledJobReinstatedBy")
  observationsRecorded                 ServiceUserObservation[]          @relation("ObservationRecordedByUser")
  serviceUserFlashMessagesCreated      ServiceUserFlashMessage[]         @relation("FlashMessageCreatedBy")
  bodyMapRecordsCreated                BodyMapRecord[]                   @relation("BodyMapRecordCreatedBy")
  bodyMapRecordsUpdated                BodyMapRecord[]                   @relation("BodyMapRecordUpdatedBy")
  bodyMapRecordsClosed                 BodyMapRecord[]                   @relation("BodyMapRecordClosedBy")
  bodyMapMarkersCreated                BodyMapMarker[]                   @relation("BodyMapMarkerCreatedBy")
  bodyMapReviewsAuthored               BodyMapReview[]                   @relation("BodyMapReviewedBy")
  bodyMapAlertsDismissed               BodyMapAlert[]                    @relation("BodyMapAlertDismissedBy")
  bodyMapAuditLogs                     BodyMapAuditLog[]                 @relation("BodyMapAuditActor")
  bodyMapSafeguardingChecksCompleted   BodyMapSafeguardingCheck[]        @relation("BodyMapSafeguardingCompletedBy")
  bodyMapPhotosUploaded                BodyMapPhoto[]                    @relation("BodyMapPhotoUploadedBy")
  bodyMapLinksCreated                  BodyMapLink[]                     @relation("BodyMapLinkCreatedBy")
  bodyMapWoundAssessmentsCreated       BodyMapWoundAssessment[]          @relation("BodyMapWoundAssessmentCreatedBy")
  bodyMapPressureAssessmentsCreated    BodyMapPressureAssessment[]       @relation("BodyMapPressureAssessmentCreatedBy")
  bodyMapMedicationSitesApplied        BodyMapMedicationSite[]           @relation("BodyMapMedicationSiteAppliedBy")
  bodyMapMedicationSitesCreated        BodyMapMedicationSite[]           @relation("BodyMapMedicationSiteCreatedBy")
  serviceUserFlashMessagesUpdated      ServiceUserFlashMessage[]         @relation("FlashMessageUpdatedBy")
  serviceUserFlashMessagesCleared      ServiceUserFlashMessage[]         @relation("FlashMessageClearedBy")
  serviceUserFlashMessagesDeleted      ServiceUserFlashMessage[]         @relation("FlashMessageDeletedBy")
  companyProfilesUpdated               CompanyProfile[]                  @relation("CompanyProfileUpdatedBy")
  organisationGeneralSettingsUpdated OrganisationGeneralSettings[]     @relation("OrganisationGeneralSettingsUpdatedBy")
  medicationSupplyDeliveriesReceived MedicationSupplyDelivery[]        @relation("MedSupplyReceivedBy")
  medicationSupplyDeliveriesWitnessed  MedicationSupplyDelivery[]        @relation("MedSupplyWitnessBy")
  medicationSupplyDeliveriesCreated    MedicationSupplyDelivery[]        @relation("MedSupplyDeliveryCreatedBy")
  medicationEventsEntered            MedicationAdministrationEvent[] @relation("MedEventEnteredBy")
  medicationEventsCreated            MedicationAdministrationEvent[] @relation("MedEventCreatedBy")
  medicationEventsManagerReviewed    MedicationAdministrationEvent[] @relation("MedEventManagerReviewedBy")
  medicationsStatusEnded             ServiceUserMedication[]         @relation("MedicationStatusEndedBy")
  visitTaskAssignmentsCreated        ServiceUserVisitTaskAssignment[] @relation("ServiceUserVisitTaskAssignmentCreatedBy")
  visitTaskAssignmentsUpdated        ServiceUserVisitTaskAssignment[] @relation("ServiceUserVisitTaskAssignmentUpdatedBy")

  @@index([email])
  @@index([deletedAt])
  @@schema("identity")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([deletedAt])
  @@schema("identity")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  rolePermissions RolePermission[]

  @@index([deletedAt])
  @@schema("identity")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt    DateTime @default(now())

  role         Role      @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@schema("identity")
}

model UserRole {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  roleId    String @db.Uuid

  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
  role      Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@schema("identity")
}

/// Singleton organisation profile (one row per deployment).
model CompanyProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  groupName            String?
  companyName          String
  odsCsCode            String
  displayName          String
  displayLogoUrl       String?
  displayLogoFileName  String?
  companyLogoUrl       String?
  companyLogoFileName  String?
  companyWebsite       String?
  contactName          String
  email                String
  phoneNumber          String
  companyNumber        String?
  vatNumber            String?
  bankName             String?
  bankSortCode         String?
  bankAccountNumber    String?
  numberOfCarers       Int      @default(0)
  numberOfServiceUsers Int      @default(0)
  activeModules        String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  updatedById          String?  @db.Uuid

  updatedBy User? @relation("CompanyProfileUpdatedBy", fields: [updatedById], references: [id])

  @@schema("identity")
}

