  id          String          @id @default(uuid()) @db.Uuid
  userId      String?         @db.Uuid
  module      String
  action      String
  eventType   AuditEventType?
  recordType  String?
  recordId    String?
  description String?
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
