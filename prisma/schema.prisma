  sentById         String?                @db.Uuid
  notes            String?
  /// Run-level QBO-style number assigned on create (kept even when the run has no lines yet).
  invoiceNumber    String?                @unique
  sequenceValue    Int?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdById      String?                @db.Uuid

  lines                 InvoiceRunLine[]
  documents             InvoiceDocument[]
  auditEvents           InvoiceRunAuditEvent[]
  lockedReconciliations VisitReconciliation[]  @relation("ReconciliationInvoiceRun")
  paymentAllocations    PaymentAllocation[]

  @@index([status])
  @@index([periodStart, periodEnd])
  @@schema("billing")
}

/// Append-only audit trail for invoice run actions (who / what / when).
model InvoiceRunAuditEvent {
  id           String                @id @default(uuid()) @db.Uuid
  invoiceRunId String                @db.Uuid
  action       InvoiceRunAuditAction
  actorUserId  String?               @db.Uuid
  occurredAt   DateTime              @default(now())
  detail       String?
  metadata     Json?
  createdAt    DateTime              @default(now())

  invoiceRun InvoiceRun @relation(fields: [invoiceRunId], references: [id], onDelete: Cascade)

  @@index([invoiceRunId, occurredAt])
  @@index([action])
  @@schema("billing")
}

/**
 * One billable invoice document per service user on a run.
 * invoiceNumber is QBO-style: global sequential (INV-1001, INV-1002, …).
 */
model InvoiceDocument {
  id            String    @id @default(uuid()) @db.Uuid
  invoiceRunId  String    @db.Uuid
  serviceUserId String    @db.Uuid
  /// Display number, e.g. INV-1001 — unique across the organisation.
  invoiceNumber String    @unique
  /// Numeric sequence used to allocate invoiceNumber.
  sequenceValue Int
  /// QBO-style invoice date (date the document was created / issued).
  invoiceDate   DateTime  @db.Date
  /// QBO-style due date = invoiceDate + payment term days.
  dueDate       DateTime? @db.Date
  /// Snapshot of charge-card terms at issue (e.g. "Net 30", "Due on receipt").
  paymentTerms  String?
  /// Last time this service-user invoice was emailed from the run.
  lastSentAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invoiceRun InvoiceRun @relation(fields: [invoiceRunId], references: [id], onDelete: Cascade)

  @@unique([invoiceRunId, serviceUserId])
  @@index([invoiceRunId])
  @@index([serviceUserId])
  @@index([dueDate])
  @@schema("billing")
}

/// Single-row global counter for InvoiceDocument.invoiceNumber (starts at 1000 → next INV-1001).
model InvoiceNumberSequence {
  id        Int      @id @default(1)
  lastValue Int      @default(1000)
  updatedAt DateTime @updatedAt

  @@schema("billing")
}

model InvoiceRunLine {
  id                    String             @id @default(uuid()) @db.Uuid
  invoiceRunId          String             @db.Uuid
  visitReconciliationId String             @db.Uuid
  serviceUserId         String             @db.Uuid
  funderId              String?            @db.Uuid
  serviceUserFundingId  String?            @db.Uuid
  lineType              InvoiceRunLineType @default(VISIT_CHARGE)
  description           String
  minutes               Int?
  splitPercent          Decimal?           @db.Decimal(5, 2)
  unitAmount            Decimal?           @db.Decimal(12, 4)
  amount                Decimal            @db.Decimal(12, 2)
  currency              String             @default("GBP")
  chargeCardId          String?            @db.Uuid
  visitRef              String?
  exceptionMessage      String?
  createdAt             DateTime           @default(now())

  invoiceRun          InvoiceRun          @relation(fields: [invoiceRunId], references: [id], onDelete: Cascade)
  visitReconciliation VisitReconciliation @relation(fields: [visitReconciliationId], references: [id], onDelete: Restrict)

  @@unique([invoiceRunId, visitReconciliationId, serviceUserFundingId, lineType])
  @@index([invoiceRunId])
  @@index([visitReconciliationId])
  @@index([serviceUserId])
  @@index([funderId])
  @@schema("billing")
}

enum PaymentType {
  COUNCIL_REMITTANCE
  BANK_TRANSFER
  DIRECT_DEBIT
  CARD
  OTHER

  @@schema("billing")
}

enum PaymentRecordStatus {
  RECEIVED
  FAILED
  REFUNDED

  @@schema("billing")
}

enum PaymentMatchStatus {
  UNMATCHED
  PARTIALLY_MATCHED
  FULLY_MATCHED

  @@schema("billing")
}

model Payment {
  id            String              @id @default(uuid()) @db.Uuid
  reference     String
  paymentType   PaymentType
  amount        Decimal             @db.Decimal(12, 2)
  receivedDate  DateTime?           @db.Date
  recordStatus  PaymentRecordStatus @default(RECEIVED)
  matchStatus   PaymentMatchStatus  @default(UNMATCHED)
  matchedAmount Decimal             @default(0) @db.Decimal(12, 2)
  currency      String              @default("GBP")
  funderId      String?             @db.Uuid
  /// When set, this payment was recorded against a specific service-user invoice
  /// and should count fully toward that person's paid balance on the run.
  serviceUserId String?             @db.Uuid
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdById   String?             @db.Uuid

  allocations PaymentAllocation[]

  @@index([receivedDate])
  @@index([matchStatus])
  @@index([recordStatus])
  @@index([funderId])
  @@index([serviceUserId])
  @@schema("billing")
}

model PaymentAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  paymentId    String   @db.Uuid
  invoiceRunId String   @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now())
  createdById  String?  @db.Uuid

  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceRun InvoiceRun @relation(fields: [invoiceRunId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceRunId])
  @@index([paymentId])
  @@index([invoiceRunId])
  @@schema("billing")
}

// =============================================================================
// Native UK Payroll foundation (schema: payroll)
// Distinct from billing.PayrollRun (visit-pay aggregation). No PAYE/NI engine here.
// =============================================================================

enum PayrollTaxYearStatus {
  DRAFT
  ACTIVE
  CLOSED

  @@schema("payroll")
}

enum PayrollPayFrequency {
  WEEKLY
  FORTNIGHTLY
  FOUR_WEEKLY
  MONTHLY

  @@schema("payroll")
}

enum PayrollScheduleStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@schema("payroll")
}

enum PayrollPeriodStatus {
  OPEN
  IN_RUN
  CLOSED

  @@schema("payroll")
}

enum EmployeePayrollProfileStatus {
  DRAFT
  READY
  SUSPENDED

  @@schema("payroll")
}

enum PayrollStarterDeclaration {
  UNKNOWN
  A_FIRST_JOB
  B_ONLY_JOB_THIS_YEAR
  C_HAS_ANOTHER_JOB_OR_PENSION

  @@schema("payroll")
}

enum PayrollNiCategory {
  A
  B
  C
  F
  H
  I
  J
  L
  M
  S
  V
  Z
  X

  @@schema("payroll")
}

enum PayrollTaxCodeGroup {
  STANDARD
  SPECIAL
  SCOTLAND
  WALES

  @@schema("payroll")
}

enum EmployeePayAgreementBasis {
  HOURLY_CARE
  SALARIED
  HYBRID

  @@schema("payroll")
}

enum EmployeePayAgreementStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  TERMINATED

  @@schema("payroll")
}

enum UkPayrollRunStatus {
  DRAFT
  EMPLOYEES_ENROLLED
  GROSS_CALCULATED
  STATUTORY_CALCULATED
  CLOSED
  CANCELLED

  @@schema("payroll")
}

enum UkPayrollInputSourceType {
  BILLING_PAYROLL_LINE
  VISIT_RECONCILIATION
  PAY_AGREEMENT_SALARY
  SALARY_DEDUCTION

  @@schema("payroll")
}

/// Per employee + tax year cumulative totals (posted on run close; reversed on reactivate).
model EmployeePayrollYtdLedger {
  id              String   @id @default(uuid()) @db.Uuid
  employeeId      String   @db.Uuid
  taxYearId       String   @db.Uuid
  grossPayYtd     Decimal  @default(0) @db.Decimal(12, 2)
  taxablePayYtd   Decimal  @default(0) @db.Decimal(12, 2)
  incomeTaxYtd    Decimal  @default(0) @db.Decimal(12, 2)
  employeeNiYtd   Decimal  @default(0) @db.Decimal(12, 2)
  employerNiYtd   Decimal  @default(0) @db.Decimal(12, 2)
  netPayYtd       Decimal  @default(0) @db.Decimal(12, 2)
  /// Gate C11: student and postgraduate loan deducted to date (closed runs).
  studentLoanYtd      Decimal @default(0) @db.Decimal(12, 2)
  postgraduateLoanYtd Decimal @default(0) @db.Decimal(12, 2)
  /// Gate C16: workplace pension to date (closed runs).
  pensionEmployeeGrossYtd Decimal @default(0) @db.Decimal(12, 2)
  pensionEmployeeNetYtd   Decimal @default(0) @db.Decimal(12, 2)
  pensionEmployerYtd      Decimal @default(0) @db.Decimal(12, 2)
  lastClosedRunId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?  @db.Uuid
  updatedById     String?  @db.Uuid

  taxYear       PayrollTaxYear                   @relation(fields: [taxYearId], references: [id], onDelete: Restrict)
  contributions EmployeePayrollYtdContribution[]

  @@unique([employeeId, taxYearId])
  @@index([taxYearId])
  @@index([employeeId])
  @@schema("payroll")
}

/// Idempotent period contribution to a YTD ledger (one row per run employee; reversible).
model EmployeePayrollYtdContribution {
  id             String    @id @default(uuid()) @db.Uuid
  ledgerId       String    @db.Uuid
  ukPayrollRunId String    @db.Uuid
  employeeId     String    @db.Uuid
  taxYearId      String    @db.Uuid
  grossPay       Decimal   @db.Decimal(12, 2)
  taxablePay     Decimal   @db.Decimal(12, 2)
  incomeTax      Decimal   @db.Decimal(12, 2)
  employeeNi     Decimal   @db.Decimal(12, 2)
  employerNi     Decimal   @db.Decimal(12, 2)
  netPay         Decimal   @db.Decimal(12, 2)
  /// Gate C10, for RTI: the NI category and method (AN for a director, null otherwise) this
  /// contribution belongs to, with its NI-able earnings and band shares. YTD per category is the
  /// sum of the contributions not reversed. Null figures: posted without NI data (legacy run).
  niCategory        String?
  directorNicMethod String?
  niableEarnings    Decimal?  @db.Decimal(12, 2)
  niEarningsAtLel   Decimal?  @db.Decimal(12, 2)
  niEarningsLelToPt Decimal?  @db.Decimal(12, 2)
  niEarningsPtToUel Decimal?  @db.Decimal(12, 2)
  /// Gate C11: student and postgraduate loan deducted by this run.
  studentLoan       Decimal   @default(0) @db.Decimal(12, 2)
  postgraduateLoan  Decimal   @default(0) @db.Decimal(12, 2)
  /// Gate C16: workplace pension posted by this run.
  pensionEmployeeGross Decimal @default(0) @db.Decimal(12, 2)
  pensionEmployeeNet   Decimal @default(0) @db.Decimal(12, 2)
  pensionEmployer      Decimal @default(0) @db.Decimal(12, 2)
  isReversed     Boolean   @default(false)
  postedAt       DateTime  @default(now())
  reversedAt     DateTime?
  createdById    String?   @db.Uuid
  reversedById   String?   @db.Uuid

  ledger EmployeePayrollYtdLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@unique([ukPayrollRunId, employeeId])
  @@index([ledgerId])
  @@index([taxYearId])
  @@index([employeeId])
  @@schema("payroll")
}

/// Singleton HMRC employer identity for FPS/EPS (one row per deployment). Survives payroll purge.
model PayrollEmployerSettings {
  id                          String    @id @db.Uuid
  /// First 3 digits of the Employer PAYE reference (HMRC office number).
  hmrcOfficeNumber            String?
  /// PAYE reference after the slash (e.g. AB45678). Full form is {office}/{this}.
  employerPayeReference       String?
  /// Accounts Office reference from HMRC registration letter (e.g. 123PA00012345).
  accountsOfficeReference     String?
  /// Optional tax district / office name for ops display.
  taxDistrict                 String?
  /// Legal / trading name to show on payroll filings (optional until FPS).
  employerTradingName         String?
  notes                       String?
  /// Which HMRC Gateway environment Care will use for RTI submit (T16). TEST | LIVE.
  activeHmrcEnvironment       String    @default("TEST")
  /// PAYE Online / Gateway user ID for HMRC test (sandbox) submissions.
  gatewayTestUserId           String?
  /// AES-GCM ciphertext (enc:v1:…) — never returned on API reads.
  gatewayTestPasswordEnc      String?
  /// PAYE Online / Gateway user ID for HMRC live submissions.
  gatewayLiveUserId           String?
  /// AES-GCM ciphertext (enc:v1:…) — never returned on API reads.
  gatewayLivePasswordEnc      String?
  gatewayCredentialsUpdatedAt DateTime?
  /// Claim Employment Allowance on EPS when eligible (T14).
  employmentAllowanceClaimed  Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  createdById                 String?   @db.Uuid
  updatedById                 String?   @db.Uuid

  @@schema("payroll")
}

/// UK tax year versioning shell (e.g. 2025-26). Statutory rate tables arrive in later phases.
model PayrollTaxYear {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  label       String
  startDate   DateTime             @db.Date
  endDate     DateTime             @db.Date
  isCurrent   Boolean              @default(false)
  status      PayrollTaxYearStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdById String?              @db.Uuid
  updatedById String?              @db.Uuid
  deletedAt   DateTime?

  periods           PayrollPeriod[]
  runs              UkPayrollRun[]
  statutoryRateSets PayrollStatutoryRateSet[]
  ytdLedgers        EmployeePayrollYtdLedger[]

  @@index([status])
  @@index([isCurrent])
  @@index([deletedAt])
  @@schema("payroll")
}

/// Tax-year versioned HMRC rates (England/NI/Wales PAYE + Class 1 NI). Source documented in notes.
model PayrollStatutoryRateSet {
  id                            String   @id @default(uuid()) @db.Uuid
  taxYearId                     String   @db.Uuid
  /// ENG | WLS | NIR (SCO deferred).
  nation                        String   @default("ENG")
  version                       Int      @default(1)
  isActive                      Boolean  @default(true)
  /// Personal allowance annual GBP.
  personalAllowanceAnnual       Decimal  @db.Decimal(12, 2)
  /// Basic rate band width above free pay (annual), e.g. 37700.
  basicRateBandAnnual           Decimal  @db.Decimal(12, 2)
  higherRateThresholdAnnual     Decimal  @db.Decimal(12, 2)
  additionalRateThresholdAnnual Decimal  @db.Decimal(12, 2)
  basicRatePercent              Decimal  @db.Decimal(5, 2)
  higherRatePercent             Decimal  @db.Decimal(5, 2)
  additionalRatePercent         Decimal  @db.Decimal(5, 2)
  /// Class 1 thresholds (weekly / monthly / annual).
  niLelWeekly                   Decimal  @db.Decimal(12, 2)
  niPtWeekly                    Decimal  @db.Decimal(12, 2)
  niStWeekly                    Decimal  @db.Decimal(12, 2)
  niUelWeekly                   Decimal  @db.Decimal(12, 2)
  niLelMonthly                  Decimal  @db.Decimal(12, 2)
  niPtMonthly                   Decimal  @db.Decimal(12, 2)
  niStMonthly                   Decimal  @db.Decimal(12, 2)
  niUelMonthly                  Decimal  @db.Decimal(12, 2)
  /// Category A primary (employee) rates.
  niEmployeeRateMainPercent     Decimal  @db.Decimal(5, 2)
  niEmployeeRateUpperPercent    Decimal  @db.Decimal(5, 2)
  /// Category A secondary (employer) rate above ST.
  niEmployerRatePercent         Decimal  @db.Decimal(5, 2)
  sourceNote                    String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  taxYear PayrollTaxYear @relation(fields: [taxYearId], references: [id], onDelete: Cascade)

  @@unique([taxYearId, nation, version])
  @@index([taxYearId, isActive])
  @@schema("payroll")
}

/// Admin catalogue of HMRC PAYE tax codes shown in employee payroll setup.
model PayrollTaxCode {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique
  label       String
  description String?
  group       PayrollTaxCodeGroup @default(STANDARD)
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdById String?             @db.Uuid
  updatedById String?             @db.Uuid
  deletedAt   DateTime?

  @@index([isActive, sortOrder])
  @@index([group])
  @@index([deletedAt])
  @@schema("payroll")
}

model PayrollSchedule {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  code        String                @unique
  frequency   PayrollPayFrequency
  /// 1–7 = Mon–Sun for weekly-style; 1–28 for monthly pay day (clamped to month length).
  anchorDay   Int                   @default(1)
  description String?
  status      PayrollScheduleStatus @default(DRAFT)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  createdById String?               @db.Uuid
  updatedById String?               @db.Uuid
  deletedAt   DateTime?

  periods    PayrollPeriod[]
  profiles   EmployeePayrollProfile[]
  agreements EmployeePayAgreement[]
  runs       UkPayrollRun[]

  @@index([status])
  @@index([deletedAt])
  @@schema("payroll")
}

model PayrollPeriod {
  id          String              @id @default(uuid()) @db.Uuid
  scheduleId  String              @db.Uuid
  taxYearId   String              @db.Uuid
  sequence    Int
  label       String
  periodStart DateTime            @db.Date
  periodEnd   DateTime            @db.Date
  paymentDate DateTime            @db.Date
  status      PayrollPeriodStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdById String?             @db.Uuid
  updatedById String?             @db.Uuid
  deletedAt   DateTime?

  schedule PayrollSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  taxYear  PayrollTaxYear  @relation(fields: [taxYearId], references: [id], onDelete: Restrict)
  runs     UkPayrollRun[]

  @@unique([scheduleId, taxYearId, sequence])
  @@index([scheduleId, periodStart, periodEnd])
  @@index([taxYearId])
  @@index([status])
  @@index([deletedAt])
  @@schema("payroll")
}

enum OfficeSalaryPeriod {
  MONTHLY
  ANNUAL

  @@schema("payroll")
}

/// Salary for an office user (login account), managed separately from carer payroll.
/// No tax / NI is calculated here — amounts are gross as agreed.
model OfficeUserSalary {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @db.Uuid
  amount            Decimal            @db.Decimal(12, 2)
  period            OfficeSalaryPeriod @default(MONTHLY)
  /// Day of the month the salary is paid (1–31).
  payDay            Int?
  startDate         DateTime?          @db.Date
  bankAccountName   String?
  bankSortCode      String?
  bankAccountNumber String?
  notes             String?            @db.Text
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdById       String?            @db.Uuid
  updatedById       String?            @db.Uuid

  @@schema("payroll")
}

/// One salary payment to an office user for a month (a row = paid).
model OfficeSalaryPayment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  /// YYYY-MM
  month       String
  amount      Decimal   @db.Decimal(12, 2)
  paidAt      DateTime? @db.Date
  reference   String?
  note        String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  @@unique([userId, month])
  @@index([month])
  @@schema("payroll")
}

/// Statutory payroll setup for an employee. Does not calculate tax — stores configuration only.
model EmployeePayrollProfile {
  id                  String                       @id @default(uuid()) @db.Uuid
  employeeId          String                       @unique @db.Uuid
  scheduleId          String?                      @db.Uuid
  status              EmployeePayrollProfileStatus @default(DRAFT)
  taxCode             String?
  taxCodeWeek1Month1  Boolean                      @default(false)
  niCategory          PayrollNiCategory?
  starterDeclaration  PayrollStarterDeclaration    @default(UNKNOWN)
  /// HMRC FPS hours-normally-worked band A–E (T04).
  hoursNormallyWorked String?
  /// Previous employer P45 received — starter declaration A/B/C not required (T05).
  p45Received         Boolean                      @default(false)
  studentLoanPlan1    Boolean                      @default(false)
  studentLoanPlan2    Boolean                      @default(false)
  studentLoanPlan4    Boolean                      @default(false)
  studentLoanPlan5    Boolean                      @default(false)
  postgraduateLoan    Boolean                      @default(false)
  pensionOptedIn      Boolean                      @default(false)
  pensionSchemeRef    String?
  /// Gate C16: workplace pension enrolment as confirmed by a person: ENROLLED or NOT_ENROLLED; null
  /// means not recorded (tax and NI are then not calculated). NOT_ENROLLED is not an auto-enrolment
  /// eligibility assessment.
  pensionStatus              String?
  pensionEnrolledFrom        DateTime? @db.Date
  /// QUALIFYING_EARNINGS is the only basis calculated.
  pensionContributionBasis   String?
  /// RAS (relief at source) is the only method calculated; NET_PAY is refused.
  pensionTaxRelief           String?
  /// Gross employee and employer contribution rates of the approved scheme policy.
  pensionEmployeeRatePercent Decimal?  @db.Decimal(5, 2)
  pensionEmployerRatePercent Decimal?  @db.Decimal(5, 2)
  pensionPolicyRef           String?
  /// Loan/pension completion: the employee's student loan declaration (starter checklist or P45):
  /// LOAN_DECLARED or NO_LOAN_CONFIRMED; null = not yet verified. With its source and date.
  loanDeclarationStatus      String?
  loanDeclarationSource      String?
  loanDeclarationDate        DateTime? @db.Date
  /// Automatic enrolment evidence: ordinarily works in the UK (null = not recorded), and a
  /// recorded State Pension age date where it cannot be derived from the date of birth.
  pensionUkWorker            Boolean?
  statePensionAgeDate        DateTime? @db.Date
  /// Q37–Q39: the day the apprenticeship began. The apprentice minimum wage rate applies under 19,
  /// or in the first year of the apprenticeship; without this date it cannot be shown for 19+.
  apprenticeshipStartDate DateTime? @db.Date
  /// Gate C7: company director for NI, as confirmed by a person; null means not yet classified,
  /// and tax and NI are then not calculated. Never inferred from a job title.
  isDirector          Boolean?
  /// Gate C7: the day the person was appointed a director.
  directorAppointedOn DateTime?                    @db.Date
  /// Gate C7: directors' NIC method for the FPS. AN: standard annual earnings period (AL is not
  /// calculated by this version).
  directorNicMethod   String?
  /// Selected UK deduction catalogue codes (2026/27) — configuration only until engines land.
  deductionElections  Json?
  bankSortCode        String?
  bankAccountNumber   String?
  bankAccountName     String?
  notes               String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  createdById         String?                      @db.Uuid
  updatedById         String?                      @db.Uuid
  deletedAt           DateTime?

  schedule PayrollSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([scheduleId])
  @@index([deletedAt])
  @@schema("payroll")
}

/// Effective-dated pay agreement. Optional link to billing pay-card UUID (no cross-schema FK required).
model EmployeePayAgreement {
  id                 String                     @id @default(uuid()) @db.Uuid
  employeeId         String                     @db.Uuid
  scheduleId         String?                    @db.Uuid
  basis              EmployeePayAgreementBasis  @default(HOURLY_CARE)
  status             EmployeePayAgreementStatus @default(DRAFT)
  effectiveFrom      DateTime                   @db.Date
  effectiveTo        DateTime?                  @db.Date
  /// Billing PayCard id when basis uses care hourly rates (stored UUID; billing owns the card).
  payCardId          String?                    @db.Uuid
  annualSalary       Decimal?                   @db.Decimal(12, 2)
  contractedHours    Decimal?                   @db.Decimal(8, 2)
  hourlyRateOverride Decimal?                   @db.Decimal(12, 4)
  /// ANNUAL | MONTHLY | WEEKLY: how the salary was entered. `annualSalary` is always the yearly figure.
  salaryEntryPeriod     String?
  salaryEntryAmount     Decimal? @db.Decimal(12, 2)
  /// How a part period is paid: CALENDAR_DAYS_365_25 (also when empty: the earlier behaviour) |
  /// EQUAL_PERIODS_CALENDAR_DAYS | EQUAL_PERIODS_WORKING_DAYS.
  salaryProrationMethod String?
  /// What the salary already pays for: ALL_VISIT_WORK | CONTRACTED_HOURS | NO_VISIT_WORK.
  /// Empty = not decided: the salary is paid and the visit wages are held, never paid on top.
  salaryCoverage        String?
  /// Guaranteed hours (WM-07 / EL-01). Hours a week the employer guarantees.
  guaranteedWeeklyHours    Decimal? @db.Decimal(6, 2)
  /// PAY_SHORTFALL: hours short of the guarantee are paid as a top-up. Empty: recorded only, nothing is paid.
  guaranteeTopUp           String?
  /// What counts towards the guarantee: VISITS | VISITS_AND_TRAVEL.
  guaranteeQualifyingTime  String?
  /// A week with recorded absence: COUNT_PAID_LEAVE_HOURS | REDUCE_FOR_ABSENCE_DAYS. Empty: the
  /// top-up of such a week is held for a person to decide.
  guaranteeLeaveTreatment  String?
  /// Second person who approved the agreement (required when it carries or replaces a salary).
  approvedById          String?   @db.Uuid
  approvedAt            DateTime?
  /// When a person last put these pay terms into effect or ended them. A change made after a
  /// period was paid is what produces a salary adjustment for that period.
  termsChangedAt        DateTime?
  currency           String                     @default("GBP")
  notes              String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  createdById        String?                    @db.Uuid
  updatedById        String?                    @db.Uuid
  deletedAt          DateTime?

  schedule PayrollSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, status])
  @@index([payCardId])
  @@index([deletedAt])
  @@schema("payroll")
}

/// Q35: how one employee's holiday is earned and paid, from a date. Nothing here is assumed for
/// anyone: an employee with no terms recorded has no entitlement worked out by the system.
model EmployeeLeaveTerms {
  id                   String    @id @default(uuid()) @db.Uuid
  employeeId           String    @db.Uuid
  /// REGULAR_HOURS | IRREGULAR_HOURS | PART_YEAR
  workerCategory       String
  /// First day of the leave year, as month and day (for example 4 and 1 for 1 April).
  leaveYearStartMonth  Int
  leaveYearStartDay    Int       @default(1)
  /// Regular hours: the hours of a normal working week. Statutory leave is 5.6 of these weeks.
  weeklyHours          Decimal?  @db.Decimal(6, 2)
  /// Leave the contract gives beyond the statutory 5.6 weeks, in hours a year.
  contractualExtraHours Decimal? @db.Decimal(8, 2)
  /// How a day of holiday is paid: NORMAL_REMUNERATION_52_WEEKS | ROLLED_UP_12_07
  payMethod            String
  /// Hours of untaken leave that may be carried into the next leave year (empty: none).
  carryOverMaxHours    Decimal?  @db.Decimal(8, 2)
  effectiveFrom        DateTime  @db.Date
  effectiveTo          DateTime? @db.Date
  /// DRAFT | ACTIVE | SUPERSEDED
  status               String    @default("DRAFT")
  note                 String?
  createdById          String?   @db.Uuid
  createdAt            DateTime  @default(now())
  approvedById         String?   @db.Uuid
  approvedAt           DateTime?
  updatedAt            DateTime  @updatedAt

  @@index([employeeId, effectiveFrom])
  @@schema("payroll")
}

/// Leave movements of an employee in hours: what was taken, adjusted, carried over or paid on
/// leaving. Accrual is worked out from the terms and the hours worked; it is not stored here.
model EmployeeLeaveEntry {
  id              String   @id @default(uuid()) @db.Uuid
  employeeId      String   @db.Uuid
  /// TAKEN | ADJUSTMENT | CARRY_OVER | LEAVER_PAYMENT
  entryType       String
  /// STATUTORY | CONTRACTUAL
  entitlementType String   @default("STATUTORY")
  /// Hours. TAKEN and LEAVER_PAYMENT reduce the balance; ADJUSTMENT and CARRY_OVER are signed.
  hours           Decimal  @db.Decimal(8, 2)
  /// The day the leave was taken, or the day the movement applies to.
  date            DateTime @db.Date
  note            String?
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())

  @@index([employeeId, date])
  @@schema("payroll")
}

/// Statutory UK payroll run shell — distinct from billing.PayrollRun visit-pay aggregation.
model UkPayrollRun {
  id                    String             @id @default(uuid()) @db.Uuid
  periodId              String             @db.Uuid
  taxYearId             String             @db.Uuid
  scheduleId            String             @db.Uuid
  runNumber             Int
  label                 String
  status                UkPayrollRunStatus @default(DRAFT)
  employeeCount         Int                @default(0)
  /// Phase 2: sum of employee totalGross after calculate-gross.
  totalGross            Decimal            @default(0) @db.Decimal(12, 2)
  /// Phase 2: sum of expense-class amounts (mileage etc.).
  totalExpenses         Decimal            @default(0) @db.Decimal(12, 2)
  grossCalculatedAt     DateTime?
  /// Phase 3 statutory totals.
  totalIncomeTax        Decimal            @default(0) @db.Decimal(12, 2)
  totalEmployeeNi       Decimal            @default(0) @db.Decimal(12, 2)
  totalEmployerNi       Decimal            @default(0) @db.Decimal(12, 2)
  totalNetPay           Decimal            @default(0) @db.Decimal(12, 2)
  statutoryCalculatedAt DateTime?
  statutoryBasis        String? /// e.g. WEEK1_MONTH1_NON_CUMULATIVE
  currency              String             @default("GBP")
  notes                 String?
  closedAt              DateTime?
  closedById            String?            @db.Uuid
  cancelledAt           DateTime?
  cancelledById         String?            @db.Uuid
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  createdById           String?            @db.Uuid
  updatedById           String?            @db.Uuid
  deletedAt             DateTime?

  period          PayrollPeriod           @relation(fields: [periodId], references: [id], onDelete: Restrict)
  taxYear         PayrollTaxYear          @relation(fields: [taxYearId], references: [id], onDelete: Restrict)
  schedule        PayrollSchedule         @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  employees       UkPayrollRunEmployee[]
  inputLines      UkPayrollInputLine[]
  payoutBatches   EmployeePayoutBatch[]
  hmrcSubmissions PayrollHmrcSubmission[]

  @@unique([scheduleId, periodId, runNumber])
  @@index([status])
  @@index([taxYearId])
  @@index([periodId])
  @@index([deletedAt])
  @@schema("payroll")
}

/// Immutable HMRC RTI submission attempt (FPS on runs; EPS on tax month).
/// Payload XML + fingerprint are write-once; gateway outcome may update status/response only.
model PayrollHmrcSubmission {
  id                     String    @id @default(uuid()) @db.Uuid
  /// Present for FPS; null for EPS (tax-month filings).
  ukPayrollRunId         String?   @db.Uuid
  /// Present for EPS; null for FPS.
  taxYearId              String?   @db.Uuid
  /// UK PAYE tax month 1–12 for EPS.
  taxMonth               Int?
  /// FPS | EPS
  documentType           String    @default("FPS")
  /// DRY_RUN | SUBMIT
  mode                   String
  /// TEST | LIVE
  environment            String
  /// DRAFT_BUILT | PENDING_APPROVAL | SUBMITTED | ACKNOWLEDGED | ACCEPTED | REJECTED | REJECTED_APPROVAL | ERROR
  status                 String
  correlationId          String?
  gatewayUserId          String?
  vendorId               String?
  submissionUrl          String?
  /// GovTalk XML with Authentication/Value redacted.
  requestXmlRedacted     String?   @db.Text
  responseXml            String?   @db.Text
  httpStatus             Int?
  qualifier              String?
  functionCode           String?
  errorCode              String?
  errorMessage           String?
  /// Structured ack / error summary JSON.
  acknowledgement        Json?
  /// T17 — snapshot of Gov-* fraud-prevention headers attached (or that would be).
  fraudPreventionHeaders Json?
  /// SHA-256 of FPS/EPS content at request time (dual-control match).
  payloadFingerprint     String?
  approvedById           String?   @db.Uuid
  approvedAt             DateTime?
  rejectedById           String?   @db.Uuid
  rejectedAt             DateTime?
  rejectionNote          String?
  createdAt              DateTime  @default(now())
  createdById            String?   @db.Uuid

  /// Preserve HMRC evidence if a payroll run is soft/hard-deleted.
  run    UkPayrollRun?                @relation(fields: [ukPayrollRunId], references: [id], onDelete: SetNull)
  events PayrollHmrcSubmissionEvent[]

  @@index([ukPayrollRunId])
  @@index([taxYearId, taxMonth])
  @@index([documentType])
  @@index([status])
  @@index([createdAt])
  @@schema("payroll")
}

/// T21 — append-only lifecycle events (who / when / hash / correlation / response digest).
model PayrollHmrcSubmissionEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  submissionId       String   @db.Uuid
  /// DRAFT_BUILT | LIVE_REQUESTED | LIVE_APPROVED | LIVE_REJECTED | GATEWAY_POSTED | GATEWAY_RESPONSE
  eventType          String
  actorUserId        String?  @db.Uuid
  fromStatus         String?
  toStatus           String
  payloadFingerprint String?
  correlationId      String?
  /// SHA-256 of full gateway response body when stored.
  responseSha256     String?
  httpStatus         Int?
  detail             Json?
  createdAt          DateTime @default(now())

  submission PayrollHmrcSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@index([eventType])
  @@schema("payroll")
}

/// Gate C13: an HMRC student or postgraduate loan start/stop notice (SL1, SL2, PGL1, PGL2) as
/// recorded by payroll staff. It applies from effectivePayday: the first payday on which the
/// employer could operate it (never before the notice was received). Recorded once per reference.
model EmployeeLoanNotice {
  id              String   @id @default(uuid()) @db.Uuid
  employeeId      String   @db.Uuid
  /// SL1, SL2, PGL1 or PGL2.
  noticeType      String
  /// SL1 only: 1, 2, 4 or 5.
  studentLoanPlan String?
  hmrcReference   String?
  /// The start or stop date stated on the notice.
  noticeDate      DateTime @db.Date
  receivedOn      DateTime @db.Date
  effectivePayday DateTime @db.Date
  notes           String?
  createdAt       DateTime @default(now())
  createdById     String   @db.Uuid
  /// Gate C15: "employeeId|noticeType|reference" while the notice is in force and has a reference;
  /// null once voided, so a controlled replacement can carry the same reference.
  activeReferenceKey String?   @unique
  /// Gate C15: the local record was entered wrongly and is voided (it was not an HMRC instruction
  /// to stop). The original values stay as they were.
  voidedAt           DateTime?
  voidedById         String?   @db.Uuid
  voidReason         String?
  voidEvidenceRef    String?
  /// Gate C15: the notice recorded in its place, and on that notice, the one it replaces.
  replacedById       String?   @db.Uuid
  replacesId         String?   @db.Uuid

  @@index([employeeId])
  @@schema("payroll")
}

/// A maker/checker correction of a student loan, postgraduate loan or pension amount already in a
/// CLOSED run. The closed run is never rewritten: once approved, the difference is applied in the
/// next run of the same tax year. Only refunds and reversals (negative amounts) are applied here.
model PayrollDeductionAdjustment {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @db.Uuid
  taxYearId       String    @db.Uuid
  /// STUDENT_LOAN, POSTGRADUATE_LOAN, PENSION_EMPLOYEE (net deduction) or PENSION_EMPLOYER.
  kind            String
  sourceRunId     String    @db.Uuid
  originalAmount  Decimal   @db.Decimal(12, 2)
  correctedAmount Decimal   @db.Decimal(12, 2)
  /// correctedAmount - originalAmount (negative: refund to the employee / reversal).
  amount          Decimal   @db.Decimal(12, 2)
  reason          String
  evidenceRef     String
  /// MANUAL_CORRECTION or PENSION_OPT_OUT.
  origin          String
  /// PROPOSED, APPROVED or REJECTED.
  status          String    @default("PROPOSED")
  proposedById    String    @db.Uuid
  proposedAt      DateTime  @default(now())
  reviewedById    String?   @db.Uuid
  reviewedAt      DateTime?
  reviewNote      String?
  appliedRunId    String?   @db.Uuid
  appliedAt       DateTime?
  /// "employeeId|sourceRunId|kind" while not rejected: one live correction per amount.
  activeKey       String?   @unique

  @@index([employeeId])
  @@index([appliedRunId])
  @@schema("payroll")
}

/// Automatic enrolment duties of one worker: the latest assessment, the dates that follow from it,
/// postponement, statutory notices, opt-in / joining requests, opt-out and re-enrolment. Each
/// change is also kept in the audit log.
model EmployeePensionAe {
  id                       String    @id @default(uuid()) @db.Uuid
  employeeId               String    @unique @db.Uuid
  lastAssessedOn           DateTime? @db.Date
  lastCategory             String?
  lastExplanation          String?
  lastRunId                String?   @db.Uuid
  automaticEnrolmentDate   DateTime? @db.Date
  enrolmentDeadline        DateTime? @db.Date
  enrolmentNoticeSentOn    DateTime? @db.Date
  postponementFrom         DateTime? @db.Date
  postponementEndsOn       DateTime? @db.Date
  postponementNoticeSentOn DateTime? @db.Date
  optInRequestedOn         DateTime? @db.Date
  joiningRequestedOn       DateTime? @db.Date
  optOutReceivedOn         DateTime? @db.Date
  optOutEvidenceRef        String?
  ceasedOn                 DateTime? @db.Date
  reEnrolmentDueOn         DateTime? @db.Date
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@schema("payroll")
}

model UkPayrollRunEmployee {
  id                    String    @id @default(uuid()) @db.Uuid
  runId                 String    @db.Uuid
  employeeId            String    @db.Uuid
  /// Snapshot of agreement id at enrolment.
  payAgreementId        String?   @db.Uuid
  enrolledAt            DateTime  @default(now())
  notes                 String?
  /// Phase 2 gross breakdown (GBP).
  visitPay              Decimal   @default(0) @db.Decimal(12, 2)
  salaryPay             Decimal   @default(0) @db.Decimal(12, 2)
  travelPay             Decimal   @default(0) @db.Decimal(12, 2)
  nmwTopUp              Decimal   @default(0) @db.Decimal(12, 2)
  otherPay              Decimal   @default(0) @db.Decimal(12, 2)
  expenseTotal          Decimal   @default(0) @db.Decimal(12, 2)
  /// TR-13: reimbursements to be paid to the employee with this run's net pay. Equal to
  /// expenseTotal for runs calculated since reimbursements were paid through payouts; 0 on older
  /// runs, whose expenses were recorded but never part of a payout.
  reimbursementPayable  Decimal   @default(0) @db.Decimal(12, 2)
  /// Part of expenseTotal whose tax treatment has not been verified (see MileageRate).
  expenseNotVerified    Decimal   @default(0) @db.Decimal(12, 2)
  deductionTotal        Decimal   @default(0) @db.Decimal(12, 2)
  /// visit + salary + travel + nmw + other − deductions (expenses tracked separately).
  totalGross            Decimal   @default(0) @db.Decimal(12, 2)
  inputLineCount        Int       @default(0)
  hasProvisionalInputs  Boolean   @default(false)
  grossCalculatedAt     DateTime?
  /// Phase 3 statutory results (GBP).
  taxablePay            Decimal   @default(0) @db.Decimal(12, 2)
  incomeTax             Decimal   @default(0) @db.Decimal(12, 2)
  employeeNi            Decimal   @default(0) @db.Decimal(12, 2)
  employerNi            Decimal   @default(0) @db.Decimal(12, 2)
  netPay                Decimal   @default(0) @db.Decimal(12, 2)
  taxCodeApplied        String?
  niCategoryApplied     String?
  /// Gate C7: AN when NI was worked out on a director's annual (or pro rata annual) earnings period.
  directorNicMethodApplied String?
  /// Gate C10, for RTI: this payment's NI-able earnings and its share of the earnings bands (at the
  /// LEL, LEL to PT, PT to UEL) of its earnings period; a supplementary payment or a director's
  /// later payment holds only the part not reported before. Null: not recorded (legacy).
  niableEarnings        Decimal?  @db.Decimal(12, 2)
  niEarningsAtLel       Decimal?  @db.Decimal(12, 2)
  niEarningsLelToPt     Decimal?  @db.Decimal(12, 2)
  niEarningsPtToUel     Decimal?  @db.Decimal(12, 2)
  /// Gate C11: student loan plan applied (1, 2, 4, 5 or NONE) and whether a postgraduate loan
  /// applied; null on rows calculated before C11. The deductions reduce net pay.
  studentLoanPlanApplied    String?
  studentLoanDeduction      Decimal   @default(0) @db.Decimal(12, 2)
  postgraduateLoanApplied   Boolean?
  postgraduateLoanDeduction Decimal   @default(0) @db.Decimal(12, 2)
  /// Gate C16: workplace pension (relief at source). pensionApplied null on rows calculated before
  /// C16; pensionablePay is the pay counted for qualifying earnings (no expenses). The employee
  /// net deduction reduces net pay; the employer contribution does not.
  pensionApplied            Boolean?
  pensionablePay            Decimal   @default(0) @db.Decimal(12, 2)
  pensionQualifyingEarnings Decimal   @default(0) @db.Decimal(12, 2)
  pensionEmployeeGross      Decimal   @default(0) @db.Decimal(12, 2)
  pensionEmployeeNet        Decimal   @default(0) @db.Decimal(12, 2)
  pensionTaxRelief          Decimal   @default(0) @db.Decimal(12, 2)
  pensionEmployer           Decimal   @default(0) @db.Decimal(12, 2)
  /// Approved corrections of earlier closed runs applied in this run (negative = refund or
  /// reversal). The employee ones change net pay; the employer one does not.
  studentLoanAdjustment       Decimal  @default(0) @db.Decimal(12, 2)
  postgraduateLoanAdjustment  Decimal  @default(0) @db.Decimal(12, 2)
  pensionEmployeeAdjustment   Decimal  @default(0) @db.Decimal(12, 2)
  pensionEmployerAdjustment   Decimal  @default(0) @db.Decimal(12, 2)
  /// Pension scheme reference in force when this run was calculated.
  pensionSchemeRefApplied     String?
  /// Automatic enrolment assessment of this pay reference period.
  aeCategory                  String?
  aeExplanation               String?
  statutoryExplanation  String?
  statutoryCalculatedAt DateTime?
  createdAt             DateTime  @default(now())
  createdById           String?   @db.Uuid

  run         UkPayrollRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  inputLines  UkPayrollInputLine[]
  payoutLines EmployeePayoutLine[]

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([runId])
  @@schema("payroll")
}

/// Immutable Phase 2 snapshot of a gross-pay input for a run employee.
model UkPayrollInputLine {
  id                          String                   @id @default(uuid()) @db.Uuid
  runId                       String                   @db.Uuid
  runEmployeeId               String                   @db.Uuid
  employeeId                  String                   @db.Uuid
  sourceType                  UkPayrollInputSourceType
  sourcePayrollRunId          String?                  @db.Uuid
  sourcePayrollRunLineId      String?                  @db.Uuid
  sourceVisitReconciliationId String?                  @db.Uuid
  sourceSalaryDeductionId     String?                  @db.Uuid
  lineType                    String
  description                 String
  minutes                     Int?
  amount                      Decimal                  @db.Decimal(12, 2)
  isExpense                   Boolean                  @default(false)
  isProvisional               Boolean                  @default(false)
  /// Claim on the earning this line brings into UK payroll, unique across all runs:
  /// LINE:<visit pay line id>, SALARY:<employee id>:<period id>, DEDUCTION:<deduction id>:<period id>.
  /// Cleared (with releasedAt set) when the run is cancelled, so a replacement run can collect the
  /// earning; the line itself stays as the snapshot of the cancelled run. Null for provisional
  /// visits, which are claimed on the visit when the run closes (paidByUkPayrollRunId).
  claimKey                    String?                  @unique
  releasedAt                  DateTime?
  /// Value of the source earning that this line does not pay, and why:
  /// COVERED_BY_SALARY (the salary already pays for the work; the earning is settled by this run) |
  /// SALARY_COVERAGE_NOT_DECIDED (held: not paid and not claimed, a later run can still pay it).
  unpaidAmount                Decimal?                 @db.Decimal(12, 2)
  unpaidReason                String?
  createdAt                   DateTime                 @default(now())

  run         UkPayrollRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  runEmployee UkPayrollRunEmployee @relation(fields: [runEmployeeId], references: [id], onDelete: Cascade)

  @@index([sourcePayrollRunLineId])
  @@index([runId])
  @@index([runEmployeeId])
  @@index([employeeId])
  @@index([sourceVisitReconciliationId])
  @@schema("payroll")
}

