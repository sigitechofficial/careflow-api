enum FundingStatus {
  PENDING
  APPROVED
  ACTIVE
  SUSPENDED
  ENDED
  REJECTED
  UNKNOWN

  @@schema("service_users")
}

/// Enterprise funding classification (who pays — LA, NHS, private, etc.). Distinct from `ServiceUserFundingType` (demographic lookup on ServiceUser).
model FundingType {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  code        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  funders             Funder[]
  serviceUserFundings ServiceUserFunding[]

  @@index([deletedAt])
  @@schema("service_users")
}

model Funder {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  code          String?   @unique
  fundingTypeId String?   @db.Uuid
  contactName   String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  town          String?
  county        String?
  country       String?
  postcode      String?
  notes         String?
  defaultChargeCardId String? @db.Uuid
  defaultInvoiceTemplateId String? @db.Uuid
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedById   String?   @db.Uuid

  fundingType         FundingType?           @relation(fields: [fundingTypeId], references: [id])
  serviceUserFundings ServiceUserFunding[]
  defaultChargeCard   ChargeCard?            @relation("FunderDefaultChargeCard", fields: [defaultChargeCardId], references: [id], onDelete: SetNull)
  defaultInvoiceTemplate InvoiceTemplate?    @relation("FunderDefaultInvoiceTemplate", fields: [defaultInvoiceTemplateId], references: [id], onDelete: SetNull)
  invoiceTemplates    InvoiceTemplate[]      @relation("FunderScopedInvoiceTemplate")

  @@index([fundingTypeId])
  @@index([defaultChargeCardId])
  @@index([defaultInvoiceTemplateId])
  @@index([deletedAt])
  @@schema("service_users")
}

model ServiceUserFunding {
  id                 String         @id @default(uuid()) @db.Uuid
  serviceUserId      String         @db.Uuid
  fundingTypeId      String         @db.Uuid
  funderId           String?        @db.Uuid
  status             FundingStatus  @default(UNKNOWN)
  fundingReference   String?
  approvalReference  String?
  packageName        String?
  startDate          DateTime?
  endDate            DateTime?
  weeklyBudget       Decimal?       @db.Decimal(12, 2)
  hourlyRate         Decimal?       @db.Decimal(12, 2)
  contributionAmount Decimal?       @db.Decimal(12, 2)
  splitPercent       Decimal?        @db.Decimal(5, 2)
  splitPriority      Int             @default(1)
  purchaseOrderNumber String?
  purchaseOrderExpiresAt DateTime?    @db.Date
  authorisedWeeklyHours Float?
  billingContactName String?
  billingContactEmail String?
  billingContactPhone String?
  invoiceGroupingRule String?
  isPrimary          Boolean        @default(false)
  isActive           Boolean        @default(true)
  approvedAt         DateTime?
  approvedById       String?        @db.Uuid
  reviewDate         DateTime?
  notes              String?
  defaultChargeCardId String?        @db.Uuid
  defaultInvoiceTemplateId String?   @db.Uuid
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  createdById        String?        @db.Uuid
  updatedById        String?        @db.Uuid
  deletedById        String?        @db.Uuid

  serviceUser        ServiceUser  @relation("FundingLines", fields: [serviceUserId], references: [id])
  fundingType        FundingType  @relation(fields: [fundingTypeId], references: [id])
  funder             Funder?      @relation(fields: [funderId], references: [id])
  approvedBy         User?        @relation("ServiceUserFundingApprovedBy", fields: [approvedById], references: [id])
  markedCurrentFor   ServiceUser? @relation("FundingAsCurrent")
  defaultChargeCard  ChargeCard?  @relation("FundingDefaultChargeCard", fields: [defaultChargeCardId], references: [id], onDelete: SetNull)
  defaultInvoiceTemplate InvoiceTemplate? @relation("FundingDefaultInvoiceTemplate", fields: [defaultInvoiceTemplateId], references: [id], onDelete: SetNull)
  invoiceTemplateProfiles InvoiceTemplate[] @relation("FundingInvoiceTemplateScope")

  @@index([serviceUserId])
  @@index([defaultChargeCardId])
  @@index([defaultInvoiceTemplateId])
  @@index([deletedAt])
  @@index([status])
  @@schema("service_users")
}

