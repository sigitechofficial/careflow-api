  @@schema("learning")
}

model LearningAssessmentQuestion {
  id           String               @id @default(uuid()) @db.Uuid
  assessmentId String               @db.Uuid
  questionType LearningQuestionType
  questionText String
  explanation  String?
  points       Int                  @default(1)
  displayOrder Int                  @default(0)
  isRequired   Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  assessment LearningAssessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    LearningAssessmentOption[]
  answers    LearningAssessmentAnswer[]

  @@index([assessmentId])
  @@index([displayOrder])
  @@schema("learning")
}

model LearningAssessmentOption {
  id           String   @id @default(uuid()) @db.Uuid
  questionId   String   @db.Uuid
  optionText   String
  isCorrect    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  question LearningAssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([displayOrder])
  @@schema("learning")
}

model LearningPathway {
  id                     String                @id @default(uuid()) @db.Uuid
  name                   String
  code                   String
  description            String?
  targetRoleId           String?               @db.Uuid
  targetWorkAreaId       String?               @db.Uuid
  targetLocationId       String?               @db.Uuid
  isMandatory            Boolean               @default(false)
