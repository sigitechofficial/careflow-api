  bodyMapRecordsUpdated                BodyMapRecord[]                   @relation("BodyMapRecordUpdatedBy")
  bodyMapRecordsClosed                 BodyMapRecord[]                   @relation("BodyMapRecordClosedBy")
  bodyMapMarkersCreated                BodyMapMarker[]                   @relation("BodyMapMarkerCreatedBy")
  bodyMapReviewsAuthored               BodyMapReview[]                   @relation("BodyMapReviewedBy")
  bodyMapAlertsDismissed               BodyMapAlert[]                    @relation("BodyMapAlertDismissedBy")
  bodyMapAuditLogs                     BodyMapAuditLog[]                 @relation("BodyMapAuditActor")
  bodyMapSafeguardingChecksCompleted   BodyMapSafeguardingCheck[]        @relation("BodyMapSafeguardingCompletedBy")
  bodyMapPhotosUploaded                BodyMapPhoto[]                    @relation("BodyMapPhotoUploadedBy")
  bodyMapLinksCreated                  BodyMapLink[]                     @relation("BodyMapLinkCreatedBy")
  bodyMapWoundAssessmentsCreated       BodyMapWoundAssessment[]          @relation("BodyMapWoundAssessmentCreatedBy")
  bodyMapPressureAssessmentsCreated    BodyMapPressureAssessment[]       @relation("BodyMapPressureAssessmentCreatedBy")
  bodyMapMedicationSitesApplied        BodyMapMedicationSite[]           @relation("BodyMapMedicationSiteAppliedBy")
  bodyMapMedicationSitesCreated        BodyMapMedicationSite[]           @relation("BodyMapMedicationSiteCreatedBy")
  serviceUserFlashMessagesUpdated      ServiceUserFlashMessage[]         @relation("FlashMessageUpdatedBy")
  serviceUserFlashMessagesCleared      ServiceUserFlashMessage[]         @relation("FlashMessageClearedBy")
  serviceUserFlashMessagesDeleted      ServiceUserFlashMessage[]         @relation("FlashMessageDeletedBy")
  companyProfilesUpdated               CompanyProfile[]                  @relation("CompanyProfileUpdatedBy")
  organisationGeneralSettingsUpdated OrganisationGeneralSettings[]     @relation("OrganisationGeneralSettingsUpdatedBy")
  medicationSupplyDeliveriesReceived MedicationSupplyDelivery[]        @relation("MedSupplyReceivedBy")
  medicationSupplyDeliveriesWitnessed  MedicationSupplyDelivery[]        @relation("MedSupplyWitnessBy")
  medicationSupplyDeliveriesCreated    MedicationSupplyDelivery[]        @relation("MedSupplyDeliveryCreatedBy")
  medicationEventsEntered            MedicationAdministrationEvent[] @relation("MedEventEnteredBy")
  medicationEventsCreated            MedicationAdministrationEvent[] @relation("MedEventCreatedBy")
  medicationEventsManagerReviewed    MedicationAdministrationEvent[] @relation("MedEventManagerReviewedBy")
  medicationsStatusEnded             ServiceUserMedication[]         @relation("MedicationStatusEndedBy")
  visitTaskAssignmentsCreated        ServiceUserVisitTaskAssignment[] @relation("ServiceUserVisitTaskAssignmentCreatedBy")
  visitTaskAssignmentsUpdated        ServiceUserVisitTaskAssignment[] @relation("ServiceUserVisitTaskAssignmentUpdatedBy")
  vacanciesCreated                   Vacancy[]                        @relation("VacancyCreatedBy")
  candidatesConverted                Candidate[]                      @relation("CandidateConvertedBy")
  candidateDocumentsUploaded         CandidateDocument[]              @relation("CandidateDocumentUploadedBy")
  candidateStageChanges              CandidateStageHistory[]          @relation("CandidateStageChangedBy")
  policyDocumentsOwned               PolicyDocument[]                 @relation("PolicyDocumentOwner")
  policyDocumentsReviewed            PolicyDocument[]                 @relation("PolicyDocumentReviewer")
  policyDocumentsApproved            PolicyDocument[]                 @relation("PolicyDocumentApprover")
  policyApprovalsAuthored            PolicyApproval[]                 @relation("PolicyApprovalActor")
  policyAcknowledgements             PolicyAcknowledgement[]
  passwordResetTokens                PasswordResetToken[]
  serviceUserTimebankEntries         ServiceUserTimebankEntry[]       @relation("ServiceUserTimebankEntryBy")

  @@index([email])
  @@index([deletedAt])
  @@schema("identity")
}

/// Single-use password reset token (POST /auth/forgot-password → /auth/reset-password).
/// Only the SHA-256 hash of the emailed token is stored.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  /// Set when consumed, or when superseded by a newer request / a completed reset.
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  requestedIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, usedAt])
  @@index([expiresAt])
  @@schema("identity")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  rolePermissions   RolePermission[]
  userRoles         UserRole[]
  policyAudiences   PolicyAudience[]
  roleTaskTemplates RoleTaskTemplate[]
  roleTasks         RoleTask[]

  @@index([deletedAt])
  @@schema("identity")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  rolePermissions RolePermission[]

  @@index([deletedAt])
  @@schema("identity")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@schema("identity")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@schema("identity")
}

/// Office-user ↔ branch (Location) assignment for authorization scope.
/// Separate from EmployeeEmployment location fields (job placement).
model UserLocation {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  locationId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@schema("identity")
}

enum RoleTaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY

  @@schema("identity")
}

enum RoleTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED

  @@schema("identity")
}

/// Work a manager gives to an office-user role (whole role owns it). One-off or repeating.
model RoleTaskTemplate {
  id          String             @id @default(uuid()) @db.Uuid
  title       String
  description String?            @db.Text
  roleId      String             @db.Uuid
  /// Branch the task is for; null = all branches.
  locationId  String?            @db.Uuid
  /// Admin page to open for the work (e.g. /billing/payroll-runs).
  link        String?
  recurrence  RoleTaskRecurrence @default(NONE)
  /// Due date for a one-off task; first possible due date for a repeating task.
  startDate   DateTime           @db.Date
  /// WEEKLY: 0 = Sunday … 6 = Saturday.
  weekday     Int?
  /// MONTHLY: 1–31 (short months use their last day).
  dayOfMonth  Int?
  isActive    Boolean            @default(true)
  createdById String?            @db.Uuid
  updatedById String?            @db.Uuid
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  role     Role       @relation(fields: [roleId], references: [id])
  location Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tasks    RoleTask[]

  @@index([roleId])
  @@index([deletedAt])
  @@schema("identity")
}

/// One due occurrence of a role task (status tracked per due date), or a one-off task raised by
/// another feature (sourceType / sourceId, e.g. a survey alert) with no template.
model RoleTask {
  id            String         @id @default(uuid()) @db.Uuid
  /// Null for a task raised by another feature (see sourceType).
  templateId    String?        @db.Uuid
  /// What raised a task without a template: "SURVEY_ALERT" (surveys.SurveyAlert id in sourceId).
  sourceType    String?
  sourceId      String?        @db.Uuid
  roleId        String         @db.Uuid
  locationId    String?        @db.Uuid
  title         String
  description   String?        @db.Text
  link          String?
  dueDate       DateTime       @db.Date
  status        RoleTaskStatus @default(OPEN)
  note          String?        @db.Text
  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?        @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  template RoleTaskTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  role     Role             @relation(fields: [roleId], references: [id])
  location Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([templateId, dueDate])
  @@index([roleId, status])
  @@index([dueDate])
  @@index([sourceType, sourceId])
  @@schema("identity")
}

/// Singleton organisation profile (one row per deployment).
model CompanyProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  groupName            String?
  companyName          String
  odsCsCode            String
  displayName          String
  displayLogoUrl       String?
  displayLogoFileName  String?
  companyLogoUrl       String?
  companyLogoFileName  String?
  companyWebsite       String?
  contactName          String
  email                String
  phoneNumber          String
  companyNumber        String?
  vatNumber            String?
  bankName             String?
  bankSortCode         String?
  bankAccountNumber    String?
  numberOfCarers       Int      @default(0)
  numberOfServiceUsers Int      @default(0)
  activeModules        String[] @default([])
  /// Organisation-operated care settings (ServiceUserCareType codes, e.g. DOMICILIARY, RESIDENTIAL, SUPPORTED_LIVING).
  /// Empty = not configured. Used for policy visibility; not inferred from service-user records.
  careServiceTypes     String[] @default([])
  /// Registered legal name at Companies House (companyNumber holds the Companies House number).
  legalName            String?
  /// CQC provider id (e.g. 1-101656545) — one per organisation; branches carry cqcLocationId.
  cqcProviderId        String?
  /// Companies House status / type as published (e.g. "Active", "Private Limited Company").
  companyStatus        String?
  companyType          String?
  incorporationDate    DateTime? @db.Date
  /// UK SIC 2007 codes (e.g. 86900).
  sicCodes             String[] @default([])
  registeredAddressLine1 String?
  registeredAddressLine2 String?
