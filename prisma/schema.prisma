  onsetDate          DateTime?
  reviewDate         DateTime?
  /// How it affects the person's daily life and care (from the assessment or the office).
  impactOnCare       String                            @default("") @db.Text
  /// Warning signs and what carers should do.
  carerGuidance      String                            @default("") @db.Text
  /// Where the diagnosis was confirmed (GP summary, hospital letter) — blank = reported only.
  confirmationSource String                            @default("") @db.Text
  /// Initial assessment that proposed this row (promoted on submit).
  sourceSubmissionId String?                           @db.Uuid
  source             ServiceUserClinicalDataSource     @default(MANUAL)
  isActive           Boolean                           @default(true)
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  deletedAt          DateTime?
