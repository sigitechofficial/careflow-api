/// A pay calculation that could not be completed (R-17). Kept until it succeeds on a retry or a
/// person dismisses it, so wage-bearing work never drops out of sight. One row per subject
/// (a reconciliation, or a visit / job whose reconciliation could not even be created); a repeat
/// failure updates the row. Holds ids and a safe message only: no error text from the database.
model PayEvaluationFailure {
  id                    String    @id @default(uuid()) @db.Uuid
  /// RECON:<reconciliation id> | VISIT:<scheduled visit id> | JOB:<scheduled job id>
  subjectKey            String    @unique
  /// EVALUATE | ENSURE_VISIT | ENSURE_JOB
  operation             String
  scheduledJobId        String?   @db.Uuid
  scheduledVisitId      String?   @db.Uuid
  visitReconciliationId String?   @db.Uuid
  serviceUserId         String?   @db.Uuid
  employeeId            String?   @db.Uuid
  visitRef              String?
  /// BUSINESS (the office can fix the data) | TECHNICAL (unexpected; logged for monitoring)
  kind                  String
  category              String
  message               String
  /// Error class and code, for support. Never the raw error text.
  context               Json?
  retryable             Boolean   @default(true)
  /// OPEN | RESOLVED | DISMISSED
  status                String    @default("OPEN")
  occurrences           Int       @default(1)
  firstOccurredAt       DateTime  @default(now())
  lastOccurredAt        DateTime  @default(now())
  resolvedAt            DateTime?
  resolvedById          String?   @db.Uuid
  /// SUCCEEDED_ON_RETRY | SUCCEEDED_LATER | DISMISSED
  resolution            String?
  /// Every retry, dismissal and re-opening: [{ at, action, byUserId, outcome, note }]
  history               Json      @default("[]")
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([employeeId])
  @@index([serviceUserId])
  @@schema("billing")
}

