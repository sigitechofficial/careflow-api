  minimumMinutes    Int?
  roundingRule      String?
  priority          Int                   @default(0)
  sortOrder         Int                   @default(0)
  appliesToVisit    Boolean               @default(true)
  appliesToTravel   Boolean               @default(false)
  appliesToWaiting  Boolean               @default(false)
  appliesToTraining Boolean               @default(false)

  payCard PayCard @relation(fields: [payCardId], references: [id], onDelete: Cascade)

  @@index([payCardId])
  @@schema("billing")
}

model PayComponent {
