// --- In-app notifications (PostgreSQL source of truth; WebSocket for live delivery) ---

enum NotificationType {
  COMPLIANCE_EXPIRING
  COMPLIANCE_EXPIRED
  EMPLOYEE_DOCUMENT_UPLOADED
  EMPLOYEE_STATUS_CHANGED
  SERVICE_USER_UPDATED
  CARE_PLAN_REVIEW_DUE
  MEDICATION_ALERT
  INCIDENT_REPORTED
  SCHEDULE_UNALLOCATED_VISIT
  REPORT_READY
  SECURITY_ALERT
  SYSTEM_MESSAGE
  APPOINTMENT_REMINDER
  GP_APPOINTMENT_REMINDER
  HOSPITAL_APPOINTMENT_REMINDER
  CARE_REVIEW_REMINDER
  MEDICATION_REVIEW_REMINDER
  ASSESSMENT_DUE_REMINDER
  BIRTHDAY_REMINDER
  HR_APPLICATION_RECEIVED
  HR_CANDIDATE_SHORTLISTED
  HR_INTERVIEW_SCHEDULED
  HR_OFFER_ACCEPTED
  SUPERVISION_DUE
  POLICY_ACKNOWLEDGEMENT_DUE
  POLICY_ACKNOWLEDGEMENT_SUMMARY

  @@schema("notifications")
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
  CRITICAL

  @@schema("notifications")
}

enum NotificationModule {
  AUTH
  EMPLOYEE
  EMPLOYEE_COMPLIANCE
  SERVICE_USER
  SERVICE_CARE
  SCHEDULING
  REPORT
  SECURITY
  SYSTEM
  HR
  POLICY

  @@schema("notifications")
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  type        NotificationType
  title       String
  message     String
  module      NotificationModule
  recordType  String?
  recordId    String?              @db.Uuid
  severity    NotificationSeverity @default(INFO)
  metadata    Json?
  createdById String?              @db.Uuid
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy  User?                   @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([type])
  @@index([module])
  @@index([severity])
  @@index([createdAt])
  @@index([recordType, recordId])
  @@schema("notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @db.Uuid
  userId         String    @db.Uuid
  deliveredAt    DateTime?
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
  @@index([readAt])
  @@index([dismissedAt])
  @@index([createdAt])
  @@schema("notifications")
}

enum CarerMessageAudience {
  ALL
  BRANCHES
  EMPLOYEES

  @@schema("notifications")
}

/// A push notification an office user sent by hand to carers (Settings › Carer notifications).
model CarerMessage {
  id             String               @id @default(uuid()) @db.Uuid
  title          String               @db.VarChar(65)
  body           String               @db.VarChar(240)
  audience       CarerMessageAudience
  locationIds    String[]             @default([]) @db.Uuid
  employeeIds    String[]             @default([]) @db.Uuid
  recipientCount Int                  @default(0)
  withAppCount   Int                  @default(0)
  deliveredCount Int                  @default(0)
  sentById       String?              @db.Uuid
  createdAt      DateTime             @default(now())

  recipients CarerMessageRecipient[]

  @@index([createdAt])
  @@schema("notifications")
}

model CarerMessageRecipient {
  id          String   @id @default(uuid()) @db.Uuid
  messageId   String   @db.Uuid
  employeeId  String   @db.Uuid
  hadDevice   Boolean  @default(false)
  createdAt   DateTime @default(now())

  message CarerMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, employeeId])
  @@index([employeeId])
  @@schema("notifications")
}

/**
 * Per-user overrides for a notification type. No row = use product defaults (in-app + sound on). Composite PK avoids a redundant surrogate id.
 */
model NotificationPreference {
  userId       String           @db.Uuid
  type         NotificationType
  inAppEnabled Boolean          @default(true)
  /**
   * When false, delivery is skipped for this type; must be false if inAppEnabled is false (enforced in DB + service).
   */
  soundEnabled Boolean          @default(true)
  emailEnabled Boolean          @default(false)
  smsEnabled   Boolean          @default(false)
  pushEnabled  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@index([userId])
  @@index([type])
  @@schema("notifications")
}

enum ScheduleStatus {
  NOT_BUILT
  BUILDING
  BUILT
  FAILED
  CANCELLED

  @@schema("scheduling")
}

enum ScheduleBuildSource {
  TEMPLATE
  WITHOUT_TEMPLATE
  MANUAL

  @@schema("scheduling")
}

/**
 * Branch lifecycle (ScheduleArea.status).
 */
enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED

  @@schema("scheduling")
}

/**
 * CQC overall rating of a registered branch.
 */
enum CqcRating {
  OUTSTANDING
  GOOD
  REQUIRES_IMPROVEMENT
  INADEQUATE

  @@schema("scheduling")
}

enum CqcRatingStatus {
  RATED
  NOT_YET_RATED

  @@schema("scheduling")
}

enum ScheduleRunStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("scheduling")
}

model ScheduleArea {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  /**
   * 3-character branch code used in visit references (VIS-[BRANCH]-…).
   */
  visitRefCode String?  @unique @db.VarChar(3)
  description String?
  /**
   * Physical / postal address for this branch.
   */
  address     String?
  locationId  String?  @db.Uuid
  zoneId      String?  @db.Uuid
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  markerColorHex          String?
  incidentMessageUserIds  Json     @default("[]")
  incidentEmailUserIds    Json     @default("[]")
  parentZoneName          String?
  /**
   * CQC registration of this branch (null for unregistered branches). Stable seed key.
   */
  cqcLocationId           String?  @unique
  officialCqcName         String?
  /**
   * Structured postal address (`address` keeps the single-line form shown in the UI).
   */
  addressLine1            String?
  addressLine2            String?
  town                    String?
  county                  String?
  postcode                String?
  country                 String?
  countryCode             String   @default("GB")
  localAuthority          String?
  phone                   String?
  email                   String?
  website                 String?
  serviceTypes            String[] @default([])
  regulatedActivities     String[] @default([])
  /**
   * A branch can have several CQC registered managers.
   */
  registeredManagers      String[] @default([])
  nominatedIndividual     String?
  cqcRegistrationDate     DateTime? @db.Date
  cqcRating               CqcRating?
  cqcRatingStatus         CqcRatingStatus?
  status                  BranchStatus @default(ACTIVE)
  timezone                String   @default("Europe/London")
  currency                String   @default("GBP")
  locale                  String   @default("en-GB")
  /**
   * Set by geocoding (prisma/scripts/geocode-branches.ts); never guessed.
   */
  latitude                Decimal? @db.Decimal(10, 7)
  longitude               Decimal? @db.Decimal(10, 7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  location         Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  zone             Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  createdBy        User?                @relation("ScheduleAreaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?                @relation("ScheduleAreaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy        User?                @relation("ScheduleAreaDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  areaStatuses     ScheduleAreaStatus[]
  runs             ScheduleRun[]
  jobs             ScheduledJob[]
  serviceUserAreas ServiceUserArea[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([locationId])
  @@index([zoneId])
  @@schema("scheduling")
}

/**
 * Geographic monitoring area under a branch (ScheduleArea), with one or more postcodes.
 */
model ServiceUserArea {
  id             String    @id @default(uuid()) @db.Uuid
  scheduleAreaId String    @db.Uuid
  name           String
  code           String
  description    String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedById    String?   @db.Uuid

  scheduleArea ScheduleArea                        @relation(fields: [scheduleAreaId], references: [id], onDelete: Cascade)
  postcodes    ServiceUserAreaPostcode[]
  serviceUsers ServiceUser[]
  employments  EmployeeEmploymentServiceUserArea[]
  createdBy    User?                               @relation("ServiceUserAreaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                               @relation("ServiceUserAreaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy    User?                               @relation("ServiceUserAreaDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([scheduleAreaId, code])
  @@index([deletedAt])
  @@index([isActive])
  @@index([scheduleAreaId])
  @@schema("scheduling")
}

model ServiceUserAreaPostcode {
  id                 String   @id @default(uuid()) @db.Uuid
  serviceUserAreaId  String   @db.Uuid
  /**
   * Display form, e.g. CR0 1AA
   */
  postcode           String
  /**
   * Uppercase, no spaces — unique org-wide so a postcode maps to one area
   */
  normalizedPostcode String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  serviceUserArea ServiceUserArea @relation(fields: [serviceUserAreaId], references: [id], onDelete: Cascade)

  @@unique([serviceUserAreaId, normalizedPostcode])
  @@index([serviceUserAreaId])
  @@schema("scheduling")
}

model ScheduleBatch {
  id           String               @id @default(uuid()) @db.Uuid
  scheduleDate DateTime             @db.Date
  name         String?
  status       ScheduleStatus       @default(NOT_BUILT)
  buildSource  ScheduleBuildSource?
  templateId   String?              @db.Uuid
  builtAt      DateTime?
  builtById    String?              @db.Uuid
  notes        String?
  metadata     Json?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  createdById  String?              @db.Uuid
  updatedById  String?              @db.Uuid
  deletedById  String?              @db.Uuid

  builtBy      User?                @relation("ScheduleBatchBuiltBy", fields: [builtById], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("ScheduleBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                @relation("ScheduleBatchUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy    User?                @relation("ScheduleBatchDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  areaStatuses ScheduleAreaStatus[]
  runs         ScheduleRun[]
  jobs         ScheduledJob[]

  @@index([scheduleDate])
  @@index([status])
  @@index([deletedAt])
  @@index([isActive])
  @@schema("scheduling")
}

model ScheduleAreaStatus {
  id              String         @id @default(uuid()) @db.Uuid
  scheduleBatchId String         @db.Uuid
  scheduleAreaId  String         @db.Uuid
  status          ScheduleStatus @default(NOT_BUILT)
  builtAt         DateTime?
  builtById       String?        @db.Uuid
  notes           String?
  metadata        Json?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  scheduleBatch ScheduleBatch @relation(fields: [scheduleBatchId], references: [id], onDelete: Cascade)
  scheduleArea  ScheduleArea  @relation(fields: [scheduleAreaId], references: [id], onDelete: Cascade)
  builtBy       User?         @relation("ScheduleAreaStatusBuiltBy", fields: [builtById], references: [id], onDelete: SetNull)

  @@unique([scheduleBatchId, scheduleAreaId])
  @@index([scheduleBatchId])
  @@index([scheduleAreaId])
  @@index([status])
  @@index([deletedAt])
  @@schema("scheduling")
}

enum ScheduledJobStatus {
