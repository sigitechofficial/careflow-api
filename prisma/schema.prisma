  changeClass            EcmScheduleChangeClass @default(ORIGINAL)
  plannedStartDateTime   DateTime
  plannedEndDateTime     DateTime?
  previousStartDateTime  DateTime?
  previousEndDateTime    DateTime?
  reasonCode             String?
  reasonNote             String?
  changedById            String?                @db.Uuid
