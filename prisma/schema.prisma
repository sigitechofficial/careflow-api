  updatedById        String?                           @db.Uuid
  deletedById        String?                           @db.Uuid

  serviceUser ServiceUser             @relation(fields: [serviceUserId], references: [id])
  condition   MedicalConditionCatalog @relation(fields: [conditionId], references: [id])

  @@unique([serviceUserId, conditionId])
  @@index([serviceUserId])
  @@index([conditionId])
  @@index([status])
  @@index([deletedAt])
  @@schema("service_users")
}

