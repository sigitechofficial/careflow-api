  name      String @unique
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  employeePersonalDetails EmployeePersonalDetail[]
  @@schema("lookups")
}

