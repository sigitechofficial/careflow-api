  reviewedBy              User?                                     @relation("InitialAssessmentReviewedBy", fields: [reviewedById], references: [id])
  createdBy               User?                                     @relation("InitialAssessmentCreatedBy", fields: [createdById], references: [id])
  updatedBy               User?                                     @relation("InitialAssessmentUpdatedBy", fields: [updatedById], references: [id])
  answers                 InitialAssessmentAnswer[]
  actions                 InitialAssessmentAction[]
  attachments             InitialAssessmentAttachment[]
  riskRecords             InitialAssessmentRiskRecord[]
  visitPlans              ServiceUserVisitPlan[]
  assessmentCompletions   ServiceUserAssessmentCompletion[]
