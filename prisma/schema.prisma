// ============================================================================
// INCIDENT MANAGEMENT MODULE  (schema: "incidents")
// Phase 1 — Foundation: categories, subtypes, core incident, status/severity
// history, and the race-safe reference-number counter.
// External references (service user, employee, location, user actors) are stored
// as scalar Uuid columns (matching the BodyMap* convention) and validated in the
// service layer, to avoid cross-schema back-relation churn on shared models.
// ============================================================================

enum IncidentStatus {
  REPORTED
  UNDER_REVIEW
  UNDER_INVESTIGATION
  ACTIONS_REQUIRED
  AWAITING_CLOSURE
  CLOSED
  /// Legacy — reopening is now an event (reopenCount / lastReopenedAt); never set on new changes.
  REOPENED

  @@schema("incidents")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("incidents")
}

enum IncidentPrivacyLevel {
  NORMAL
  RESTRICTED
  HIGHLY_CONFIDENTIAL

  @@schema("incidents")
}

/// Configurable event category (Accident, Incident, Near Miss, ...). DB-driven so
/// new categories can be added without code changes.
model IncidentCategory {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  label       String
  description String?
  /// Marks the built-in categories seeded by the platform (protected from deletion).
  isSystem    Boolean @default(false)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subtypes  IncidentSubtype[]
  incidents Incident[]

  @@index([isActive])
  @@index([deletedAt])
  @@schema("incidents")
}

/// Configurable subtype belonging to a category (Slip, Trip, Fall, Missed Dose, ...).
model IncidentSubtype {
  id         String  @id @default(uuid()) @db.Uuid
  categoryId String  @db.Uuid
  key        String
  label      String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category  IncidentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  incidents Incident[]

  @@unique([categoryId, key])
  @@index([categoryId])
  @@index([isActive])
  @@schema("incidents")
}

/// Monotonic per-year counter that backs human reference numbers (INC-2026-000128).
/// Incremented atomically inside the incident-create transaction.
model IncidentNumberSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@schema("incidents")
}

/// A reported accident / incident / near miss. The frontline report is preserved;
/// management data (review, investigation, actions, outcome) is layered on in later
/// phases via related tables.
model Incident {
  id              String @id @default(uuid()) @db.Uuid
  referenceNumber String @unique

  categoryId String  @db.Uuid
  subtypeId  String? @db.Uuid

  status            IncidentStatus       @default(REPORTED)
  severity          IncidentSeverity     @default(LOW)
  privacyLevel      IncidentPrivacyLevel @default(NORMAL)
  shareWithHandover Boolean              @default(false)

  /// When the incident actually occurred (date + time).
  occurredAt DateTime

  /// Reference to lookups.Location (validated in service layer, no cross-schema FK).
  locationId   String? @db.Uuid
  specificArea String?
  /// Where it happened (office raise form dropdown), e.g. HOME_BATHROOM — see INCIDENT_LOCATION_KEYS.
  locationKey    String? @db.VarChar(40)
  /// Free text when locationKey is OTHER. (specificArea holds the carer app's own wording.)
  locationDetail String? @db.VarChar(200)

  /// Reporter (a platform user); optionally the employee they map to.
  reportedById       String? @db.Uuid
  reporterEmployeeId String? @db.Uuid

  /// Primary person affected — a service user OR an employee (or neither for external).
  primaryServiceUserId String?              @db.Uuid
  primaryEmployeeId    String?              @db.Uuid
  /// Kind of primary person affected. For FAMILY/VISITOR/HEALTHCARE_PROFESSIONAL/CONTRACTOR/OTHER
  /// the person is not a platform record, so their name is captured in primaryPersonName.
  primaryPersonKind    IncidentPersonKind?
  primaryPersonName    String?              @db.Text
  /// All kinds of person affected (multi-select). primaryPersonKind holds the first for back-compat.
  affectedPersonKinds  IncidentPersonKind[]
  /// Everyone involved (multi-select), primary person first. Ids only — no cross-schema FKs.
  involvedServiceUserIds String[]           @default([]) @db.Uuid
  involvedEmployeeIds    String[]           @default([]) @db.Uuid
  /// The visit (scheduling.ScheduledJob) this incident was reported during, if any.
  /// Scalar UUID validated in the service layer (no cross-schema FK), like other external refs.
  scheduledJobId       String?              @db.Uuid

  description          String   @default("") @db.Text
  contextBefore        String?  @db.Text
  contextAfter         String?  @db.Text
  immediateActions     String?  @db.Text
  /// Checklist codes for immediate actions taken (FIRST_AID, EMERGENCY_SERVICES, ...).
  immediateActionCodes String[]

  injuryOccurred           Boolean  @default(false)
  /// Carer-supplied free-text injury description (beyond the boolean flag).
  injuryDetails            String?  @db.Text
  /// Carer-supplied free-text describing other people involved.
  peopleInvolved           String?  @db.Text
  /// Carer-supplied free-text about witnesses, kept exactly as written (the office records
  /// structured IncidentWitness rows from it).
  witnessDetails           String?  @db.Text
  /// Carer-app reports made outside a visit: the app's entry id (edits / retries find the row)
  /// and the last write key applied (a retry of the same save is a replay).
  appClientEntryId         String?  @unique
  appLastWriteKey          String?
  /// Hospital outcome at raise — null means "Not known" (e.g. reported by phone).
  ambulanceAttended        Boolean?
  takenToAe                Boolean?
  admittedToHospital       Boolean?
  /// Category-specific answers (shape per category key; see incident-category-details.util.ts).
  categoryDetails          Json?
  /// When a manager started the review (Reported → Under Review).
  reviewStartedAt          DateTime?
  /// Reopen is an event: how many times it was reopened, and when last.
  reopenCount              Int      @default(0)
  lastReopenedAt           DateTime?
  /// Keys of parties the carer informed (office, gp, emergency_999, family_nok, etc.).
  whoInformedKeys          String[]
  /// Whether the carer flagged a safeguarding concern at time of report.
  carerSafeguardingConcern Boolean?
  /// Whether the carer flagged follow-up as required.
  followUpRequired         Boolean  @default(false)
  /// Details about emergency services involvement.
  emergencyServicesDetails String?
  /// Whether the service user's family was informed.
  familyInformed           Boolean  @default(false)
  /// Carer's additional notes captured at time of report.
  carerNotes               String?  @db.Text

  /// Manager who owns the incident once triaged.
  ownerId String? @db.Uuid

  reportedAt DateTime @default(now())

  /// Denormalised latest-closure info (full trail lives in status history + audit).
  closedAt   DateTime?
  closedById String?   @db.Uuid

  /// Soft lifecycle: archived/void instead of hard delete.
  isArchived Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  category        IncidentCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subtype         IncidentSubtype?        @relation(fields: [subtypeId], references: [id], onDelete: SetNull)
  statusHistory   IncidentStatusHistory[]
  severityHistory IncidentSeverityHistory[]
  review          IncidentReview?
  investigation   IncidentInvestigation?
  outcome         IncidentOutcome?
  actions         IncidentAction[]
  carerSuspensions IncidentCarerSuspension[]
  staffActions     IncidentStaffAction[]
  candourRecords   IncidentCandour[]
  externalBodies        IncidentExternalBody[]
  courseRecommendations IncidentCarerCourseRecommendation[]
  injuries        IncidentInjury[]
  witnesses       IncidentWitness[]
  attachments     IncidentAttachment[]
  relatedCareRecords IncidentRelatedCareRecord[]
  relatedFrom        IncidentRelatedIncident[]   @relation("IncidentRelSource")
  relatedTo          IncidentRelatedIncident[]   @relation("IncidentRelTarget")
  corrections        IncidentCorrection[]
  reviewCycles          IncidentReviewCycle[]
  investigationPauses   IncidentInvestigationPause[]
  clarifications     IncidentClarificationNote[]

  @@index([status])
  @@index([severity])
  @@index([privacyLevel])
  @@index([categoryId])
  @@index([subtypeId])
  @@index([primaryServiceUserId])
  @@index([primaryEmployeeId])
  @@index([locationId])
  @@index([ownerId])
  @@index([occurredAt])
  @@index([reportedAt])
  @@index([isArchived])
  @@index([deletedAt])
  @@schema("incidents")
}

/// Append-only workflow-status transitions for an incident.
model IncidentStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  incidentId  String          @db.Uuid
  fromStatus  IncidentStatus?
  toStatus    IncidentStatus
  changedById String?         @db.Uuid
  reason      String?
  createdAt   DateTime        @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@schema("incidents")
}

/// Append-only severity-change history for an incident.
/// A correction to a raised field (manager, with a reason). The original value stays readable here;
/// fields corrected together share a batchId and reason.
model IncidentCorrection {
  id            String   @id @default(uuid()) @db.Uuid
  incidentId    String   @db.Uuid
  batchId       String   @db.Uuid
  /// Incident field key, e.g. occurredAt, categoryId, involvedServiceUserIds.
  fieldKey      String
  fromValue     Json?
  toValue       Json?
  /// Human-readable values at the time (names can change later).
  fromLabel     String?  @db.Text
  toLabel       String?  @db.Text
  reason        String   @db.Text
  correctedById String?  @db.Uuid
  createdAt     DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@schema("incidents")
}

/// The reporter's own account that a clarification note can be added to (the text itself is never edited).
enum IncidentClarificationField {
  DESCRIPTION
  CONTEXT_BEFORE
  CONTEXT_AFTER
  IMMEDIATE_ACTIONS
  PEOPLE_INVOLVED
  EMERGENCY_SERVICES
  WITNESS_DETAILS

  @@schema("incidents")
}

/// Append-only manager note clarifying the reporter's account. Never edited or deleted.
model IncidentClarificationNote {
  id          String                     @id @default(uuid()) @db.Uuid
  incidentId  String                     @db.Uuid
  field       IncidentClarificationField
  note        String                     @db.Text
  createdById String?                    @db.Uuid
  createdAt   DateTime                   @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@schema("incidents")
}

model IncidentSeverityHistory {
  id           String            @id @default(uuid()) @db.Uuid
  incidentId   String            @db.Uuid
  fromSeverity IncidentSeverity?
  toSeverity   IncidentSeverity
  changedById  String?           @db.Uuid
  reason       String?
  createdAt    DateTime          @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@schema("incidents")
}

// --- Phase 3: Manager Review & Investigation --------------------------------

enum IncidentPreventability {
  YES
  NO
  PARTIALLY
  UNKNOWN

  @@schema("incidents")
}

/// Whether the investigation is handled internally or externally.
enum IncidentInvestigationScope {
  INTERNAL
  EXTERNAL

  @@schema("incidents")
}

/// When scope is EXTERNAL — who is leading / involved.
enum IncidentExternalInvestigationType {
  POLICE
  AGENCY
  COMBINED

  @@schema("incidents")
}

/// Manager triage / review — one per incident (upserted). Captures the triage
/// questions used to decide investigation, safeguarding and escalation routing.
model IncidentReview {
  id                           String            @id @default(uuid()) @db.Uuid
  incidentId                   String            @unique @db.Uuid
  confirmedSeverity            IncidentSeverity?
  investigationRequired        Boolean?
  safeguardingConcern          Boolean?
  possibleAbuseOrNeglect       Boolean?
  furtherMedicalAttention      Boolean?
  externalNotificationRequired Boolean?
  escalationRequired           Boolean?
  /// Is anyone at immediate or ongoing risk? Yes needs protectiveAction.
  immediateRisk                Boolean?
  protectiveAction             String?           @db.Text
  managementNotes              String?           @db.Text
  reviewedById                 String?           @db.Uuid
  reviewedAt                   DateTime?
  /// Review decision: INVESTIGATE / NO_INVESTIGATION (null = not decided yet).
  decision                     String?           @db.VarChar(30)
  decisionReason               String?           @db.Text
  decidedAt                    DateTime?
  /// 1 for the first review; each reopen archives the review and starts the next number.
  cycleNumber                  Int               @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@schema("incidents")
}

/// Structured investigation — one per incident (upserted). Contributing factors
/// are stored as codes (multi-select) alongside the narrative fields.
/// A finished review cycle, archived when the incident is reopened. Never changed afterwards.
model IncidentReviewCycle {
  id                           String            @id @default(uuid()) @db.Uuid
  incidentId                   String            @db.Uuid
  cycleNumber                  Int
  confirmedSeverity            IncidentSeverity?
  investigationRequired        Boolean?
  safeguardingConcern          Boolean?
  possibleAbuseOrNeglect       Boolean?
  furtherMedicalAttention      Boolean?
  externalNotificationRequired Boolean?
  escalationRequired           Boolean?
  immediateRisk                Boolean?
  protectiveAction             String?           @db.Text
  managementNotes              String?           @db.Text
  decision                     String?           @db.VarChar(30)
  decisionReason               String?           @db.Text
  decidedAt                    DateTime?
  reviewedById                 String?           @db.Uuid
  reviewedAt                   DateTime?
  lastUpdatedById              String?           @db.Uuid
  lastUpdatedAt                DateTime?
  /// When the incident was reopened (and this cycle archived), by whom and why.
  archivedAt                   DateTime          @default(now())
  archivedById                 String?           @db.Uuid
  reopenReason                 String?           @db.Text

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, cycleNumber])
  @@schema("incidents")
}

/// One pause of an investigation (kept after it is resumed).
model IncidentInvestigationPause {
  id             String    @id @default(uuid()) @db.Uuid
  incidentId     String    @db.Uuid
  reason         String    @db.Text
  pausedAt       DateTime  @default(now())
  pausedById     String?   @db.Uuid
  nextReviewDate DateTime  @db.Date
  resumedAt      DateTime?
  resumedById    String?   @db.Uuid

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, pausedAt])
  @@schema("incidents")
}

model IncidentInvestigation {
  id                  String                  @id @default(uuid()) @db.Uuid
  incidentId          String                  @unique @db.Uuid
  /// Internal vs external investigation.
  investigationScope  IncidentInvestigationScope?
  /// Required when investigationScope is EXTERNAL (Police / Agency / Combined).
  externalType        IncidentExternalInvestigationType?
  whatHappened        String?                 @db.Text
  whyHappened         String?                 @db.Text
  contributingFactors String[]
  /// Per factor: which records it relates to (id + name at the time) and a note,
  /// e.g. { STAFFING: { items: [{ id, label }], note } }.
  contributingFactorDetails Json?
  rootCause           String?                 @db.Text
  preventable         IncidentPreventability?
  conclusion          String?                 @db.Text
  completedAt         DateTime?
  /// Set-up: STANDARD / ENHANCED / COMPREHENSIVE (needed to complete).
  investigationLevel         String?                            @db.VarChar(20)
  /// Staff member (Employee) leading the investigation (separate from the incident owner).
  leadInvestigatorEmployeeId String?                            @db.Uuid
  /// Was the lead investigator directly involved in the incident? NO / YES / NOT_KNOWN.
  investigatorInvolved       String?                            @db.VarChar(20)
  /// Why the investigator is still appropriate when involved = YES.
  investigatorInvolvedReason String?                            @db.Text
  targetDate                 DateTime?                          @db.Date
  termsOfReference           String?                            @db.Text
  /// IN_PROGRESS / PAUSED / COMPLETED (separate from the incident status).
  investigationStatus        String                             @default("IN_PROGRESS") @db.VarChar(20)
  /// Evidence: which kinds of records were reviewed (CARE_PLAN, MAR, ROTA…).
  recordsReviewed            String[]
  /// Per reviewed kind: linked records ({ id, label } as at save time) and a note.
  recordsReviewedDetails     Json?
  /// What was noticed while reviewing records (not the findings).
  evidenceNotes              String?                            @db.Text
  /// Evidence still awaited or unavailable (a note only).
  outstandingEvidence        String?                            @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@schema("incidents")
}

/// Interim suspension of a carer during an incident investigation (kept after it is lifted).
model IncidentCarerSuspension {
  id          String   @id @default(uuid()) @db.Uuid
  incidentId  String   @db.Uuid
  employeeId  String   @db.Uuid
  reason      String   @db.Text
  /// Inclusive suspension window (dates).
  suspendFrom DateTime @db.Date
  suspendTo   DateTime @db.Date
  suspendedAt DateTime @default(now())
  /// SCHEDULED (starts on suspendFrom) / ACTIVE / LIFTED. "Review due" = ACTIVE past suspendTo.
  status         String    @default("ACTIVE") @db.VarChar(20)
  liftedAt       DateTime?
  liftedById     String?   @db.Uuid
  liftReason     String?   @db.Text
  /// Decision at Outcome & close: the suspension continues after the incident (e.g. HR process).
  continuedAt    DateTime?
  continuedById  String?   @db.Uuid
  continueReason String?   @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  /// A carer can be suspended again after a lift (one open suspension at a time, checked in code).
  @@index([incidentId, employeeId])
  @@index([incidentId])
  @@index([employeeId])
  @@index([deletedAt])
  @@schema("incidents")
}

/// Duty of Candour (Regulation 20, SI 2014/2936) for one affected service user on an incident:
/// the decision (with the health professional's opinion), then told in person, written follow-up
/// and results shared — or, under Reg 20(5), the attempts made when the person can't be reached or
/// declines. Rules: incident-candour.util.ts.
model IncidentCandour {
  id            String @id @default(uuid()) @db.Uuid
  incidentId    String @db.Uuid
  serviceUserId String @db.Uuid

  /// YES / NO / NOT_KNOWN / NOT_APPLICABLE
  decision       String    @db.VarChar(20)
  decisionReason String?   @db.Text
  /// Regulation 20(9) harms: DEATH, IMPAIRMENT_28_DAYS, BODY_STRUCTURE_CHANGE, PROLONGED_PAIN,
  /// PROLONGED_PSYCH_HARM, SHORTENED_LIFE, TREATMENT_TO_PREVENT
  harmTypes      String[]  @default([])
  /// "In the reasonable opinion of a health care professional" (may be external: GP, paramedic).
  healthProfessionalName       String?  @db.VarChar(200)
  healthProfessionalRole       String?  @db.VarChar(120)
  healthProfessionalEmployeeId String?  @db.Uuid
  decidedById    String?   @db.Uuid
  decidedAt      DateTime?
  /// When the duty started counting (report date, or the day it changed to Yes from No).
  dutyStartedAt  DateTime?

  /// Step 1 — told in person (Reg 20(2)–(3)).
  toldOn             DateTime? @db.Date
  toldByEmployeeId   String?   @db.Uuid
  /// SERVICE_USER / REPRESENTATIVE
  toldPersonKind     String?   @db.VarChar(20)
  toldPersonName     String?   @db.VarChar(200)
  toldRelationship   String?   @db.VarChar(120)
  factsExplained     Boolean   @default(false)
  enquiriesExplained Boolean   @default(false)
  apologyGiven       Boolean   @default(false)
  supportOffered     String?   @db.Text

  /// Step 2 — written follow-up (Reg 20(4), copy kept under 20(6)).
  writtenSentOn         DateTime? @db.Date
  writtenByEmployeeId   String?   @db.Uuid
  /// POST / EMAIL / HANDED
  writtenMethod         String?   @db.VarChar(20)
  writtenAttachmentId   String?   @db.Uuid

  /// Step 3 — results of the enquiries shared in writing, or no further enquiries (with reason).
  resultsSharedOn           DateTime? @db.Date
  resultsMethod             String?   @db.VarChar(20)
  resultsAttachmentId       String?   @db.Uuid
  noFurtherEnquiriesReason  String?   @db.Text

  /// Reg 20(5): the person can't be contacted or declines to speak — attempts are recorded.
  unableToNotify Boolean @default(false)
  /// DECLINED / NOT_CONTACTABLE / NO_REPRESENTATIVE
  unableReason   String? @db.VarChar(30)
  unableNote     String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  incident Incident                 @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  attempts IncidentCandourAttempt[]

  @@unique([incidentId, serviceUserId])
  @@index([incidentId])
  @@index([decision])
  @@schema("incidents")
}

/// A contact attempt for Duty of Candour (needed when the person can't be reached or declines).
model IncidentCandourAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  candourId         String   @db.Uuid
  attemptedOn       DateTime @db.Date
  /// PHONE / VISIT / LETTER / EMAIL / OTHER
  method            String   @db.VarChar(20)
  byEmployeeId      String?  @db.Uuid
  outcome           String   @db.Text
  createdAt         DateTime @default(now())
  createdById       String?  @db.Uuid

  candour IncidentCandour @relation(fields: [candourId], references: [id], onDelete: Cascade)

  @@index([candourId])
  @@schema("incidents")
}

/// What was decided for a staff member at Outcome & close: no action, a warning, a fine, dismissal
/// or a referral to an HR process. A FINE also creates the salary deduction
/// (billing.EmployeeSalaryDeduction.incidentStaffActionId), kept in step with this row.
model IncidentStaffAction {
  id         String @id @default(uuid()) @db.Uuid
  incidentId String @db.Uuid
  employeeId String @db.Uuid
  /// NO_ACTION / INFORMAL_DISCUSSION / VERBAL_WARNING / WRITTEN_WARNING / FINAL_WRITTEN_WARNING /
  /// FINE / DISMISSAL / HR_PROCESS (incident-staff-action.util.ts)
  actionType String @db.VarChar(40)
  reason     String @db.Text
  /// The day the staff member was told of the decision (null = not told yet).
  staffInformedOn DateTime? @db.Date

  /// FINE only: amount in GBP and the salary month (YYYY-MM) it is deducted from.
  fineAmount      Decimal? @db.Decimal(12, 2)
  fineSalaryMonth String?  @db.VarChar(7)
  /// FINE only: the manager confirmed the contract (or the staff member's written consent) allows
  /// the deduction (Employment Rights Act 1996 s13).
  deductionAllowedConfirmed Boolean @default(false)
  salaryDeductionId         String? @db.Uuid

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedAt    DateTime?
  deletedById  String?   @db.Uuid
  deleteReason String?   @db.Text

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([employeeId])
  @@index([deletedAt])
  @@schema("incidents")
}

/// An outside body involved alongside the internal investigation — local authority safeguarding
/// (Section 42), police, CQC, HSE, coroner, commissioner, etc. Several can be involved at once.
/// REFERRED / IN_PROGRESS are open; closing the incident while one is open needs an audited reason.
model IncidentExternalBody {
  id               String    @id @default(uuid()) @db.Uuid
  incidentId       String    @db.Uuid
  /// LOCAL_AUTHORITY_SAFEGUARDING / POLICE / CQC / HSE / CORONER / COMMISSIONER / OTHER
  bodyType         String    @db.VarChar(40)
  /// e.g. "Leeds City Council", "West Yorkshire Police" (required for OTHER).
  organisationName String?   @db.VarChar(200)
  referredOn       DateTime  @db.Date
  /// Their reference (crime reference, safeguarding case number…).
  referenceNumber  String?   @db.VarChar(100)
  contactName      String?   @db.VarChar(200)
  contactPhone     String?   @db.VarChar(50)
  contactEmail     String?   @db.VarChar(200)
  /// Who leads: LEAD (they lead, we support) / SUPPORTING (joint) / INFORMED (information only).
  role             String    @db.VarChar(20)
  /// REFERRED / IN_PROGRESS / CONCLUDED / NO_FURTHER_ACTION
  status           String    @default("REFERRED") @db.VarChar(30)
  /// Their outcome — required once CONCLUDED or NO_FURTHER_ACTION.
  outcome          String?   @db.Text
  outcomeDate      DateTime? @db.Date
  /// What we gave them (records, statements…) and when.
  informationProvided String? @db.Text
  /// What we got from them (updates, findings, instructions such as "pause your investigation").
  informationReceived String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([status])
  @@schema("incidents")
}

/// Course recommended / assigned to a carer after an incident investigation.
model IncidentCarerCourseRecommendation {
  id                   String   @id @default(uuid()) @db.Uuid
  incidentId           String   @db.Uuid
  employeeId           String   @db.Uuid
  courseId             String   @db.Uuid
  learningAssignmentId String?  @db.Uuid
  reason               String?  @db.Text
  dueAt                DateTime?
  recommendedAt        DateTime @default(now())

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, employeeId, courseId])
  @@index([incidentId])
  @@index([employeeId])
  @@index([courseId])
  @@index([learningAssignmentId])
  @@index([deletedAt])
  @@schema("incidents")
}

// --- Phase 4: Corrective Actions --------------------------------------------

enum IncidentActionPriority {
  LOW
  MEDIUM
  HIGH

  @@schema("incidents")
}

/// Stored action lifecycle. OVERDUE is intentionally NOT stored — it is derived
/// from (status not in COMPLETED/CANCELLED) AND (dueDate < now).
enum IncidentActionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("incidents")
}

/// A corrective / preventive action arising from an incident.
model IncidentAction {
  id          String                 @id @default(uuid()) @db.Uuid
  incidentId  String                 @db.Uuid
  title       String
  description String?                @db.Text
  priority    IncidentActionPriority @default(MEDIUM)
  status      IncidentActionStatus   @default(NOT_STARTED)
  /// Mandatory actions block closure of High/Critical incidents unless overridden.
  isMandatory Boolean                @default(false)
  dueDate     DateTime?

  /// Assigned to an existing employee (validated in the service layer).
  assignedEmployeeId String? @db.Uuid

  completionNotes String?   @db.Text
  completedById   String?   @db.Uuid
  completedAt     DateTime?
  /// What kind of measure (CARE_PLAN_UPDATE, COURSE…); null for measures added before types.
  measureType            String?   @db.VarChar(40)
  /// Records the measure relates to ({ id, label } as at save time) — not copies of the records.
  linkedRecords          Json?
  /// Investigation findings it addresses: ROOT_CAUSE and/or contributing factor codes.
  addresses              String[]
  /// COURSE measures: the course recommendation (learning assignment) created with it.
  courseRecommendationId String?   @db.Uuid
  /// Care plan / risk assessment / policy measures: a new record is needed (none to update yet).
  newRecordNeeded        Boolean   @default(false)
  /// Set on completion: the record(s) actually updated or added ({ id, label } as at completion).
  completedRecords       Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@schema("incidents")
}

// --- Phase 5: Injuries, witnesses, attachments, related links ---------------

enum IncidentInjurySeverity {
  MINOR
  MODERATE
  SERIOUS
  FATAL

  @@schema("incidents")
}

/// Kind of person referenced by an injury / witness (existing entity or external).
enum IncidentPersonKind {
  SERVICE_USER
  EMPLOYEE
  FAMILY
  VISITOR
  HEALTHCARE_PROFESSIONAL
  CONTRACTOR
  OTHER

  @@schema("incidents")
}

enum IncidentRelatedRecordType {
  CARE_PLAN
  RISK_ASSESSMENT
  MEDICATION
  BODY_MAP
  DAILY_NOTES
  VISIT
  BEHAVIOUR
  OTHER

  @@schema("incidents")
}

enum IncidentRelatedRecordStatus {
  REVIEW_REQUIRED
  UPDATED

  @@schema("incidents")
}

enum IncidentAttachmentCategory {
  INCIDENT_PHOTO
  INJURY_PHOTO
  WITNESS_EVIDENCE
  MEDICAL_DOCUMENT
  NOTIFICATION_EVIDENCE
  INVESTIGATION_DOCUMENT
  OTHER

  @@schema("incidents")
}

/// A recorded injury. Person may be an existing service user / employee or an
/// external person (name only). Optionally links to an existing BodyMapRecord.
model IncidentInjury {
  id                  String                 @id @default(uuid()) @db.Uuid
  incidentId          String                 @db.Uuid
  personKind          IncidentPersonKind     @default(SERVICE_USER)
  personServiceUserId String?                @db.Uuid
  personEmployeeId    String?                @db.Uuid
  personName          String?
  injurySeverity      IncidentInjurySeverity @default(MINOR)
  injuryType          String
  bodyRegion          String?
  side                String?
  notes               String?                @db.Text
  measurements        String?
  /// Optional link to an existing body-map record (reuses the body-map module).
  bodyMapRecordId     String?                @db.Uuid

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([personServiceUserId])
  @@schema("incidents")
}

/// A witness and their statement. Statements are never silently overwritten —
/// each is a distinct row.
model IncidentWitness {
  id                  String             @id @default(uuid()) @db.Uuid
  incidentId          String             @db.Uuid
  personKind          IncidentPersonKind @default(OTHER)
  personServiceUserId String?            @db.Uuid
  personEmployeeId    String?            @db.Uuid
  personName          String?
  statement           String?            @db.Text
  statementDate       DateTime?
  addedById           String?            @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@schema("incidents")
}

/// Reference to an existing care record that needs review / has been updated.
/// The care record itself lives in its own module — this only links to it.
model IncidentRelatedCareRecord {
  id             String                      @id @default(uuid()) @db.Uuid
  incidentId     String                      @db.Uuid
  recordType     IncidentRelatedRecordType
  referenceLabel String
  externalId     String?                     @db.Uuid
  status         IncidentRelatedRecordStatus @default(REVIEW_REQUIRED)
  note           String?
  updatedByLabel String?
  resolvedAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@schema("incidents")
}

/// Directed link between two incidents (e.g. repeat falls).
model IncidentRelatedIncident {
  id                String   @id @default(uuid()) @db.Uuid
  incidentId        String   @db.Uuid
  relatedIncidentId String   @db.Uuid
  note              String?
  createdById       String?  @db.Uuid
  createdAt         DateTime @default(now())

  incident        Incident @relation("IncidentRelSource", fields: [incidentId], references: [id], onDelete: Cascade)
  relatedIncident Incident @relation("IncidentRelTarget", fields: [relatedIncidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, relatedIncidentId])
  @@index([incidentId])
  @@index([relatedIncidentId])
  @@schema("incidents")
}

/// Secure attachment. Stored on disk (multer); served only via an authenticated,
/// permission-checked download endpoint (never a public URL).
model IncidentAttachment {
  id           String                     @id @default(uuid()) @db.Uuid
  incidentId   String                     @db.Uuid
  category     IncidentAttachmentCategory @default(OTHER)
  fileName     String
  originalName String
  fileUrl      String
  mimeType     String
  fileSize     Int
  caption      String?
  uploadedById String?                    @db.Uuid

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@schema("incidents")
}

// --- Phase 6: Outcome & lessons learned (closure) ---------------------------

/// Closure record — one per incident (upserted). Captures the outcome, lessons
/// learned and what changed. Preserved across reopen cycles (never destroyed).
model IncidentOutcome {
  id                         String                  @id @default(uuid()) @db.Uuid
  incidentId                 String                  @unique @db.Uuid
  finalOutcome               String?                 @db.Text
  lessonsLearned             String?                 @db.Text
  preventability             IncidentPreventability?
  /// Codes for changes made (CARE_PLAN, RISK_ASSESSMENT, POLICY, ...).
  changesMade                String[]
  /// Per change: which records were changed (id + name at the time) and a note.
  changesMadeDetails         Json?
  informationSharedWithStaff Boolean?
  serviceUserInformed        Boolean?
  nokInformed                Boolean?
  finalManagementComments    String?                 @db.Text
  /// Who the outcome was shared with: one row per person (shared on/how, or why not).
  outcomeSharing             Json?
  /// How the learning reached the team (replaces the old Yes/No).
  learningSharedOn           DateTime?               @db.Date
  learningSharedMethod       String?                 @db.VarChar(30)
  learningSharedNote         String?                 @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@schema("incidents")
}

// ---- Policy Management ----

enum PolicyDocumentType {
  POLICY
  PROCEDURE
  PROTOCOL
  GUIDELINE
  FORM
  TEMPLATE

  @@schema("policies")
}

enum PolicyDocumentSource {
  EDITOR
  UPLOAD
  CATALOGUE

  @@schema("policies")
}

/// Shared by PolicyDocument (denormalised) and PolicyVersion.
enum PolicyStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  SUPERSEDED
  ARCHIVED

  @@schema("policies")
}

enum PolicyLinkModuleType {
  CARE_PLAN
  INITIAL_ASSESSMENT
  RISK_ASSESSMENT
  MEDICATION
  INCIDENT
  SAFEGUARDING
  VISIT
  EMPLOYEE
  HR
  TRAINING
  RECRUITMENT
  AUDIT
  BUSINESS_CONTINUITY
  BRANCH
  EQUIPMENT
  INFECTION_CONTROL

  @@schema("policies")
}

enum PolicyLinkScope {
  MODULE
  FORM_TEMPLATE
  SECTION
  RECORD

  @@schema("policies")
}

enum PolicyAudienceTargetType {
  ALL_EMPLOYEES
  ROLE
  JOB_TITLE
  WORK_AREA
  LOCATION

  @@schema("policies")
}

enum PolicyApprovalKind {
  REVIEW
  APPROVAL

  @@schema("policies")
}

enum PolicyApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED

  @@schema("policies")
}

enum PolicyAcknowledgementStatus {
  PENDING
  VIEWED
  ACKNOWLEDGED

  @@schema("policies")
}

model PolicyCategory {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  code         String
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedById  String?   @db.Uuid

  primaryDocuments PolicyDocument[]     @relation("PolicyDocumentPrimaryCategory")
  categoryLinks    PolicyCategoryLink[]

  @@unique([code])
  @@index([deletedAt])
  @@index([isActive])
  @@index([displayOrder])
  @@schema("policies")
}

model PolicyTag {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  tagLinks PolicyTagLink[]

  @@unique([name])
  @@index([deletedAt])
  @@index([isActive])
  @@schema("policies")
}

model PolicyDocument {
  id                String               @id @default(uuid()) @db.Uuid
  reference         String
  title             String
  description       String?              @db.Text
  documentType      PolicyDocumentType
  source            PolicyDocumentSource @default(EDITOR)
  primaryCategoryId String               @db.Uuid
  parentDocumentId  String?              @db.Uuid
  /// Plain UUID pointer to the current version (no FK — same cycle-avoidance as LearningCourse.currentVersionId).
  currentVersionId  String?              @db.Uuid
  status            PolicyStatus         @default(DRAFT)
  isCatalogue       Boolean              @default(false)
  /// Ready-made (catalogue) policy this one was adopted from, and the library revision its content is based on.
  libraryDocumentId String?              @db.Uuid
  libraryRevision   Int?
  ownerId           String?              @db.Uuid
  reviewerId        String?              @db.Uuid
  approverId        String?              @db.Uuid
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  createdById       String?              @db.Uuid
  updatedById       String?              @db.Uuid
  deletedById       String?              @db.Uuid

  primaryCategory PolicyCategory       @relation("PolicyDocumentPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  parent          PolicyDocument?      @relation("PolicyDocumentParent", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  children        PolicyDocument[]     @relation("PolicyDocumentParent")
  librarySource   PolicyDocument?      @relation("PolicyDocumentLibrarySource", fields: [libraryDocumentId], references: [id], onDelete: SetNull)
  adoptedCopies   PolicyDocument[]     @relation("PolicyDocumentLibrarySource")
  owner           User?                @relation("PolicyDocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewer        User?                @relation("PolicyDocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approver        User?                @relation("PolicyDocumentApprover", fields: [approverId], references: [id], onDelete: SetNull)
  versions        PolicyVersion[]
  categoryLinks   PolicyCategoryLink[]
  tagLinks        PolicyTagLink[]

  @@unique([reference])
  @@index([status])
  @@index([primaryCategoryId])
  @@index([documentType])
  @@index([parentDocumentId])
  @@index([ownerId])
  @@index([reviewerId])
  @@index([approverId])
  @@index([isCatalogue])
  @@index([libraryDocumentId])
  @@index([deletedAt])
  @@schema("policies")
}

model PolicyCategoryLink {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now())

  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  category PolicyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([documentId, categoryId])
  @@index([documentId])
  @@index([categoryId])
  @@schema("policies")
}

model PolicyTagLink {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  tagId      String   @db.Uuid
  createdAt  DateTime @default(now())

  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      PolicyTag      @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
  @@schema("policies")
}

model PolicyVersion {
  id                      String       @id @default(uuid()) @db.Uuid
  documentId              String       @db.Uuid
  versionMajor            Int
  versionMinor            Int
  status                  PolicyStatus @default(DRAFT)
  titleSnapshot           String
  contentJson             Json?
  contentHtml             String?      @db.Text
  changeSummary           String?      @db.Text
  fileName                String?
  mimeType                String?
  fileSize                Int?
  storagePath             String?
  effectiveDate           DateTime?    @db.Date
  reviewDate              DateTime?    @db.Date
  publishedAt             DateTime?
  publishedById           String?      @db.Uuid
  archivedAt              DateTime?
  acknowledgementRequired Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  document         PolicyDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  links            PolicyLink[]
  applicability    PolicyApplicability[]
  audiences        PolicyAudience[]
  approvals        PolicyApproval[]
  acknowledgements PolicyAcknowledgement[]

  @@unique([documentId, versionMajor, versionMinor])
  @@index([documentId])
  @@index([status])
  @@index([reviewDate])
  @@index([publishedAt])
  @@schema("policies")
}

model PolicyApplicability {
  id               String   @id @default(uuid()) @db.Uuid
  versionId        String   @db.Uuid
  organisationWide Boolean  @default(true)
  locationId       String?  @db.Uuid
  /// ServiceUserCareType.code (e.g. DOMICILIARY, RESIDENTIAL, SUPPORTED_LIVING). No FK — code reference only.
  serviceTypeCode  String?
  createdAt        DateTime @default(now())

  version  PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  location Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([locationId])
  @@index([serviceTypeCode])
  @@index([organisationWide])
  @@schema("policies")
}

model PolicyAudience {
  id         String                   @id @default(uuid()) @db.Uuid
  versionId  String                   @db.Uuid
  targetType PolicyAudienceTargetType
  roleId     String?                  @db.Uuid
  jobTitleId String?                  @db.Uuid
  workAreaId String?                  @db.Uuid
  locationId String?                  @db.Uuid
  createdAt  DateTime                 @default(now())

  version  PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  role     Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  jobTitle JobTitle?     @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  workArea WorkArea?     @relation(fields: [workAreaId], references: [id], onDelete: SetNull)
  location Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([targetType])
  @@index([roleId])
  @@index([jobTitleId])
  @@index([workAreaId])
  @@index([locationId])
  @@schema("policies")
}

/// Polymorphic CareFlow link. recordId is a generic UUID — never a multi-table FK.
model PolicyLink {
  id          String               @id @default(uuid()) @db.Uuid
  versionId   String               @db.Uuid
  moduleType  PolicyLinkModuleType
  scope       PolicyLinkScope
  recordId    String?              @db.Uuid
  sectionKey  String?
  label       String?
  createdAt   DateTime             @default(now())
  createdById String?              @db.Uuid

  version PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([moduleType, scope])
  @@index([recordId])
  @@schema("policies")
}

model PolicyApproval {
  id        String                 @id @default(uuid()) @db.Uuid
  versionId String                 @db.Uuid
  kind      PolicyApprovalKind
  decision  PolicyApprovalDecision
  comments  String?                @db.Text
  actorId   String?                @db.Uuid
  decidedAt DateTime               @default(now())
  createdAt DateTime               @default(now())

  version PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  actor   User?         @relation("PolicyApprovalActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([actorId])
  @@index([kind])
  @@index([decidedAt])
  @@schema("policies")
}

/// A staff member's read-and-acknowledge record for one policy version. Belongs to the employee
/// (care workers use the Employee App and have no User row).
model PolicyAcknowledgement {
  id             String                      @id @default(uuid()) @db.Uuid
  versionId      String                      @db.Uuid
  employeeId     String                      @db.Uuid
  /// Web user account that acted, when the action came from the admin web app.
  userId         String?                     @db.Uuid
  status         PolicyAcknowledgementStatus @default(PENDING)
  viewedAt       DateTime?
  acknowledgedAt DateTime?
  /// Channel of the latest action: WEB | EMPLOYEE_APP
  channel        String?                     @db.VarChar(20)
  metadata       Json?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  version  PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([versionId, userId])
  @@unique([versionId, employeeId])
  @@index([versionId])
  @@index([userId])
  @@index([employeeId])
  @@index([status])
  @@schema("policies")
}

// ---------------------------------------------------------------------------
// Surveys — staff-authored questionnaires sent to employees (and, later,
// service users). Mirrors the initial-assessment template/question/answer
// shape. Recipient identity is polymorphic (employeeId / serviceUserId are
// plain UUID columns, no FK) like the incidents primary-person pattern.
// ---------------------------------------------------------------------------

enum SurveyTargetKind {
  EMPLOYEE
  SERVICE_USER
  PUBLIC

  @@schema("surveys")
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED

  @@schema("surveys")
}

enum SurveyQuestionType {
  YES_NO
  SINGLE_SELECT
  MULTI_SELECT
  TEXT
  TEXTAREA
  NUMBER
  RATING
  LIKERT

  @@schema("surveys")
}

enum SurveyRecipientStatus {
  PENDING
  SENT
  STARTED
  COMPLETED
  /// Not answered, and the person can no longer be sent it (src/surveys/survey-eligibility.util.ts).
  LAPSED

  @@schema("surveys")
}

enum SurveyRecurrence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY

  @@schema("surveys")
}

/// How a survey response was collected.
enum SurveyResponseChannel {
  /// Survey link / carer app — answered by the person themselves.
  ONLINE
  /// Service user portal.
  PORTAL
  /// Recorded by staff during a phone call.
  TELEPHONE
  /// Recorded by staff from a paper form.
  PAPER
  /// Recorded by staff face to face.
  IN_PERSON

  @@schema("surveys")
}

/// Who actually answered a service-user survey (the service user or someone on their behalf).
enum SurveyRespondentRelation {
  SELF
  FAMILY_MEMBER
  REPRESENTATIVE
  /// Staff answered on the person's behalf (recorded by office staff).
  STAFF

  @@schema("surveys")
}

model Survey {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  description String?          @db.Text
  targetKind  SurveyTargetKind @default(EMPLOYEE)
  status      SurveyStatus     @default(DRAFT)
  isAnonymous Boolean          @default(false)
  /// Named surveys: each person may choose to answer without their name ("Answer without my name").
  /// Such a response is stored like an anonymous one (no recipient link, day-only times). Always
  /// false on anonymous surveys. See migration 20261209090000_survey_respondent_anonymity.
  allowAnonymousResponses Boolean @default(false)
  opensAt     DateTime?
  closesAt    DateTime?
  publishedAt DateTime?
  locationIds String[]         @default([]) @db.Uuid
  /// Employee job-role (EmployeeRoleLookup) ids to scope an employee survey to. Empty = all roles.
  roleIds     String[]         @default([]) @db.Uuid
  /// Marks this survey as a reusable template (a starting point only — never sent, published or answered).
  isTemplate  Boolean          @default(false)
  /// When to auto-send this survey (scheduled distribution). Never set on templates.
  distributeAt DateTime?
  /// When scheduled distribution actually ran (one-shot only).
  distributedAt DateTime?
  /// When set, each due run copies this survey into a new period survey and sends the copy.
  recurrence  SurveyRecurrence?
  /// Period copy created from a recurring survey.
  clonedFromId String?         @db.Uuid
  /// Period copy: the period it covers ("2026-11", "2026-Q4", "2026-11-05", "2026"). Unique per recurring survey.
  periodKey   String?
  /// Recurring survey: each period copy stays open this many days (null = until the next period starts).
  periodOpenDays Int?
  /// Recurring survey: first scheduled run; later runs count from it (month-end clamped, operational timezone).
  recurrenceAnchorAt DateTime?
  /// Scheduled send: chosen employees (empty = everyone matching locationIds / roleIds).
  audienceEmployeeIds String[] @default([]) @db.Uuid
  /// Scheduled send: chosen people we support (empty = everyone in locationIds).
  audienceServiceUserIds String[] @default([]) @db.Uuid
  /// Scheduled send: the user who scheduled it (acting user for the background run).
  scheduledById String?        @db.Uuid
  /// Scheduled send failed (e.g. no questions, nobody to send to). Not retried until rescheduled.
  distributionFailedAt DateTime?
  distributionError    String?
  /// Public shareable link token — one link for many respondents (PUBLIC surveys only).
  shareToken  String           @unique @default(uuid())
  /// Ready-made survey owned by CareFlow (Surveys → Ready-made surveys). Always isTemplate as well;
  /// never listed, counted, sent, scheduled, opened, recorded, shared or answered.
  isCatalogue Boolean          @default(false)
  /// Survey library reference (e.g. SUR-PWS-001): on the catalogue survey and on templates adopted from it.
  libraryReference String?
  /// Library revision the content is based on (catalogue: current; adopted template: when adopted or last updated).
  libraryRevision  Int?
  /// Adopted template: the ready-made (catalogue) survey it came from. Only ever on templates; a ready-made
  /// survey is adopted at most once as a live template (partial unique index, see migration
  /// 20261208090000_survey_origin_and_safeguards — not expressible in Prisma).
  librarySourceId  String?     @db.Uuid
  /// The template this survey was started from ("Use template"); a duplicate keeps its source's template.
  /// Surveys started from a ready-made template also keep libraryReference / libraryRevision, and their
  /// anonymity is then fixed.
  createdFromTemplateId String? @db.Uuid
  /// Library details: purpose, timing, channels, cqc, estimatedMinutes, privacyNotice, managerGuidance,
  /// relatedPolicies, regulatoryBasis, sections (see prisma/seed-lib/survey-library.ts).
  libraryMeta      Json?
  /// When the alert rules were first set up (library alerts copied in). Null = not yet; set even
  /// when there are none, so deleting every rule is kept. See SurveyAlertRule.
  alertRulesSetUpAt DateTime?
  /// Who it's for, on top of targetKind (SURVEY_AUDIENCE_GROUPS code, e.g. FAMILIES, CARE_WORKERS,
  /// NEW_CLIENTS, SEVERAL). Null = not said.
  audienceGroup      String?
  /// audienceGroup OTHER: the group in the organisation's words.
  audienceGroupOther String?
  /// Staff and service-user surveys: also answerable through one shared link (no person, no
  /// tracking of who answered). PUBLIC surveys always have their shared link.
  sharedLinkEnabled Boolean @default(false)
  /// Shared link: one answer per device. A random marker kept only on the device (never sent with or
  /// stored against the answer) stops a second answer from the same browser. Off by default.
  sharedLinkOncePerDevice Boolean @default(false)
  /// Shared links: a raised limit of answers per 10 minutes for a planned sitting (e.g. 300 at a staff
  /// meeting), until sharedLinkLimitUntil; otherwise the standard limit (src/surveys/survey-link-guard.ts).
  sharedLinkLimit      Int?
  sharedLinkLimitUntil DateTime?
  /// A copy made for each manager (SUR-STF-018): { managerUserIds, pooled, minTeam }. Its team is
  /// checked again at send / open (survey-manager-copy-team.ts). Null on every other survey.
  managerCopy Json?
  /// Section introductions shown under the heading to people answering: { [sectionTitle]: text }.
  sectionIntros    Json?
  /// Shown to people after they submit (the closing screen): thanks, what happens next, where to
  /// get help. Ready-made surveys bring theirs; copies keep it. Null = the standard thank-you only.
  closingMessage   String? @db.Text
  /// Who may see this survey's answers (src/surveys/survey-access.ts): { responses, results }, each
  /// { restricted, ownerKeys, roleIds, userIds }. responses = individual responses and written
  /// answers; results = the figures. Null = the ready-made default, else everyone with survey access.
  /// A repeating survey's periods use their source survey's.
  accessPolicy     Json?
  /// Library roles an alert from this survey must never go to, because the survey rates them
  /// (e.g. CARE_COORDINATOR on a survey about the rota). The alert goes to the next role instead.
  alertNeverRouteTo String[] @default([])
  /// Fewest written-out responses before any question figures, breakdowns or exports show. Null =
  /// the ready-made default, else 5 when answers can be given without a name (never below 5 then).
  reportingThreshold Int?
  /// Reminders and follow-up (src/surveys/survey-contact-plan.util.ts): { reminders: [{ afterDays }],
  /// channels, quietStart, quietEnd, weekdaysOnly, call }. Null = no automatic reminders. A repeating
  /// survey's periods use their source survey's plan.
  contactPlan      Json?
  /// The 4-week contact rule (src/surveys/survey-contact-rule.util.ts): { holdBack, countsAsContact, reason }.
  /// Null = the ready-made default (library timing.contactRule), else both on. Periods use their source's.
  contactRule      Json?
  /// Sampling: { percent } (5–100) of the free people each send or period; null = everyone. Periods use their source's.
  sampling         Json?
  /// Sent when something happens in the care records (src/surveys/survey-event-triggers.util.ts): { event,
  /// delayDays, windowDays, exclusions, options, checkFirst, since, ownerKey }. Null = not sent by events.
  /// Sends go into a month copy (a period, like a repeating survey's) made on demand.
  eventTrigger     Json?
  /// A survey about one person we support (family or GP views on their care); found from their record.
  aboutServiceUserId String?   @db.Uuid
  /// Scoring for scored tools (src/surveys/survey-scoring.util.ts): { scales: [{ key, label, questionKeys, reversed,
  /// method, bands }] }. Null = no scores. A repeating survey's periods use their source survey's.
  scoring          Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdById String?          @db.Uuid
  updatedById String?          @db.Uuid
  deletedById String?          @db.Uuid

  clonedFrom Survey?  @relation("SurveyClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones     Survey[] @relation("SurveyClones")
  librarySource Survey?  @relation("SurveyLibrarySource", fields: [librarySourceId], references: [id], onDelete: SetNull)
  adoptedCopies Survey[] @relation("SurveyLibrarySource")
  createdFromTemplate Survey?  @relation("SurveyTemplateOrigin", fields: [createdFromTemplateId], references: [id], onDelete: SetNull)
  startedFromTemplate Survey[] @relation("SurveyTemplateOrigin")
  questions  SurveyQuestion[]
  recipients SurveyRecipient[]
  responses  SurveyResponse[]
  pendingResponses SurveyPendingResponse[]
  alertRules SurveyAlertRule[]
  alerts     SurveyAlert[]
  shareLinks SurveyShareLink[]
  sharedLinkDays SurveySharedLinkDay[]
  unlinkedAnswerDays SurveyUnlinkedAnswerDay[]
  reviewerGrants SurveyReviewerGrant[]
  reminderRuns   SurveyReminderRun[]
  callAttempts   SurveyCallAttempt[]
  heldBack       SurveyHeldBack[]
  eventOccurrences SurveyEventOccurrence[]
  actions          SurveyAction[]
  discussions      SurveyDiscussion[]
  youSaidWeDid     SurveyYouSaidWeDid[]

  @@unique([clonedFromId, periodKey])
  @@index([targetKind])
  @@index([status])
  @@index([deletedAt])
  @@index([distributeAt])
  @@index([clonedFromId])
  @@index([isCatalogue])
  @@index([librarySourceId])
  @@index([createdFromTemplateId])
  @@index([aboutServiceUserId])
  @@schema("surveys")
}

model SurveyQuestion {
  id           String             @id @default(uuid()) @db.Uuid
  surveyId     String             @db.Uuid
  questionText String             @db.Text
  helpText     String?            @db.Text
  questionType SurveyQuestionType
  options      Json?
  isRequired   Boolean            @default(false)
  sortOrder    Int                @default(0)
  config       Json?
  isActive     Boolean            @default(true)
  /// Period copy: the recurring survey's question this was copied from (results across periods).
  sourceQuestionId String?        @db.Uuid
  /// Heading of the section the question sits in (ready-made surveys); consecutive questions share it.
  sectionTitle String?
  /// Stable reference for this question within its survey (show-if rules point at it). Kept on copies.
  key          String?
  /// SINGLE_SELECT / MULTI_SELECT: an "Other" choice with a text box: { label, textPrompt, textRequired }.
  otherOption  Json?
  /// MULTI_SELECT: options that cannot be combined with any other ("None of these"): string[].
  exclusiveOptions Json?
  /// SINGLE_SELECT / MULTI_SELECT: options come from a CareFlow list (ETHNICITY, SEXUAL_ORIENTATION,
  /// GENDER, SEX, LANGUAGE, MARITAL_STATUS; src/surveys/survey-lookup-options.ts), not `options`.
  optionsFrom  String?

  /// Optional respondent comment box: { prompt, showWhen: string[] | null } (null = always offered).
  commentConfig Json?
  /// Ask only when an earlier question's answer is one of a list: { questionKey, answers: string[] }.
  showIf       Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  // Partial unique (surveyId, key) WHERE deletedAt IS NULL — see migration
  // 20261208090000_survey_origin_and_safeguards (not expressible in Prisma).
  @@index([surveyId])
  @@index([deletedAt])
  @@index([sourceQuestionId])
  @@schema("surveys")
}

model SurveyRecipient {
  id            String                @id @default(uuid()) @db.Uuid
  surveyId      String                @db.Uuid
  targetKind    SurveyTargetKind
  employeeId    String?               @db.Uuid
  serviceUserId String?               @db.Uuid
  status        SurveyRecipientStatus @default(PENDING)
  token         String                @unique
  sentAt        DateTime?
  remindedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  createdById   String?               @db.Uuid
  /// An unlinked answer being submitted (anonymous survey / "answer without my name"): a random
  /// token, no time. Taken before the answer is held, cleared when the survey is marked Completed.
  submitClaim          String?
  /// When an unfinished claim may be taken again: rounded up to a quarter hour, never the exact time.
  submitClaimExpiresAt DateTime?
  /// Reminders sent to this person (never more than 3). remindedAt is the last; day only on anonymous surveys.
  reminderCount        Int @default(0)
  /// The row exists only because an answer was recorded or given (not sent). Never a survey contact on an
  /// anonymous survey (the 4-week rule would otherwise show that the person answered).
  addedByAnswer        Boolean @default(false)
  /// The invitation text waits for the end of quiet hours (the survey job sends it, then clears this).
  invitationTextPending Boolean @default(false)
  /// An outside person (family, professional, commissioner) sent a named public survey with their own link.
  externalContactId    String? @db.Uuid

  survey   Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  response SurveyResponse?
  callAttempts SurveyCallAttempt[]
  externalContact SurveyExternalContact? @relation(fields: [externalContactId], references: [id], onDelete: SetNull)

  @@unique([surveyId, employeeId])
  // Partial unique (surveyId, externalContactId) WHERE externalContactId IS NOT NULL — see migration
  // 20261216130000_survey_outside_people.
  @@index([externalContactId, sentAt])
  // Partial unique (surveyId, serviceUserId) WHERE serviceUserId IS NOT NULL — see migration
  // 20261201090000_survey_templates_anonymity_recurrence (not expressible in Prisma).
  @@index([surveyId])
  @@index([employeeId])
  @@index([serviceUserId])
  @@index([status])
  @@index([employeeId, sentAt])
  @@index([serviceUserId, sentAt])
  @@schema("surveys")
}

model SurveyResponse {
  id            String   @id @default(uuid()) @db.Uuid
  surveyId      String   @db.Uuid
  /// The named recipient who answered. Always null on anonymous surveys and shared-link answers,
  /// so an anonymous answer can never be traced back to a person from the database.
  recipientId   String?  @unique @db.Uuid
  /// Branch / job title of the respondent when they answered (group breakdowns only).
  locationId    String?  @db.Uuid
  jobTitleId    String?  @db.Uuid
  submittedById String?  @db.Uuid
  /// Service-user surveys: who answered (self / family member / representative).
  respondentRelation SurveyRespondentRelation?
  /// Name of the family member / representative when not answered by the service user.
  respondentName     String?
  /// Recorded as given by a family member or representative chosen from People involved (their own survey
  /// contact, decision P10). Never set on an answer not linked to anyone.
  respondentContactId String?  @db.Uuid
  /// How the answers were collected. Staff-recorded channels (telephone / paper / in person) can be corrected.
  channel            SurveyResponseChannel @default(ONLINE)
  /// Office user who recorded the response (staff-recorded channels only).
  recordedById       String?  @db.Uuid
  /// This response is not linked to anyone (even when the survey itself is named).
  isAnonymous        Boolean  @default(false)
  /// Telephone: when the call took place, the number called, call notes and phone consent.
  contactedAt        DateTime?
  contactNumber      String?
  contactNotes       String?  @db.Text
  consentGiven       Boolean?
  /// Alert rules have been checked against this response (set with raw SQL, never moving updatedAt).
  alertsChecked      Boolean  @default(false)
  /// Failed alert checks (the sweep stops retrying after a few and reports it).
  alertCheckFailures Int      @default(0)
  /// Answered through a shared link (not a person's own link).
  viaSharedLink      Boolean  @default(false)
  /// The branch shared link it came through (SurveyShareLink), when one was used.
  shareLinkId        String?  @db.Uuid
  /// Response quality flags (FAST; src/surveys/survey-quality.util.ts). Flagged, never removed. Never a time.
  qualityFlags       String[] @default([])
  submittedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  recipient SurveyRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  answers   SurveyAnswer[]

  @@index([surveyId])
  @@index([recipientId])
  @@index([respondentContactId])
  @@schema("surveys")
}

model SurveyAnswer {
  id              String   @id @default(uuid()) @db.Uuid
  responseId      String   @db.Uuid
  questionId      String   @db.Uuid
  booleanValue    Boolean?
  textValue       String?  @db.Text
  numberValue     Decimal? @db.Decimal(12, 4)
  selectedOptions Json?
  notes           String?  @db.Text
  /// Respondent's text when they chose the question's "Other" option.
  otherText       String?  @db.Text
  /// Respondent's comment alongside their answer (question's comment box).
  comment         String?  @db.Text
  /// Questions whose options come from a CareFlow list: the chosen entries' stable codes (the names
  /// at the time are in selectedOptions), so renaming or retiring an entry never breaks results.
  lookupCodes     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id])

  @@unique([responseId, questionId])
  @@index([responseId])
  @@index([questionId])
  @@schema("surveys")
}

/// A rule that turns answers into work: when a question gets one of the listed answers, a task goes
/// to a role (identity.RoleTask) with the policy timescale, optionally to start a complaint,
/// safeguarding concern, incident or compliment. Ready-made surveys bring their library alerts as
/// rules; organisations change them or add their own. Held on the survey itself (a recurring
/// survey's periods use their source survey's rules). See src/surveys/survey-alerts.service.ts.
model SurveyAlertRule {
  id             String   @id @default(uuid()) @db.Uuid
  surveyId       String   @db.Uuid
  /// Stable within the survey and kept on copies ("library-3" for the library's fourth alert).
  key            String
  position       Int      @default(0)
  /// The task's title, e.g. "Feels unsafe with care workers".
  title          String
  /// When it fires, in words.
  whenText       String   @db.Text
  /// What to do: the task's instructions.
  actionText     String   @db.Text
  /// [{ questionKey, answers: string[] }]: fires when any one of them matches.
  conditions     Json
  /// Library role (SURVEY_ALERT_OWNERS) the task goes to, through the organisation's setting.
  ownerKey       String?
  /// Role chosen for this survey's rule (overrides ownerKey).
  roleId         String?  @db.Uuid
  /// Working days to do it in (0 = the same working day).
  dueWorkingDays Int      @default(0)
  /// Calendar days to do it in instead (a policy's "within 7 days"); wins over dueWorkingDays.
  dueCalendarDays Int?
  /// Tell the role at once (high-priority notification), e.g. safeguarding.
  urgent         Boolean  @default(false)
  /// Record to start from the alert: COMPLAINT, COMPLIMENT, SAFEGUARDING or INCIDENT.
  recordKind     String?
  /// "Would you like someone to contact you" answered Yes: goes on the contact-me follow-up list.
  contactRequest Boolean  @default(false)
  isActive       Boolean  @default(true)
  /// Ready-made surveys: the library alert this came from (its index in managerGuidance.alerts).
  libraryAlert   Int?
  /// Answers linked to no one: raise only if at least this many answered (above the survey's
  /// reporting threshold), e.g. 10 for abuse, harassment and equality. Null = the threshold.
  minimumAnswers Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  survey Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  alerts SurveyAlert[]

  @@unique([surveyId, key])
  @@index([surveyId])
  @@schema("surveys")
}

/// An alert raised by a rule: the work (a RoleTask for the role, whose status is the alert's
/// status), who owns it, the outcome and any complaint / safeguarding / incident started from it.
/// Answers linked to no one (anonymous surveys, "answer without my name") raise grouped alerts only
/// once they are written out in shuffled batches: no response, person, branch (unless the survey has
/// one branch), written answer or time of day, and createdAt is the day only.
model SurveyAlert {
  id               String    @id @default(uuid()) @db.Uuid
  /// The survey (or period) that was answered.
  surveyId         String    @db.Uuid
  ruleId           String?   @db.Uuid
  /// The named response. Always null for answers linked to no one.
  responseId       String?   @db.Uuid
  /// Raised from answers linked to no one (grouped; never names anyone).
  unlinked         Boolean   @default(false)
  /// How many answers matched (named: 1).
  matchCount       Int       @default(1)
  /// [{ question, answers: string[], count }]
  matched          Json
  title            String
  details          String    @db.Text
  /// Contact-me follow-up (the person asked to be contacted).
  contactRequest   Boolean   @default(false)
  /// The person it is about (named service-user / staff answers only).
  serviceUserId    String?   @db.Uuid
  employeeId       String?   @db.Uuid
  locationId       String?   @db.Uuid
  roleId           String?   @db.Uuid
  /// The task (identity.RoleTask); null when no role could be found yet.
  roleTaskId       String?   @unique @db.Uuid
  /// The person in the role who is doing it.
  ownerUserId      String?   @db.Uuid
  dueDate          DateTime  @db.Date
  urgent           Boolean   @default(false)
  /// What happened: CONTACTED, NOT_REACHED, NO_LONGER_NEEDED, ACTIONED.
  outcomeKind      String?
  outcome          String?   @db.Text
  recordKind       String?
  /// The record started from it: COMPLAINT / COMPLIMENT (FeedbackRecord), SAFEGUARDING, INCIDENT.
  linkedRecordType String?
  linkedRecordId   String?   @db.Uuid
  /// Answers linked to no one: the day only.
  createdAt        DateTime
  updatedAt        DateTime  @updatedAt
  updatedById      String?   @db.Uuid

  survey Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  rule   SurveyAlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([ruleId, responseId])
  @@index([surveyId])
  @@index([contactRequest])
  @@index([dueDate])
  @@schema("surveys")
}

/// The organisation's role for each library alert owner (e.g. SAFEGUARDING_LEAD → "Registered Manager").
model SurveyAlertOwnerRole {
  ownerKey    String   @id
  roleId      String   @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@schema("surveys")
}

/// A further shared link for a survey (one per branch, so answers carry the branch). The survey's
/// own shareToken stays its main link. Turned off (revokedAt) when replaced or no longer wanted.
model SurveyShareLink {
  id          String    @id @default(uuid()) @db.Uuid
  surveyId    String    @db.Uuid
  token       String    @unique
  locationId  String?   @db.Uuid
  label       String?
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  revokedAt   DateTime?
  revokedById String?   @db.Uuid

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@schema("surveys")
}

/// How many answers arrived through a survey's shared links on each day (counts by day only, nothing
/// else), so Results can warn when they arrive in an unusual burst (possible ballot-stuffing).
/// Shared-link form tokens already used (survey-link-guard.ts): the token's random part and when it
/// expires, nothing else (no IP, device or survey). Shared by every API server; expired rows are
/// cleared by the guard.
model SurveyLinkFormToken {
  nonce     String   @id
  expiresAt DateTime

  @@index([expiresAt])
  @@schema("surveys")
}

/// Answers through each shared link per minute (survey-link-guard.ts), for the per-link limit across
/// API servers: a hash of the link, the minute and a count, nothing about who answered. Rows older
/// than the window are cleared by the guard.
model SurveyLinkRate {
  linkHash String
  minute   DateTime
  answers  Int      @default(0)

  @@id([linkHash, minute])
  @@index([minute])
  @@schema("surveys")
}

model SurveySharedLinkDay {
  surveyId String   @db.Uuid
  /// The operational day (date only).
  day      DateTime @db.Date
  answers  Int      @default(0)

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@id([surveyId, day])
  @@schema("surveys")
}

/// Answers not linked to anyone, counted per survey per day (date only). They get no audit row
/// each (an exact time would date each answer); the day's count is audited once the day is over.
model SurveyUnlinkedAnswerDay {
  surveyId         String    @db.Uuid
  /// The operational day (date only).
  day              DateTime  @db.Date
  answers          Int       @default(0)
  /// Of those, recorded by staff or an independent reviewer.
  recorded         Int       @default(0)
  /// Of those, recorded by an independent reviewer.
  reviewerRecorded Int       @default(0)
  /// When the day's count was written to the audit log (null until the day is over).
  auditedAt        DateTime?

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@id([surveyId, day])
  @@index([auditedAt, day])
  @@schema("surveys")
}

/// An answer not linked to anyone (anonymous survey, or "Answer without my name") waiting to be
/// written as a SurveyResponse. The person's survey is marked Completed in its own transaction; the
/// response is written later by the survey job, in shuffled batches (or when the survey / period
/// closes), so the database never ties the two together (same transaction, row order or time).
/// Holds no recipient, person, token or IP. See src/surveys/survey-pending-responses.ts and
/// migration 20261210090000_survey_pending_unlinked_responses.
/// One reminder run on a survey: how many people were reminded and by which channel. Counts only,
/// never who. Anonymous surveys: createdAt is the day only. See src/surveys/survey-reminders.service.ts.
model SurveyReminderRun {
  id        String   @id @default(uuid()) @db.Uuid
  surveyId  String   @db.Uuid
  /// Contact plan step (1-based); null for "Remind now".
  step      Int?
  manual    Boolean  @default(false)
  sentById  String?  @db.Uuid
  people    Int      @default(0)
  email     Int      @default(0)
  app       Int      @default(0)
  portal    Int      @default(0)
  text      Int      @default(0)
  /// Not reminded: no way to reach them (no email, app, portal or mobile number).
  noContact Int      @default(0)
  /// Not reminded: they asked not to be contacted about surveys.
  optedOut  Int      @default(0)
  createdAt DateTime

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@schema("surveys")
}

/// A phone call to someone who has not answered a named survey (the call list). Never on anonymous
/// surveys. outcome: NO_ANSWER, LEFT_MESSAGE, CALL_BACK, DECLINED, WRONG_NUMBER, ANSWERED.
model SurveyCallAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  surveyId    String   @db.Uuid
  recipientId String   @db.Uuid
  outcome     String
  notes       String?  @db.Text
  calledById  String?  @db.Uuid
  createdAt   DateTime @default(now())

  survey    Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  recipient SurveyRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([recipientId])
  @@schema("surveys")
}

/// Someone who does not want survey invitations or reminders, on every channel (ALL) or one (EMAIL,
/// TEXT, APP, PORTAL, PHONE). subjectKind: EMPLOYEE, SERVICE_USER, CONTACT, EXTERNAL.
/// Someone held back from a survey by the 4-week contact rule (src/surveys/survey-contact-rule.service.ts).
/// status: HELD (waiting for freeFrom) | SENT (sent on their free day) | OVERRIDDEN (sent anyway, with a reason)
/// | LAPSED (the survey closed first). Days only. Partial uniques per person per survey: see migration
/// 20261216100000_survey_contact_rule.
model SurveyHeldBack {
  id             String    @id @default(uuid()) @db.Uuid
  surveyId       String    @db.Uuid
  employeeId     String?   @db.Uuid
  serviceUserId  String?   @db.Uuid
  lastContactOn  DateTime
  freeFrom       DateTime
  status         String    @default("HELD")
  overrideReason String?
  resolvedById   String?   @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([status, freeFrom])
  @@schema("surveys")
}

/// An action raised from survey results (Phase 2 part 6): a question's figure, a theme, an alert, a team discussion
/// or general. The work is a RoleTask (sourceType SURVEY_ACTION) for the owner role; DONE actions with youSaid /
/// weDid feed CQC evidence. source QUESTION | THEME | ALERT | DISCUSSION | GENERAL; status OPEN | IN_PROGRESS |
/// DONE | CANCELLED. sourceLabel is the figure as shown when raised, never answer text.
model SurveyAction {
  id            String    @id @default(uuid()) @db.Uuid
  surveyId      String    @db.Uuid
  periodId      String?   @db.Uuid
  source        String    @default("GENERAL")
  sourceKey     String?
  sourceLabel   String?
  discussionId  String?   @db.Uuid
  title         String
  detail        String?
  ownerRoleId   String    @db.Uuid
  ownerUserId   String?   @db.Uuid
  roleTaskId    String?   @unique @db.Uuid
  dueOn         DateTime  @db.Date
  status        String    @default("OPEN")
  outcome       String?
  youSaid       String?
  weDid         String?
  evidenceNote  String?
  locationIds   String[]  @default([]) @db.Uuid
  completedAt   DateTime?
  completedById String?   @db.Uuid
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([status, dueOn])
  @@schema("surveys")
}

/// When survey results were discussed with a team and what was agreed (Phase 2 part 6). kind TEAM_MEETING |
/// STAFF_FORUM | SUPERVISION_GROUP | MANAGEMENT_MEETING | CLIENT_OR_FAMILY_MEETING | OTHER.
model SurveyDiscussion {
  id           String   @id @default(uuid()) @db.Uuid
  surveyId     String   @db.Uuid
  periodId     String?  @db.Uuid
  heldOn       DateTime @db.Date
  kind         String
  attendees    Int?
  summary      String
  agreed       String?
  locationIds  String[] @default([]) @db.Uuid
  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@schema("surveys")
}

/// "You said, we did" (Phase 2 part 6): published to the portal, the carer app, a printable letter and / or a public
/// page. items [{ youSaid, weDid, actionId }]; headline = the overall figure as shown when published, else null.
/// channels PORTAL | APP | LETTER | PUBLIC; status DRAFT | PUBLISHED | WITHDRAWN; audience = the survey's targetKind.
model SurveyYouSaidWeDid {
  id            String    @id @default(uuid()) @db.Uuid
  surveyId      String    @db.Uuid
  periodId      String?   @db.Uuid
  title         String
  intro         String?
  items         Json
  headline      Json?
  channels      String[]  @default([])
  status        String    @default("DRAFT")
  publicToken   String?   @unique
  locationIds   String[]  @default([]) @db.Uuid
  audience      String
  publishedAt   DateTime?
  publishedById String?   @db.Uuid
  withdrawnAt   DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([status])
  @@schema("surveys")
}

/// An outside person a survey can go to (Phase 2 part 4): typed in once, or from a record CareFlow keeps
/// (People involved, a funder, a pathway professional; read again at each send). The real person for the
/// 4-week rule. kind FAMILY | PROFESSIONAL | COMMISSIONER | OTHER; sourceType TYPED | SERVICE_USER_CONTACT |
/// FUNDER | PATHWAY_PROFESSIONAL. Partial unique (sourceType, sourceId) — see migration 20261216130000.
model SurveyExternalContact {
  id            String    @id @default(uuid()) @db.Uuid
  kind          String
  name          String
  organisation  String?
  role          String?
  email         String?
  mobile        String?
  phone         String?
  sourceType    String    @default("TYPED")
  sourceId      String?   @db.Uuid
  /// FAMILY: the person we support they are family or a representative of.
  serviceUserId String?   @db.Uuid
  locationIds   String[]  @default([]) @db.Uuid
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?

  recipients SurveyRecipient[]
  lists      SurveyContactListMember[]

  @@index([kind])
  @@index([serviceUserId])
  @@index([deletedAt])
  @@schema("surveys")
}

/// A reusable list of outside people (e.g. "GP practices").
model SurveyContactList {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  locationIds String[]  @default([]) @db.Uuid
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  members SurveyContactListMember[]

  @@schema("surveys")
}

model SurveyContactListMember {
  listId    String   @db.Uuid
  contactId String   @db.Uuid
  createdAt DateTime @default(now())

  list    SurveyContactList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact SurveyExternalContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
  @@schema("surveys")
}

/// One event from the care records acted on for a survey with an event trigger (Phase 2 part 3): who, the
/// event day and the due days (days only), and what became of it. Never answers, completion or times.
/// status WAITING | DUE | BATCH | SENT | HELD | SKIPPED | CANCELLED | EXPIRED | OFFERED.
model SurveyEventOccurrence {
  id            String    @id @default(uuid()) @db.Uuid
  surveyId      String    @db.Uuid
  event         String
  /// The record that raised it (and the person), so each event is acted on once per survey.
  sourceKey     String
  employeeId    String?   @db.Uuid
  serviceUserId String?   @db.Uuid
  eventOn       DateTime
  dueOn         DateTime
  lastDay       DateTime
  status        String    @default("WAITING")
  /// Why it was skipped, cancelled or not sent (a code, or the user's words).
  reason        String?
  /// The month copy it was sent in.
  sentSurveyId  String?   @db.Uuid
  resolvedById  String?   @db.Uuid
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, event, sourceKey])
  @@index([status, dueOn])
  @@index([serviceUserId])
  @@index([employeeId])
  @@schema("surveys")
}

model SurveyContactOptOut {
  id           String   @id @default(uuid()) @db.Uuid
  subjectKind  String
  subjectId    String   @db.Uuid
  channel      String   @default("ALL")
  reason       String?
  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  @@unique([subjectKind, subjectId, channel])
  @@schema("surveys")
}

/// "Unsubscribe from all surveys" link (former people): an opaque random token per message, kept only as its
/// SHA-256 hash with the person it stands for (subjectKind EMPLOYEE | SERVICE_USER | EXTERNAL | CONTACT).
model SurveyUnsubscribeToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  subjectKind String
  subjectId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  @@index([subjectKind, subjectId])
  @@schema("surveys")
}

/// An independent reviewer's permission to record answers on ONE survey (SUR-CQC-001/002): a
/// temporary login (employees.TemporaryInspector), for a time window inside the login's own, and
/// only for the people chosen as the sample (none = anonymous recording only, on anonymous surveys).
/// Never results, other answers, counts or other people. Granting, revoking and every answer recorded
/// are audited. See src/surveys/survey-reviewers.service.ts.
model SurveyReviewerGrant {
  id          String    @id @default(uuid()) @db.Uuid
  surveyId    String    @db.Uuid
  /// The reviewer's user account (only role "Independent reviewer", no branch).
  userId      String    @db.Uuid
  /// The sample: people we support (or staff) the reviewer may record for. Empty = anonymous only.
  personIds   String[]  @default([]) @db.Uuid
  validFrom   DateTime
  validTo     DateTime
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  revokedAt   DateTime?
  revokedById String?   @db.Uuid

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user   User   @relation("SurveyReviewerGrantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([userId])
  @@schema("surveys")
}

model SurveyPendingResponse {
  id          String                @id @default(uuid()) @db.Uuid
  surveyId    String                @db.Uuid
  /// SurveyResponse.isAnonymous of the response it becomes (true = answered without a name).
  isAnonymous Boolean               @default(false)
  channel     SurveyResponseChannel @default(ONLINE)
  /// The response's branch, who answered (anonymous surveys only) and its answers.
  payload     Json
  /// The day only (start of the operational day), like the response it becomes. No exact time.
  createdAt   DateTime

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@schema("surveys")
}

// ─── Azure Pricing (platform costs) ─────────────────────────────────────────────
// Platform-operations data about the Careflow Azure subscription itself (not care data),
// kept in its own `platform` schema. Read-only mirror of Azure Cost Management / Retail
// Prices / Consumption budgets / Advisor; money in Decimal (major units of `currency`).

/// One row per usage day × resource group × service × resource × meter category (ActualCost).
model AzureCostDaily {
  id            String   @id @default(uuid()) @db.Uuid
  date          DateTime @db.Date
  /// Lower-cased resource group name.
  resourceGroup String
  serviceName   String
  /// Lower-cased ARM resource id ('' when Azure reports none).
  resourceId    String
  meterCategory String
  cost          Decimal  @db.Decimal(18, 6)
  currency      String   @default("GBP")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, resourceGroup, serviceName, resourceId, meterCategory])
  @@index([date])
  @@index([serviceName, date])
  @@schema("platform")
}

/// Azure Retail Prices catalogue (public list prices) for the services Careflow uses.
model AzureRetailPrice {
  id                   String    @id @default(uuid()) @db.Uuid
  /// meterId|skuId|type|armRegionName|tierMinimumUnits|currency
  priceKey             String    @unique
  meterId              String
  skuId                String?
  serviceName          String
  serviceFamily        String?
  productName          String
  skuName              String
  armSkuName           String?
  meterName            String
  unitOfMeasure        String
  unitPrice            Decimal   @db.Decimal(20, 10)
  retailPrice          Decimal   @db.Decimal(20, 10)
  tierMinimumUnits     Decimal   @default(0) @db.Decimal(20, 4)
  currency             String
  armRegionName        String
  location             String?
  type                 String
  isPrimaryMeterRegion Boolean?
  effectiveStartDate   DateTime?
  refreshedAt          DateTime  @default(now())

  @@index([serviceName])
  @@index([currency, armRegionName])
  @@schema("platform")
}

/// Consumption budget snapshot (no notification contact e-mails are stored).
model AzureBudgetSnapshot {
  id            String    @id @default(uuid()) @db.Uuid
  budgetId      String
  name          String
  amount        Decimal   @db.Decimal(18, 2)
  timeGrain     String
  currentSpend  Decimal   @db.Decimal(18, 6)
  forecastSpend Decimal?  @db.Decimal(18, 6)
  currency      String
  /// [{ percent, type: 'Actual' | 'Forecasted', enabled }]
  thresholds    Json
  periodStart   DateTime? @db.Date
  periodEnd     DateTime? @db.Date
  capturedAt    DateTime  @default(now())

  @@index([capturedAt])
  @@index([name, capturedAt])
  @@schema("platform")
}

/// Month-end forecast snapshot (Azure forecast, or linear fallback when Azure has too little history).
model AzureForecastSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  /// YYYY-MM (UTC billing month)
  month         String
  actualToDate  Decimal  @db.Decimal(18, 6)
  forecastTotal Decimal  @db.Decimal(18, 6)
  /// 'azure' | 'linear'
  source        String
  currency      String
  capturedAt    DateTime @default(now())

  @@index([month, capturedAt])
  @@schema("platform")
}

/// Azure Advisor cost recommendation (replaced on every advisor refresh).
model AzureAdvisorRecommendation {
  id               String   @id @default(uuid()) @db.Uuid
  recommendationId String   @unique
  impact           String
  problem          String
  solution         String
  resourceId       String?
  resourceName     String?
  annualSavings    Decimal? @db.Decimal(18, 2)
  currency         String?
  refreshedAt      DateTime @default(now())

  @@schema("platform")
}

/// Daily cost spike (one per usage date).
model AzureCostAnomaly {
  id               String    @id @default(uuid()) @db.Uuid
  date             DateTime  @unique @db.Date
  cost             Decimal   @db.Decimal(18, 6)
  baseline         Decimal   @db.Decimal(18, 6)
  increasePercent  Decimal   @db.Decimal(12, 2)
  topDriver        String?
  /// 'open' | 'acknowledged'
  status           String    @default("open")
  acknowledgedAt   DateTime?
  acknowledgedById String?   @db.Uuid
  notifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, date])
  @@schema("platform")
}

/// Audit trail of every Azure sync (scheduled or manual); also backs the manual-sync rate limit.
model AzureSyncRun {
  id            String    @id @default(uuid()) @db.Uuid
  /// 'costs' | 'prices' | 'budgets' | 'forecast' | 'advisor'
  kind          String
  /// 'schedule' | 'manual'
  trigger       String
  /// 'running' | 'success' | 'failed'
  status        String    @default("running")
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  rowsUpserted  Int       @default(0)
  error         String?
  triggeredById String?   @db.Uuid

  @@index([startedAt])
  @@index([kind, status, startedAt])
  @@index([trigger, startedAt])
  @@schema("platform")
}

/// Singleton (id = 'default') — anomaly rule + monthly report settings.
model PlatformCostSettings {
  id                      String   @id @default("default")
  anomalyThresholdPercent Int      @default(50)
  anomalyMinDailyIncrease Decimal  @default(1) @db.Decimal(12, 2)
  monthlyReportEnabled    Boolean  @default(true)
  monthlyReportRecipients String[] @default([])
  /// YYYY-MM of the last period whose scheduled monthly report was sent (idempotency).
  lastMonthlyReportPeriod String?
  updatedById             String?  @db.Uuid
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@schema("platform")
}

/// Scheduled job run history (System jobs). One row per job per period: the
/// (jobName, periodKey) unique constraint makes every scheduled period run exactly once,
/// whichever trigger (in-process @Cron, Azure Function, Container Apps Job, manual) gets there first.
model JobRun {
  id            String    @id @default(uuid()) @db.Uuid
  /// Canonical job name from the catalogue (src/jobs/job-catalogue.ts), e.g. 'rolling-rota'
  jobName       String
  /// Minute/hour bucket ('2026-10-02T10:05Z'), date ('2026-10-02') or 'manual:<ISO minute>'
  periodKey     String
  /// 'internal' | 'function' | 'container-job' | 'manual'
  source        String
  /// 'running' | 'success' | 'failed' | 'skipped'
  status        String    @default("running")
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  summary       Json?
  error         String?
  triggeredById String?   @db.Uuid
  /// 1 for the first run of a period; +1 each time a failed/stale run of the same period is retried
  attempt       Int       @default(1)

  @@unique([jobName, periodKey])
  @@index([jobName, startedAt(sort: Desc)])
  @@index([status])
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// Complaints & compliments (Accident & Incident → Complaints & Compliments)
// ---------------------------------------------------------------------------

enum FeedbackType {
  COMPLAINT
  COMPLIMENT

  @@schema("incidents")
}

/// Complaint: RECEIVED → ACKNOWLEDGED → INVESTIGATING → RESPONDED → CLOSED. Compliment: RECEIVED → CLOSED (shared).
enum FeedbackStatus {
  RECEIVED
  ACKNOWLEDGED
  INVESTIGATING
  RESPONDED
  CLOSED

  @@schema("incidents")
}

/// Who the complaint / compliment came from.
enum FeedbackFromKind {
  SERVICE_USER
  FAMILY
  PROFESSIONAL
  STAFF
  PUBLIC
  ANONYMOUS

  @@schema("incidents")
}

enum FeedbackChannel {
  PHONE
  EMAIL
  LETTER
  IN_PERSON
  PORTAL
  SURVEY
  OTHER

  @@schema("incidents")
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH

  @@schema("incidents")
}

enum ComplaintOutcome {
  UPHELD
  PARTIALLY_UPHELD
  NOT_UPHELD
  WITHDRAWN

  @@schema("incidents")
}

/// One complaint or compliment. People are scalar ids (no cross-schema FKs), validated in the service.
model FeedbackRecord {
  id              String         @id @default(uuid()) @db.Uuid
  /// CMP-2026-0001 / CPL-2026-0001
  referenceNumber String         @unique
  type            FeedbackType
  status          FeedbackStatus @default(RECEIVED)

  receivedAt   DateTime
  channel      FeedbackChannel  @default(PHONE)
  fromKind     FeedbackFromKind
  /// Name of the person (blank when anonymous).
  fromName     String?
  /// Phone / email / address to reply to.
  fromContact  String?
  fromServiceUserId String? @db.Uuid
  fromEmployeeId    String? @db.Uuid

  /// Who it is about.
  aboutServiceUserId String?  @db.Uuid
  aboutEmployeeIds   String[] @default([]) @db.Uuid
  /// Branch (lookups.Location) — from the service user when known.
  locationId         String?  @db.Uuid

  subject        String
  details        String             @db.Text
  /// Complaint area, e.g. Care quality, Missed / late visit, Staff conduct.
  category       String?
  severity       ComplaintSeverity?
  /// What the complainant would like to happen.
  desiredOutcome String?            @db.Text

  /// Employee handling the complaint (investigating manager).
  handlerEmployeeId  String?   @db.Uuid
  acknowledgeDueAt   DateTime?
  acknowledgedAt     DateTime?
  responseDueAt      DateTime?
  investigationNotes String?   @db.Text
  respondedAt        DateTime?
  responseSummary    String?   @db.Text
  outcome            ComplaintOutcome?
  lessonsLearned     String?   @db.Text
  closedAt           DateTime?
  /// Compliment passed on to the staff it was about.
  sharedWithStaffAt  DateTime?

  recordedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?   @db.Uuid

  events              FeedbackEvent[]
  investigation       FeedbackInvestigation?
  investigationPauses FeedbackInvestigationPause[]

  @@index([type, status])
  @@index([receivedAt])
  @@index([aboutServiceUserId])
  @@index([locationId])
  @@index([deletedAt])
  @@schema("incidents")
}

/// Timeline: status changes and notes on a complaint / compliment.
model FeedbackEvent {
  id         String   @id @default(uuid()) @db.Uuid
  feedbackId String   @db.Uuid
  /// RECORDED, ACKNOWLEDGED, INVESTIGATION_STARTED, RESPONDED, CLOSED, REOPENED, SHARED, NOTE, UPDATED
  action     String
  note       String?  @db.Text
  userId     String?  @db.Uuid
  createdAt  DateTime @default(now())

  feedback FeedbackRecord @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
  @@schema("incidents")
}

/// Investigation of a complaint: the same set-up, findings and evidence as an incident investigation
/// (shared rules in incidents/investigation-core.service), without the incident-only scope fields.
model FeedbackInvestigation {
  id                         String                  @id @default(uuid()) @db.Uuid
  feedbackId                 String                  @unique @db.Uuid
  whatHappened               String?                 @db.Text
  whyHappened                String?                 @db.Text
  contributingFactors        String[]
  contributingFactorDetails  Json?
  rootCause                  String?                 @db.Text
  preventable                IncidentPreventability?
  conclusion                 String?                 @db.Text
  completedAt                DateTime?
  investigationLevel         String?                 @db.VarChar(20)
  leadInvestigatorEmployeeId String?                 @db.Uuid
  investigatorInvolved       String?                 @db.VarChar(20)
  investigatorInvolvedReason String?                 @db.Text
  targetDate                 DateTime?               @db.Date
  termsOfReference           String?                 @db.Text
  /// IN_PROGRESS / PAUSED / COMPLETED (separate from the complaint status).
  investigationStatus        String                  @default("IN_PROGRESS") @db.VarChar(20)
  recordsReviewed            String[]
  recordsReviewedDetails     Json?
  evidenceNotes              String?                 @db.Text
  outstandingEvidence        String?                 @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  feedback FeedbackRecord @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@schema("incidents")
}

/// Pauses of a complaint investigation (kept after resuming).
model FeedbackInvestigationPause {
  id             String    @id @default(uuid()) @db.Uuid
  feedbackId     String    @db.Uuid
  reason         String    @db.Text
  pausedAt       DateTime  @default(now())
  pausedById     String?   @db.Uuid
  nextReviewDate DateTime  @db.Date
  resumedAt      DateTime?
  resumedById    String?   @db.Uuid

  feedback FeedbackRecord @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, pausedAt])
  @@schema("incidents")
}

/// Per type + year counter for reference numbers.
model FeedbackNumberSequence {
  type      FeedbackType
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([type, year])
  @@schema("incidents")
}

// ---------------------------------------------------------------------------
// Referrals & private care quotations (Service User → Referral & Quotes)
// People / branch / funding refs are scalar ids validated in the service, like other modules.
// ---------------------------------------------------------------------------

enum ReferralSourceType {
  LOCAL_AUTHORITY
  NHS
  HOSPITAL
  SOCIAL_WORKER
  GP
  PRIVATE
  FAMILY
  SELF_REFERRAL
  OTHER

  @@schema("service_users")
}

enum ReferralReceivedVia {
  EMAIL
  PHONE
  PORTAL
  IN_PERSON
  LETTER
  OTHER

  @@schema("service_users")
}

enum ReferralPriority {
  ROUTINE
  URGENT
  EMERGENCY

  @@schema("service_users")
}

/// NEW → UNDER_REVIEW → ASSESSMENT_BOOKED → ACCEPTED / DECLINED; ON_HOLD and WITHDRAWN at any open stage.
enum ReferralStatus {
  NEW
  UNDER_REVIEW
  ASSESSMENT_BOOKED
  ON_HOLD
  ACCEPTED
  DECLINED
  WITHDRAWN

  @@schema("service_users")
}

/// One referral for a service user (a person can be re-referred later).
model ServiceUserReferral {
  id              String         @id @default(uuid()) @db.Uuid
  /// REF-2026-0001
  referenceNumber String         @unique
  serviceUserId   String         @db.Uuid
  status          ReferralStatus @default(NEW)
  priority        ReferralPriority @default(ROUTINE)

  sourceType            ReferralSourceType
  /// Referring organisation (council, trust, hospital ward, GP practice…). Not the payer.
  referringOrganisation String?
  referrerName          String?
  referrerRole          String?
  referrerPhone         String?
  referrerEmail         String?

  /// When the referral was made (date/time on the referral).
  referralDate        DateTime?
  /// When it actually reached us.
  receivedAt          DateTime
  receivedVia         ReferralReceivedVia @default(EMAIL)
  receivedByEmployeeId String?            @db.Uuid

  /// Assigned branch (lookups.Location) and the employee responsible for the referral.
  locationId            String? @db.Uuid
  responsibleEmployeeId String? @db.Uuid

  careRequirements   String?   @db.Text
  expectedStartDate  DateTime? @db.Date
  requestedHoursPerWeek Decimal? @db.Decimal(6, 2)

  /// Funding arrangement (service_users.FundingType: LA, NHS, Private, Family, Mixed…). Null = to be confirmed.
  fundingTypeId String?  @db.Uuid
  /// Funding organisation (service_users.Funder) — may differ from the referrer and from the actual payer.
  funderId      String?  @db.Uuid
  fundingNotes  String?  @db.Text

  nextFollowUpAt DateTime?
  decisionAt     DateTime?
  decisionById   String?   @db.Uuid
  decisionReason String?   @db.Text
  notes          String?   @db.Text

  /// Staff user who entered it (server-set from the session).
  recordedById String?   @db.Uuid
  updatedById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?   @db.Uuid

  serviceUser ServiceUser     @relation(fields: [serviceUserId], references: [id])
  quotations  CareQuotation[]
  events      ServiceUserReferralEvent[]

  @@index([serviceUserId])
  @@index([status])
  @@index([locationId])
  @@index([deletedAt])
  @@schema("service_users")
}

enum CareQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  SUPERSEDED

  @@schema("service_users")
}

enum QuotationPayerType {
  SERVICE_USER
  FAMILY
  REPRESENTATIVE
  OTHER

  @@schema("service_users")
}

enum QuotationChargeFrequency {
  ONE_OFF
  WEEKLY
  MONTHLY

  @@schema("service_users")
}

/// Private care quotation. Revisions are new rows sharing rootQuotationId; sent / accepted rows are never edited.
model CareQuotation {
  id              String              @id @default(uuid()) @db.Uuid
  /// QUO-2026-0001 (same for every revision)
  referenceNumber String
  revision        Int                 @default(1)
  /// First revision's id (itself for revision 1).
  rootQuotationId String?             @db.Uuid
  serviceUserId   String              @db.Uuid
  referralId      String?             @db.Uuid
  /// Care package (service_users.ServiceUserVisitPlan) once one exists.
  visitPlanId     String?             @db.Uuid
  status          CareQuotationStatus @default(DRAFT)

  responsibleEmployeeId String? @db.Uuid

  payerType         QuotationPayerType @default(SERVICE_USER)
  payerName         String?
  payerRelationship String?
  payerEmail        String?
  payerPhone        String?
  payerAddress      String?            @db.Text

  validUntil  DateTime? @db.Date
  startDate   DateTime? @db.Date
  currency    String    @default("GBP")
  notes       String?   @db.Text
  terms       String?   @db.Text

  /// Totals calculated on the server from the lines and charges.
  weeklyCareCost      Decimal @default(0) @db.Decimal(12, 2)
  weeklyChargesCost   Decimal @default(0) @db.Decimal(12, 2)
  monthlyChargesCost  Decimal @default(0) @db.Decimal(12, 2)
  oneOffChargesCost   Decimal @default(0) @db.Decimal(12, 2)
  weeklyTotal         Decimal @default(0) @db.Decimal(12, 2)
  monthlyTotal        Decimal @default(0) @db.Decimal(12, 2)
  weeklyHours         Decimal @default(0) @db.Decimal(8, 2)

  sentAt               DateTime?
  sentById             String?   @db.Uuid
  acceptedAt           DateTime?
  acceptedByName       String?
  acceptanceMethod     String?
  acceptanceRecordedById String? @db.Uuid
  declinedAt           DateTime?
  declineReason        String?   @db.Text
  supersededAt         DateTime?

  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  serviceUser ServiceUser          @relation(fields: [serviceUserId], references: [id])
  referral    ServiceUserReferral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  lines       CareQuotationLine[]
  charges     CareQuotationCharge[]

  @@unique([referenceNumber, revision])
  @@index([serviceUserId])
  @@index([referralId])
  @@index([rootQuotationId])
  @@index([status])
  @@schema("service_users")
}

/// Proposed service: e.g. "Morning personal care", 7 visits a week, 45 min, 2 carers, £28/h.
model CareQuotationLine {
  id              String   @id @default(uuid()) @db.Uuid
  quotationId     String   @db.Uuid
  description     String
  /// MON..SUN codes; empty = not specified.
  daysOfWeek      String[] @default([])
  visitsPerWeek   Int
  durationMinutes Int
  numberOfCarers  Int      @default(1)
  hourlyRate      Decimal  @db.Decimal(10, 2)
  /// Carer-hours per week and cost per week (server calculated).
  weeklyHours     Decimal  @db.Decimal(8, 2)
  weeklyCost      Decimal  @db.Decimal(12, 2)
  sortOrder       Int      @default(0)

  quotation CareQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@schema("service_users")
}

/// Additional charge: e.g. mileage, assessment fee, key safe installation.
model CareQuotationCharge {
  id          String                   @id @default(uuid()) @db.Uuid
  quotationId String                   @db.Uuid
  description String
  amount      Decimal                  @db.Decimal(12, 2)
  frequency   QuotationChargeFrequency @default(WEEKLY)
  sortOrder   Int                      @default(0)

  quotation CareQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@schema("service_users")
}

/// History for referrals and quotations: who did what, when (server time), with field changes.
model ServiceUserReferralEvent {
  id            String   @id @default(uuid()) @db.Uuid
  serviceUserId String   @db.Uuid
  referralId    String?  @db.Uuid
  quotationId   String?  @db.Uuid
  /// RECORDED, UPDATED, STATUS_CHANGED, ASSIGNED, FOLLOW_UP, NOTE, QUOTE_CREATED, QUOTE_UPDATED, QUOTE_SENT, QUOTE_ACCEPTED, QUOTE_DECLINED, QUOTE_WITHDRAWN, QUOTE_REVISED, LEGACY_IMPORTED
  action        String
  fromStatus    String?
  toStatus      String?
  note          String?  @db.Text
  /// [{ field, from, to }] for edits.
  changes       Json?
  userId        String?  @db.Uuid
  createdAt     DateTime @default(now())

  referral ServiceUserReferral? @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([serviceUserId, createdAt])
  @@index([referralId])
  @@index([quotationId])
  @@schema("service_users")
}

/// Per kind + year counter for REF- / QUO- reference numbers.
model ReferralNumberSequence {
  kind      String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([kind, year])
  @@schema("service_users")
}

/// On-call: who covers evenings, nights, weekends and bank holidays when the office is closed.
enum OnCallTier {
  FIRST_LINE
  SECOND_LINE

  @@schema("scheduling")
}

/// One on-call shift. locationId null = covers every branch.
model OnCallShift {
  id          String     @id @default(uuid()) @db.Uuid
  employeeId  String     @db.Uuid
  locationId  String?    @db.Uuid
  tier        OnCallTier
  startsAt    DateTime
  endsAt      DateTime
  notes       String?    @db.VarChar(500)
  createdById String?    @db.Uuid
  updatedById String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([startsAt])
  @@index([endsAt])
  @@index([employeeId])
  @@schema("scheduling")
}

enum OnCallCallerType {
  CARER
  SERVICE_USER
  FAMILY
  PROFESSIONAL
  OTHER

  @@schema("scheduling")
}

enum OnCallCallCategory {
  CARER_SICKNESS
  LATE_OR_MISSED_VISIT
  ACCESS_PROBLEM
  SERVICE_USER_UNWELL
  MEDICATION
  CONCERN_OR_COMPLAINT
  OTHER

  @@schema("scheduling")
}

enum OnCallCallStatus {
  OPEN
  CLOSED

  @@schema("scheduling")
}

/// A call received while the office is closed. OPEN calls make up the morning handover.
model OnCallCall {
  id                String             @id @default(uuid()) @db.Uuid
  receivedAt        DateTime
  takenByUserId     String?            @db.Uuid
  callerType        OnCallCallerType
  callerName        String             @db.VarChar(120)
  callerPhone       String?            @db.VarChar(40)
  callerEmployeeId  String?            @db.Uuid
  serviceUserId     String?            @db.Uuid
  locationId        String?            @db.Uuid
  category          OnCallCallCategory
  summary           String             @db.VarChar(2000)
  actionTaken       String?            @db.VarChar(2000)
  followUpRequired  Boolean            @default(false)
  status            OnCallCallStatus   @default(OPEN)
  closedAt          DateTime?
  closedByUserId    String?            @db.Uuid
  closingNote       String?            @db.VarChar(1000)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@index([receivedAt])
  @@index([status])
  @@index([serviceUserId])
  @@schema("scheduling")
}

// ---------------------------------------------------------------------------
// Specialist care pathways (generic foundation; v1 ships Learning Disability).
// A pathway case records a client-type-specific assessment (free-form sections
// stored as JSON) and produces versioned, approved care plans. Section layouts
// live in the frontend `pathway-specs.ts`, keeping this model generic.
// ---------------------------------------------------------------------------

enum SpecialistPathwayType {
  LEARNING_DISABILITY
  DEMENTIA
  END_OF_LIFE
  CHILDREN
  SUPPORTED_LIVING

  @@schema("service_users")
}

enum SpecialistPathwayStatus {
  OPEN
  ACTIVE
  CLOSED

  @@schema("service_users")
}

enum SpecialistPathwayPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
  SUPERSEDED

  @@schema("service_users")
}

model SpecialistPathwayCase {
  id            String                  @id @default(uuid()) @db.Uuid
  serviceUserId String                  @db.Uuid
  pathwayType   SpecialistPathwayType
  ref           String
  status        SpecialistPathwayStatus @default(OPEN)
  reviewDueDate DateTime?
  /// Keyed assessment answers: { [sectionKey]: { fields: Record<string,string>, verifiedById, verifiedAt } }
  sections      Json                    @default("{}")
  closedReason  String?

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  serviceUser ServiceUser                 @relation(fields: [serviceUserId], references: [id])
  plans       SpecialistPathwayCarePlan[]
  risks       SpecialistPathwayRisk[]
  reviews     SpecialistPathwayReview[]
  events      SpecialistPathwayEvent[]
  professionals SpecialistPathwayProfessional[]
  documents     SpecialistPathwayDocument[]

  @@unique([pathwayType, ref])
  @@index([serviceUserId])
  @@index([pathwayType, status])
  @@index([deletedAt])
  @@schema("service_users")
}

enum SpecialistPathwayRiskStatus {
  OPEN
  CLOSED

  @@schema("service_users")
}

enum SpecialistPathwayReviewOutcome {
  NO_CHANGE
  PLAN_UPDATE_NEEDED
  ESCALATED
  CASE_CLOSED

  @@schema("service_users")
}

/// Risk assessment on a pathway case: score = likelihood × impact (each 1–5).
model SpecialistPathwayRisk {
  id          String                      @id @default(uuid()) @db.Uuid
  caseId      String                      @db.Uuid
  title       String
  category    String?
  description String?
  likelihood  Int
  impact      Int
  controls    String?
  reviewDate  DateTime?
  status      SpecialistPathwayRiskStatus @default(OPEN)
  createdById String?                     @db.Uuid
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  deletedAt   DateTime?

  case SpecialistPathwayCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@schema("service_users")
}

/// A recorded review of a pathway case.
model SpecialistPathwayReview {
  id             String                         @id @default(uuid()) @db.Uuid
  caseId         String                         @db.Uuid
  reviewedAt     DateTime
  reviewedById   String?                        @db.Uuid
  outcome        SpecialistPathwayReviewOutcome
  notes          String?
  nextReviewDate DateTime?
  createdAt      DateTime                       @default(now())

  case SpecialistPathwayCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@schema("service_users")
}

/// External professional involved in a pathway case (GP, social worker, SALT...).
model SpecialistPathwayProfessional {
  id           String    @id @default(uuid()) @db.Uuid
  caseId       String    @db.Uuid
  name         String
  role         String
  organisation String?
  phone        String?
  email        String?
  notes        String?
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  case SpecialistPathwayCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@schema("service_users")
}

/// File attached to a pathway case. Stored outside the public static root; served only via the download endpoint.
model SpecialistPathwayDocument {
  id           String    @id @default(uuid()) @db.Uuid
  caseId       String    @db.Uuid
  title        String
  category     String?
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  uploadedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  case SpecialistPathwayCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@schema("service_users")
}

/// Activity timeline entry on a pathway case.
model SpecialistPathwayEvent {
  id     String   @id @default(uuid()) @db.Uuid
  caseId String   @db.Uuid
  action String
  note   String?
  userId String?  @db.Uuid
  at     DateTime @default(now())

  case SpecialistPathwayCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@schema("service_users")
}

model SpecialistPathwayCarePlan {
  id        String                      @id @default(uuid()) @db.Uuid
  caseId    String                      @db.Uuid
  version   Int
  status    SpecialistPathwayPlanStatus @default(DRAFT)
  /// Plan body (free-form; e.g. { summary, goals[], support[] }).
  content   Json                        @default("{}")
  comment   String?

  submittedById String?   @db.Uuid
  submittedAt   DateTime?
  decidedById   String?   @db.Uuid
  decidedAt     DateTime?

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid

  case SpecialistPathwayCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, version])
  @@index([caseId])
  @@index([status])
  @@schema("service_users")
}

// ---------------------------------------------------------------------------
// Safeguarding (lean case register). A concern is raised, triaged (risk +
// category), referred to the Local Authority / CQC, investigated via a
// timeline of events, and closed with an outcome. People/branch are linked as
// scalar UUIDs (validated in the service), so no cross-schema FK is needed.
// ---------------------------------------------------------------------------

enum SafeguardingStatus {
  RAISED
  SCREENING
  INVESTIGATING
  REFERRED
  CLOSED

  @@schema("incidents")
}

enum SafeguardingRisk {
  LOW
  MEDIUM
  HIGH

  @@schema("incidents")
}

enum SafeguardingCategory {
  PHYSICAL
  EMOTIONAL
  SEXUAL
  FINANCIAL
  NEGLECT
  SELF_NEGLECT
  DISCRIMINATORY
  ORGANISATIONAL
  DOMESTIC_ABUSE
  MODERN_SLAVERY
  OTHER

  @@schema("incidents")
}

enum SafeguardingReferralDecision {
  NOT_REQUIRED
  PENDING
  MADE

  @@schema("incidents")
}

model SafeguardingCase {
  id              String                       @id @default(uuid()) @db.Uuid
  referenceNumber String                       @unique
  status          SafeguardingStatus           @default(RAISED)
  category        SafeguardingCategory
  riskLevel       SafeguardingRisk             @default(MEDIUM)
  aboutServiceUserId String?                   @db.Uuid
  personDescription  String?
  locationId         String?                   @db.Uuid
  handlerEmployeeId  String?                   @db.Uuid
  raisedByRole       String?
  raisedAt           DateTime
  description        String                    @db.Text
  immediateAction    String?
  laReferral         SafeguardingReferralDecision @default(PENDING)
  laReference        String?
  laReferredAt       DateTime?
  cqcNotified        SafeguardingReferralDecision @default(PENDING)
  cqcReference       String?
  outcome            String?
  lessonsLearned     String?
  closedAt           DateTime?

  /// Phase 2: case lead (office user), review date, immediate safety, multi-agency and the person's voice.
  leadUserId          String?   @db.Uuid
  reviewDate          DateTime?
  reportedToManagerAt DateTime?
  personSafe          String?
  safetyMeasures      String?   @db.Text
  personWords         String?   @db.Text
  evidence            String?   @db.Text
  agencies            String[]  @default([])
  agenciesOther       String?
  meetingHeld         String?
  meetingDate         DateTime?
  protectionPlan      String?   @db.Text
  personWants         String?   @db.Text
  capacity            String?

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  recordedById String?  @db.Uuid
  deletedById  String?  @db.Uuid

  events SafeguardingEvent[]
  investigation       SafeguardingInvestigation?
  investigationPauses SafeguardingInvestigationPause[]

  @@index([status])
  @@index([category])
  @@index([aboutServiceUserId])
  @@index([locationId])
  @@index([deletedAt])
  @@schema("incidents")
}

model SafeguardingEvent {
  id     String   @id @default(uuid()) @db.Uuid
  caseId String   @db.Uuid
  action String
  note   String?
  userId String?  @db.Uuid
  at     DateTime @default(now())

  case SafeguardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@schema("incidents")
}

/// Structured investigation of a safeguarding case (one per case, upserted) — same shape as
/// IncidentInvestigation: set-up, findings, contributing factors, evidence and conclusion.
model SafeguardingInvestigation {
  id                         String                  @id @default(uuid()) @db.Uuid
  caseId                     String                  @unique @db.Uuid
  whatHappened               String?                 @db.Text
  whyHappened                String?                 @db.Text
  contributingFactors        String[]
  contributingFactorDetails  Json?
  rootCause                  String?                 @db.Text
  preventable                IncidentPreventability?
  conclusion                 String?                 @db.Text
  completedAt                DateTime?
  /// STANDARD / ENHANCED / COMPREHENSIVE.
  investigationLevel         String?                 @db.VarChar(20)
  leadInvestigatorEmployeeId String?                 @db.Uuid
  /// NO / YES / NOT_KNOWN.
  investigatorInvolved       String?                 @db.VarChar(20)
  investigatorInvolvedReason String?                 @db.Text
  targetDate                 DateTime?               @db.Date
  termsOfReference           String?                 @db.Text
  /// IN_PROGRESS / PAUSED / COMPLETED (separate from the case status).
  investigationStatus        String                  @default("IN_PROGRESS") @db.VarChar(20)
  recordsReviewed            String[]
  recordsReviewedDetails     Json?
  evidenceNotes              String?                 @db.Text
  outstandingEvidence        String?                 @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  case SafeguardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@schema("incidents")
}

/// One pause of a safeguarding investigation (kept after it is resumed).
model SafeguardingInvestigationPause {
  id             String    @id @default(uuid()) @db.Uuid
  caseId         String    @db.Uuid
  reason         String    @db.Text
  pausedAt       DateTime  @default(now())
  pausedById     String?   @db.Uuid
  nextReviewDate DateTime  @db.Date
  resumedAt      DateTime?
  resumedById    String?   @db.Uuid

  case SafeguardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, pausedAt])
  @@schema("incidents")
}

model SafeguardingNumberSequence {
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([year])
  @@schema("incidents")
}

// ---------------------------------------------------------------------------
// CRM / Enquiries (lead intake pipeline). A care enquiry is captured, moved
// through pipeline stages on a board, and converted into a ServiceUser (the
// conversion reuses POST /service-users; the new id is stored here). People
// are linked as scalar UUIDs, so no existing model is touched.
// ---------------------------------------------------------------------------

enum EnquiryStage {
  NEW
  CONTACTED
  ASSESSMENT
  OFFER
  WON
  LOST

  @@schema("service_users")
}

enum EnquirySource {
  SELF
  FAMILY
  GP
  HOSPITAL
  LOCAL_AUTHORITY
  NHS
  SOCIAL_WORKER
  WEBSITE
  WORD_OF_MOUTH
  OTHER

  @@schema("service_users")
}

enum EnquiryType {
  PRIVATE
  LOCAL_AUTHORITY
  NHS
  HOSPITAL

  @@schema("service_users")
}

/// An enquiry from the person or family, or a referral from a professional; both follow the same pipeline.
enum EnquiryKind {
  ENQUIRY
  REFERRAL

  @@schema("service_users")
}

enum EnquiryUrgency {
  ROUTINE
  URGENT
  EMERGENCY

  @@schema("service_users")
}

enum EnquiryReceivedVia {
  PHONE
  EMAIL
  WEBSITE
  IN_PERSON
  LETTER
  FAX
  OTHER

  @@schema("service_users")
}

enum EnquiryLostReason {
  PRICE
  CHOSE_ANOTHER_PROVIDER
  NO_CAPACITY
  OUT_OF_AREA
  NEEDS_NOT_MET
  MOVED_TO_CARE_HOME
  NO_LONGER_NEEDED
  DECEASED
  NO_RESPONSE
  FUNDING_DECLINED
  OTHER

  @@schema("service_users")
}

enum EnquiryFundingType {
  SELF_FUNDED
  LOCAL_AUTHORITY
  NHS_CHC
  MIXED
  UNKNOWN

  @@schema("service_users")
}

model Enquiry {
  id                     String         @id @default(uuid()) @db.Uuid
  referenceNumber        String         @unique
  stage                  EnquiryStage   @default(NEW)
  /// ENQUIRY (the person or family) or REFERRAL (a professional: council, NHS, hospital, GP, social worker).
  kind                   EnquiryKind    @default(ENQUIRY)
  /// Referral only: the referring organisation, the referrer's role, their reference and the date on the referral.
  referringOrganisation  String?
  referrerRole           String?
  referralReference      String?
  referralDate           DateTime?
  firstName              String
  lastName               String
  dateOfBirth            DateTime?
  contactName            String?
  contactRelationship    String?
  contactPhone           String?
  contactEmail           String?
  source                 EnquirySource  @default(OTHER)
  sourceDetail           String?
  enquiryType            EnquiryType?
  urgency                EnquiryUrgency @default(ROUTINE)
  needs                  String?        @db.Text
  /// Care plans the person is likely to need (CARE_PLAN CarePathwayForm ids; scalar links).
  carePlanFormIds        String[]       @default([]) @db.Uuid
  ownerId                String?        @db.Uuid
  /// How the enquiry reached us (phone, email, website, …).
  receivedVia            EnquiryReceivedVia?
  /// When the referrer/person sent the enquiry.
  sentAt                 DateTime?
  /// When the office received the enquiry (may differ from createdAt — when it was entered).
  receivedAt             DateTime?
  addressLine            String?
  postcode               String?
  /// Map position of the address (from Google Places); copied to the service user's address.
  latitude               Decimal?       @db.Decimal(10, 7)
  longitude              Decimal?       @db.Decimal(10, 7)
  fundingType            EnquiryFundingType?
  /// Funding type from the shared lookup (ServiceUserFundingType) — preferred over `fundingType`.
  fundingTypeId          String?        @db.Uuid
  funderName             String?
  hoursPerWeek           Float?
  visitsPerDay           Int?
  requestedStartDate     DateTime?
  /// Next follow-up due and what needs doing; overdue when in the past on an open enquiry.
  nextFollowUpAt         DateTime?
  nextAction             String?
  /// Branch the enquiry belongs to (scalar link to Location; drives branch scoping).
  locationId             String?        @db.Uuid
  quoteWeeklyAmount      Float?
  quoteHourlyRate        Float?
  quoteSentAt            DateTime?
  quoteNotes             String?
  assessmentAt           DateTime?
  /// Office user carrying out the assessment.
  assessorId             String?        @db.Uuid
  assessmentLocation     String?
  lostReasonCode         EnquiryLostReason?
  lostReason             String?
  convertedServiceUserId String?        @db.Uuid
  stageChangedAt         DateTime       @default(now())

  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  recordedById String?   @db.Uuid
  deletedById  String?   @db.Uuid

  /// Legacy "Quote sent" enquiry (no quotation record) reviewed by staff; legacy quote fields stay as recorded.
  legacyQuoteReconciledAt   DateTime?
  legacyQuoteReconciledById String?   @db.Uuid
  legacyQuoteReconcileNote  String?   @db.Text

  events     EnquiryEvent[]
  quotations EnquiryQuotation[]

  @@index([stage])
  @@index([kind])
  @@index([source])
  @@index([ownerId])
  @@index([locationId])
  @@index([deletedAt])
  @@schema("service_users")
}

model EnquiryEvent {
  id        String   @id @default(uuid()) @db.Uuid
  enquiryId String   @db.Uuid
  action    String
  note      String?
  userId    String?  @db.Uuid
  at        DateTime @default(now())
  /// Quotation version the event is about (quote created, sent, response, …).
  quotationVersionId String? @db.Uuid

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@schema("service_users")
}

model EnquiryNumberSequence {
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([year])
  @@schema("service_users")
}

// ---------------------------------------------------------------------------
// Enquiry quotations. A quotation (stable number EQ-YYYY-NNNN) has numbered versions;
// a version is editable only while DRAFT and is frozen (pricing snapshot) when it leaves
// DRAFT. Prices come from the CLIENT charge cards (billing.ChargeCard), never pay cards.
// ---------------------------------------------------------------------------

enum EnquiryQuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  CHANGES_REQUESTED
  UNDER_NEGOTIATION
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
  CANCELLED

  @@schema("service_users")
}

enum EnquiryQuoteType {
  PROVISIONAL_ESTIMATE
  FINAL

  @@schema("service_users")
}

/// DETAILED: visits with times, priced from the rates. SUMMARY: a "total amount" quote — a typed weekly
/// total, and the visits listed only by time of day (the client sees no times or per-visit prices).
enum EnquiryQuoteClientLayout {
  DETAILED
  SUMMARY

  @@schema("service_users")
}

enum EnquiryQuoteFundingCategory {
  PRIVATE
  LOCAL_AUTHORITY
  NHS
  OTHER
  MIXED

  @@schema("service_users")
}

enum EnquiryQuotePayerType {
  PRIVATE_CLIENT
  LOCAL_AUTHORITY
  NHS
  OTHER

  @@schema("service_users")
}

/// FIXED = £ per week, PERCENTAGE = % of the weekly total, PER_VISIT = £ per visit.
enum EnquiryQuoteFundingMethod {
  FIXED
  PERCENTAGE
  PER_VISIT

  @@schema("service_users")
}

enum EnquiryQuoteFundingStatus {
  CONFIRMED
  PENDING_APPROVAL

  @@schema("service_users")
}

enum EnquiryQuotePatternFrequency {
  WEEKLY
  FORTNIGHTLY
  FOUR_WEEKLY
  ONE_OFF

  @@schema("service_users")
}

enum EnquiryQuoteExtraKind {
  SETUP_FEE
  MILEAGE
  DISCOUNT
  OTHER

  @@schema("service_users")
}

enum EnquiryQuoteResponseType {
  ACCEPTED
  DECLINED
  CHANGES_REQUESTED
  QUERY
  NO_RESPONSE

  @@schema("service_users")
}

/// EMAIL = sent through the system mail integration; the others record a send done outside CareFlow.
enum EnquiryQuoteSendChannel {
  EMAIL
  EXTERNAL_EMAIL
  POST
  HAND_DELIVERED
  OTHER

  @@schema("service_users")
}

enum EnquiryQuoteSendStatus {
  SENT
  FAILED
  RECORDED

  @@schema("service_users")
}

enum EnquiryQuoteFollowUpStatus {
  OPEN
  DONE
  CANCELLED

  @@schema("service_users")
}

model EnquiryQuotation {
  id              String    @id @default(uuid()) @db.Uuid
  enquiryId       String    @db.Uuid
  /// EQ-2026-0001 — the same for every version.
  quotationNumber String    @unique
  /// The enquiry's current quotation (one per enquiry).
  isCurrent       Boolean   @default(true)
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  enquiry        Enquiry                         @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  versions       EnquiryQuotationVersion[]
  communications EnquiryQuotationCommunication[]
  responses      EnquiryQuotationResponse[]
  followUps      EnquiryQuotationFollowUp[]

  @@index([enquiryId])
  @@schema("service_users")
}

model EnquiryQuotationNumberSequence {
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([year])
  @@schema("service_users")
}

model EnquiryQuotationVersion {
  id                   String             @id @default(uuid()) @db.Uuid
  quotationId          String             @db.Uuid
  versionNumber        Int
  status               EnquiryQuoteStatus @default(DRAFT)
  quoteType            EnquiryQuoteType   @default(PROVISIONAL_ESTIMATE)
  clientLayout         EnquiryQuoteClientLayout @default(DETAILED)
  /// The typed weekly price of the visits on a SUMMARY ("total amount") quote.
  manualWeeklyTotal    Decimal?                    @db.Decimal(12, 2)
  /// Version this one was revised from (V1 for V2, …).
  revisedFromVersionId String?            @db.Uuid

  locationId             String?                     @db.Uuid
  ownerId                String?                     @db.Uuid
  proposedStartDate      DateTime?                   @db.Date
  proposedEndDate        DateTime?                   @db.Date
  issueDate              DateTime?                   @db.Date
  validUntil             DateTime?                   @db.Date
  currency               String                      @default("GBP")
  /// Assessment the quote is based on (InitialAssessmentSubmission id) or a free-text reference.
  assessmentSubmissionId String?                     @db.Uuid
  assessmentReference    String?
  fundingCategory        EnquiryQuoteFundingCategory @default(PRIVATE)
  /// Client charge card used for pricing; empty = picked automatically (branch / funder / default).
  chargeCardId           String?                     @db.Uuid
  /// £ per carer per hour; quotes are priced by hand from this (charge cards are not used).
  hourlyRate             Decimal?                    @db.Decimal(10, 2)
  /// Other rates typed on the quote: short visits, weekend, bank holiday, sleeping / waking night (QuoteRates JSON).
  rates                  Json?
  /// Staff only — never on the client preview, PDF or email.
  internalNotes          String?                     @db.Text
  clientNotes            String?                     @db.Text
  terms                  String?                     @db.Text

  /// Server-calculated totals (latest calculation; frozen with the snapshot once issued).
  weeklyTotal           Decimal   @default(0) @db.Decimal(12, 2)
  fourWeeklyTotal       Decimal   @default(0) @db.Decimal(12, 2)
  monthlyAverageTotal   Decimal   @default(0) @db.Decimal(12, 2)
  annualTotal           Decimal   @default(0) @db.Decimal(12, 2)
  calendarMonthTotal    Decimal?  @db.Decimal(12, 2)
  oneOffTotal           Decimal   @default(0) @db.Decimal(12, 2)
  vatWeekly             Decimal   @default(0) @db.Decimal(12, 2)
  clientWeeklyLiability Decimal   @default(0) @db.Decimal(12, 2)
  weeklyCoverageMinutes Int       @default(0)
  weeklyCarerMinutes    Int       @default(0)
  unresolvedCharges     Int       @default(0)
  calculatedAt          DateTime?
  /// Full breakdown frozen when the version leaves DRAFT (the issued price).
  pricingSnapshot       Json?
  issuedAt              DateTime?
  issuedById            String?   @db.Uuid

  submittedForApprovalAt   DateTime?
  submittedForApprovalById String?   @db.Uuid
  approvedAt               DateTime?
  approvedById             String?   @db.Uuid
  approvalNote             String?   @db.Text

  sentAt                DateTime?
  respondedAt           DateTime?
  acceptedAt            DateTime?
  /// Signed / written agreement received (recorded by staff — not a digital signature).
  agreementReceivedAt   DateTime?
  agreementRecordedById String?   @db.Uuid
  agreementNote         String?   @db.Text
  /// Draft care package created from this version (service_users.ServiceUserVisitPlan).
  convertedVisitPlanId  String?   @db.Uuid
  convertedAt           DateTime?
  convertedById         String?   @db.Uuid
  statusChangedAt       DateTime  @default(now())

  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotation EnquiryQuotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  patterns  EnquiryQuotationVisitPattern[]
  fundings  EnquiryQuotationFunding[]
  extras    EnquiryQuotationExtra[]

  @@unique([quotationId, versionNumber])
  @@index([status])
  @@index([locationId])
  @@schema("service_users")
}

/// One visit pattern: e.g. "Morning personal care", Mon–Fri 08:00–08:45, 2 carers.
model EnquiryQuotationVisitPattern {
  id              String                       @id @default(uuid()) @db.Uuid
  versionId       String                       @db.Uuid
  sortOrder       Int                          @default(0)
  label           String
  careType        String?
  /// Visit start (HH:mm). With a time window it is the window start.
  startTime       String
  /// Visit end (HH:mm); an end at/before the start is the next day.
  endTime         String?
  /// Latest start when the visit can happen in a window (HH:mm); null = fixed time.
  windowEndTime   String?
  durationMinutes Int
  /// 0=Sun … 6=Sat (same as visit plan slots).
  daysOfWeek      Int[]                        @default([])
  frequency       EnquiryQuotePatternFrequency @default(WEEKLY)
  effectiveFrom   DateTime?                    @db.Date
  effectiveTo     DateTime?                    @db.Date
  oneOffDates     DateTime[]                   @db.Date
  /// Carers per visit (2+ = double-up for this visit only).
  carersPerVisit  Int                          @default(1)
  nightDuty       VisitPlanNightDuty           @default(NONE)
  activities      String[]                     @default([])
  notes           String?                      @db.Text

  /// Manual charge per visit instead of the card rate (reason + who + when required).
  manualChargePerVisit Decimal?  @db.Decimal(12, 2)
  overrideReason       String?   @db.Text
  overrideById         String?   @db.Uuid
  overrideAt           DateTime?

  /// Server calculated.
  rateReference         String?
  chargePerOccurrence   Decimal? @db.Decimal(12, 2)
  weeklyOccurrences     Decimal  @default(0) @db.Decimal(8, 3)
  weeklyCoverageMinutes Int      @default(0)
  weeklyCarerMinutes    Int      @default(0)
  weeklyTotal           Decimal  @default(0) @db.Decimal(12, 2)
  pricingIssue          String?  @db.Text

  version EnquiryQuotationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@schema("service_users")
}

model EnquiryQuotationFunding {
  id           String                    @id @default(uuid()) @db.Uuid
  versionId    String                    @db.Uuid
  payerType    EnquiryQuotePayerType
  payerName    String?
  funderId     String?                   @db.Uuid
  reference    String?
  method       EnquiryQuoteFundingMethod @default(FIXED)
  amount       Decimal                   @db.Decimal(12, 2)
  status       EnquiryQuoteFundingStatus @default(PENDING_APPROVAL)
  /// Server calculated £ per week covered by this payer.
  weeklyAmount Decimal                   @default(0) @db.Decimal(12, 2)
  sortOrder    Int                       @default(0)

  version EnquiryQuotationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@schema("service_users")
}

/// Set-up fee, mileage, discount or another charge on top of the visits.
model EnquiryQuotationExtra {
  id           String                   @id @default(uuid()) @db.Uuid
  versionId    String                   @db.Uuid
  kind         EnquiryQuoteExtraKind
  description  String
  frequency    QuotationChargeFrequency @default(WEEKLY)
  /// £ amount; for MILEAGE the miles (quantity) × rate; for DISCOUNT a £ amount or a % when isPercentage.
  amount       Decimal?                 @db.Decimal(12, 2)
  quantity     Decimal?                 @db.Decimal(10, 2)
  isPercentage Boolean                  @default(false)
  /// Server calculated £ (negative for a discount).
  total        Decimal                  @default(0) @db.Decimal(12, 2)
  sortOrder    Int                      @default(0)

  version EnquiryQuotationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@schema("service_users")
}

/// Every send (or recorded external send) of a specific version.
model EnquiryQuotationCommunication {
  id                String                  @id @default(uuid()) @db.Uuid
  quotationId       String                  @db.Uuid
  versionId         String                  @db.Uuid
  channel           EnquiryQuoteSendChannel
  status            EnquiryQuoteSendStatus
  recipientName     String?
  recipientEmail    String?
  template          String?
  subject           String?
  message           String?                 @db.Text
  senderId          String?                 @db.Uuid
  sentAt            DateTime?
  failureReason     String?                 @db.Text
  attemptCount      Int                     @default(1)
  providerMessageId String?
  followUpDate      DateTime?
  /// Client-supplied key so a double-click / retry never sends twice.
  idempotencyKey    String?                 @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  quotation EnquiryQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([versionId])
  @@schema("service_users")
}

model EnquiryQuotationResponse {
  id                    String                   @id @default(uuid()) @db.Uuid
  quotationId           String                   @db.Uuid
  versionId             String                   @db.Uuid
  responseType          EnquiryQuoteResponseType
  responderName         String?
  responderRelationship String?
  method                String?
  respondedAt           DateTime
  details               String?                  @db.Text
  /// Where the evidence is (e.g. "Email from daughter 3 Nov, saved to documents").
  evidence              String?                  @db.Text
  declineReasonCode     EnquiryLostReason?
  nextAction            String?
  /// Draft revision created by a Changes Requested response.
  createdVersionId      String?                  @db.Uuid
  recordedById          String?                  @db.Uuid
  createdAt             DateTime                 @default(now())

  quotation EnquiryQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([versionId])
  @@schema("service_users")
}

model EnquiryQuotationFollowUp {
  id                String                     @id @default(uuid()) @db.Uuid
  quotationId       String                     @db.Uuid
  versionId         String?                    @db.Uuid
  assigneeId        String?                    @db.Uuid
  method            String?
  dueAt             DateTime
  note              String?                    @db.Text
  status            EnquiryQuoteFollowUpStatus @default(OPEN)
  completedAt       DateTime?
  completedById     String?                    @db.Uuid
  outcome           String?                    @db.Text
  /// Follow-up this one replaced when it was rescheduled.
  rescheduledFromId String?                    @db.Uuid
  createdById       String?                    @db.Uuid
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  quotation EnquiryQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([status, dueAt])
  @@schema("service_users")
}

/// Google driving distance and time between two map points (rounded to 5 decimals), kept so the
/// rota and visit billing do not ask Google again for the same journey. Only Google answers are stored.
model TravelRouteCache {
  id             String   @id @default(uuid()) @db.Uuid
  originKey      String   @db.VarChar(32)
  destinationKey String   @db.VarChar(32)
  meters         Int
  seconds        Int
  fetchedAt      DateTime @default(now())

  @@unique([originKey, destinationKey])
  @@schema("scheduling")
}

// ─── CQC evidence (Quality & compliance → CQC evidence) ─────────────────────────────────────────
// The CQC framework is versioned data (prisma/seed-data/cqc-framework, prisma/seed-lib/cqc-framework.ts);
// evidence links to quality statements of a version, so a new framework is re-mapped, not rebuilt.

enum CqcFrameworkStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@schema("quality")
}

/// Where a piece of evidence came from. SURVEY_RESULT is filled automatically when a survey closes.
enum CqcEvidenceSourceType {
  SURVEY_RESULT
  POLICY
  AUDIT
  INCIDENT_LEARNING
  TRAINING
  COMPLAINT
  COMPLIMENT
  MANUAL

  @@schema("quality")
}

enum CqcEvidenceStatus {
  CURRENT
  SUPERSEDED
  ARCHIVED

  @@schema("quality")
}

/// One version of CQC's assessment framework (v1 = single assessment framework). One is ACTIVE.
model CqcFrameworkVersion {
  id            String             @id @default(uuid()) @db.Uuid
  version       Int                @unique
  code          String
  title         String
  status        CqcFrameworkStatus @default(DRAFT)
  effectiveFrom DateTime?          @db.Date
  checkedOn     DateTime?          @db.Date
  note          String?            @db.Text
  /// Sources the titles were checked against: [{ id, source, url }].
  sources       Json?
  /// Hash of the seed file content; the seed skips an unchanged version.
  contentHash   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  keyQuestions CqcKeyQuestion[]
  statements   CqcQualityStatement[]
  categories   CqcEvidenceCategory[]

  @@schema("quality")
}

model CqcKeyQuestion {
  id                 String   @id @default(uuid()) @db.Uuid
  frameworkVersionId String   @db.Uuid
  code               String
  title              String
  summary            String   @db.Text
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  frameworkVersion CqcFrameworkVersion   @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)
  statements       CqcQualityStatement[]

  @@unique([frameworkVersionId, code])
  @@schema("quality")
}

model CqcQualityStatement {
  id                 String    @id @default(uuid()) @db.Uuid
  frameworkVersionId String    @db.Uuid
  keyQuestionId      String    @db.Uuid
  code               String
  title              String
  /// CareFlow's short summary of what the statement expects (own words, not CQC's text).
  summary            String    @db.Text
  /// Other spellings used in survey and policy library metadata ("Medicine optimisation").
  aliases            String[]  @default([])
  /// Codes in the previous framework version this statement takes over (re-mapping).
  mapsFrom           String[]  @default([])
  /// Title checked against an opened source (false = from a secondary summary only).
  verified           Boolean   @default(false)
  displayOrder       Int       @default(0)
  /// No longer in the seed file (kept because evidence may link to it).
  retiredAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  frameworkVersion CqcFrameworkVersion    @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)
  keyQuestion      CqcKeyQuestion         @relation(fields: [keyQuestionId], references: [id], onDelete: Cascade)
  evidenceLinks    CqcEvidenceStatement[]

  @@unique([frameworkVersionId, code])
  @@index([keyQuestionId])
  @@schema("quality")
}

model CqcEvidenceCategory {
  id                 String    @id @default(uuid()) @db.Uuid
  frameworkVersionId String    @db.Uuid
  code               String
  title              String
  description        String    @db.Text
  mapsFrom           String[]  @default([])
  displayOrder       Int       @default(0)
  retiredAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  frameworkVersion CqcFrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)

  @@unique([frameworkVersionId, code])
  @@schema("quality")
}

/// A piece of evidence kept for CQC, linked to one or more quality statements.
model CqcEvidence {
  id             String                @id @default(uuid()) @db.Uuid
  title          String
  summary        String?               @db.Text
  sourceType     CqcEvidenceSourceType
  /// The source record (e.g. the survey or survey period). Null for manual evidence.
  sourceId       String?               @db.Uuid
  /// What the source was called when the evidence was made (e.g. survey title and period).
  sourceLabel    String?
  /// Automatic evidence only: "survey:<surveyId>:<statementId>", so a re-capture updates it.
  sourceKey      String?               @unique
  /// Evidence category code of the framework (PEOPLES_EXPERIENCE, PROCESSES…).
  categoryCode   String
  periodStart    DateTime?
  periodEnd      DateTime?
  /// Branches the evidence is about. Empty = the whole organisation.
  locationIds    String[]              @default([]) @db.Uuid
  status         CqcEvidenceStatus     @default(CURRENT)
  reviewDueAt    DateTime?
  /// Aggregated figures (survey results: counts, rate, headline percentages). Never individual answers.
  metrics        Json?
  /// "You said, we did": [{ youSaid, weDid }].
  actions        Json?
  notes          String?               @db.Text
  /// The newer evidence that replaced this one (e.g. the next period of a repeating survey).
  supersededById String?               @db.Uuid
  createdById    String?               @db.Uuid
  updatedById    String?               @db.Uuid
  archivedAt     DateTime?
  archivedById   String?               @db.Uuid
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  statements  CqcEvidenceStatement[]
  attachments CqcEvidenceAttachment[]

  @@index([status])
  @@index([sourceType, sourceId])
  @@index([categoryCode])
  @@index([reviewDueAt])
  @@schema("quality")
}

model CqcEvidenceStatement {
  evidenceId  String   @db.Uuid
  statementId String   @db.Uuid
  createdAt   DateTime @default(now())

  evidence  CqcEvidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  statement CqcQualityStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@id([evidenceId, statementId])
  @@index([statementId])
  @@schema("quality")
}

/// A file kept with evidence (uploads/cqc-evidence/<evidenceId>/…; downloaded through the API only).
model CqcEvidenceAttachment {
  id           String    @id @default(uuid()) @db.Uuid
  evidenceId   String    @db.Uuid
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  uploadedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  evidence CqcEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@schema("quality")
}

/// Quality statements a manager chose for a survey without ready-made (library) statements.
/// Used when the survey, or each period of a repeating survey, is added to CQC evidence.
model CqcSurveyStatementChoice {
  surveyId     String   @id @db.Uuid
  statementIds String[] @db.Uuid
  categoryCode String?
  chosenById   String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("quality")
}

/// Last time a closed survey was checked for CQC evidence (so the sweep handles each close once).
model CqcSurveyCapture {
  surveyId        String   @id @db.Uuid
  /// Survey.updatedAt when it was checked; closing it again after re-opening captures again.
  surveyUpdatedAt DateTime
  /// CAPTURED, NO_STATEMENTS, NOT_CLOSED or FAILED.
  outcome         String
  evidenceCount   Int      @default(0)
  detail          String?
  capturedAt      DateTime @default(now())

  @@schema("quality")
}
