  accessInstruction      String  @default("") @db.Text
  accessRisks            String  @default("") @db.Text
  doorCode               String?
  careInstructions       String  @default("") @db.Text
  weeklyContractedHours  String?
  contractDocumentUrl    String?
  numberOfCarers         Int     @default(1)

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  serviceUser         ServiceUser                      @relation(fields: [serviceUserId], references: [id])
  preferredCarerLinks ServiceUserDomCarePreferredCarer[]
  blockedCarerLinks   ServiceUserDomCareBlockedCarer[]

  @@schema("service_users")
}

model ServiceUserDomCarePreferredCarer {
  id                   String @id @default(uuid()) @db.Uuid
  serviceUserDomCareId String @db.Uuid
  employeeId           String @db.Uuid

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceUserDomCare ServiceUserDomCare @relation(fields: [serviceUserDomCareId], references: [id], onDelete: Cascade)
  employee           Employee           @relation("DomCarePreferredEmployee", fields: [employeeId], references: [id])

  @@unique([serviceUserDomCareId, employeeId])
  @@index([serviceUserDomCareId])
  @@schema("service_users")
}

model ServiceUserDomCareBlockedCarer {
  id                   String @id @default(uuid()) @db.Uuid
  serviceUserDomCareId String @db.Uuid
  employeeId           String @db.Uuid

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceUserDomCare ServiceUserDomCare @relation(fields: [serviceUserDomCareId], references: [id], onDelete: Cascade)
  employee           Employee           @relation("DomCareBlockedEmployee", fields: [employeeId], references: [id])

  @@unique([serviceUserDomCareId, employeeId])
  @@index([serviceUserDomCareId])
  @@schema("service_users")
}

model ServiceUserInitialAssessment {
  id                            String  @id @default(uuid()) @db.Uuid
  serviceUserId                 String  @unique @db.Uuid
  numberOfCarers                Int     @default(1)
  likesToBeKnownAs              String?
  doorCode                      String?
  accessRisks                   String  @default("") @db.Text
  accessInstruction             String  @default("") @db.Text
  reasonForAdmission            String  @default("") @db.Text
  previousMedicalHistory        String  @default("") @db.Text
  careInstructions              String  @default("") @db.Text
  assessmentPictureUrl          String?
  checklist                     Json    @default("{}")
  culturalReligiousNotes        String  @default("") @db.Text
  careCarerNumbersNote          String  @default("") @db.Text
  additionalRisksNotes          String  @default("") @db.Text
  environmentAccessHazardsNotes String  @default("") @db.Text
  hydrationComment              String  @default("") @db.Text
  nutritionComment              String  @default("") @db.Text

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id])

  @@schema("service_users")
}
