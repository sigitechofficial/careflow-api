generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "identity", "employees", "lookups", "audit", "service_users", "notifications"]
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@schema("employees")
}

enum ComplianceCategory {
  IDENTITY
  RIGHT_TO_WORK
  SAFEGUARDING
  TRAINING
  CLINICAL
  EMPLOYMENT
  HEALTH_AND_SAFETY
  PROFESSIONAL_REGISTRATION
  DRIVING
  OTHER

  @@schema("lookups")
}

enum EmployeeComplianceStatus {
  REQUIRED
  SUBMITTED
  PENDING_REVIEW
  VALID
  EXPIRING_SOON
  EXPIRED
  REJECTED
  MISSING
  NOT_REQUIRED
  NO_LONGER_REQUIRED

  @@schema("employees")
}

enum ComplianceVerificationAction {
  SUBMITTED
  VERIFIED
  REJECTED
  UPDATED
  MARKED_NO_LONGER_REQUIRED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED

  @@schema("employees")
}

enum ComplianceReminderType {
  EXPIRY_90_DAYS
  EXPIRY_60_DAYS
  EXPIRY_30_DAYS
  EXPIRY_7_DAYS
  EXPIRED

  @@schema("employees")
}

enum ComplianceReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED

  @@schema("employees")
}

enum ServiceUserAbsenceType {
  PLANNED
  UNPLANNED
  NOT_APPLICABLE

  @@schema("service_users")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  username          String?  @unique
  passwordHash      String
  firstName         String?
  lastName          String?
  refreshTokenHash  String?

  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  createdById       String?  @db.Uuid
  updatedById       String?  @db.Uuid
  deletedById       String?  @db.Uuid

  createdBy         User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?    @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  deletedBy         User?    @relation("UserDeletedBy", fields: [deletedById], references: [id])

  createdUsers      User[]   @relation("UserCreatedBy")
  updatedUsers      User[]   @relation("UserUpdatedBy")
  deletedUsers      User[]   @relation("UserDeletedBy")

  userRoles         UserRole[]
  auditLogs         AuditLog[]
  loginHistories    LoginHistory[]
  securityEvents    SecurityEvent[]
  dataAccessLogs    DataAccessLog[]
  exportLogs        ExportLog[]
  reviewedEmployees EmployeeReview[] @relation("EmployeeReviewReviewedBy")
  uploadedEmployeeDocuments EmployeeDocument[]
  employeeCompliancesVerified       EmployeeCompliance[]       @relation("EmployeeComplianceVerifiedBy")
  employeeCompliancesRejected      EmployeeCompliance[]       @relation("EmployeeComplianceRejectedBy")
  employeeCompliancesNoLongerReq    EmployeeCompliance[]       @relation("EmployeeComplianceNoLongerRequiredBy")
  employeeComplianceDocumentsUploaded EmployeeComplianceDocument[] @relation("EmployeeComplianceDocumentUploadedBy")
  complianceVerificationsPerformed ComplianceVerification[]   @relation("ComplianceVerificationPerformedBy")
  approvedServiceUserFundings      ServiceUserFunding[]        @relation("ServiceUserFundingApprovedBy")
  uploadedLiveInContractDocuments    ServiceUserLiveInContractDocument[] @relation("LiveInContractUploadedBy")
  notificationRecipients             NotificationRecipient[]
  notificationPreferences            NotificationPreference[]
  notificationsCreated               Notification[]                    @relation("NotificationCreatedBy")

  @@index([email])
  @@index([deletedAt])
  @@schema("identity")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([deletedAt])
  @@schema("identity")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  rolePermissions RolePermission[]

  @@index([deletedAt])
  @@schema("identity")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt    DateTime @default(now())

  role         Role      @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@schema("identity")
}

model UserRole {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  roleId    String @db.Uuid

  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
  role      Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@schema("identity")
}

model Employee {
  id          String   @id @default(uuid()) @db.Uuid

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  personalDetail EmployeePersonalDetail?
  emergencyContacts EmployeeEmergencyContact[]
  employment     EmployeeEmployment?
  skills         EmployeeSkill[]
  certifications EmployeeWorkCertification[]
  reviews        EmployeeReview[]
  documents      EmployeeDocument[]
  nonCoreActivities EmployeeNonCoreActivity[]
  workingPatterns EmployeeWorkingPattern[]
  complianceRecords EmployeeCompliance[]
  holidays       EmployeeHoliday[]
  leavingRecords EmployeeLeavingRecord[]

  serviceUsersAsKeyWorker   ServiceUser[]           @relation("ServiceUserKeyWorker")
  serviceUsersAsNamedNurse  ServiceUser[]           @relation("ServiceUserNamedNurse")
  assignmentAsKeyWorker     ServiceUserAssignment[] @relation("AssignmentKeyWorker")
  assignmentAsNamedNurse    ServiceUserAssignment[] @relation("AssignmentNamedNurse")
  domCarePreferredLinks       ServiceUserDomCarePreferredCarer[] @relation("DomCarePreferredEmployee")
  domCareBlockedLinks         ServiceUserDomCareBlockedCarer[]   @relation("DomCareBlockedEmployee")
  liveInPreferredCarerLinks   ServiceUserLiveInPreferredCarer[]  @relation("LiveInPreferredEmployee")
  liveInBlockedCarerLinks     ServiceUserLiveInBlockedCarer[]    @relation("LiveInBlockedEmployee")

  medicationAdministrations MedicationAdministrationEvent[] @relation("MedAdministeredBy")
  medicationReviews         MedicationReview[]              @relation("MedReviewedBy")
  medicationStockRecords    MedicationStockRecord[]         @relation("MedStockRecordedBy")

  @@index([deletedAt])
  @@schema("employees")
}

model EmployeePersonalDetail {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @unique @db.Uuid

  firstName        String
  lastName         String
  titleId          String?  @db.Uuid
  genderId         String?  @db.Uuid
  email            String?  @unique
  username         String?  @unique
  dateOfBirth      DateTime?
  nationalityId    String?  @db.Uuid
  addressLine1     String?
  addressLine2     String?
  town             String?
  country          String?
  postcode         String?
  homeTelephone    String?
  mobileTelephone  String?
  photoUrl         String?
  statusId         String?  @db.Uuid

  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  createdById      String?  @db.Uuid
  updatedById      String?  @db.Uuid
  deletedById      String?  @db.Uuid

  employee         Employee @relation(fields: [employeeId], references: [id])

  title            Title?       @relation(fields: [titleId], references: [id])
  gender           Gender?      @relation(fields: [genderId], references: [id])
  nationality      Nationality? @relation(fields: [nationalityId], references: [id])
  status           EmployeeStatus? @relation(fields: [statusId], references: [id])

  @@index([employeeId])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeEmergencyContact {
  id          String @id @default(uuid()) @db.Uuid
  employeeId  String @db.Uuid
  firstName   String
  lastName    String
  relationship String
  phone       String

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  employee    Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeEmployment {
  id                    String @id @default(uuid()) @db.Uuid
  employeeId            String @unique @db.Uuid
  workAreaId            String? @db.Uuid
  roleId                String? @db.Uuid
  jobTitleId            String? @db.Uuid
  rbacLevelId           String? @db.Uuid
  startDate             DateTime?
  endDate               DateTime?
  leavingReasonId       String? @db.Uuid
  leavingNotes          String?
  nationalInsuranceNo   String?
  gradeId               String? @db.Uuid
  nmcPinNumber          String?
  contractTypeId        String? @db.Uuid
  employeeNumber        String?
  travelPaymentTypeId   String? @db.Uuid
  payrollNumber         String?
  baseLocationId        String? @db.Uuid
  locationId            String? @db.Uuid
  accessAllZones        Boolean @default(false)
  defaultZoneView       Boolean @default(false)
  contractedWeeklyHours Float?
  maximumWeeklyHours    Float?
  minimumWeeklyHours    Float?
  optedOutOf48Hours     Boolean @default(false)
  isAgencyStaff         Boolean @default(false)
  agencyName            String?
  agencyRating          String?
  isPreferredAgency     Boolean @default(false)
  isBlacklisted         Boolean @default(false)
  dailyRate             Float?
  hourlyDayRate         Float?
  hourlyNightRate       Float?
  isBankStaff           Boolean @default(false)

  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?
  createdById           String?  @db.Uuid
  updatedById           String?  @db.Uuid
  deletedById           String?  @db.Uuid

  employee              Employee @relation(fields: [employeeId], references: [id])
  workArea              WorkArea? @relation(fields: [workAreaId], references: [id])
  role                  EmployeeRoleLookup? @relation(fields: [roleId], references: [id])
  jobTitle              JobTitle? @relation(fields: [jobTitleId], references: [id])
  rbacLevel             RBACLevel? @relation(fields: [rbacLevelId], references: [id])
  grade                 Grade? @relation(fields: [gradeId], references: [id])
  contractType          ContractType? @relation(fields: [contractTypeId], references: [id])
  travelPaymentType     TravelPaymentType? @relation(fields: [travelPaymentTypeId], references: [id])
  baseLocation          Location? @relation("EmploymentBaseLocation", fields: [baseLocationId], references: [id])
  location              Location? @relation("EmploymentLocation", fields: [locationId], references: [id])
  leavingReason         LeavingReason? @relation(fields: [leavingReasonId], references: [id])

  @@index([employeeId])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeSkill {
  id          String @id @default(uuid()) @db.Uuid
  employeeId  String @db.Uuid
  skillTypeId String? @db.Uuid
  expiryDate  DateTime?
  notes       String?
  documentUrl String?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  employee    Employee @relation(fields: [employeeId], references: [id])
  skillType   SkillType? @relation(fields: [skillTypeId], references: [id])

  @@index([employeeId])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeWorkCertification {
  id                String @id @default(uuid()) @db.Uuid
  employeeId        String @db.Uuid
  certificationTypeId String? @db.Uuid
  reference         String?
  issueDate         DateTime?
  expiryDate        DateTime?
  notes             String?
  certificateUrl    String?

  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  createdById       String?  @db.Uuid
  updatedById       String?  @db.Uuid
  deletedById       String?  @db.Uuid

  employee          Employee @relation(fields: [employeeId], references: [id])
  certificationType CertificationType? @relation(fields: [certificationTypeId], references: [id])

  @@index([employeeId])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeReview {
  id          String @id @default(uuid()) @db.Uuid
  employeeId  String @db.Uuid
  reviewTypeId String? @db.Uuid
  status      String?
  lastDone    DateTime?
  nextDue     DateTime?
  notes       String?
  reviewedById String? @db.Uuid

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  employee    Employee @relation(fields: [employeeId], references: [id])
  reviewType  ReviewType? @relation(fields: [reviewTypeId], references: [id])
  reviewedBy  User? @relation("EmployeeReviewReviewedBy", fields: [reviewedById], references: [id])

  @@index([employeeId])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeDocument {
  id           String @id @default(uuid()) @db.Uuid
  employeeId   String @db.Uuid
  name         String
  description  String?
  fileUrl      String
  fileName     String
  fileSize     Int
  mimeType     String
  uploadedById String? @db.Uuid
  uploadedDate DateTime @default(now())
  tags         String[]

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  createdById  String?  @db.Uuid
  updatedById  String?  @db.Uuid
  deletedById  String?  @db.Uuid

  employee     Employee @relation(fields: [employeeId], references: [id])
  uploadedBy   User? @relation(fields: [uploadedById], references: [id])

  @@index([employeeId])
  @@index([uploadedDate])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeNonCoreActivity {
  id                String @id @default(uuid()) @db.Uuid
  employeeId        String @db.Uuid
  reasonId          String? @db.Uuid
  dateFrom          DateTime
  dateTo            DateTime
  includeInPayroll  Boolean @default(false)
  onCallForPeriod   Boolean @default(false)
  notes             String?

  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  createdById       String?  @db.Uuid
  updatedById       String?  @db.Uuid
  deletedById       String?  @db.Uuid

  employee          Employee @relation(fields: [employeeId], references: [id])
  reason            NonCoreActivityReason? @relation(fields: [reasonId], references: [id])

  @@index([employeeId])
  @@index([dateFrom, dateTo])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeWorkingPattern {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  dayOfWeek  DayOfWeek
  startTime  String?
  endTime    String?
  isAvailable Boolean @default(true)
  notes      String?

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  createdById String? @db.Uuid
  updatedById String? @db.Uuid
  deletedById String? @db.Uuid

  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([dayOfWeek])
  @@index([deletedAt])
  @@schema("employees")
}

model ComplianceRequirement {
  id                 String   @id @default(uuid()) @db.Uuid
  complianceTypeId   String   @db.Uuid
  roleId             String?  @db.Uuid
  workAreaId         String?  @db.Uuid
  jobTitleId         String?  @db.Uuid
  contractTypeId     String?  @db.Uuid
  locationId         String?  @db.Uuid
  zoneId             String?  @db.Uuid
  isMandatory        Boolean  @default(true)
  renewalBeforeDays  Int      @default(30)
  notes              String?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  complianceType ComplianceType         @relation(fields: [complianceTypeId], references: [id])
  role           EmployeeRoleLookup?    @relation(fields: [roleId], references: [id])
  workArea       WorkArea?              @relation(fields: [workAreaId], references: [id])
  jobTitle       JobTitle?              @relation(fields: [jobTitleId], references: [id])
  contractType   ContractType?          @relation(fields: [contractTypeId], references: [id])
  location       Location?              @relation(fields: [locationId], references: [id])
  zone           Zone?                  @relation(fields: [zoneId], references: [id])

  employeeComplianceRecords EmployeeCompliance[]

  @@index([complianceTypeId])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeCompliance {
  id                 String                   @id @default(uuid()) @db.Uuid
  employeeId         String                   @db.Uuid
  complianceTypeId   String?                  @db.Uuid
  requirementId      String?                  @db.Uuid
  status               EmployeeComplianceStatus @default(REQUIRED)

  issueDate   DateTime?
  expiryDate  DateTime?
  documentUrl String? /// legacy single URL; prefer EmployeeComplianceDocument rows
  notes       String?

  submittedAt DateTime?
  verifiedAt  DateTime?
  verifiedById String? @db.Uuid
  rejectedAt   DateTime?
  rejectedById String? @db.Uuid
  rejectionReason String?

  isNoLongerRequired       Boolean   @default(false)
  noLongerRequiredReason   String?
  noLongerRequiredAt       DateTime?
  noLongerRequiredById     String?   @db.Uuid

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  employee       Employee @relation(fields: [employeeId], references: [id])
  complianceType ComplianceType?         @relation(fields: [complianceTypeId], references: [id])
  requirement    ComplianceRequirement?  @relation(fields: [requirementId], references: [id])
  verifiedBy     User?                   @relation("EmployeeComplianceVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy     User?                   @relation("EmployeeComplianceRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  noLongerRequiredBy User?               @relation("EmployeeComplianceNoLongerRequiredBy", fields: [noLongerRequiredById], references: [id], onDelete: SetNull)

  documents     EmployeeComplianceDocument[]
  verifications ComplianceVerification[]
  reminders     ComplianceReminder[]

  @@index([employeeId])
  @@index([complianceTypeId])
  @@index([requirementId])
  @@index([status])
  @@index([expiryDate])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeComplianceDocument {
  id                   String   @id @default(uuid()) @db.Uuid
  employeeComplianceId String   @db.Uuid
  fileName             String
  originalName         String
  fileUrl              String
  fileSize             Int
  mimeType             String
  uploadedById         String?  @db.Uuid
  uploadedAt           DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  employeeCompliance EmployeeCompliance @relation(fields: [employeeComplianceId], references: [id], onDelete: Cascade)
  uploadedBy         User?              @relation("EmployeeComplianceDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([employeeComplianceId])
  @@index([deletedAt])
  @@schema("employees")
}

model ComplianceVerification {
  id                   String   @id @default(uuid()) @db.Uuid
  employeeComplianceId String @db.Uuid
  action               ComplianceVerificationAction
  previousStatus       EmployeeComplianceStatus?
  newStatus            EmployeeComplianceStatus
  notes                String?
  performedById        String?  @db.Uuid
  performedAt          DateTime @default(now())
  metadata             Json?

  employeeCompliance EmployeeCompliance @relation(fields: [employeeComplianceId], references: [id], onDelete: Cascade)
  performedBy        User?              @relation("ComplianceVerificationPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([employeeComplianceId])
  @@index([performedAt])
  @@schema("employees")
}

model ComplianceReminder {
  id                   String   @id @default(uuid()) @db.Uuid
  employeeComplianceId String   @db.Uuid
  reminderType         ComplianceReminderType
  dueDate              DateTime
  sentAt               DateTime?
  status               ComplianceReminderStatus @default(PENDING)
  metadata             Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeCompliance EmployeeCompliance @relation(fields: [employeeComplianceId], references: [id], onDelete: Cascade)

  @@index([employeeComplianceId])
  @@index([dueDate])
  @@index([status])
  @@schema("employees")
}

model EmployeeHoliday {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  startDate  DateTime
  endDate    DateTime
  notes      String?

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  createdById String? @db.Uuid
  updatedById String? @db.Uuid
  deletedById String? @db.Uuid

  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([deletedAt])
  @@schema("employees")
}

model EmployeeLeavingRecord {
  id             String @id @default(uuid()) @db.Uuid
  employeeId     String @db.Uuid
  leavingReasonId String? @db.Uuid
  leavingDate    DateTime
  notes          String?

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid
  deletedById    String?  @db.Uuid

  employee       Employee @relation(fields: [employeeId], references: [id])
  leavingReason  LeavingReason? @relation(fields: [leavingReasonId], references: [id])

  @@index([employeeId])
  @@index([deletedAt])
  @@schema("employees")
}

/** Short-lived inspector logins; empty `serviceUserKeys` = access all service users (product default). */
model TemporaryInspector {
  id             String    @id @default(uuid()) @db.Uuid
  firstName      String
  lastName       String
  username       String    @unique
  passwordHash   String
  reason         String
  /** Option ids from `GET /temporary-inspectors/service-user-options`; empty = all service users. */
  serviceUserKeys String[] @default([])
  validFrom      DateTime
  validTo        DateTime
  refreshTokenHash String?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  @@index([deletedAt])
  @@index([validTo])
  @@schema("employees")
}

enum AuditStatus {
  SUCCESS
  FAILED

  @@schema("audit")
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("audit")
}

enum DataAccessType {
  VIEW
  DOWNLOAD
  EXPORT
  PRINT

  @@schema("audit")
}

enum ExportType {
  CSV
  EXCEL
  PDF
  PRINT

  @@schema("audit")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  module      String
  action      String
  recordType  String?
  recordId    String?
  description String?
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  status      AuditStatus @default(SUCCESS)
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([recordType, recordId])
  @@index([createdAt])
  @@index([status])
  @@schema("audit")
}

model LoginHistory {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @db.Uuid
  email         String?
  event         String
  ipAddress     String?
  userAgent     String?
  deviceName    String?
  status        AuditStatus
  failureReason String?
