  medicalAlerts         ServiceUserMedicalAlert[]
  monitoringConfigs     ServiceUserMonitoringConfig[]
  usualParameters       ServiceUserUsualParameter[]
  legalDocument         ServiceUserLegalDocument?
  dolsRecords           ServiceUserDolsRecord[]
  legalAuthorities      ServiceUserLegalAuthority[]
  documentRecords       ServiceUserDocumentRecord[]
  absences              ServiceUserAbsence[]
  domCare               ServiceUserDomCare?
  initialAssessment     ServiceUserInitialAssessment?
