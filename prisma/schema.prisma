  assessments                    ServiceUserAssessment[]
  carePlanInstances              ServiceUserCarePlanInstance[]
  scheduledJobs                  ScheduledJob[]
  scheduledVisits                ScheduledVisit[]
  callOffVisits                  CallOffVisit[]
  jobCancellations               ScheduledJobCancellation[]
  observations                   ServiceUserObservation[]
  flashMessages                  ServiceUserFlashMessage[]
  bodyMapRecords                 BodyMapRecord[]
  bodyMapAlerts                  BodyMapAlert[]
  portalAccount                  ServiceUserPortalAccount?
  visitCareConsents              VisitCareConsent[]

