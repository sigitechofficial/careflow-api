  allowEmployeeExternalTrainingSubmission   Boolean  @default(true)
  requireManagerApprovalForExternalTraining Boolean  @default(false)
  automaticRefresherAssignment              Boolean  @default(true)
  automaticOverdueEscalation                Boolean  @default(true)
  defaultCertificateValidityDays            Int      @default(365)
  allowCourseAccessAfterExpiry              Boolean  @default(false)
  allowCourseRetakeAfterPass                Boolean  @default(false)
  complianceCalculationMode                 String   @default("HYBRID")
  createdAt                                 DateTime @default(now())
