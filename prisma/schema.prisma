 */
enum EcmScheduleChangeClass {
  ORIGINAL
  PLANNED
  SERVICE_USER_REQUESTED
  PROVIDER_REQUESTED
  EMERGENCY
  SAME_DAY
  LATE_NOTICE
  RETROSPECTIVE
  UNAUTHORISED

