    {
      "name": "Visit workspace",
      "item": [
        {
          "name": "Visit overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/employee-app/visits/{{jobId}}",
