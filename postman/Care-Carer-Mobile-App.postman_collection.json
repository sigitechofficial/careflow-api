{
  "info": {
    "_postman_id": "a8c3e2f1-7b4d-4e9a-9c21-employee-app-carer",
    "name": "Care — Carer Mobile App",
    "description": "Employee / carer mobile app APIs (separate from web admin).\n\nBase URL uses your LAN IP so a phone or emulator on the same network can reach the API.\n\n1. Set `email` / `password` (must match Employee app access on the web admin employee edit page).\n2. Run **Login** — tokens are saved to collection variables automatically.\n3. Call **Home**, **Schedule**, **My visits**, **My salary**, **Clients**, then client-detail endpoints with `{{clientId}}`.\n4. Use **Me**, **Refresh**, **Logout** as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://192.168.0.127:3000"
    },
    {
      "key": "email",
      "value": "carer@example.com"
    },
    {
      "key": "password",
      "value": "YourPassword1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "date",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "medicationKey",
      "value": ""
    },
    {
      "key": "observationId",
      "value": ""
    },
    {
      "key": "incidentId",
      "value": ""
    },
    {
      "key": "month",
      "value": "2026-07"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Carer mobile authentication under `/employee-app/auth/*`",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body && body.data ? body.data : body;",
                  "if (data && data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "}",
                  "if (data && data.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}",
                  "if (data && data.employeeId) {",
                  "  pm.collectionVariables.set('employeeId', data.employeeId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employee-app/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["employee-app", "auth", "login"]
            },
            "description": "Sign in with the email/password set under Employee app access on the admin employee edit page.\n\nSaves `accessToken`, `refreshToken`, and `employeeId` to collection variables."
          },
          "response": []
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body && body.data ? body.data : body;",
                  "if (data && data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "}",
                  "if (data && data.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employee-app/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["employee-app", "auth", "refresh"]
            },
            "description": "Rotate access/refresh tokens for the carer app. Do not use web `/auth/refresh` for these tokens."
          },
          "response": []
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employee-app/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["employee-app", "auth", "me"]
            },
            "description": "Current carer session profile. Uses collection Bearer `{{accessToken}}`."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employee-app/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["employee-app", "auth", "logout"]
            },
            "description": "Clears the carer refresh token server-side and empties local token variables."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Today",
      "description": "Home / Today screen for the carer app (`GET /employee-app/home`).",
      "item": [
        {
          "name": "Home (Today)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "const data = body && body.data ? body.data : body;",
                  "pm.test('Has date, visits, activeVisit, endOfShift; trimmed keys absent', function () {",
                  "  pm.expect(data).to.have.property('date');",
                  "  pm.expect(data).to.have.property('visits');",
                  "  pm.expect(data.visits).to.be.an('array');",
                  "  pm.expect(data).to.have.property('activeVisit');",
                  "  pm.expect(data).to.have.property('endOfShift');",
                  "  pm.expect(data).to.not.have.property('greeting');",
                  "  pm.expect(data).to.not.have.property('sync');",
                  "  pm.expect(data).to.not.have.property('notifications');",
                  "  pm.expect(data).to.not.have.property('quickActions');",
                  "  pm.expect(data).to.not.have.property('progress');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employee-app/home",
              "host": ["{{baseUrl}}"],
              "path": ["employee-app", "home"]
            },
            "description": "Today home payload for the authenticated carer:\n- `date` (schedule day)\n- `activeVisit` (in-progress card with allergies + directions, or null)\n- `visits` list (status, tags, task progress, `scheduledStartIso` / `scheduledEndIso` UTC matching visit details)\n- `endOfShift` summary\n\nTrimmed: greeting / sync / notifications / quickActions / progress are **not** returned.\n\nUses Bearer `{{accessToken}}`. Defaults to today's UTC date."
          },
          "response": []
        },
        {
          "name": "Home (by date)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employee-app/home?date={{date}}",
              "host": ["{{baseUrl}}"],
              "path": ["employee-app", "home"],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}",
                  "description": "YYYY-MM-DD (UTC schedule day)"
                }
              ]
            },
            "description": "Same as Home (Today) but for a specific schedule day. Set collection variable `date` (e.g. `2026-07-15`)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Schedule",
      "description": "Schedule screen (`GET /employee-app/schedule`), monthly visits (`GET /employee-app/me/visits`), and salary (`GET /employee-app/me/salary`).",
      "item": [
        {
          "name": "My visits (month)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/employee-app/me/visits?month={{month}}",
              "host": ["{{baseUrl}}"],
              "path": ["employee-app", "me", "visits"],
              "query": [{ "key": "month", "value": "{{month}}" }]
            },
            "description": "Read-only visit history for the authenticated carer (same as admin Employee → Visits): summary buckets + planned/actual times + delivery assessment. Defaults to current UTC month. Open a visit with GET /employee-app/visits/{{jobId}}."
          },
          "response": []
        },
        {
          "name": "My visits (date range)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/employee-app/me/visits?dateFrom=2026-01-01&dateTo=2026-07-31",
              "host": ["{{baseUrl}}"],
              "path": ["employee-app", "me", "visits"],
              "query": [
                { "key": "dateFrom", "value": "2026-01-01", "description": "YYYY-MM-DD" },
