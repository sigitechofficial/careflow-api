{
  "name": "careadmin-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest build && nest start --entryFile src/main",
    "start:dev": "nest start --watch --entryFile src/main",
    "start:debug": "nest start --debug --watch --entryFile src/main",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "seed": "prisma db seed",
    "seed:deploy": "bash prisma/scripts/run-deploy-seeds.sh .",
    "setup:payroll-employees-ready": "node prisma/scripts/setup-payroll-employees-ready.mjs",
    "setup:payroll-fps-employee-data": "node prisma/scripts/setup-payroll-fps-employee-data.mjs",
    "seed:payroll-tax-codes": "node prisma/scripts/seed-payroll-tax-codes.mjs",
    "seed:demo-office-users": "ts-node --transpile-only prisma/scripts/seed-demo-office-users.ts",
    "seed:greenwich-branch-users": "ts-node --transpile-only prisma/scripts/seed-greenwich-branch-users.ts",
    "seed:greenwich-service-users": "ts-node --transpile-only prisma/scripts/seed-greenwich-service-users.ts",
    "seed:task-catalogue": "ts-node --transpile-only prisma/scripts/seed-task-catalogue.ts",
    "import:gallery-urls": "node scripts/import-gallery-from-urls.mjs",
    "probe:gallery-urls": "node scripts/probe-gallery-blob-urls.mjs",
    "sync:gallery-public": "node scripts/sync-gallery-from-public.mjs",
    "sync:gallery-images": "node scripts/sync-gallery-images-folder.mjs",
    "refresh:form-icons": "ts-node --transpile-only prisma/seeds/refresh-form-icons.ts",
    "download:gallery-api": "node scripts/download-gallery-from-api.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "openapi:export": "ts-node --transpile-only --prefer-ts-exts scripts/export-openapi.ts",
    "seed:full-su": "ts-node --transpile-only prisma/scripts/seed-full-service-user-demo.ts",
    "provision:ia-qa-demo-user": "ts-node --transpile-only prisma/scripts/provision-ia-qa-demo-user.ts",
    "seed:personas": "ts-node --transpile-only prisma/scripts/seed-service-user-personas.ts",
    "seed:persona-schedule": "ts-node --transpile-only prisma/scripts/seed-persona-schedule.ts",
    "seed:persona-runs": "ts-node --transpile-only prisma/scripts/seed-persona-schedule-runs.ts",
    "seed:ecm-demo": "ts-node --transpile-only prisma/scripts/seed-ecm-demo-visits.ts",
    "seed:employee-app-qa": "ts-node --transpile-only prisma/scripts/seed-employee-app-qa-visits.ts",
    "seed:mar-30-api": "ts-node --transpile-only prisma/scripts/seed-mar-30-days-via-api.ts",
    "seed:medication-realistic": "ts-node --transpile-only prisma/scripts/reset-and-seed-realistic-medication-via-api.ts",
    "seed:section-311-flooring": "ts-node --transpile-only prisma/scripts/resync-section-311-flooring.ts",
    "seed:ia-sections-16-17": "ts-node --transpile-only prisma/scripts/resync-ia-sections-16-17.ts",
    "seed:allergies": "ts-node --transpile-only prisma/scripts/seed-allergy-catalog.ts",
    "seed:ethnicities": "ts-node --transpile-only prisma/scripts/seed-ethnicities.ts",
    "seed:funding-types": "ts-node --transpile-only prisma/scripts/seed-funding-types.ts",
    "seed:assign-billing-cards": "ts-node --transpile-only prisma/scripts/assign-billing-cards.ts",
    "seed:pay-cards": "ts-node --transpile-only prisma/scripts/seed-pay-cards.ts",
    "seed:charge-cards": "ts-node --transpile-only prisma/scripts/seed-charge-cards.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.21",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.21",
    "@prisma/client": "^6.10.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "puppeteer-core": "^24.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
