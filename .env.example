NODE_ENV=development

PORT=3000
# Bind address: 0.0.0.0 = LAN/IP access; 127.0.0.1 = localhost only
HOST=0.0.0.0



# Database

DATABASE_URL="postgresql://postgres:Abubakr123@localhost:5432/careadmin?schema=public"



# Auth

JWT_ACCESS_TOKEN_SECRET="CHANGE_ME_ACCESS_SECRET"

JWT_ACCESS_TOKEN_EXPIRES_IN="15m"

JWT_REFRESH_TOKEN_SECRET="CHANGE_ME_REFRESH_SECRET"

JWT_REFRESH_TOKEN_EXPIRES_IN="7d"



# Swagger

SWAGGER_TITLE="CareAdmin API"

SWAGGER_DESCRIPTION="CareAdmin backend API"

SWAGGER_VERSION="1.0.0"

SWAGGER_PATH="api/docs"



# File uploads (local)

UPLOAD_MAX_FILE_SIZE_BYTES=10485760

MAX_UPLOAD_FILE_SIZE_MB=10

UPLOAD_BASE_PATH=uploads



# Initial assessment PDF export (HTML → PDF via system Chrome/Edge)

# PUPPETEER_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"



# AES-256-GCM key for secure assessment fields (32+ bytes, base64 recommended)

FIELD_ENCRYPTION_KEY="CHANGE_ME_32_BYTE_BASE64_KEY"



# Rate limiting (per IP; sliding window)

RATE_LIMIT_TTL_MS=60000

RATE_LIMIT_MAX=200



# Node HTTP server: max time to receive the full request (ms)

HTTP_REQUEST_TIMEOUT_MS=120000



# openFDA drug label search (medication name autocomplete)
# https://open.fda.gov/apis/authentication/
OPENDFDA_API_KEY=
