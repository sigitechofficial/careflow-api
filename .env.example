NODE_ENV=development

PORT=3000
# Bind address: 0.0.0.0 = LAN/IP access; 127.0.0.1 = localhost only
HOST=0.0.0.0
# Admin web app address used in survey emails/push links (e.g. https://admin.example.com).
# ADMIN_APP_URL=http://localhost:5173



# Database (replace PASSWORD with your local Postgres password)

DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/careadmin?schema=public"



# Auth

JWT_ACCESS_TOKEN_SECRET="CHANGE_ME_ACCESS_SECRET"

JWT_ACCESS_TOKEN_EXPIRES_IN="15m"

JWT_REFRESH_TOKEN_SECRET="CHANGE_ME_REFRESH_SECRET"

JWT_REFRESH_TOKEN_EXPIRES_IN="7d"



# Swagger

SWAGGER_TITLE="CareAdmin API"

SWAGGER_DESCRIPTION="CareAdmin backend API"

SWAGGER_VERSION="1.0.0"

SWAGGER_PATH="api/docs"



# File uploads (local)

UPLOAD_MAX_FILE_SIZE_BYTES=10485760

MAX_UPLOAD_FILE_SIZE_MB=10

UPLOAD_BASE_PATH=uploads



# Initial assessment PDF export (HTML → PDF via system Chrome/Edge)

# PUPPETEER_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"



# AES-256-GCM key for secure assessment fields (32+ bytes, base64 recommended)

FIELD_ENCRYPTION_KEY="CHANGE_ME_32_BYTE_BASE64_KEY"

# HMRC RTI Transaction Engine (T16 — test gateway). Keep HTTP off until credentials + Vendor ID are ready.
# HMRC_VENDOR_ID comes from HMRC Software Developers Support Team.
# Local/dev: CARE-DEV-DUMMY-VENDOR-ID is fine for dry-run / UI testing (not for real HMRC recognition).
HMRC_VENDOR_ID=CARE-DEV-DUMMY-VENDOR-ID
HMRC_RTI_HTTP_ENABLED=false
# T18 — live dual-control. Keep false until ops is ready for real HMRC filings.
HMRC_RTI_LIVE_ENABLED=false

# T17 — fraud-prevention headers (WEB_APP_VIA_SERVER). Public IP of the Care API edge (load balancer / NAT).
HMRC_VENDOR_PRODUCT_NAME="Care Payroll"
HMRC_VENDOR_PUBLIC_IP=
HMRC_ADMIN_VERSION=1.0.0
HMRC_BACKEND_VERSION=0.0.1



# Rate limiting (per IP; sliding window)

RATE_LIMIT_TTL_MS=60000

RATE_LIMIT_MAX=200

# Reverse-proxy hops in front of the API whose X-Forwarded-For entry is trusted for the client IP
# (rate limiting + audit logs). 0 = trust none (local / direct). Azure Container Apps ingress = 1.
# Never set higher than the real number of proxies, or clients can spoof their IP.

TRUST_PROXY_HOPS=0

# Narrow production flag for POST /dev/generate-ia-section only (staff JWT still required).
# Does NOT enable ENABLE_DEV_TOOLS, SEED_DEMO_DATA, or any other /dev route. Off unless exactly true.
# ENABLE_IA_QA_DEMO=true

# Seeding. Sample people (Greenwich roster, demo office logins, demo service users) are
# OFF unless exactly true — set true only on dev/test databases, never on Azure production.
# SEED_SAMPLE_PEOPLE=true

# First super admin (created once; an existing admin's password is never changed by seeding).
# In production ADMIN_SEED_PASSWORD is required (min 12 chars) — there is no default.
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=



# Node HTTP server: max time to receive the full request (ms)

HTTP_REQUEST_TIMEOUT_MS=120000



# openFDA drug label search (medication name autocomplete)
# https://open.fda.gov/apis/authentication/
OPENDFDA_API_KEY=

# Outbound email (invoice send). Prefer ZeptoMail HTTP API.
# Without MAIL_API_TOKEN / SMTP_HOST, MAIL_MODE defaults to `log` (local/dev).
# MAIL_MODE=api
# MAIL_API_URL=https://api.zeptomail.com/v1.1/email
# MAIL_API_TOKEN="Zoho-enczapikey YOUR_SEND_MAIL_TOKEN"
# MAIL_FROM="Allfor Care <noreply@allforcare.co.uk>"
# Optional SMTP fallback:
# MAIL_MODE=smtp
# SMTP_HOST=smtp.zeptomail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=emailapikey
# SMTP_PASS="Zoho-enczapikey YOUR_KEY_HERE"
# MAIL_MODE=log
# Password reset emails link to `${PASSWORD_RESET_URL_BASE}/auth/reset-password?token=…` (the admin
# site origin). Required in production (no email is sent without it); defaults to http://localhost:5173 elsewhere.
# PASSWORD_RESET_URL_BASE=https://admin.careflow.example.com

# Survey text messages (invitations and reminders with the person's own link; never on anonymous surveys
# where a text could link a person to an answer). No provider package is installed yet.
#   log  (default) nothing is sent; the API log gets a masked number (07*** ***123) and the length only.
#   off  no texts at all (the text channel is skipped and counted as "not sent").
#   live the configured provider sends them. Until a provider is set up in code, live falls back to log
#        with a warning at start-up.
# TEXT_MESSAGE_MODE=log
# Replies (STOP / START): the exact public https address set at the provider for replies, e.g.
# https://api.careflow.example.com/text-messages/replies. Signatures are checked against this address,
# never one worked out from the request. Leave unset until a provider that handles replies is in use: the
# reply address then refuses everything, and messages never offer "Reply STOP".
# TEXT_MESSAGE_REPLY_URL=

# Firebase Admin (carer FCM). Default ./serviceAccount.json — do not commit the private key.
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# CORS: comma-separated browser origins allowed to call the API (HTTP + Socket.io).
# Unset = any origin outside production; in production unset means NO cross-origin access.
# ALLOWED_ORIGINS=https://careflow.example.com

# Swagger UI at SWAGGER_PATH: defaults to off in production, on elsewhere.
# SWAGGER_ENABLED=false

# Email via Azure Communication Services (MAIL_MODE=acs). No secret: uses the managed identity
# on Azure (AZURE_CLIENT_ID = the user-assigned identity's client id) and your `az login` locally.
# MAIL_FROM must be a MailFrom address on a domain linked to the ACS resource.
# MAIL_MODE=acs
# ACS_ENDPOINT=https://<acs-name>.uk.communication.azure.com
# MAIL_FROM="Allfor Care <noreply@allforcare.co.uk>"   # required in production; ACS shows the display name configured on the Azure sender (noreply → "Allfor Care")
# Dev (developer machines, your az login): ACS_ENDPOINT=https://acs-careflow-dev.uk.communication.azure.com
# Production: ACS_ENDPOINT=https://acs-careflow-prod.uk.communication.azure.com
# A server with no managed identity (e.g. the cPanel VPS, where outbound SMTP is blocked): sign
# in as an Entra app used only for email (HTTPS on port 443). Its secret goes in the server .env only.
# ACS_ENDPOINT=https://acs-careflow-dev.uk.communication.azure.com
# ACS_TENANT_ID=<tenant id>
# ACS_CLIENT_ID=<app (client) id of careflow-cpanel-smtp>
# ACS_CLIENT_SECRET=<client secret>
# Silent copy (BCC) of every email to these comma-separated addresses. Password-reset emails
# are never copied (the link signs in as that user). Not applied while MAIL_REDIRECT_TO is set.
# MAIL_BCC=office@example.com,manager@example.com
# Laptop safety net: send EVERY email to this inbox instead of the real recipients (ignored in production).
# MAIL_REDIRECT_TO=you@example.com

# Azure Pricing (admin → Azure Pricing). Strictly READ-ONLY towards Azure: Cost Management
# query/forecast, Consumption budgets, Advisor, public Retail Prices. No secret: uses the API's
# managed identity on Azure (AZURE_CLIENT_ID) and your `az login` locally. The identity needs
# "Cost Management Reader" + "Reader" on the subscription (see docs/AZURE_PRICING.md).
# Off by default: endpoints still answer from the database with `enabled:false`.
# AZURE_COST_ENABLED=true
# AZURE_COST_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_COST_SCOPE=/subscriptions/00000000-0000-0000-0000-000000000000
# AZURE_COST_RESOURCE_GROUPS=rg-careflow-prod,rg-careflow-prod-cae-infra
# AZURE_COST_REGION=uksouth
# AZURE_COST_CURRENCY=GBP

# Scheduled jobs (admin → System jobs). CRON_MODE=internal (default): the API runs its own @Cron
# timers (cPanel / single replica). CRON_MODE=external: the API's timers stay idle; Azure Functions
# call POST /internal/jobs/<name> and Container Apps Jobs run `node dist/src/jobs/run-job.js <name>`.
# Every run is recorded in platform.JobRun and runs at most once per period whichever trigger fires.
# CRON_MODE=internal
# Shared secret for POST /internal/jobs/<name> (header x-jobs-trigger-secret, min 16 chars; use 48+
# random chars in production, from Key Vault). Unset = the endpoint answers 503 (disabled).
# JOBS_TRIGGER_SECRET=

# Google Routes API (server key) for driving distance/time between service users. Empty = rota-style estimate.
GOOGLE_MAPS_API_KEY=

# Initial Assessment "Conversation to text" (Whisper runs on this server; needs Python + "pip install faster-whisper")
# Model: tiny | base | small | medium | large-v3 (bigger = more accurate, slower). Language empty = auto-detect.
# WHISPER_PYTHON=python
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=
# WHISPER_MAX_UPLOAD_MB=200
# Where Whisper runs. Empty/"local" = inside this API process (above; VPS and developer machines).
# "azure-job" = Azure only: uploads are queued in the database and the Whisper Container Apps Job is started
# for them (scales to zero; see deploy/azure/whisper/README.md). Needs WHISPER_JOB_RESOURCE_ID and the API's
# managed identity allowed to start that job.
# WHISPER_MODE=
# WHISPER_JOB_RESOURCE_ID=/subscriptions/<id>/resourceGroups/rg-careflow-prod/providers/Microsoft.App/jobs/job-careflow-whisper

# Initial Assessment "Fill fields from transcript" (Anthropic Claude API key, sk-ant-...)
# AI_API_KEY=

# How often surveys check the records for events like a hospital discharge (minutes, 1-60; default 15)
# SURVEY_EVENT_DETECT_MINUTES=15

# Referral mailboxes (Referral inbox → Mailboxes). Gmail and Microsoft 365 connect by sign-in; IMAP/SMTP and
# webhook mailboxes are added on screen (their passwords are stored encrypted with FIELD_ENCRYPTION_KEY).
# Gmail / Google Workspace: Google Cloud OAuth client (Gmail API, scope gmail.modify).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/referral-mailbox/google/callback
# Microsoft 365 / Outlook: Entra app registration ("Accounts in any organizational directory and personal
# Microsoft accounts"), delegated permissions offline_access, User.Read, Mail.ReadWrite, Mail.Send, and a
# web redirect URI matching the one below. TENANT: "common" (default) or your tenant id to allow only your own.
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/referral-mailbox/microsoft/callback
# MICROSOFT_OAUTH_TENANT=common
