NODE_ENV=development

PORT=3000
# Bind address: 0.0.0.0 = LAN/IP access; 127.0.0.1 = localhost only
HOST=0.0.0.0
# Admin web app address used in survey emails/push links (e.g. https://admin.example.com).
# ADMIN_APP_URL=http://localhost:5173



# Database (replace PASSWORD with your local Postgres password)

DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/careadmin?schema=public"



# Auth

JWT_ACCESS_TOKEN_SECRET="CHANGE_ME_ACCESS_SECRET"

JWT_ACCESS_TOKEN_EXPIRES_IN="15m"

JWT_REFRESH_TOKEN_SECRET="CHANGE_ME_REFRESH_SECRET"

JWT_REFRESH_TOKEN_EXPIRES_IN="7d"



# Swagger

SWAGGER_TITLE="CareAdmin API"

SWAGGER_DESCRIPTION="CareAdmin backend API"

SWAGGER_VERSION="1.0.0"

SWAGGER_PATH="api/docs"



# File uploads (local)

UPLOAD_MAX_FILE_SIZE_BYTES=10485760

MAX_UPLOAD_FILE_SIZE_MB=10

UPLOAD_BASE_PATH=uploads



# Initial assessment PDF export (HTML → PDF via system Chrome/Edge)

# PUPPETEER_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"



# AES-256-GCM key for secure assessment fields (32+ bytes, base64 recommended)

FIELD_ENCRYPTION_KEY="CHANGE_ME_32_BYTE_BASE64_KEY"

# HMRC RTI Transaction Engine (T16 — test gateway). Keep HTTP off until credentials + Vendor ID are ready.
# HMRC_VENDOR_ID comes from HMRC Software Developers Support Team.
# Local/dev: CARE-DEV-DUMMY-VENDOR-ID is fine for dry-run / UI testing (not for real HMRC recognition).
HMRC_VENDOR_ID=CARE-DEV-DUMMY-VENDOR-ID
HMRC_RTI_HTTP_ENABLED=false
# T18 — live dual-control. Keep false until ops is ready for real HMRC filings.
HMRC_RTI_LIVE_ENABLED=false

# T17 — fraud-prevention headers (WEB_APP_VIA_SERVER). Public IP of the Care API edge (load balancer / NAT).
HMRC_VENDOR_PRODUCT_NAME="Care Payroll"
HMRC_VENDOR_PUBLIC_IP=
HMRC_ADMIN_VERSION=1.0.0
HMRC_BACKEND_VERSION=0.0.1



# Rate limiting (per IP; sliding window)

RATE_LIMIT_TTL_MS=60000

RATE_LIMIT_MAX=200

# Narrow production flag for POST /dev/generate-ia-section only (staff JWT still required).
# Does NOT enable ENABLE_DEV_TOOLS, SEED_DEMO_DATA, or any other /dev route. Off unless exactly true.
# ENABLE_IA_QA_DEMO=true



# Node HTTP server: max time to receive the full request (ms)

HTTP_REQUEST_TIMEOUT_MS=120000



# openFDA drug label search (medication name autocomplete)
# https://open.fda.gov/apis/authentication/
OPENDFDA_API_KEY=

# Outbound email (invoice send, surveys, etc.) via SMTP.
# Without MAIL_MODE / SMTP_HOST it defaults to `log` (local/dev; nothing is sent).
#
# Azure Communication Services (SMTP) — staging/production.
# SMTP_SECURE=false is correct for port 587: connection upgrades to TLS via STARTTLS.
# MAIL_MODE=smtp
# SMTP_HOST=smtp.azurecomm.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=careflow-cpanel-staging
# SMTP_PASS=                # from Azure Key Vault (cpanel-smtp-password)
# MAIL_FROM="Allfor Care <noreply@allforcare.co.uk>"

# Firebase Admin (carer FCM). Default ./serviceAccount.json — do not commit the private key.
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
